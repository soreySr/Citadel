+(defbehavior fishermans-boat-ios-draw-hints fishermans-boat ()
+  "Driving controls, styled like the warp gate's hints, right-aligned under the touch HUD button.
+   Shown for 5 seconds after taking the wheel, then faded out over 1 second."
+  (let* ((elapsed (the int (- (current-time) (-> self state-time))))
+         (alpha (if (< elapsed (the int (seconds 5)))
+                  128
+                  (- 128 (/ (* 128 (- elapsed (the int (seconds 5)))) (the int (seconds 1)))))))
+    (when (> alpha 0)
+      (let ((font (new 'stack 'font-context *font-default-matrix* 464 26 0.0 (font-color default) (font-flags shadow kerning))))
+        (set-scale! font 0.7)
+        (set-width! font 300)
+        (set-height! font 20)
+        (set! (-> font flags) (font-flags shadow kerning right large))
+        ;; <PAD_X> and <PAD_CIRCLE> in the game font (see font_db_jak1.cpp)
+        (fishermans-boat-ios-hint-line "PRESS ~Y~22L<~Z~Y~27L*~Z~Y~1L>~Z~Y~23L[~Z~+26H TO START/STOP" font alpha)
+        (fishermans-boat-ios-hint-line "PRESS ~Y~22L<~Z~Y~25L@~Z~Y~1L>~Z~Y~23L[~Z~+26H TO EXIT" font alpha))))
+  0
+  (none))
