index 000000000..ecb523df4
--- /dev/null
+++ b/tools/ios/aot_type_image.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""Plan a fixed-address type arena for the Jak 1 iOS AOT bootstrap.
+
+This is a data-only plan for a native iOS bootstrap allocator. It follows the
+Jak 1 kernel's type allocation sizing. The caller supplies a reserved,
+16-byte-aligned arena outside the kernel heap and prelinked image. Captured
+desktop addresses are optional validation inputs, not iOS runtime addresses.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+
+BASIC_OFFSET = 4
+ALIGNMENT = 16
+
+
+def type_allocation_size(method_count: int) -> int:
+    """Match Jak 1's size_of_type in game/kernel/jak1/kscheme.cpp."""
+    return (4 * method_count + 0x23) & 0xFFFF_FFF0
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("startup_table", type=Path)
+    parser.add_argument("bootstrap_addresses", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument(
+        "--base",
+        required=True,
+        type=lambda value: int(value, 0),
+        help="start of the iOS runtime's reserved type arena (for example 0x02000000)",
+    )
+    parser.add_argument(
+        "--preserve-captured-types",
+        action="store_true",
+        help="reuse matching desktop-capture addresses (for capture analysis only)",
+    )
+    args = parser.parse_args()
+    if args.base < BASIC_OFFSET or args.base % ALIGNMENT:
+        parser.error("--base must be 16-byte aligned and greater than the basic offset")
+
+    table = json.loads(args.startup_table.read_text())
+    capture = json.loads(args.bootstrap_addresses.read_text())
+    captured = {entry["name"]: entry for entry in capture["types"]}
+    allocations = []
+    cursor = args.base
+
+    for entry in table["type_intern_order"]:
+        name = entry["name"]
+        method_count = entry["method_count"]
+        size = type_allocation_size(method_count)
+        observed = captured.get(name) if args.preserve_captured_types else None
+        if observed is not None:
+            if observed["method_count"] < method_count:
+                raise RuntimeError(
+                    f"captured type {name!r} has {observed['method_count']} methods, "
+                    f"but AOT objects require {method_count}"
+                )
+            allocations.append({
+                "name": name,
+                "method_count": method_count,
+                "goal_offset": observed["goal_offset"],
+                "source": "captured-kernel-boot",
+            })
+            continue
+
+        raw_offset = cursor
+        goal_offset = raw_offset + BASIC_OFFSET
+        allocations.append({
+            "name": name,
+            "method_count": method_count,
+            "goal_offset": goal_offset,
+            "raw_offset": raw_offset,
+            "allocation_size": size,
+            "source": "reserved-ios-type-arena",
+        })
+        cursor += size
+
+    output = {
+        "format": "OpenGOAL Jak 1 iOS AOT type image plan v1",
+        "reserved_arena_base": args.base,
+        "reserved_arena_end": cursor,
+        "reserved_arena_size": cursor - args.base,
+        "captured_type_count": sum(item["source"] == "captured-kernel-boot" for item in allocations),
+        "allocated_type_count": sum(item["source"] == "reserved-ios-type-arena" for item in allocations),
+        "types": allocations,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(output, indent=2) + "\n")
+    print(
+        f"Wrote {args.output} ({output['captured_type_count']} captured types, "
+        f"{output['allocated_type_count']} planned arena types, "
+        f"{output['reserved_arena_size']} bytes)"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
