+       (go mount-race-ring-active)
+       )
+      )
+    )
+  :code (behavior ()
+    (if (nonzero? (-> self sound))
+        (stop! (-> self sound))
+        )
+    (loop
+      (suspend)
+      )
+    )
+  )
