+                      (static-attack-info ((shove-up (meters 1.0)) (shove-back (meters -4.0)) (vector forward-dir))))
+          (set! (-> self control dynam gravity y) (meters 60)))
+        ;; if we run out of yellow eco, fire a partially charged shot
+        (when (and (not (target-powerup? super-eco-yellow))
+                   (> (-> *ios-tfl-super* super-yellow-charge-time) 0)
+                   (time-elapsed? (-> *ios-tfl-super* super-yellow-charge-time) SUPER_YELLOW_MAX_CHARGE_TIME))
+          (cpad-clear! 0 square)
+          (stop! (ios-tfl-charge-loop-sound))
+          (sound-play "bfg-fire" :id fire-id)
