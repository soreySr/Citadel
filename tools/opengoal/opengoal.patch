+(defbehavior fishermans-boat-ios-shore-collide fishermans-boat ()
+  "og:ios driveable boat: the rigid body has no background collision (the stock boat only ever followed
+   its path), so probe ahead along its velocity at the waterline and remove the velocity into shores and rocks."
+  (let* ((rb (-> self rbody))
+         (dir (new 'stack-no-clear 'vector))
+         (speed (vector-xz-length (-> rb lin-velocity))))
+    (when (< 1024.0 speed)
+      (set! (-> dir quad) (-> rb lin-velocity quad))
+      (set! (-> dir y) 0.0)
+      (vector-normalize! dir 1.0)
+      (let ((start (new 'stack-no-clear 'vector))
+            (probe (new 'stack-no-clear 'vector))
+            (result (new 'stack-no-clear 'collide-tri-result)))
+        (set! (-> start quad) (-> self root-overlay trans quad))
+        (set! (-> start y) (+ 4096.0 (ocean-get-height start)))
+        ;; the bow is ~12 m ahead of the origin; look just past this frame's travel. A thin (1 m) probe, so
+        ;; docks, piers and rocks beside the boat's path don't brush it and bleed off speed.
+        (vector-float*! probe dir (+ 49152.0 (* 2.0 speed (seconds-per-frame))))
+        (when (>= (fill-and-probe-using-line-sphere *collide-cache*
+                                                    start
+                                                    probe
+                                                    4096.0
+                                                    (collide-kind background)
+                                                    self
+                                                    result
+                                                    (new 'static 'pat-surface :noentity #x1))
+                  0.0)
+          ;; Only walls and shores block (a mostly horizontal surface normal): flat ground such as the sea floor
+          ;; used to cancel all forward motion, leaving the boat stuck with its propeller spinning. Remove just
+          ;; the motion into the surface, with a small bounce, so the boat can still slide along or turn away.
+          (let ((wall (new 'stack-no-clear 'vector)))
+            (set! (-> wall quad) (-> result normal quad))
+            (set! (-> wall y) 0.0)
+            (when (and (< 0.5 (vector-length wall))
+                       ;; only obstacles the boat is heading into (within ~60 degrees of head-on); grazing
+                       ;; contacts along the side are left alone
+                       (begin
+                         (vector-normalize! wall 1.0)
+                         (< (vector-dot dir wall) -0.5)))
+              (let ((into (- (vector-dot (-> rb lin-momentum) wall))))
+                (if (< 0.0 into) (vector+*! (-> rb lin-momentum) (-> rb lin-momentum) wall (* 1.2 into))))
+              (let ((into (- (vector-dot (-> rb lin-velocity) wall))))
+                (if (< 0.0 into) (vector+*! (-> rb lin-velocity) (-> rb lin-velocity) wall (* 1.2 into)))))))
+        ;; The stand-in coastline has no background collision: stop where it rises above the keel (1 m down).
+        (when *ios-coast-visible*
+          (let ((tip (vector+! (new 'stack-no-clear 'vector) start probe)))
+            (when (< (- (ocean-get-height tip) (meters 1)) (ios-coast-height (-> tip x) (-> tip z)))
+              (let ((into (vector-dot (-> rb lin-momentum) dir)))
+                (if (< 0.0 into) (vector+*! (-> rb lin-momentum) (-> rb lin-momentum) dir (* -1.2 into))))
+              (let ((into (vector-dot (-> rb lin-velocity) dir)))
+                (if (< 0.0 into) (vector+*! (-> rb lin-velocity) (-> rb lin-velocity) dir (* -1.2 into))))))))))
+  0
+  (none))
+
+;; Cruise throttle: 65% of the top of the autopilot's throttle table (0.6694, the long legs of the ride). Water drag
+;; is linear in velocity, so the top speed scales the same way.
+(defconstant FISHERMANS_BOAT_IOS_MAX_THROTTLE 0.4351)
+
+(defbehavior fishermans-boat-ios-steady fishermans-boat ()
+  "og:ios driveable boat: damp pitch and roll (keeping yaw, so turning is unaffected). Run every physics step;
+   without it the hull rocks a lot under thrust and waves (the stock ride was a canned animation).
+   The damping doubles as the throttle reaches cruise (0.85 -> 0.85^2 kept per step), about halving the rocking at
+   top speed."
+  (let* ((am (-> self rbody ang-momentum))
+         (yaw (vector-dot am *y-vector*))
+         (t (fmax 0.0 (fmin 1.0 (/ (-> self controller throttle) FISHERMANS_BOAT_IOS_MAX_THROTTLE))))
+         (keep (* 0.85 (lerp 1.0 0.85 t))))
+    (vector-float*! am am keep)
+    (vector+*! am am *y-vector* (* (- 1.0 keep) yaw)))
+  0
+  (none))
+
+;; Turn-in-place push at bow and stern, as a fraction of cruise thrust (user 2026-10-10: 0.15 -> 0.22, a bit faster).
+(defconstant FISHERMANS_BOAT_IOS_TURN_IN_PLACE 0.22)
+
+(defbehavior fishermans-boat-ios-turn-in-place fishermans-boat ()
+  "og:ios driveable boat: steering normally only bites through the engine's thrust, so a stopped boat could not
+   turn. At the wheel, add a slow yaw twist (equal and opposite side pushes at bow and stern, so it does not drift)
+   that fades out as the engine thrust builds."
+  (when (and *ios-boat-driving* (!= (-> self controller steering) 0.0))
+    (let* ((cruise (* 1228800.0 FISHERMANS_BOAT_IOS_MAX_THROTTLE))
+           (fade (- 1.0 (fmax 0.0 (fmin 1.0 (/ (-> self engine-thrust) cruise)))))
+           ;; same turn direction as the thrust: the stern gets pushed toward -steering
+           (push (* (- FISHERMANS_BOAT_IOS_TURN_IN_PLACE) cruise fade (-> self controller steering)))
+           (mat (-> self rbody matrix))
+           (pos (new 'stack-no-clear 'vector))
+           (force (new 'stack-no-clear 'vector)))
+      (when (< 0.0 fade)
+        (set-vector! force push 0.0 0.0 1.0)
+        (vector-rotate*! force force mat)
+        (set-vector! pos 0.0 12288.0 -20480.0 1.0)
+        (vector-matrix*! pos pos mat)
+        (rigid-body-method-13 (-> self rbody) pos force)
+        (vector-float*! force force -1.0)
+        (set-vector! pos 0.0 12288.0 20480.0 1.0)
+        (vector-matrix*! pos pos mat)
+        (rigid-body-method-13 (-> self rbody) pos force))))
+  0
+  (none))
