+++ b/tools/ios/aot_runtime_state_pack.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""Pack a captured 128 MiB Jak 1 GOAL arena for the stock-iOS runtime."""
+
+from __future__ import annotations
+
+import argparse
+import struct
+import zlib
+from pathlib import Path
+
+
+MAGIC = b"JAK1STA\0"
+VERSION = 1
+HEADER = struct.Struct("<8sIIIII")
+EXPECTED_STATE_SIZE = 128 * 1024 * 1024
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("input", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+
+    state = args.input.read_bytes()
+    if len(state) != EXPECTED_STATE_SIZE:
+        parser.error(
+            f"expected a {EXPECTED_STATE_SIZE}-byte GOAL arena, got {len(state)} bytes"
+        )
+
+    # Apple's COMPRESSION_ZLIB consumes raw RFC 1951 DEFLATE, not a .gz or
+    # zlib-container header. Keep this format intentionally small and portable.
+    compressor = zlib.compressobj(level=9, wbits=-15)
+    encoded = compressor.compress(state) + compressor.flush()
+    header = HEADER.pack(
+        MAGIC,
+        VERSION,
+        len(state),
+        len(encoded),
+        zlib.crc32(state),
+        0,
+    )
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_bytes(header + encoded)
+    print(
+        f"Wrote {args.output} ({len(state)} bytes -> {len(encoded)} bytes, "
+        f"CRC32 0x{zlib.crc32(state):08x})"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
