+(defun ios-tfl-actor-in-range? ((lev level) (links entity-links))
+  (case (-> lev name)
+    (('crystal-ca 'crescent-t 'energy-bay 'open-mines 'valley)
+     (let ((hack (res-lump-float (-> links entity) 'vis-dist-hack :default 0.0)))
+       (or (= hack 0.0) (< (vector-vector-distance (-> links trans) (camera-pos)) hack))))
+    (else #t)))
