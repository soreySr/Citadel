+(defun ios-fish-menu-preview-draw-text ((species int))
+  "Under the previewed fish: its rarity and how many this save has caught. Drawn from the menu hook, after the pause
+   menu has drawn, so it is on top of the menu's panels."
+  (let ((rarity (-> *ios-fish-roster* species species rarity)))
+        (ios-fishing-text (case rarity
+                            ((0) "COMMON")
+                            ((1) "UNCOMMON")
+                            ((2) "RARE")
+                            ((3) "EPIC")
+                            (else "LEGENDARY"))
+                          IOS_FISH_MENU_PREVIEW_X
+                          (+ IOS_FISH_MENU_PREVIEW_Y 40.0)
+                          0.7
+                          (case rarity
+                            ((0) (font-color white))
+                            ((1) (font-color green))
+                            ((2) (font-color cyan))
+                            ((3) (font-color pink))
+                            (else (font-color orange)))
+                          128)
+        (format (clear *temp-string*) "CAUGHT: ~D" *ios-fish-menu-preview-count*)
+        (ios-fishing-text *temp-string* IOS_FISH_MENU_PREVIEW_X (+ IOS_FISH_MENU_PREVIEW_Y 58.0) 0.55 (font-color default) 128))
+  0)
