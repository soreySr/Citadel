+    (restore-collide-with-as (-> self root))
+    (format 0 "[CATCHABLE MUSE] Entered hide-n-seek-catchable~%"))
+  :code
+  (behavior ()
+    (loop
+      ;; Idle wagging animation
+      (ja-no-eval :group! muse-idle-ja :num! (seek!) :frame-num 0.0)
