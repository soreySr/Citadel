+    (stop! (ios-tfl-charge-loop-sound))
+    (false! (-> *ios-tfl-super* super-yellow-charge-loop))
+    (target-super-yellow-part-reset)
+    (sound-stop fire-id)
+    (if (not (time-elapsed? (-> *ios-tfl-super* super-yellow-charge-time) SUPER_YELLOW_MAX_CHARGE_TIME))
