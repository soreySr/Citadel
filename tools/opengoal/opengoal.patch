index 000000000..878cd21a9
--- /dev/null
+++ b/tools/ios/aot_ios_backend_contract.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""Derive the iOS AOT backend contract from a Jak 1 startup patch plan.
+
+The desktop ARM64 loader patches a contiguous executable GOAL mapping at load
+time. iOS cannot make an imported payload executable or rewrite Mach-O text,
+so its loader must prelink signed text at build time and provide separate x27
+(code) and x22 (writable state) views. This tool turns the existing plan into a
+machine-readable gate for that work.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from collections import Counter
+from pathlib import Path
+
+
+TEXT_RELOCATIONS = {"arm64_symbol_mov32"}
+STATE_RELOCATIONS = {"symbol_offset", "type_pointer"}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("startup_patch_plan", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+
+    plan = json.loads(args.startup_patch_plan.read_text())
+    patches = plan.get("patches")
+    if plan.get("format") != "OpenGOAL Jak 1 iOS AOT startup patch plan v1" or not isinstance(patches, list):
+        raise RuntimeError("expected an OpenGOAL Jak 1 iOS AOT startup patch plan v1")
+
+    kinds = Counter()
+    unresolved = []
+    for patch in patches:
+        kind = patch.get("kind")
+        if not isinstance(kind, str):
+            raise RuntimeError("startup patch has no relocation kind")
+        kinds[kind] += 1
+        if kind == "type_pointer":
+            resolved = patch.get("type_address") is not None
+        else:
+            resolved = patch.get("symbol_address") is not None
+        if not resolved:
+            unresolved.append(patch)
+
+    unknown_kinds = sorted(set(kinds) - TEXT_RELOCATIONS - STATE_RELOCATIONS)
+    contract = {
+        "format": "OpenGOAL Jak 1 iOS signed backend contract v1",
+        "inputStartupPatchCount": len(patches),
+        "resolvedStartupPatchCount": len(patches) - len(unresolved),
+        "unresolvedStartupPatchCount": len(unresolved),
+        "relocationsByKind": dict(sorted(kinds.items())),
+        "signedTextRelocationCount": sum(kinds[kind] for kind in TEXT_RELOCATIONS),
+        "writableStateRelocationCount": sum(kinds[kind] for kind in STATE_RELOCATIONS),
+        "unknownRelocationKinds": unknown_kinds,
+        "requiredBackendCapabilities": [
+            "Apply every ARM64 symbol MOVZ/MOVK relocation in signed Mach-O text at build time.",
+            "Provide x27 as a signed code view covering every linked GOAL code offset.",
+            "Provide x22 as a 128 MB writable GOAL state arena for symbols, strings, types, and heaps.",
+            "Avoid any runtime text patching, executable mmap, or JIT entitlement.",
+        ],
+        "executionEligible": False,
+        "blockingReason": (
+            "The existing payload must be prelinked into signed code and paired with the native "
+            "x22/x27 GOAL runtime before it can execute."
+        ),
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(contract, indent=2, sort_keys=True) + "\n")
+    print(json.dumps(contract, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
