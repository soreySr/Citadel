+++ b/tools/ios/aot_object_audit.py
@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+"""Validate OpenGOAL v3 ARM64 objects before generating an iOS AOT image.
+
+This tool deliberately does not execute or link game code.  It reads the portable
+GOAL object format emitted by goalc and produces a JSON inventory of relocation
+kinds.  The inventory is the input contract for the future signed-code packer:
+every relocation must be resolved before the app is built, never on-device.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import struct
+import sys
+from collections import Counter
+from pathlib import Path
+
+
+MAGIC = b"GOAL"
+BASIC_OFFSET = 4  # The magic word is excluded from every linker offset.
+HEADER_SIZE = 68  # magic plus ObjectFileHeader
+SEGMENT_COUNT = 3
+LINK_NAMES = {
+    0: "end",
+    1: "symbol_offset",
+    2: "type_pointer",
+    3: "distance_other_segment_64",
+    4: "distance_other_segment_32",
+    5: "intra_segment_pointer",
+    6: "arm64_symbol_mov32",
+    7: "arm64_other_segment_mov32",
+}
+
+
+class ObjectFormatError(ValueError):
+    pass
+
+
+def u32(data: bytes, offset: int) -> int:
+    if offset + 4 > len(data):
+        raise ObjectFormatError("unexpected end of file")
+    return struct.unpack_from("<I", data, offset)[0]
+
+
+def parse_link_table(table: bytes, counts: Counter[str]) -> None:
+    offset = 0
+    while True:
+        if offset >= len(table):
+            raise ObjectFormatError("link table has no terminator")
+        kind = table[offset]
+        offset += 1
+        name = LINK_NAMES.get(kind)
+        if name is None:
+            raise ObjectFormatError(f"unknown relocation kind {kind}")
+        counts[name] += 1
+        if kind == 0:
+            if offset != len(table):
+                raise ObjectFormatError("bytes follow link-table terminator")
+            return
+        if kind in (1, 2, 6):
+            terminator = table.find(b"\0", offset)
+            if terminator < 0:
+                raise ObjectFormatError("unterminated relocation symbol")
+            offset = terminator + 1
+            if kind == 2:
+                offset += 1  # method count
+            count = u32(table, offset)
+            offset += 4 + count * 4
+        elif kind in (3, 4):
+            offset += 1 + 3 * 4
+        elif kind == 5:
+            offset += 2 * 4
+        elif kind == 7:
+            offset += 1 + 2 * 4
+        if offset > len(table):
+            raise ObjectFormatError("truncated relocation record")
+
+
+def audit_object(path: Path, counts: Counter[str]) -> dict[str, int]:
+    data = path.read_bytes()
+    if len(data) < HEADER_SIZE or data[:4] != MAGIC:
+        raise ObjectFormatError("not a GOAL v3 object")
+    major, minor, version, segment_count = struct.unpack_from("<HHII", data, 4)
+    if version != 3 or segment_count != SEGMENT_COUNT:
+        raise ObjectFormatError(f"unsupported object version {version}, segments {segment_count}")
+
+    pairs = struct.unpack_from("<12I", data, 16)
+    links = list(zip(pairs[0:6:2], pairs[1:6:2]))
+    code = list(zip(pairs[6:12:2], pairs[7:12:2]))
+    link_block_length = u32(data, 64)
+    # Unlike individual table offsets, this length includes the magic word.
+    link_block_end = link_block_length
+    if link_block_length < HEADER_SIZE - BASIC_OFFSET or link_block_end > len(data):
+        raise ObjectFormatError("invalid link-block length")
+
+    for link_offset, link_size in links:
+        end = link_offset + link_size
+        if link_offset < HEADER_SIZE - BASIC_OFFSET or end > link_block_length:
+            raise ObjectFormatError("link table lies outside link block")
+        parse_link_table(data[BASIC_OFFSET + link_offset:BASIC_OFFSET + end], counts)
+
+    code_size = sum(size for _, size in code)
+    if link_block_end + code_size != len(data):
+        raise ObjectFormatError("segment data does not fill object")
+    return {"bytes": len(data), "goal_major": major, "goal_minor": minor}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("object_directory", type=Path, help="OpenGOAL out/jak1/obj directory")
+    args = parser.parse_args()
+    paths = sorted(args.object_directory.rglob("*.o"))
+    if not paths:
+        parser.error("no .o files found")
+
+    counts: Counter[str] = Counter()
+    errors: list[dict[str, str]] = []
+    total_bytes = 0
+    for path in paths:
+        try:
+            result = audit_object(path, counts)
+            total_bytes += result["bytes"]
+        except ObjectFormatError as error:
+            errors.append({"path": str(path), "error": str(error)})
+
+    report = {
+        "format": "OpenGOAL v3",
+        "objects": len(paths),
+        "object_bytes": total_bytes,
+        "relocations": dict(sorted(counts.items())),
+        "errors": errors,
+        "format_valid": not errors,
+    }
+    print(json.dumps(report, indent=2, sort_keys=True))
+    return 0 if not errors else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
