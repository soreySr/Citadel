+(defun ios-coast-height ((x float) (z float))
+  "Height of the stand-in coastline at x z (game units), or -1e9 where it has none. It is drawn natively and has
+   no background collision, so the boat and swimming Jak test this grid instead."
+  (let ((fx (/ (- x IOS_COAST_X0) IOS_COAST_CELL))
+        (fz (/ (- z IOS_COAST_Z0) IOS_COAST_CELL)))
+    (if (and (>= fx 0.0) (>= fz 0.0) (< fx (the float IOS_COAST_NX)) (< fz (the float IOS_COAST_NZ)))
+      (let ((h (-> *ios-coast-heights* (+ (the int fx) (* (the int fz) IOS_COAST_NX)))))
+        (if (= h -128) -1000000000.0 (* 4096.0 (the float h))))
+      -1000000000.0)))
