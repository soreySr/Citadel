+                   (time-elapsed? (-> *ios-tfl-super* super-yellow-charge-time) SUPER_YELLOW_MAX_CHARGE_TIME))
+          (cpad-clear! 0 square)
+          (stop! (ios-tfl-charge-loop-sound))
