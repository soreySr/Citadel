+    (let ((ttracker-left (the touch-tracker
+                              (ppointer->process (process-spawn touch-tracker :init touch-tracker-init (-> self control trans) (meters 1) TIME_ALIVE :to self))))
+          (ttracker-right (the touch-tracker
+                               (ppointer->process (process-spawn touch-tracker :init touch-tracker-init (-> self control trans) (meters 1) TIME_ALIVE :to self)))))
