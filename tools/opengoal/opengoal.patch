+
+(defmethod set-pos-and-scale ((this hud-bike-red-boost) (widescreen? symbol) (pal? symbol))
+  (let ((base-x 378.0))
+    (+! base-x (* (- 512.0 base-x) (- 1.0 (-> *pc-settings* aspect-ratio-reciprocal))))
+    (set! (-> this particles 0 init-pos x) 413.0)
+    (when (not (-> *pc-settings* use-vis?))
+      (dotimes (i (-> this nb-of-particles))
+        (set! (-> this particles i init-pos x)
+              (+ base-x (* (-> *pc-settings* aspect-ratio-reciprocal) (- (-> this particles i init-pos x) base-x)))))))
+  (none))
+
+(defmethod draw-hud ((this hud-bike-red-boost))
+  ;; (call-parent-method this)
+  ((method-of-type hud draw-hud) this)
+  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug))
+    (let ((str-x (+ (-> this text-x) (* (-> this x-sgn) (-> this offset))))
+          (str-y (/ (* (+ (-> this text-y) (* (-> this y-sgn) (-> this offset)) (-> this y-offset))
+                       (the int (-> *video-parms* relative-y-scale)))
+                    2)))
+      (if (and (nonzero? (-> *target* racer)) (time-elapsed? (-> *target* racer super-red-boost-time) (seconds 2)))
+        (draw-string-xy-scaled (lookup-text! *common-text* (text-id pad-circle) #f)
+                               buf
+                               str-x
+                               str-y
+                               (font-color white)
+                               (font-flags shadow kerning large)
+                               0.85))))
+  0
+  (none))
+
+(defmethod hud-update ((this hud-bike-red-boost))
+  (let ((should-display? (and (on-racer?) (target-powerup? super-eco-red))))
+    (when (and (hidden? this) should-display?)
+      (false! (-> this kicked?))
+      (true! (-> this ready?))
+      (send-event this 'show))
+    (when (and (not (-> this kicked?)) (= *master-mode* 'progress))
+      (true! (-> this kicked?))
+      (false! (-> this ready?))
+      (send-event this 'hide-quick))
+    (when (and (not (-> this kicked?)) (not should-display?))
+      (true! (-> this kicked?))
+      (false! (-> this ready?))
+      (send-event this 'hide))
+    (if (!= (-> this next-state name) 'hud-leaving) (set-time! (-> this trigger-time))))
+  (none))
+
+(defun activate-hud-pc ((tree process-tree))
+  "make the pc hud"
+  (deactivate-hud-pc)
+  (set! (-> *hud-parts-pc* battle-enemy)
+        (process-spawn hud-battle-enemy :init hud-init-by-other 0 :from *pc-dead-pool* :to tree))
+  ;; TFL note: added bike-red-boost
+  (set! *ios-tfl-red-boost-hud*
+        (process-spawn hud-bike-red-boost :init hud-init-by-other 0 :from *pc-dead-pool* :to tree))
+  0)
+
diff --git a/goal_src/jak1/pc/ios/ios-forgotten.gc b/goal_src/jak1/pc/ios/ios-forgotten.gc
new file mode 100644
index 000000000..4d67d9255
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-forgotten.gc
@@ -0,0 +1,396 @@
+;;-*-Lisp-*-
+(in-package goal)
+
+;; name: ios-forgotten.gc
+;; name in dgo: ios-forgotten
+;; dgos: none (iOS startup object)
+
+;; The Forgotten Lands: the community mod by Kuitar5 (jakIOS/ModLevels/Forgotten, forgotten-lands-plan.md), five
+;; connected levels (crystal-ca, crescent-t, energy-bay, open-mines, valley) built on the device at import and reached
+;; through warp gate slot 7 (Crystal Cave). Their code is level code (levels/crystalc, crescent, energybay, mines,
+;; valley); the mod's shared code (levels/tfl_common) and its engine changes (ios-forgotten-engine.gc, generated) are
+;; startup objects after this one. This file is what those need first:
+;;   * *ios-tfl-super*: the fields the mod added to captured types (target, control-info, camera-bank).
+;;   * room for the mod's particles (ids up to 4183, the captured tables hold 3584 / 1024) and its art groups (Open
+;;     Mines has 60, the captured level art directories hold 50).
+;;   * the five progress pages (22-26) and their counts, open while slot 7 is (outside the stock 100%).
+;;   * the levels sit inside the stock world's coordinates (Crystal Cave above Sandover, Crescent Top over the
+;;     Sandover / Misty sea), so only the load boundaries of the world Jak is in run (check-boundary), the stock
+;;     levels whose texture pages they copy (village1, misty) are held back while they are in, and the sea, boat and
+;;     Brume code treat them like Brume Village (ios-brume-here?).
+;;   * the mod's boundary flags (ignore while on foot / on the zoomer / on the flut flut), actor birth distance
+;;     (500 m), and its audio: the music track of the TFL level Jak is in (or the boss's) and its voice-acted hints are
+;;     played by the host (OpenGOALRuntimeHost.mm SyncForgottenAudio) from bundled files, like Brume's.
+;; Not taken from the mod: its title screen and new-game flow, developer commentary, speedrun / autosplit, cheats,
+;; loading every sound bank at once, the zoomer red boost HUD, hint subtitles, texscroll-dist.
+;; Linked as a startup object (aot_level_code_link.py --startup-object ios-forgotten, after ios-brume).
+
+;; set by the host every frame (SyncForgottenLevelOption): the levels are built and the option is on. Opens warp gate
+;; slot 7 (villagep-obs.gc) and the five progress pages.
+(define-perm *ios-forgotten-warp* symbol #f)
+
+;; ---- the mod base's hooks --------------------------------------------------------------------------------------
+;; ios-forgotten-engine.gc's collectables / game-info overrides call the mod base's mod-custom-code.gc hooks, which
+;; the captured (upstream) engine doesn't have: calling them jumped to address 0 on every orb / fly / cell / eco
+;; pickup and every death, anywhere in the game (2026-10-28 crash collecting an orb in Brume Village). Empty in both
+;; mods, so empty here.
+(defun runs-on-orb-pickup ((parent process-tree))
+  (none))
+
+(defun runs-on-fly-pickup ()
+  (none))
+
+(defun runs-on-cell-pickup ((cell-event symbol))
+  (none))
+
+(defun runs-on-eco-pickup ((eco-type pickup-type) (parent process-tree))
+  (none))
+
+(defun runs-on-jak-death ((death-event symbol))
+  (none))
+
+;; mods/orb-placer.gc's (debug segment only, never on iOS)
+(defun orb-placer-list-maintenace ((arg0 symbol))
+  (none))
+
+;; ---- fields the mod added to captured types ------------------------------------------------------------------------
+
+(deftype ios-tfl-super (structure)
+  (;; control-info's (collide-target-h.gc in the mod)
+   (super-yellow-charge-time            time-frame)
+   (super-yellow-scatter-last-fire-time time-frame)
+   (super-yellow-scatter-count          int32)
+   (super-yellow-charge-loop            symbol)
+   (super-yellow-fp-last-fire-time      time-frame)
+   ;; target's (target-h.gc), made for the target process `owner` (init-target in the mod)
+   (owner                               handle)
+   (charge-loop-sound                   ambient-sound)
+   (charge-part                         sparticle-launch-control)
+   ;; camera-bank's default-track-speed / -accel (camera-h.gc; cam-string-code's stock constants)
+   (track-speed                         meters)
+   (track-accel                         meters)))
+
+(define *ios-tfl-super* (new 'static 'ios-tfl-super :track-speed (meters 0.6) :track-accel (meters 0.005)))
+
+(defbehavior ios-tfl-super-ensure target ()
+  "The super yellow charge sound and particles of this target (the mod makes them in init-target)."
+  (when (!= (handle->process (-> *ios-tfl-super* owner)) self)
+    (set! (-> *ios-tfl-super* owner) (process->handle self))
+    (set! (-> *ios-tfl-super* charge-loop-sound)
+          (new 'process 'ambient-sound (static-sound-spec "bfg-buzz" :fo-max 80) (-> self control trans)))
+    (set! (-> *ios-tfl-super* charge-part) (create-launch-control (-> *part-group-id-table* 959) self)))
+  0)
+
+(defbehavior ios-tfl-charge-loop-sound target ()
+  (ios-tfl-super-ensure)
+  (-> *ios-tfl-super* charge-loop-sound))
+
+(defbehavior ios-tfl-charge-part target ()
+  (ios-tfl-super-ensure)
+  (-> *ios-tfl-super* charge-part))
+
+;; the zoomer's super red eco boost HUD (hud-bike-red-boost, ios-forgotten-late.gc): the mod keeps it in
+;; *hud-parts-pc*, whose captured static only has room for the battle HUD
+(define *ios-tfl-red-boost-hud* (the-as (pointer process) #f))
+
+(define-perm *ios-tfl-prev-deactivate-hud-pc* (function int) deactivate-hud-pc)
+
+(defun deactivate-hud-pc ()
+  "kill the pc hud (and the red boost HUD)"
+  (*ios-tfl-prev-deactivate-hud-pc*)
+  (when *ios-tfl-red-boost-hud*
+    (deactivate (ppointer->process *ios-tfl-red-boost-hud*))
+    (set! *ios-tfl-red-boost-hud* (the-as (pointer process) #f)))
+  0)
+
+;; ---- particle tables and art group directories -------------------------------------------------------------------
+
+(defconstant IOS_TFL_PART_IDS 8192)  ;; the mod's sparticle-launcher.gc
+(defconstant IOS_TFL_PART_GROUPS 2048)
+
+(defun ios-tfl-grow-part-tables ()
+  (let ((old *part-id-table*))
+    (when (< (-> old allocated-length) IOS_TFL_PART_IDS)
+      (let ((new-table (new 'global 'boxed-array sparticle-launcher IOS_TFL_PART_IDS)))
+        (dotimes (i IOS_TFL_PART_IDS)
+          (set! (-> new-table i) (if (< i (-> old length)) (-> old i) (the-as sparticle-launcher 0))))
+        (set! *part-id-table* new-table))))
+  (let ((old *part-group-id-table*))
+    (when (< (-> old allocated-length) IOS_TFL_PART_GROUPS)
+      (let ((new-table (new 'global 'boxed-array sparticle-launch-group IOS_TFL_PART_GROUPS)))
+        (dotimes (i IOS_TFL_PART_GROUPS)
+          (set! (-> new-table i) (if (< i (-> old length)) (-> old i) (the-as sparticle-launch-group 0))))
+        (set! *part-group-id-table* new-table))))
+  0
+  (none))
+
+(ios-tfl-grow-part-tables)
+
+(defconstant IOS_TFL_ART_GROUPS 60)  ;; the mod's level.gc
+
+(defun ios-tfl-grown-art-dir ((old load-dir-art-group))
+  "A copy of a level's art group directory with room for IOS_TFL_ART_GROUPS. The captured directories are not empty:
+the default level's holds the resident art (Jak's eichar among it), so the entries are copied."
+  (if (>= (-> old string-array allocated-length) IOS_TFL_ART_GROUPS)
+    (return old))
+  (let ((dir (new 'global 'load-dir-art-group IOS_TFL_ART_GROUPS (-> old lev)))
+        (count (-> old string-array length)))
+    (dotimes (i count)
+      (set! (-> dir string-array i) (-> old string-array i))
+      (set! (-> dir art-group-array i) (-> old art-group-array i)))
+    (set! (-> dir string-array length) count)
+    (set! (-> dir data-array length) (-> old data-array length))
+    dir))
+
+(defun ios-tfl-grow-art-dirs ()
+  (let ((lev-group *level*))
+    (set! (-> lev-group level0 art-group) (ios-tfl-grown-art-dir (-> lev-group level0 art-group)))
+    (set! (-> lev-group level1 art-group) (ios-tfl-grown-art-dir (-> lev-group level1 art-group)))
+    (set! (-> lev-group level-default art-group) (ios-tfl-grown-art-dir (-> lev-group level-default art-group))))
+  0
+  (none))
+
+(ios-tfl-grow-art-dirs)
+
+;; ---- which world Jak is in --------------------------------------------------------------------------------------------
+
+(defun ios-forgotten-level? ((name symbol))
+  (case name
+    (('crystal-ca 'crescent-t 'energy-bay 'open-mines 'valley) #t)
+    (else #f)))
+
+(defun ios-forgotten-here? ()
+  "A Forgotten Lands level is loaded (or loading)."
+  (the-as symbol (or (level-get *level* 'crystal-ca) (level-get *level* 'crescent-t) (level-get *level* 'energy-bay)
+                     (level-get *level* 'open-mines) (level-get *level* 'valley))))
+
+;; ios-brume.gc's: the sea's code (fishermans-boat.gc, ios-open-ocean.gc), the big collide cache and the village1 /
+;; snow hold-back treat The Forgotten Lands like Brume Village. Its music update leaves TFL levels at 0.
+(defun ios-brume-here? ()
+  "A Brume Village or Forgotten Lands level is loaded (or loading)."
+  (the-as symbol (or (level-get *level* 'brume) (level-get *level* 'abandon) (level-get *level* 'mount)
+                     (level-get *level* 'preundg) (ios-forgotten-here?))))
+
+;; ---- game counts and progress pages ---------------------------------------------------------------------------------
+
+(defconstant IOS_TFL_FIRST_PAGE 22)  ;; *level-task-data* / *game-counts* index of crystal-ca (progress-static.gc)
+(defconstant IOS_TFL_PAGE_COUNT 5)
+
+;; as ios-brume-grow-game-counts: room for the pages, the mod's level-info custom-orb-count / custom-buzzer-count
+(defun ios-tfl-grow-game-counts ()
+  (let ((old *game-counts*)
+        (count (+ IOS_TFL_FIRST_PAGE IOS_TFL_PAGE_COUNT)))
+    (when (and old (< (-> old length) count))
+      (let* ((mem (malloc 'global (+ 16 (* count (size-of count-info)))))
+             (new-counts (the-as game-count-info (&+ mem 4))))
+        (set! (-> (the-as (pointer type) mem) 0) game-count-info)
+        (set! (-> new-counts length) count)
+        (dotimes (i count)
+          (cond
+            ((< i (-> old length))
+             (set! (-> new-counts data i money-count) (-> old data i money-count))
+             (set! (-> new-counts data i buzzer-count) (-> old data i buzzer-count)))
+            (else
+             (set! (-> new-counts data i money-count) 0)
+             (set! (-> new-counts data i buzzer-count) 7))))
+        (set! (-> new-counts data (+ IOS_TFL_FIRST_PAGE 0) money-count) 150)
+        (set! (-> new-counts data (+ IOS_TFL_FIRST_PAGE 1) money-count) 200)
+        (set! (-> new-counts data (+ IOS_TFL_FIRST_PAGE 2) money-count) 200)
+        (set! (-> new-counts data (+ IOS_TFL_FIRST_PAGE 3) money-count) 150)
+        (set! (-> new-counts data (+ IOS_TFL_FIRST_PAGE 4) money-count) 50)
+        (set! *game-counts* new-counts))))
+  0
+  (none))
+
+(ios-tfl-grow-game-counts)
+
+(define-perm *ios-tfl-prev-make-levels* (function none) make-levels-with-tasks-available-to-progress)
+
+(defun make-levels-with-tasks-available-to-progress ()
+  (*ios-tfl-prev-make-levels*)
+  (when (>= (length *level-task-data*) (+ IOS_TFL_FIRST_PAGE IOS_TFL_PAGE_COUNT))
+    (dotimes (i IOS_TFL_PAGE_COUNT)
+      (set! (-> *game-info* level-opened (+ IOS_TFL_FIRST_PAGE i))
+            (the-as uint (if (and *ios-forgotten-warp* (= *kernel-boot-message* 'play)) 1 0)))))
+  0
+  (none))
+
+;; ---- load boundaries ---------------------------------------------------------------------------------------------
+
+;; marks the boundaries of The Forgotten Lands (load-boundary-data.gc appends them): a spare flags bit
+(defconstant IOS_TFL_BOUNDARY_FLAG #x80)
+
+(defun ios-tfl-command? ((cmd load-boundary-crossing-command))
+  "This crossing command loads, shows or checkpoints a Forgotten Lands level."
+  (case (-> cmd cmd)
+    (((load-boundary-cmd checkpt))
+     (let ((cont (get-continue-by-name *game-info* (the-as string (-> cmd lev0)))))
+       (and cont (ios-forgotten-level? (-> cont level)))))
+    (((load-boundary-cmd load) (load-boundary-cmd display) (load-boundary-cmd force-vis))
+     (or (ios-forgotten-level? (the-as symbol (-> cmd lev0))) (ios-forgotten-level? (the-as symbol (-> cmd lev1)))))
+    (((load-boundary-cmd vis))
+     (case (the-as symbol (-> cmd lev0))
+       (('crc 'cst 'enb 'opm 'val) #t)
+       (else #f)))
+    (else #f)))
+
+(defun ios-tfl-tag-boundaries ()
+  (let ((b *load-boundary-list*))
+    (while b
+      (if (or (ios-tfl-command? (-> b cmd-fwd)) (ios-tfl-command? (-> b cmd-bwd)))
+        (set! (-> b flags) (the-as load-boundary-flags (logior (the-as int (-> b flags)) IOS_TFL_BOUNDARY_FLAG))))
+      (set! b (-> b next))))
+  0
+  (none))
+
+(ios-tfl-tag-boundaries)
+
+;; on-foot? / on-flut? / on-racer? are the mod's (load-boundary.gc, in ios-forgotten-engine.gc)
+(define-extern on-foot? (function symbol))
+(define-extern on-flut? (function symbol))
+(define-extern on-racer? (function symbol))
+
+;; load-boundary.gc's check-boundary, with the mod's ignore flags, and only the boundaries of the world Jak is in.
+(defun check-boundary ((arg0 load-boundary))
+  (local-vars (s5-0 object))
+  (when (!= (logtest? (the-as int (-> arg0 flags)) IOS_TFL_BOUNDARY_FLAG) (if (ios-forgotten-here?) #t #f))
+    (return (the-as none 0)))
+  (let ((a1-0 (if (logtest? (-> arg0 flags) (load-boundary-flags player)) (-> *load-boundary-target* 1) (-> *load-boundary-target* 0)))
+        (a2-0 (if (logtest? (-> arg0 flags) (load-boundary-flags player)) (-> *load-boundary-target* 3) (-> *load-boundary-target* 2))))
+    0
+    (let ((f0-1 (- (-> a1-0 x) (-> arg0 rejector x)))
+          (f1-2 (- (-> a1-0 z) (-> arg0 rejector z))))
+      (cond
+        ((< (+ (square f0-1) (square f1-2)) (* (-> arg0 rejector w) (-> arg0 rejector w)))
+         (if (logtest? (-> arg0 flags) (load-boundary-flags closed))
+           (set! s5-0 (check-closed-boundary arg0 a1-0 a2-0))
+           (set! s5-0 (check-open-boundary arg0 a1-0 a2-0))))
+        (else (set! s5-0 0) (return (the-as none 0))))))
+  (when *target*
+    (if (or (and (logtest? (-> arg0 flags) (load-boundary-flags ignore-normal)) (on-foot?))
+            (and (logtest? (-> arg0 flags) (load-boundary-flags ignore-racing)) (on-racer?))
+            (and (logtest? (-> arg0 flags) (load-boundary-flags ignore-flut)) (on-flut?)))
+      (return (the-as none 0))))
+  (let ((s4-0 (the-as load-boundary-crossing-command #f)))
+    (if (= (the-as symbol s5-0) 1) (set! s4-0 (-> arg0 cmd-fwd)))
+    (if (= (the-as symbol s5-0) 2) (set! s4-0 (-> arg0 cmd-bwd)))
+    (when s4-0
+      (cond
+        ((= (-> s4-0 cmd) (load-boundary-cmd vis)) (load-state-want-vis (the-as symbol (-> s4-0 lev0))))
+        ((= (-> s4-0 cmd) (load-boundary-cmd load))
+         (load-state-want-levels (the-as symbol (-> s4-0 lev0)) (the-as symbol (-> s4-0 lev1))))
+        ((= (-> s4-0 cmd) (load-boundary-cmd display))
+         (load-state-want-display-level (the-as symbol (-> s4-0 lev0)) (the-as symbol (-> s4-0 lev1))))
+        ((= (-> s4-0 cmd) (load-boundary-cmd force-vis))
+         (load-state-want-force-vis (the-as symbol (-> s4-0 lev0)) (the-as symbol (-> s4-0 lev1))))
+        ((= (-> s4-0 cmd) (load-boundary-cmd checkpt))
+         (format 0 "Setting continue to ~A~%" (-> s4-0 lev0))
+         (set-continue! *game-info* (the-as string (-> s4-0 lev0)))))))
+  (none))
+
+;; ---- levels held back --------------------------------------------------------------------------------------------
+
+;; As ios-brume-guard-levels (which already holds back village1 / snow while these are in, ios-brume-here? above):
+;; misty, whose texture pages Open Mines copies, never starts loading while a Forgotten Lands level is in.
+(define *ios-tfl-held-slot* -1)
+(define *ios-tfl-held* (new 'global 'level-buffer-state))
+
+(defun ios-tfl-guard-levels ()
+  (cond
+    ((ios-forgotten-here?)
+     (dotimes (i 2)
+       (let ((want (-> *load-state* want i)))
+         (when (and (= (-> want name) 'misty) (not (level-get *level* 'misty)))
+           (format 0 "ios-forgotten: misty held back while a Forgotten Lands level is loaded~%")
+           (mem-copy! (the-as pointer *ios-tfl-held*) (the-as pointer want) (size-of level-buffer-state))
+           (set! *ios-tfl-held-slot* i)
+           (set! (-> want name) #f)
+           (set! (-> want display?) #f)
+           (set! (-> want force-vis?) #f)
+           (set! (-> want force-inside?) #f)))))
+    ((>= *ios-tfl-held-slot* 0)
+     (let ((want (-> *load-state* want *ios-tfl-held-slot*))
+           (held (-> *ios-tfl-held* name)))
+       (when (and (not (-> want name)) (!= (-> *load-state* want (- 1 *ios-tfl-held-slot*) name) held))
+         (format 0 "ios-forgotten: The Forgotten Lands gone, ~A loads~%" held)
+         (mem-copy! (the-as pointer want) (the-as pointer *ios-tfl-held*) (size-of level-buffer-state))))
+     (set! *ios-tfl-held-slot* -1)))
+  0
+  (none))
+
+;; ---- audio (played by the host) --------------------------------------------------------------------------------------
+
+;; read by the host every frame (SyncForgottenAudio): the track that plays (0 none, 1 crystal-ca, 2 crescent-t,
+;; 3 energy-bay, 4 open-mines, 5 valley, 6 the PDS sentinel boss), its gain in thousandths (0 while paused), and the
+;; last hint asked for: its file name and a counter that goes up on every request. The host writes the counter's
+;; value to *ios-tfl-hint-done* when that hint has finished playing (at once if the file is not bundled).
+(define-perm *ios-tfl-music* int 0)
+(define-perm *ios-tfl-music-gain* int 0)
+(define-perm *ios-tfl-hint-seq* int 0)
+(define-perm *ios-tfl-hint-done* int 0)
+(define *ios-tfl-hint-name* (new 'global 'string 128 (the-as string #f)))
+(define *ios-tfl-boss-music* #f)
+
+;; the mod's runtime functions (kernel-defs.gc in the mod: mp3 / wav playback in its C++ runtime)
+(defun play-tfl-hint ((name string) (volume float) (interrupt? symbol))
+  (copy-string<-string *ios-tfl-hint-name* name)
+  (+! *ios-tfl-hint-seq* 1)
+  #t)
+
+(defun play-tfl-music ((name string) (volume float))
+  #t)
+
+(defun stop-tfl-commentary ()
+  #t)
+
+(define-extern *tfl-hint-playing?* symbol)  ;; tfl-hint.gc
+
+(defun ios-tfl-audio-update ()
+  (let ((lev (if *target* (level-get-target-inside *level*))))
+    (set! *ios-tfl-music*
+          (cond
+            ((or (not lev) (!= *master-mode* 'game) (movie?)) 0)
+            ((and *ios-tfl-boss-music* (= (-> lev name) 'valley)) 6)
+            (else
+             (case (-> lev name)
+               (('crystal-ca) 1)
+               (('crescent-t) 2)
+               (('energy-bay) 3)
+               (('open-mines) 4)
+               (('valley) 5)
+               (else 0))))))
+  (set! *ios-tfl-music-gain* (if (paused?) 0 (the int (* 10.0 (-> *setting-control* current music-volume)))))
+  ;; the hint's clip ended: tfl-hint-play stops waiting
+  (if (and *tfl-hint-playing?* (= *ios-tfl-hint-done* *ios-tfl-hint-seq*)) (set! *tfl-hint-playing?* #f))
+  0
+  (none))
+
+;; ---- per frame ------------------------------------------------------------------------------------------------------
+
+;; the stock birth distance (entity-h.gc), and the mod's while its levels are in
+(defconstant IOS_TFL_BIRTH_DIST (meters 500))
+
+(define *ios-tfl-stock-birth-dist* (-> *ACTOR-bank* birth-dist))
+
+(defun ios-forgotten-update ()
+  (cond
+    ((ios-forgotten-here?)
+     (when (< (-> *ACTOR-bank* birth-dist) IOS_TFL_BIRTH_DIST)
+       (set! *ios-tfl-stock-birth-dist* (-> *ACTOR-bank* birth-dist))
+       (set! (-> *ACTOR-bank* birth-dist) IOS_TFL_BIRTH_DIST)))
+    ((= (-> *ACTOR-bank* birth-dist) IOS_TFL_BIRTH_DIST) (set! (-> *ACTOR-bank* birth-dist) *ios-tfl-stock-birth-dist*)))
+  (if (not (ios-forgotten-here?)) (set! *ios-tfl-boss-music* #f))
+  (ios-tfl-audio-update)
+  0
+  (none))
+
+;; Chain into *menu-hook* (after ios-brume's).
+(define *ios-forgotten-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-forgotten-menu-hook ()
+  (ios-forgotten-update)
+  (*ios-forgotten-prev-menu-hook*)
+  (ios-tfl-guard-levels)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-forgotten-menu-hook))
diff --git a/goal_src/jak1/pc/ios/ios-glacier.gc b/goal_src/jak1/pc/ios/ios-glacier.gc
new file mode 100644
index 000000000..dc080488f
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-glacier.gc
@@ -0,0 +1,144 @@
+;;-*-Lisp-*-
+(in-package goal)
+
+;; name: ios-glacier.gc
+;; name in dgo: ios-glacier
+;; dgos: none (iOS startup object)
+
+;; Glacier: the community mod level "Glacier" by Cuttlefishthesage (jakIOS/ModLevels/Glacier, glacier-plan.md),
+;; built on the device at import and reached through warp gate slot 5. Its own code (levels/glacier/glacier.gc) is
+;; level code in GLA.DGO; this file is the engine side the mod changed in its engine sources, done at boot because
+;; game-info, progress and the target are captured engine objects:
+;;   * the seven glacier tasks (game-task 116-122) need task-perm-list / fuel-cell-time entries; the captured image
+;;     allocated both with 116, so they are reallocated with (game-task max) entries. Saves keep task perms by
+;;     length (game-save.gc), so glacier progress is saved; loading a save written before shrinks the length again,
+;;     which the per-frame update repairs.
+;;   * *game-counts* (from the disc's game-cnt, 16 entries) gets room for the glacier page (17): 101 orbs, 7 flies.
+;;   * snow falls in the glacier (the mod's powerups.gc change).
+;;   * it is reached by boat too (fishermans-boat.gc: the Misty + Glacier pair north of Misty). The level copies
+;;     Sandover's texture pages; Sandover logging in while the glacier is loaded crashed (adgif_shader_texture_with_
+;;     update, 2026-10-27), so ios-glacier-guard-levels never lets Sandover start loading while it is in.
+;; Linked as a startup object (aot_level_code_link.py --startup-object ios-glacier, after ios-open-ocean).
+
+;; set by the host every frame (OpenGOALRuntimeHost.mm SyncGlacierLevel): the level is built and its option on.
+;; Opens warp gate slot 5 (villagep-obs.gc) and the glacier progress page (ios-open-ocean.gc).
+(define-perm *ios-glacier-warp* symbol #f)
+
+(defconstant IOS_GLACIER_PAGE 17)  ;; *level-task-data* / *game-counts* index (progress-static.gc)
+(defconstant IOS_GLACIER_ORBS 101)
+(defconstant IOS_GLACIER_FLIES 7)
+
+;; task perms: one per game-task
+(defun ios-glacier-grow-task-perms ()
+  (let* ((info *game-info*)
+         (old (-> info task-perm-list))
+         (count (the int (game-task max))))
+    (when (< (-> old allocated-length) count)
+      (let ((new-list (new 'global 'entity-perm-array count)))
+        (dotimes (i count)
+          (if (< i (-> old length))
+            (mem-copy! (the-as pointer (-> new-list data i)) (the-as pointer (-> old data i)) (size-of entity-perm))
+            (set! (-> new-list data i task) (the-as game-task i))))
+        (set! (-> new-list length) count)
+        (set! (-> info task-perm-list) new-list)))
+    (let ((old-times (-> info fuel-cell-time)))
+      (when (< (-> old-times allocated-length) count)
+        (let ((new-times (new 'global 'boxed-array time-frame count)))
+          (dotimes (i count)
+            (set! (-> new-times i) (if (< i (-> old-times length)) (-> old-times i) 0)))
+          (set! (-> info fuel-cell-time) new-times)))))
+  0
+  (none))
+
+;; A save from before the glacier (116 task perms) loads with length 116: put the glacier tasks back, unstarted.
+(defun ios-glacier-repair-task-perms ()
+  (let ((perms (-> *game-info* task-perm-list))
+        (count (the int (game-task max))))
+    (when (and (< (-> perms length) count) (>= (-> perms allocated-length) count))
+      (countdown (i count)
+        (when (>= i (-> perms length))
+          (mem-set32! (the-as pointer (-> perms data i)) (/ (size-of entity-perm) 4) 0)
+          (set! (-> perms data i task) (the-as game-task i))))
+      (set! (-> perms length) count)))
+  0
+  (none))
+
+;; *game-counts* with the glacier's entry. A basic laid out as the kernel's alloc_heap_object does: type tag, then
+;; the object 4 bytes in.
+(defun ios-glacier-grow-game-counts ()
+  (let ((old *game-counts*))
+    (when (and old (< (-> old length) (+ IOS_GLACIER_PAGE 1)))
+      (let* ((count (+ IOS_GLACIER_PAGE 1))
+             (mem (malloc 'global (+ 16 (* count (size-of count-info)))))
+             (new-counts (the-as game-count-info (&+ mem 4))))
+        (set! (-> (the-as (pointer type) mem) 0) game-count-info)
+        (set! (-> new-counts length) count)
+        (dotimes (i count)
+          (cond
+            ((< i (-> old length))
+             (set! (-> new-counts data i money-count) (-> old data i money-count))
+             (set! (-> new-counts data i buzzer-count) (-> old data i buzzer-count)))
+            (else
+             (set! (-> new-counts data i money-count) 0)
+             (set! (-> new-counts data i buzzer-count) 0))))
+        ;; entry 16 (the Open Ocean page) as progress.gc's relocate sets it
+        (set! (-> new-counts data 16 money-count) 150)
+        (set! (-> new-counts data 16 buzzer-count) 7)
+        (set! (-> new-counts data IOS_GLACIER_PAGE money-count) IOS_GLACIER_ORBS)
+        (set! (-> new-counts data IOS_GLACIER_PAGE buzzer-count) IOS_GLACIER_FLIES)
+        (set! *game-counts* new-counts))))
+  0
+  (none))
+
+(ios-glacier-grow-task-perms)
+(ios-glacier-grow-game-counts)
+
+;; Run after every other menu hook (the ocean manager, load boundaries and the boat park have set *load-state* by
+;; then) and before level-update: while the glacier is loaded, a wanted village1 that is not loaded yet is held back
+;; (its slot emptied, so the glacier unloads first), then put back once the glacier is gone. A one-shot request (a
+;; continue point) is kept that way; the ocean manager simply asks again. A village1 already loaded is left alone (a
+;; warp from Sandover loads the glacier next to it, which works).
+(define *ios-glacier-held-slot* -1)
+(define *ios-glacier-held* (new 'global 'level-buffer-state))
+
+(defun ios-glacier-guard-levels ()
+  (cond
+    ((and (level-get *level* 'glacier) (not (level-get *level* 'village1)))
+     (dotimes (i 2)
+       (let ((want (-> *load-state* want i)))
+         (when (= (-> want name) 'village1)
+           (format 0 "ios-glacier: village1 held back while the glacier is loaded~%")
+           (mem-copy! (the-as pointer *ios-glacier-held*) (the-as pointer want) (size-of level-buffer-state))
+           (set! *ios-glacier-held-slot* i)
+           (set! (-> want name) #f)
+           (set! (-> want display?) #f)
+           (set! (-> want force-vis?) #f)
+           (set! (-> want force-inside?) #f)))))
+    ((>= *ios-glacier-held-slot* 0)
+     (let ((want (-> *load-state* want *ios-glacier-held-slot*)))
+       ;; still empty (nobody asked for something else meanwhile): village1 as it was asked for
+       (when (and (not (-> want name)) (!= (-> *load-state* want (- 1 *ios-glacier-held-slot*) name) 'village1))
+         (format 0 "ios-glacier: glacier gone, village1 loads~%")
+         (mem-copy! (the-as pointer want) (the-as pointer *ios-glacier-held*) (size-of level-buffer-state))))
+     (set! *ios-glacier-held-slot* -1)))
+  0
+  (none))
+
+(defun ios-glacier-update ()
+  (ios-glacier-repair-task-perms)
+  ;; snow in the glacier (target powerups do this for 'snow)
+  (when (and *target* (not (paused?)) (-> *target* current-level) (= (-> *target* current-level name) 'glacier))
+    (update-snow *target*))
+  0
+  (none))
+
+;; Chain into *menu-hook* (after ios-open-ocean's).
+(define *ios-glacier-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-glacier-menu-hook ()
+  (ios-glacier-update)
+  (*ios-glacier-prev-menu-hook*)
+  (ios-glacier-guard-levels)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-glacier-menu-hook))
diff --git a/goal_src/jak1/pc/ios/ios-green-eco.gc b/goal_src/jak1/pc/ios/ios-green-eco.gc
new file mode 100644
index 000000000..e9033577f
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-green-eco.gc
@@ -0,0 +1,251 @@
+;;-*-Lisp-*-
+(in-package goal)
+(require "engine/game/game-info.gc")
+(require "engine/target/logic-target.gc")
+(require "engine/common-obs/collectables.gc")
+
+;; og:ios Expanded Green Eco (experimental, user 2026-10-12).
+;;
+;; - Green eco vents and big green eco clusters (the `health` collectable) charge Jak with green eco like the other
+;;   eco colours: a vent fills the meter, a cluster fills it partially (the stock eco timeouts). Stock only does this
+;;   for a green vent while racing on the zoomer; the glow, particles and loop sound are the stock
+;;   target-powerup-process ones for a green charge, so they now show on foot too. The stock health gain still
+;;   happens on pickup.
+;; - While charged: +1 health every IOS_GREEN_ECO_REGEN_TIME until full; at full health Jak takes no damage (the
+;;   stock but unused invuln-powerup state flag, honoured by target-attacked). The flag is dropped as soon as the
+;;   charge runs out (stock target-powerup-process also clears it then) or health is below full.
+;; - Extra green eco vents (user 2026-10-12), only while the option is on: see *ios-green-vent-spots* below.
+;;
+;; game-info and logic-target are captured engine objects on iOS, so this file is linked as a startup object
+;; (aot_level_code_link.py --startup-object ios-green-eco, after ios-boat-summon). Its top-level runs once at boot:
+;; it replaces fact-info-target's pickup-collectable! (wrapping the stock method) and chains the per-frame update
+;; into *menu-hook*.
+
+;; set by the host every frame (OpenGOALRuntimeHost.mm SyncExpandedGreenEcoOption)
+(define-perm *ios-expanded-green-eco* symbol #f)
+
+(defconstant IOS_GREEN_ECO_REGEN_TIME (seconds 5))
+
+;; the captured stock method (define-perm: never wrap the wrapper)
+(define-perm *ios-green-eco-stock-pickup* (function fact-info-target pickup-type float handle float)
+  (the-as (function fact-info-target pickup-type float handle float)
+          (method-of-type fact-info-target pickup-collectable!)))
+
+(defun ios-green-eco-source? ((source-handle handle))
+  "A green eco vent or a big green eco cluster."
+  (let ((proc (handle->process source-handle)))
+    (and proc (or (type-type? (-> proc type) vent) (type-type? (-> proc type) health)))))
+
+(defun ios-green-eco-charge! ((this fact-info-target) (amount float))
+  "Stock eco powerup path of pickup-collectable! (game-info.gc, label cfg-80) for green eco. The stock green
+   branch already ran and played the pickup sound, so the duplicate sound/vibration is skipped like it is on the
+   zoomer."
+  (when (!= (-> this eco-type) (pickup-type eco-green))
+    (set! (-> this eco-level) 0.0)
+    (set! (-> this eco-timeout) 0))
+  (set! (-> this eco-type) (pickup-type eco-green))
+  (let ((eco-lev (-> this eco-level)))
+    (set! (-> this eco-level) 1.0)
+    (when (= eco-lev 0.0)
+      (set! (-> this eco-pickup-time) (-> *display* game-frame-counter))
+      (send-event (-> this process) 'reset-collide))
+    (set! (-> this eco-timeout)
+          (the-as seconds
+                  (min (the-as int (+ (-> this eco-timeout) (* (the-as int (-> *FACT-bank* eco-single-timeout)) (the int amount))))
+                       (the-as int (+ (-> *FACT-bank* eco-full-timeout) (- (-> *display* game-frame-counter) (-> this eco-pickup-time)))))))
+    (if (>= (the-as int (- (-> this eco-timeout) (the-as uint (- (-> *display* game-frame-counter) (-> this eco-pickup-time)))))
+            (the-as int (-> *FACT-bank* eco-full-timeout)))
+      (set! (-> this eco-level) 2.0)))
+  (-> this eco-level))
+
+(defmethod pickup-collectable! ((this fact-info-target) (kind pickup-type) (amount float) (source-handle handle))
+  (let ((result (*ios-green-eco-stock-pickup* this kind amount source-handle)))
+    (if (and (= *ios-expanded-green-eco* #t)
+             (= kind (pickup-type eco-green))
+             (< 0.0 amount)
+             (ios-green-eco-source? source-handle)
+             ;; stock already charged it (green vent on the zoomer)
+             (not (and (logtest? (-> (the-as collide-shape (-> this process root)) root-prim prim-core action) (collide-action racer))
+                       (type-type? (-> (handle->process source-handle) type) vent))))
+      (ios-green-eco-charge! this amount)
+      result)))
+
+;; ---- per-frame: health regen + invulnerability while charged ----------------------------------------------------
+
+(define *ios-green-eco-regen-time* (the-as time-frame 0))
+(define *ios-green-eco-was-charged* #f)
+(define *ios-green-eco-invuln* #f) ;; we set invuln-powerup (only clear it if we did)
+
+(defun ios-green-eco-update ()
+  (let* ((tgt *target*)
+         (now (-> *display* game-frame-counter))
+         (charged (and (= *ios-expanded-green-eco* #t)
+                       tgt
+                       (= (-> tgt game mode) 'play)
+                       (not (logtest? (-> tgt state-flags) (state-flags dying)))
+                       (= (-> tgt fact eco-type) (pickup-type eco-green))
+                       (< 0.0 (-> tgt fact eco-level)))))
+    (cond
+      (charged
+       ;; the 5 s count starts when the charge does
+       (if (not *ios-green-eco-was-charged*) (set! *ios-green-eco-regen-time* now))
+       (cond
+         ((< (-> tgt fact health) (-> tgt fact health-max))
+          (when (>= (- now *ios-green-eco-regen-time*) IOS_GREEN_ECO_REGEN_TIME)
+            (set! *ios-green-eco-regen-time* now)
+            ;; stock big green eco pickup: health + 1, health HUD pops up
+            (pickup-collectable! (-> tgt fact) (pickup-type eco-green) (-> *FACT-bank* health-single-inc) (the-as handle #f))))
+         (else (set! *ios-green-eco-regen-time* now)))
+       (cond
+         ((>= (-> tgt fact health) (-> tgt fact health-max))
+          (logior! (-> tgt state-flags) (state-flags invuln-powerup))
+          (set! *ios-green-eco-invuln* #t))
+         (*ios-green-eco-invuln*
+          (logclear! (-> tgt state-flags) (state-flags invuln-powerup))
+          (set! *ios-green-eco-invuln* #f))))
+      (else
+       (when *ios-green-eco-invuln*
+         (if tgt (logclear! (-> tgt state-flags) (state-flags invuln-powerup)))
+         (set! *ios-green-eco-invuln* #f))))
+    (set! *ios-green-eco-was-charged* (if charged #t #f)))
+  0)
+
+;; ---- extra green eco vents ---------------------------------------------------------------------------------------
+;;
+;; Only while the option is on. Each is an ios-green-vent (a stock `vent`: eco stream particles, ambient sound,
+;; touch pickup, so pickup-collectable! above sees a vent source) spawned in *entity-pool* while its level is active
+;; and Jak is in range, re-ensured every frame (a death's reset-actors clears the pool). The vent has no model of
+;; its own: the stone ring is a background prop, so the renderer draws the citadel's vent ring (cit-ecovent.mb,
+;; Jak1Level-ios-vents.fr3z) at every vent listed in *ios-green-vent-props*.
+
+(defconstant IOS_GREEN_VENT_COUNT 3)
+(defconstant IOS_GREEN_VENT_RANGE (meters 120))
+
+;; Where each vent stands (on the ground, game units) and the level whose collision it stands on.
+;;  0: outside Gol and Maia's citadel, on the lava tube's bridge in front of the steps up to the door, 6 m south and
+;;     4 m east of the "citadel-entrance" continue point (Jak's spawn), 6 m from the bridge's east edge, nothing
+;;     taller within 9 m (bridge y -39.5 m, flat; spot picked from the lavatube collision mesh).
+;;  1: Rock Village, on the grass knoll just outside the blue sage's hut door (north-west of the hut), the flattest
+;;     spot there (ground within 0.36 m of the centre out to 3 m) (user 2026-10-26).
+;;  2: Volcanic Crater, on the rock ledge beside the hut-side end of the first rope bridge (ropebridge-59) on the way
+;;     from the village3-start continue point up to the red sage's hut (ground within 0.16 m out to 3 m)
+;;     (user 2026-10-26).
+;; Spots 1 and 2 were picked offline from the levels' collision meshes (village2.fr3 / village3.fr3 height maps).
+(define *ios-green-vent-spots*
+  (new 'static 'inline-array vector IOS_GREEN_VENT_COUNT
+       (new 'static 'vector :x 11460362.0 :y -161792.0 :z -18448220.0 :w 1.0)
+       (new 'static 'vector :x (meters 356.0) :y (meters 23.45) :z (meters -1521.0) :w 1.0)
+       (new 'static 'vector :x (meters 1110.0) :y (meters 49.79) :z (meters -3472.0) :w 1.0)))
+
+(defun ios-green-vent-level ((i int))
+  (case i
+    ((0) 'lavatube)
+    ((1) 'village2)
+    ((2) 'village3)
+    (else #f)))
+
+;; read by the host every frame (OpenGOALRuntimeHost.mm SyncExpandedGreenEcoOption): x y z w per vent, w = 1
+;; while its vent is up (the renderer draws the vent ring there); 8 slots (Jak1Background kMaxGreenVentProps)
+(define-perm *ios-green-vent-props* pointer
+  (let ((p (malloc 'global 128)))
+    (dotimes (i 32)
+      (set! (-> (the-as (pointer float) p) i) 0.0))
+    p))
+
+(defun ios-green-vent-prop ((i int))
+  (the-as vector (&+ *ios-green-vent-props* (* i 16))))
+
+(define-perm *ios-green-vent-entity* entity-actor #f)
+
+(defun ios-green-vent-entity ()
+  "The vents' entity: an empty res-lump (fact-info finds no eco-info, so the pickup is green eco), level-default,
+   process never set. Same as the ocean fish's. Made once."
+  (when (not *ios-green-vent-entity*)
+    (let ((ent (new 'global 'entity-actor 1 0))
+          (links (new 'global 'entity-links)))
+      (set! (-> links entity) ent)
+      (set! (-> links process) #f)
+      (set! (-> links level) (-> *level* level-default))
+      (set! (-> ent extra) links)
+      (set! (-> ent etype) vent)
+      (quaternion-identity! (-> ent quat))
+      (set! *ios-green-vent-entity* ent)))
+  *ios-green-vent-entity*)
+
+(deftype ios-green-vent (vent)
+  ((spot int32)))
+
+(define *ios-green-vent-ppointers* (new 'static 'array uint32 IOS_GREEN_VENT_COUNT))
+(define *ios-green-vent-pids* (new 'static 'array int32 IOS_GREEN_VENT_COUNT))
+
+(defun ios-green-vent-get ((i int))
+  (let ((pp (the-as (pointer process) (-> *ios-green-vent-ppointers* i))))
+    (the-as ios-green-vent
+            (when (nonzero? pp)
+              (let ((proc (-> pp 0)))
+                (if (and proc (= (-> proc pid) (-> *ios-green-vent-pids* i))) proc))))))
+
+(defbehavior ios-green-vent-init-by-other ios-green-vent ((i int))
+  "Stock vent initialize (collectables.gc) for green eco at spot I, without the entity's trans and blocker."
+  (set! (-> self entity) (ios-green-vent-entity))
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! (-> self spot) i)
+  (set! (-> *ios-green-vent-ppointers* i) (the-as uint (-> self ppointer)))
+  (set! (-> *ios-green-vent-pids* i) (-> self pid))
+  (let ((cshape (new 'process 'collide-shape self (collide-list-enum hit-by-player))))
+    (let ((sphere (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
+      (set! (-> sphere prim-core collide-as) (collide-kind powerup))
+      (set! (-> sphere collide-with) (collide-kind target))
+      (set-vector! (-> sphere local-sphere) 0.0 4915.2 0.0 6553.6)
+      (set-root-prim! cshape sphere))
+    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
+    (backup-collide-with-as cshape)
+    (set! (-> self root) cshape))
+  (set! (-> self root trans quad) (-> *ios-green-vent-spots* i quad))
+  (update-transforms! (-> self root))
+  (set! (-> self root pause-adjust-distance) 409600.0)
+  (set! (-> self fact) (new 'process 'fact-info self (pickup-type eco-green) (-> *FACT-bank* eco-full-inc)))
+  (set! (-> self block-func) (the-as (function vent symbol) true-func))
+  (set! (-> self part) (create-launch-control group-part-vent-green-active self))
+  (set! (-> self collect-effect) group-green-collect)
+  (set! (-> self collect-effect2) group-eco-green-collect)
+  (set! (-> self sound) (new 'process 'ambient-sound 'eco-bg-green (-> self root trans)))
+  (set! (-> self blocker) #f)
+  (set! (-> self pickup-handle) (the-as handle #f))
+  (set! (-> self show-particles) #t)
+  (format 0 "ios-green-vent: vent ~D up at ~m ~m ~m~%" i (-> self root trans x) (-> self root trans y) (-> self root trans z))
+  (go vent-wait-for-touch)
+  (none))
+
+(defun ios-green-vents-update ()
+  (dotimes (i IOS_GREEN_VENT_COUNT)
+    (let* ((spot (-> *ios-green-vent-spots* i))
+           (lev (level-get *level* (ios-green-vent-level i)))
+           (want (and (= *ios-expanded-green-eco* #t)
+                      *target*
+                      lev
+                      (= (-> lev status) 'active)
+                      (not (level-get *level* 'title))
+                      (< (vector-vector-distance (target-pos 0) spot) IOS_GREEN_VENT_RANGE)))
+           (proc (ios-green-vent-get i)))
+      (cond
+        ((and want (not proc)) (process-spawn ios-green-vent i :to *entity-pool*))
+        ((and (not want) proc) (deactivate proc)))
+      (let ((prop (ios-green-vent-prop i)))
+        (cond
+          ((ios-green-vent-get i)
+           (set! (-> prop quad) (-> spot quad))
+           (set! (-> prop w) 1.0))
+          (else (set! (-> prop w) 0.0))))))
+  0)
+
+;; Chain into *menu-hook* (after ios-boat-summon's). This file's top-level only runs once, at boot.
+(define *ios-green-eco-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-green-eco-menu-hook ()
+  (ios-green-eco-update)
+  (ios-green-vents-update)
+  (*ios-green-eco-prev-menu-hook*)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-green-eco-menu-hook))
diff --git a/goal_src/jak1/pc/ios/ios-ocean-fish.gc b/goal_src/jak1/pc/ios/ios-ocean-fish.gc
new file mode 100644
index 000000000..860dd2130
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-ocean-fish.gc
@@ -0,0 +1,902 @@
+;;-*-Lisp-*-
+(in-package goal)
+(require "engine/target/logic-target.gc")
+(require "engine/target/target2.gc")
+
+;; og:ios Fishing (experimental; was Fish in Ocean, user 2026-10-10): fish around Jak in the ocean.
+;;
+;; - Fish spawn alone (fishing phase 1, user 2026-10-17) in ocean water around Jak, in the open sea or near the
+;;   shore but not right at it, and despawn once he is far from them. Each fish is one species of the Fishing
+;;   roster (*ios-fish-roster*, written by the host from jakIOS/Runtime/IOSFishRoster.h): a stock model, a
+;;   tint (draw-control color-mult / color-emissive) and a scale, picked by rarity weight. Epic and Legendary
+;;   fish only live in deep water. A "school" process is the fish's swimming brain (kept from the schools of
+;;   Fish in Ocean); its one child is the drawn fish.
+;; - Models: catch-fisha / catch-fishb / catch-fishc (the fishing game's eel) / junglefish (Forbidden Jungle) and
+;;   the three sunkenfisha colours (Lost Precursor City). Each model is its own process type (ios-fish-*), all
+;;   sharing the ios-ocean-fish behaviour, so they can grow apart later.
+;; - The art is not tied to those levels: the host (OpenGOALRuntimeHost.mm LoadResidentFishArt) loads the five art
+;;   groups into the global heap as level-default art, and every fish has a stand-in entity whose level is
+;;   level-default, so initialize-skeleton takes those copies. The renderer draws the models from
+;;   Jak1Level-ios-fish.fr3z (built at import, jakIOS/Import/Jak1CustomLevelBuilder.cpp).
+;; - Fish never leave the water: every school probes the background collision under itself and ahead (sea floor,
+;;   shores, docks, rocks) and turns away from anything that is not deep enough water; each fish is kept between
+;;   the floor and the (wavy) ocean surface.
+;; - While Jak is in the ocean (in ocean water, or on the boat) *ios-clear-ocean* asks the renderer to draw the
+;;   near ocean at its clearest everywhere (Jak1Ocean SetOceanClearWater), so the fish show from a high camera too.
+;;
+;; Linked as a startup object (aot_level_code_link.py --startup-object ios-ocean-fish, after ios-dynamic-save): its
+;; top-level runs once at boot and chains the per-frame update into *menu-hook*.
+
+;; fishermans-boat.gc (village1 level code): Jak at the free boat's wheel
+(define-extern *ios-boat-driving* symbol)
+;; ios-fishing.gc (linked later): where the bobber is (fish go for it, fishing phase 4)
+(define-extern *ios-fishing-bobber-pos* vector)
+
+;; set by the host every frame (OpenGOALRuntimeHost.mm SyncOceanFishOption): option on and fish art resident
+(define-perm *ios-ocean-fish* symbol #f)
+;; read by the host every frame: draw the near ocean at its clearest
+(define-perm *ios-clear-ocean* symbol #f)
+;; read by the host every frame: Jak may start fishing here (Action menu > Fish is available)
+(define-perm *ios-can-fish* symbol #f)
+
+;; ---- tuning --------------------------------------------------------------------------------------------------
+
+(defconstant IOS_FISH_MAX 10)              ;; fish alive at once (one per school)
+(defconstant IOS_FISH_MAX_SCHOOLS 10)
+(defconstant IOS_FISH_SPAWN_MIN (meters 14)) ;; new schools appear this far from Jak (xz) ...
+(defconstant IOS_FISH_SPAWN_MAX (meters 34)) ;; ... up to this far
+(defconstant IOS_FISH_HIDDEN_DIST (meters 24)) ;; closer than this, never spawn inside the camera's view
+(defconstant IOS_FISH_DESPAWN (meters 46))  ;; a school farther than this from Jak (xz) is removed
+(defconstant IOS_FISH_HOME_DIST (meters 32)) ;; beyond this, schools heading away turn back towards Jak
+(defconstant IOS_FISH_JAK_ABOVE_SEA (meters 15)) ;; Jak higher than this above the sea: no new fish
+;; water column
+(defconstant IOS_FISH_PROBE_ABOVE (meters 30)) ;; floor probe starts this far above the surface (finds land, docks)
+(defconstant IOS_FISH_MAX_DEPTH (meters 18)) ;; deepest a fish goes (open sea, or the floor is deeper)
+(defconstant IOS_FISH_MIN_COLUMN (meters 2.5)) ;; water shallower than this is "not water" for fish
+(defconstant IOS_FISH_SURFACE_GAP (meters 0.7)) ;; fish stay at least this far under the surface ...
+(defconstant IOS_FISH_FLOOR_GAP (meters 0.8))   ;; ... and above the floor
+(defconstant IOS_FISH_LOOK_AHEAD (meters 5)) ;; turn away from shores/shallows this far ahead
+(defconstant IOS_FISH_SHORE_CLEAR (meters 7)) ;; a new fish needs fish water this far around it too
+(defconstant IOS_FISH_DEEP_WATER (meters 12)) ;; Epic / Legendary fish need a water column this deep
+(defconstant IOS_FISH_DEEP_RARITY 3)           ;; rarity from which deep water is needed (3 = Epic)
+
+;; going for the bobber (fishing phase 4; ios-fishing.gc decides, the school swims it)
+(defconstant IOS_FISH_LURE_NONE 0)
+(defconstant IOS_FISH_LURE_APPROACH 1) ;; swims to just under the bobber
+(defconstant IOS_FISH_LURE_HOOKED 2)   ;; on the line: stays under the bobber, facing away from Jak
+(defconstant IOS_FISH_LURE_FLEE 3)     ;; got away: darts off, then is removed
+(defconstant IOS_FISH_LURE_DEPTH (meters 0.6))
+
+;; kinds = models, each its own process type. Same numbers as FishModel in IOSFishRoster.h.
+(defconstant IOS_FISH_KIND_CATCH_A 0)
+(defconstant IOS_FISH_KIND_CATCH_B 1)
+(defconstant IOS_FISH_KIND_EEL 2)
+(defconstant IOS_FISH_KIND_JUNGLE 3)
+(defconstant IOS_FISH_KIND_SUNKEN_RED_YELLOW 4)
+(defconstant IOS_FISH_KIND_SUNKEN_YELLOW_BLUE 5)
+(defconstant IOS_FISH_KIND_SUNKEN_YELLOW_EYE 6)
+
+;; ---- roster --------------------------------------------------------------------------------------------------
+;; Written by the host (OpenGOALRuntimeHost.mm SyncFishRoster) from IOSFishRoster.h kFishSpecies; index = species
+;; id (as stored in the save's fishing log). count stays 0 until the host has written it: no fish until then.
+
+(defconstant IOS_FISH_ROSTER_CAPACITY 64)
+
+(deftype ios-fish-species-info (structure)
+  ((model  int32  :offset 0)          ;; IOS_FISH_KIND_*
+   (rarity int32  :offset 4)          ;; 0 Common .. 4 Legendary
+   (scale  float  :offset 8)          ;; times the model's ocean-fish scale
+   (weight float  :offset 12)         ;; spawn weight (its rarity's weight shared by that rarity's species)
+   (tint   vector :inline :offset 16) ;; rgb = color-mult, w = glow (color-emissive = tint * glow)
+   (region int32  :offset 32)         ;; IOS_FISH_REGION_*: only spawns there (0: anywhere)
+   (pad    int32 3 :offset 36))
+  :size-assert #x30)
+
+(deftype ios-fish-roster (structure)
+  ((count   int32 :offset 0)
+   (species ios-fish-species-info IOS_FISH_ROSTER_CAPACITY :inline :offset 16))
+  :size-assert #xc10)
+
+(define *ios-fish-roster* (new 'global 'ios-fish-roster))
+(set! (-> *ios-fish-roster* count) 0)
+
+;; Regions (user 2026-10-18): some species only live around one place. Same numbers as FishRegion in IOSFishRoster.h;
+;; worked out from the level Jak is in.
+(defconstant IOS_FISH_REGION_ANY 0)
+(defconstant IOS_FISH_REGION_VILLAGE1 1) ;; Sandover Village
+(defconstant IOS_FISH_REGION_BEACH 2)    ;; Sentinel Beach
+(defconstant IOS_FISH_REGION_MISTY 3)    ;; Misty Island
+(defconstant IOS_FISH_REGION_VILLAGE2 4) ;; Rock Village
+(defconstant IOS_FISH_REGION_SWAMP 5)    ;; Boggy Swamp
+
+(defun ios-fish-region ()
+  "The region Jak is in (IOS_FISH_REGION_*), from his current level."
+  (let ((lev (if *target* (-> *target* current-level))))
+    (if lev
+      (case (-> lev name)
+        (('village1) IOS_FISH_REGION_VILLAGE1)
+        (('beach) IOS_FISH_REGION_BEACH)
+        (('misty) IOS_FISH_REGION_MISTY)
+        (('village2) IOS_FISH_REGION_VILLAGE2)
+        (('swamp) IOS_FISH_REGION_SWAMP)
+        (else IOS_FISH_REGION_ANY))
+      IOS_FISH_REGION_ANY)))
+
+(defun ios-fish-species-allowed? ((idx int) (deep symbol) (region int))
+  (let ((info (-> *ios-fish-roster* species idx)))
+    (and (or deep (< (-> info rarity) IOS_FISH_DEEP_RARITY))
+         (or (= (-> info region) IOS_FISH_REGION_ANY) (= (-> info region) region)))))
+
+(defun ios-fish-random-species ((deep symbol))
+  "A species by spawn weight among those that live in this water (DEEP: column at least IOS_FISH_DEEP_WATER) and
+   region. -1 when the roster isn't there yet."
+  (let ((roster *ios-fish-roster*)
+        (region (ios-fish-region))
+        (total 0.0)
+        (pick -1))
+    (dotimes (i (-> roster count))
+      (if (ios-fish-species-allowed? i deep region) (+! total (-> roster species i weight))))
+    (when (< 0.0 total)
+      (let ((r (rand-vu-float-range 0.0 total)))
+        (dotimes (i (-> roster count))
+          (when (and (< pick 0) (ios-fish-species-allowed? i deep region))
+            (set! r (- r (-> roster species i weight)))
+            (if (<= r 0.0) (set! pick i))))
+        ;; rounding: the last allowed species
+        (when (< pick 0)
+          (dotimes (i (-> roster count))
+            (if (ios-fish-species-allowed? i deep region) (set! pick i))))))
+    pick))
+
+;; ---- art -----------------------------------------------------------------------------------------------------
+;; Same art groups as the stock skeleton groups (fisher.gc, junglefish.gc, sunken-fish.gc), defined here so they
+;; exist without the jungle/sunken code. Bounds are in world units, for the scaled ocean fish (about 1-1.5 m long).
+
+(defskelgroup *ios-fish-catch-a-sg*
+  catch-fisha
+  catch-fisha-lod0-jg
+  catch-fisha-idle-ja
+  ((catch-fisha-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 0.4 0 1.5))
+
+(defskelgroup *ios-fish-catch-b-sg*
+  catch-fishb
+  catch-fishb-lod0-jg
+  catch-fishb-idle-ja
+  ((catch-fishb-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 0.4 0 1.5))
+
+(defskelgroup *ios-fish-eel-sg*
+  catch-fishc
+  catch-fishc-lod0-jg
+  catch-fishc-idle-ja
+  ((catch-fishc-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 0.4 0 1.5))
+
+(defskelgroup *ios-fish-jungle-sg*
+  junglefish
+  junglefish-lod0-jg
+  junglefish-swim-ja
+  ((junglefish-lod0-mg (meters 20)) (junglefish-lod1-mg (meters 40)) (junglefish-lod2-mg (meters 999999)))
+  :bounds (static-spherem 0 0.4 0 1.5))
+
+(defskelgroup *ios-fish-sunken-red-yellow-sg*
+  sunkenfisha
+  sunkenfisha-red-yellow-lod0-jg
+  sunkenfisha-idle-ja
+  ((sunkenfisha-red-yellow-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 0.6 0 1.5))
+
+(defskelgroup *ios-fish-sunken-yellow-blue-sg*
+  sunkenfisha
+  sunkenfisha-yellow-blue-lod0-jg
+  sunkenfisha-idle-ja
+  ((sunkenfisha-yellow-blue-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 0.6 0 1.5))
+
+(defskelgroup *ios-fish-sunken-yellow-eye-sg*
+  sunkenfisha
+  sunkenfisha-yellow-eye-lod0-jg
+  sunkenfisha-idle-ja
+  ((sunkenfisha-yellow-eye-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 0.6 0 1.5))
+
+(defun ios-fish-skel ((kind int))
+  (case kind
+    ((IOS_FISH_KIND_CATCH_A) *ios-fish-catch-a-sg*)
+    ((IOS_FISH_KIND_CATCH_B) *ios-fish-catch-b-sg*)
+    ((IOS_FISH_KIND_EEL) *ios-fish-eel-sg*)
+    ((IOS_FISH_KIND_JUNGLE) *ios-fish-jungle-sg*)
+    ((IOS_FISH_KIND_SUNKEN_RED_YELLOW) *ios-fish-sunken-red-yellow-sg*)
+    ((IOS_FISH_KIND_SUNKEN_YELLOW_BLUE) *ios-fish-sunken-yellow-blue-sg*)
+    (else *ios-fish-sunken-yellow-eye-sg*)))
+
+;; Swim animation: its index in the art group (engine/data/art-elts.gc).
+(defun ios-fish-anim-index ((kind int))
+  (case kind
+    ((IOS_FISH_KIND_CATCH_A IOS_FISH_KIND_CATCH_B IOS_FISH_KIND_EEL) 2) ;; catch-fish?-idle-ja
+    ((IOS_FISH_KIND_JUNGLE) 4)                        ;; junglefish-swim-ja
+    (else 6)))                                        ;; sunkenfisha-idle-ja
+
+;; Model scale: the bind poses are ~3.6 m (catch), ~3 m (junglefish) and ~0.5 m (sunkenfisha) long; the eel
+;; (catch-fishc) is assumed catch-fish sized.
+(defun ios-fish-scale ((kind int))
+  (case kind
+    ((IOS_FISH_KIND_CATCH_A) 0.3)
+    ((IOS_FISH_KIND_CATCH_B) 0.32)
+    ((IOS_FISH_KIND_EEL) 0.3)
+    ((IOS_FISH_KIND_JUNGLE) 0.45)
+    (else 2.4)))
+
+;; School cruising speed range.
+(defun ios-fish-speed-lo ((kind int))
+  (case kind
+    ((IOS_FISH_KIND_CATCH_A IOS_FISH_KIND_CATCH_B) (meters 1.0))
+    ((IOS_FISH_KIND_EEL) (meters 0.7))
+    ((IOS_FISH_KIND_JUNGLE) (meters 1.4))
+    (else (meters 0.6))))
+
+(defun ios-fish-speed-hi ((kind int))
+  (case kind
+    ((IOS_FISH_KIND_CATCH_A IOS_FISH_KIND_CATCH_B) (meters 2.2))
+    ((IOS_FISH_KIND_EEL) (meters 1.6))
+    ((IOS_FISH_KIND_JUNGLE) (meters 2.8))
+    (else (meters 1.6))))
+
+;; ---- stand-in entity -----------------------------------------------------------------------------------------
+
+(define-perm *ios-fish-entity* entity-actor #f)
+
+(defun ios-fish-entity ()
+  "The fish's entity: an empty res-lump whose links point at level-default (so initialize-skeleton takes the
+   resident fish art) and whose process is never set. Same as the free boat's (fishermans-boat.gc). Made once."
+  (when (not *ios-fish-entity*)
+    (let ((ent (new 'global 'entity-actor 1 0))
+          (links (new 'global 'entity-links)))
+      (set! (-> links entity) ent)
+      (set! (-> links process) #f)
+      (set! (-> links level) (-> *level* level-default))
+      (set! (-> ent extra) links)
+      (set! (-> ent etype) process-drawable)
+      (quaternion-identity! (-> ent quat))
+      (set! *ios-fish-entity* ent)))
+  *ios-fish-entity*)
+
+;; ---- water ---------------------------------------------------------------------------------------------------
+;; Water is the ocean, or a (harmless) water volume: Boggy Swamp's water is not the ocean but water-vol actors with
+;; their own height (user 2026-10-18), as are rivers and pools. The manager keeps a list of the water-vols alive.
+
+(defconstant IOS_FISH_VOL_MAX 24)
+(defconstant IOS_FISH_NO_VOL (meters -100000))
+(defconstant IOS_FISH_VOL_MIN_COLUMN (meters 1.5)) ;; water volumes are shallower than the sea
+(defconstant IOS_FISH_VOL_NEAR (meters 60))        ;; a volume this close (its actor, xz) can be the water by Jak
+
+(deftype ios-fish-vol-list (structure)
+  ((count int32)
+   (vols  handle IOS_FISH_VOL_MAX :offset 8)))
+
+(define *ios-fish-vol-list* (new 'global 'ios-fish-vol-list))
+(set! (-> *ios-fish-vol-list* count) 0)
+
+(defun ios-fish-collect-vol ((proc process))
+  (let ((list *ios-fish-vol-list*))
+    (when (and (type-type? (-> proc type) water-vol)
+               (< (-> list count) IOS_FISH_VOL_MAX)
+               (not (logtest? (-> (the-as water-vol proc) flag) (water-flag deadly)))
+               (nonzero? (-> (the-as water-vol proc) vol))
+               (-> (the-as water-vol proc) vol))
+      (set! (-> list vols (-> list count)) (process->handle proc))
+      (+! (-> list count) 1)))
+  #f)
+
+(defun ios-fish-refresh-vols ()
+  (set! (-> *ios-fish-vol-list* count) 0)
+  (iterate-process-tree *active-pool* (the-as (function object object) ios-fish-collect-vol) *null-kernel-context*)
+  0)
+
+(defun ios-fish-vol-surface ((pos vector))
+  "The height of the water volume POS (xz) is in, IOS_FISH_NO_VOL if none."
+  (let ((list *ios-fish-vol-list*)
+        (test (new 'stack-no-clear 'vector))
+        (best IOS_FISH_NO_VOL))
+    (dotimes (i (-> list count))
+      (let ((vol (the-as water-vol (handle->process (-> list vols i)))))
+        (when (and vol (< best (-> vol water-height)))
+          ;; just under its surface
+          (set-vector! test (-> pos x) (- (-> vol water-height) (meters 0.3)) (-> pos z) 1.0)
+          (if (point-in-vol? (-> vol vol) test) (set! best (-> vol water-height))))))
+    best))
+
+(defun ios-fish-surface ((pos vector))
+  "The water surface over POS (xz): its water volume's, else the ocean's."
+  (let ((vol (ios-fish-vol-surface pos)))
+    (if (< IOS_FISH_NO_VOL vol) vol (ocean-get-height pos))))
+
+(defun ios-fish-jak-surface ((pos vector))
+  "The water surface by Jak at POS: the ocean's or that of the highest nearby water volume below him (he can stand on
+   a shore outside the volume itself)."
+  (let ((list *ios-fish-vol-list*)
+        (best (ios-fish-surface pos)))
+    (dotimes (i (-> list count))
+      (let ((vol (the-as water-vol (handle->process (-> list vols i)))))
+        (when (and vol
+                   (< best (-> vol water-height))
+                   (< (-> vol water-height) (+ (-> pos y) (meters 1)))
+                   (< (vector-vector-xz-distance (-> vol root trans) pos) IOS_FISH_VOL_NEAR))
+          (set! best (-> vol water-height)))))
+    best))
+
+(defun ios-fish-water-column ((pos vector) (proc process) (out vector))
+  "Is there water (ocean or a water volume) at POS (xz) deep enough for fish? Probes the background straight down
+   from well above the surface, so land, docks and shallows above or near the surface all fail. OUT x = floor y
+   (MAX_DEPTH under the surface when the probe finds nothing, e.g. the open sea), y = surface y."
+  (let* ((vol-surface (ios-fish-vol-surface pos))
+         (in-vol (< IOS_FISH_NO_VOL vol-surface))
+         (surface (if in-vol vol-surface (ocean-get-height pos)))
+         (len (+ IOS_FISH_PROBE_ABOVE IOS_FISH_MAX_DEPTH))
+         (start (new 'stack-no-clear 'vector))
+         (probe (new 'stack-no-clear 'vector))
+         (result (new 'stack-no-clear 'collide-tri-result)))
+    (set-vector! start (-> pos x) (+ surface IOS_FISH_PROBE_ABOVE) (-> pos z) 1.0)
+    (set-vector! probe 0.0 (- len) 0.0 1.0)
+    (let* ((u (fill-and-probe-using-line-sphere *collide-cache*
+                                                start
+                                                probe
+                                                (meters 0.5)
+                                                (collide-kind background)
+                                                proc
+                                                result
+                                                (new 'static 'pat-surface :noentity #x1)))
+           (floor (if (>= u 0.0) (- (-> start y) (* u len)) (- surface IOS_FISH_MAX_DEPTH))))
+      (set! (-> out x) floor)
+      (set! (-> out y) surface)
+      (< (+ floor (if in-vol IOS_FISH_VOL_MIN_COLUMN IOS_FISH_MIN_COLUMN)) surface))))
+
+(define *ios-fish-at-sea* #f)
+
+(defun ios-fish-jak-at-sea? ((proc process))
+  "Jak in ocean water, or just above the sea with no ground under him (on the boat's deck)."
+  (when *target*
+    (let ((flags (-> *target* water flag)))
+      (or (and (logtest? flags (water-flag touch-water)) (logtest? flags (water-flag use-ocean)))
+          (let* ((pos (target-pos 0))
+                 (above (- (-> pos y) (ocean-get-height pos))))
+            (and (< (meters -0.5) above)
+                 (< above (meters 6))
+                 (let ((probe (new 'stack-no-clear 'vector))
+                       (result (new 'stack-no-clear 'collide-tri-result)))
+                   (set-vector! probe 0.0 (- (+ above (meters 2))) 0.0 1.0)
+                   ;; no background (dock, beach, rock) between his feet and 2 m under the surface
+                   (< (fill-and-probe-using-line-sphere *collide-cache*
+                                                        pos
+                                                        probe
+                                                        (meters 0.3)
+                                                        (collide-kind background)
+                                                        proc
+                                                        result
+                                                        (new 'static 'pat-surface :noentity #x1))
+                      0.0))))))))
+
+;; ---- types ---------------------------------------------------------------------------------------------------
+
+;; A school: the swimming brain (position, heading, depth) of its one fish, its child process.
+(deftype ios-fish-school (process)
+  ((kind         int32)
+   (species      int32)          ;; roster index
+   (count        int32)          ;; always 1 since fishing phase 1
+   (lure-mode    int32)          ;; IOS_FISH_LURE_*: set by ios-fishing.gc
+   (lure-time    time-frame)
+   (center       vector :inline)
+   (column       vector :inline) ;; x floor, y surface (latest probes)
+   (ahead        vector :inline)
+   (yaw          float)
+   (target-yaw   float)
+   (speed        float)
+   (target-speed float)
+   (target-y     float)
+   (radius       float)
+   (probe-ahead  symbol)         ;; alternate the two probes
+   (wander-time  time-frame)
+   (probe-time   time-frame))
+  (:states
+   ios-fish-school-swim))
+
+;; One fish. Each model is its own type (below) so they can be given their own behaviour later.
+(deftype ios-ocean-fish (process-drawable)
+  ((kind      int32)
+   (species   int32)          ;; roster index (bites / catch log use it)
+   (offset    vector :inline) ;; place in the school (school space: x right, y up, z ahead)
+   (vel       vector :inline)
+   (facing    vector :inline) ;; x pitch, y yaw
+   (phase     float)
+   (anim-rate float))
+  (:states
+   ios-ocean-fish-swim))
+
+(deftype ios-fish-catch-a (ios-ocean-fish) ())
+(deftype ios-fish-catch-b (ios-ocean-fish) ())
+(deftype ios-fish-eel (ios-ocean-fish) ())
+(deftype ios-fish-jungle (ios-ocean-fish) ())
+(deftype ios-fish-sunken-red-yellow (ios-ocean-fish) ())
+(deftype ios-fish-sunken-yellow-blue (ios-ocean-fish) ())
+(deftype ios-fish-sunken-yellow-eye (ios-ocean-fish) ())
+
+;; Spawns schools around Jak, keeps the fish count capped. Its children are the schools.
+(deftype ios-fish-manager (process)
+  ((spawn-time   time-frame)
+   (sea-time     time-frame)
+   (vol-time     time-frame)  ;; *ios-fish-vol-list* refreshed
+   (fish-count   int32)  ;; ios-fish-manager-count
+   (school-count int32))
+  (:states
+   ios-fish-manager-run))
+
+(define *ios-fish-manager-ppointer* (the-as (pointer process) #f))
+(define *ios-fish-manager-pid* 0)
+
+(defun ios-fish-manager-get ()
+  (let ((pp *ios-fish-manager-ppointer*))
+    (the-as ios-fish-manager
+            (when pp
+              (let ((proc (-> pp 0)))
+                (if (and proc (= (-> proc pid) *ios-fish-manager-pid*)) proc))))))
+
+;; ---- fish ----------------------------------------------------------------------------------------------------
+
+(defun ios-fish-slot-world ((school ios-fish-school) (offset vector) (out vector))
+  "Where a fish with OFFSET wants to be: the school centre plus OFFSET turned to the school's heading."
+  (vector-rotate-around-y! out offset (-> school yaw))
+  (vector+! out out (-> school center)))
+
+(defbehavior ios-ocean-fish-init-by-other ios-ocean-fish ((kind int) (sp int) (offset vector))
+  (let ((school (the-as ios-fish-school (ppointer->process (-> self parent)))))
+    (set! (-> self entity) (ios-fish-entity))
+    (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+    (set! (-> self kind) kind)
+    (set! (-> self species) sp)
+    (set! (-> self offset quad) (-> offset quad))
+    (set! (-> self root) (new 'process 'trsqv))
+    (ios-fish-slot-world school offset (-> self root trans))
+    (initialize-skeleton self (ios-fish-skel kind) '())
+    ;; silent: no effect-control, so the swim animations' built-in sound effects (junglefish splashes etc.)
+    ;; never play (user 2026-10-10)
+    (set! (-> self skel effect) #f)
+    (let* ((info (-> *ios-fish-roster* species sp))
+           (scale (* (ios-fish-scale kind) (-> info scale) (rand-vu-float-range 0.9 1.1)))
+           (tint (-> info tint)))
+      (set-vector! (-> self root scale) scale scale scale 1.0)
+      ;; The species' colours: lighting times tint, plus some of it self-lit (draw-control, as stock fisher.gc).
+      ;; Seen through the (translucent, blue) ocean the plain tint was lost (user 2026-10-17), so in the water it is
+      ;; exaggerated (away from white) and self-lit in its own colour, which shows through the water. 1.6x and a
+      ;; flat 0.18 glow still looked stock under the water (user 2026-10-18): now 2.6x, and the glow grows with how far
+      ;; the tint is from white (stock-coloured species stay unlit).
+      (let* ((r (fmin 2.2 (fmax 0.1 (+ 1.0 (* 2.6 (+ -1.0 (-> tint x)))))))
+             (g (fmin 2.2 (fmax 0.1 (+ 1.0 (* 2.6 (+ -1.0 (-> tint y)))))))
+             (b (fmin 2.2 (fmax 0.1 (+ 1.0 (* 2.6 (+ -1.0 (-> tint z)))))))
+             (off-white (fmax (fabs (+ -1.0 (-> tint x))) (fmax (fabs (+ -1.0 (-> tint y))) (fabs (+ -1.0 (-> tint z))))))
+             (glow (+ (-> tint w) (fmin 0.45 (* 1.1 off-white)))))
+        (set-vector! (-> self draw color-mult) r g b 1.0)
+        (set-vector! (-> self draw color-emissive) (* r glow) (* g glow) (* b glow) 0.0)))
+    (vector-reset! (-> self vel))
+    (set-vector! (-> self facing) 0.0 (-> school yaw) 0.0 1.0)
+    (quaternion-zxy! (-> self root quat) (-> self facing))
+    (set! (-> self phase) (rand-vu-float-range 0.0 65536.0))
+    (set! (-> self anim-rate) (rand-vu-float-range 0.8 1.2)))
+  (go ios-ocean-fish-swim)
+  (none))
+
+(defbehavior ios-ocean-fish-move ios-ocean-fish ()
+  (let ((school (the-as ios-fish-school (ppointer->process (-> self parent))))
+        (dt (seconds-per-frame)))
+    (when school
+      (let ((goal (new 'stack-no-clear 'vector))
+            (want (new 'stack-no-clear 'vector)))
+        (ios-fish-slot-world school (-> self offset) goal)
+        ;; a little personal wander so the school doesn't move like one rigid block
+        (+! (-> self phase) (* 16384.0 dt))
+        (+! (-> goal y) (* (meters 0.25) (sin (-> self phase))))
+        (+! (-> goal x) (* (meters 0.3) (cos (* 0.7 (-> self phase)))))
+        ;; spring towards the slot, never much faster than the school
+        (vector-! want goal (-> self root trans))
+        (vector-float*! want want 1.5)
+        (let ((len (vector-length want))
+              (max-speed (+ (-> school speed) (meters 1.5))))
+          (if (< max-speed len) (vector-float*! want want (/ max-speed len))))
+        (vector-lerp! (-> self vel) (-> self vel) want (fmin 1.0 (* 3.0 dt)))
+        (vector+*! (-> self root trans) (-> self root trans) (-> self vel) dt))
+      ;; stay in the water: under the (wavy) surface, above the school's floor
+      (let* ((pos (-> self root trans))
+             (top (- (ios-fish-surface pos) IOS_FISH_SURFACE_GAP))
+             (bottom (+ (-> school column x) IOS_FISH_FLOOR_GAP)))
+        (if (< top (-> pos y)) (set! (-> pos y) top))
+        (if (< (-> pos y) bottom) (set! (-> pos y) (fmin bottom top))))
+      ;; face where it swims; level out when slow
+      (let ((flat (vector-xz-length (-> self vel))))
+        (when (< (meters 0.1) flat)
+          (set! (-> self facing y)
+                (deg-seek-smooth (-> self facing y) (vector-y-angle (-> self vel)) (* 32768.0 dt) 0.2)))
+        (set! (-> self facing x)
+              (deg-seek-smooth (-> self facing x)
+                               (fmax -3640.889 (fmin 3640.889 (- (atan (-> self vel y) (fmax (meters 0.2) flat)))))
+                               (* 16384.0 dt)
+                               0.2)))
+      (quaternion-zxy! (-> self root quat) (-> self facing))))
+  0
+  (none))
+
+(defstate ios-ocean-fish-swim (ios-ocean-fish)
+  :trans
+    (behavior ()
+      (if (ppointer->process (-> self parent)) (ios-ocean-fish-move) (deactivate self)))
+  :code
+    (behavior ()
+      (ja-channel-set! 1)
+      (let ((anim (the-as art-joint-anim (-> self draw art-group data (ios-fish-anim-index (-> self kind))))))
+        (loop
+          (ja-no-eval :group! anim :num! (seek! max (-> self anim-rate)) :frame-num 0.0)
+          (until (ja-done? 0)
+            (suspend)
+            (ja :num! (seek! max (-> self anim-rate)))))))
+  :post ja-post)
+
+(defun ios-fish-spawn-fish ((school ios-fish-school) (kind int) (species int) (offset vector))
+  "One fish of SPECIES (model KIND) in SCHOOL, as that model's own process type."
+  (case kind
+    ((IOS_FISH_KIND_CATCH_A)
+     (process-spawn ios-fish-catch-a :init ios-ocean-fish-init-by-other kind species offset :to school))
+    ((IOS_FISH_KIND_CATCH_B)
+     (process-spawn ios-fish-catch-b :init ios-ocean-fish-init-by-other kind species offset :to school))
+    ((IOS_FISH_KIND_EEL)
+     (process-spawn ios-fish-eel :init ios-ocean-fish-init-by-other kind species offset :to school))
+    ((IOS_FISH_KIND_JUNGLE)
+     (process-spawn ios-fish-jungle :init ios-ocean-fish-init-by-other kind species offset :to school))
+    ((IOS_FISH_KIND_SUNKEN_RED_YELLOW)
+     (process-spawn ios-fish-sunken-red-yellow :init ios-ocean-fish-init-by-other kind species offset :to school))
+    ((IOS_FISH_KIND_SUNKEN_YELLOW_BLUE)
+     (process-spawn ios-fish-sunken-yellow-blue :init ios-ocean-fish-init-by-other kind species offset :to school))
+    (else
+     (process-spawn ios-fish-sunken-yellow-eye :init ios-ocean-fish-init-by-other kind species offset :to school)))
+  0)
+
+;; ---- school --------------------------------------------------------------------------------------------------
+
+(defbehavior ios-fish-school-new-course ios-fish-school ()
+  "Every few seconds: a new heading (a gentle turn), speed and depth inside the water column."
+  (set! (-> self target-yaw) (+ (-> self yaw) (rand-vu-float-range -10922.667 10922.667)))
+  (set! (-> self target-speed) (rand-vu-float-range (ios-fish-speed-lo (-> self kind)) (ios-fish-speed-hi (-> self kind))))
+  (let ((top (- (-> self column y) IOS_FISH_SURFACE_GAP (* 0.5 (-> self radius))))
+        (bottom (+ (-> self column x) IOS_FISH_FLOOR_GAP (* 0.5 (-> self radius)))))
+    (set! (-> self target-y) (if (< bottom top) (rand-vu-float-range bottom top) (* 0.5 (+ top bottom)))))
+  (set! (-> self wander-time) (+ (current-time) (rand-vu-int-range (seconds 3) (seconds 8))))
+  0)
+
+(defbehavior ios-fish-school-turn-away ios-fish-school ()
+  "The water ahead ends (shore, rock, dock, shallows): turn to the first open direction, slowing down."
+  (let ((test (new 'stack-no-clear 'vector))
+        (col (new 'stack-no-clear 'vector))
+        (found #f))
+    ;; +-45, +-90, +-135, 180 degrees
+    (dotimes (k 7)
+      (when (not found)
+        (let ((yaw (+ (-> self yaw)
+                      (* 8192.0 (the float (* (+ 1 (/ k 2)) (if (zero? (logand k 1)) 1 -1)))))))
+          (set-vector! test (sin yaw) 0.0 (cos yaw) 1.0)
+          (vector+*! test (-> self center) test (+ IOS_FISH_LOOK_AHEAD (-> self radius)))
+          (when (ios-fish-water-column test self col)
+            (set! (-> self target-yaw) yaw)
+            (set! found #t)))))
+    (if (not found) (set! (-> self target-yaw) (+ (-> self yaw) 32768.0))))
+  (set! (-> self target-speed) (fmin (-> self target-speed) (meters 0.4)))
+  (set! (-> self wander-time) (+ (current-time) (seconds 2)))
+  0)
+
+(define-extern ios-fish-school-steer (function float vector int :behavior ios-fish-school))
+
+(defbehavior ios-fish-school-lure ios-fish-school ((dt float) (jak vector))
+  "Going for the bobber, hooked on it, or fleeing (fishing phase 4)."
+  (let ((bob *ios-fishing-bobber-pos*)
+        (to (new 'stack-no-clear 'vector)))
+    (vector-! to bob (-> self center))
+    (set! (-> to y) 0.0)
+    (case (-> self lure-mode)
+      ((IOS_FISH_LURE_APPROACH)
+       ;; turn towards the bobber quickly, slow down near it, rise to just under it
+       (let ((dist (vector-length to)))
+         (if (< (meters 0.1) dist)
+           (set! (-> self yaw) (deg-seek (-> self yaw) (vector-y-angle to) (* 16384.0 dt))))
+         (set! (-> self speed) (seek (-> self speed) (fmin (meters 1.8) (* 0.8 dist)) (* (meters 2) dt))))
+       (+! (-> self center x) (* (sin (-> self yaw)) (-> self speed) dt))
+       (+! (-> self center z) (* (cos (-> self yaw)) (-> self speed) dt))
+       (set! (-> self center y)
+             (seek (-> self center y) (- (ios-fish-surface bob) IOS_FISH_LURE_DEPTH) (* (meters 1) dt))))
+      ((IOS_FISH_LURE_HOOKED)
+       ;; under the bobber, struggling away from Jak
+       (let ((away (vector-! (new 'stack-no-clear 'vector) bob jak)))
+         (set! (-> away y) 0.0)
+         (if (< 0.0 (vector-length away))
+           (set! (-> self yaw)
+                 (deg-seek (-> self yaw)
+                           (+ (vector-y-angle away) (* 5461.3335 (sin (* 65536.0 1.5 (/ (the float (- (current-time) (-> self lure-time))) 300.0)))))
+                           (* 32768.0 dt)))))
+       (set! (-> self speed) (meters 1.5))
+       (set-vector! (-> self center) (-> bob x) (- (ios-fish-surface bob) IOS_FISH_LURE_DEPTH) (-> bob z) 1.0))
+      (else
+       ;; fled: away from the bobber, fast, then gone
+       (if (< (meters 0.1) (vector-length to))
+         (set! (-> self yaw) (deg-seek (-> self yaw) (+ 32768.0 (vector-y-angle to)) (* 32768.0 dt))))
+       (set! (-> self speed) (seek (-> self speed) (meters 5) (* (meters 6) dt)))
+       (+! (-> self center x) (* (sin (-> self yaw)) (-> self speed) dt))
+       (+! (-> self center z) (* (cos (-> self yaw)) (-> self speed) dt))
+       (set! (-> self center y) (seek (-> self center y) (+ (-> self column x) IOS_FISH_FLOOR_GAP) (* (meters 1.5) dt)))
+       (if (time-elapsed? (-> self lure-time) (seconds 2.5)) (deactivate self)))))
+  0)
+
+(defbehavior ios-fish-school-update ios-fish-school ()
+  (let ((dt (seconds-per-frame))
+        (jak (target-pos 0)))
+    (cond
+      ;; fishing: going for the bobber, on the line or fleeing (never despawned on the way)
+      ((nonzero? (-> self lure-mode))
+       (ios-fish-school-lure dt jak))
+      ;; too far from Jak: gone (the manager spawns new schools nearer him)
+      ((< IOS_FISH_DESPAWN (vector-vector-xz-distance (-> self center) jak))
+       (deactivate self))
+      (else
+       (ios-fish-school-steer dt jak))))
+  0)
+
+(defbehavior ios-fish-school-steer ios-fish-school ((dt float) (jak vector))
+  (begin
+    ;; probes, alternating: the column under the school, and ahead of it
+    (when (time-elapsed? (-> self probe-time) (seconds 0.2))
+      (set-time! (-> self probe-time))
+      (let ((col (new 'stack-no-clear 'vector)))
+        (cond
+          ((-> self probe-ahead)
+           (set-vector! (-> self ahead) (sin (-> self yaw)) 0.0 (cos (-> self yaw)) 1.0)
+           (vector+*! (-> self ahead)
+                      (-> self center)
+                      (-> self ahead)
+                      (+ IOS_FISH_LOOK_AHEAD (-> self radius) (* 0.5 (-> self speed))))
+           (if (ios-fish-water-column (-> self ahead) self col)
+             ;; shallower ahead: keep the stricter floor so the fish rise before they get there
+             (set! (-> self column x) (fmax (-> self column x) (-> col x)))
+             (ios-fish-school-turn-away)))
+          (else
+           (if (ios-fish-water-column (-> self center) self col) (set! (-> self column quad) (-> col quad))))))
+      (set! (-> self probe-ahead) (not (-> self probe-ahead))))
+    (if (>= (current-time) (-> self wander-time)) (ios-fish-school-new-course))
+    ;; stay around Jak instead of swimming off: far out and heading away -> turn back towards him
+    (when (< IOS_FISH_HOME_DIST (vector-vector-xz-distance (-> self center) jak))
+      (let ((to-jak (vector-! (new 'stack-no-clear 'vector) jak (-> self center))))
+        (when (< (+ (* (sin (-> self yaw)) (-> to-jak x)) (* (cos (-> self yaw)) (-> to-jak z))) 0.0)
+          (set! (-> self target-yaw) (+ (vector-y-angle to-jak) (rand-vu-float-range -7281.778 7281.778)))
+          (set! (-> self wander-time) (+ (current-time) (seconds 4))))))
+    ;; steer, speed, depth
+    (set! (-> self yaw) (deg-seek (-> self yaw) (-> self target-yaw) (* 8192.0 dt)))
+    (set! (-> self speed) (seek (-> self speed) (-> self target-speed) (* (meters 1) dt)))
+    (+! (-> self center x) (* (sin (-> self yaw)) (-> self speed) dt))
+    (+! (-> self center z) (* (cos (-> self yaw)) (-> self speed) dt))
+    (let ((top (- (ios-fish-surface (-> self center)) IOS_FISH_SURFACE_GAP (* 0.5 (-> self radius))))
+          (bottom (+ (-> self column x) IOS_FISH_FLOOR_GAP (* 0.5 (-> self radius)))))
+      (set! (-> self center y) (seek (-> self center y) (-> self target-y) (* (meters 0.6) dt)))
+      (if (< top (-> self center y)) (set! (-> self center y) top))
+      (if (< (-> self center y) bottom) (set! (-> self center y) (fmin bottom top)))))
+  0)
+
+(defbehavior ios-fish-school-init-by-other ios-fish-school ((sp int) (pos vector) (column vector))
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (let ((kind (-> *ios-fish-roster* species sp model)))
+    (set! (-> self kind) kind)
+    (set! (-> self species) sp)
+    (set! (-> self count) 1)
+    (set! (-> self lure-mode) IOS_FISH_LURE_NONE)
+    (set! (-> self center quad) (-> pos quad))
+    (set! (-> self column quad) (-> column quad))
+    (set! (-> self yaw) (rand-vu-float-range 0.0 65536.0))
+    (set! (-> self target-yaw) (-> self yaw))
+    (set! (-> self speed) (ios-fish-speed-lo kind))
+    (set! (-> self probe-ahead) #t)
+    (set-time! (-> self probe-time))
+    (set! (-> self radius) (meters 0.5))
+    (ios-fish-school-new-course)
+    (set! (-> self target-y) (-> pos y))
+    ;; the fish swims at the school's centre
+    (ios-fish-spawn-fish self kind sp (new 'static 'vector)))
+  (go ios-fish-school-swim)
+  (none))
+
+(defstate ios-fish-school-swim (ios-fish-school)
+  :trans
+    (behavior ()
+      (ios-fish-school-update))
+  :code
+    (behavior ()
+      (loop
+        (suspend))))
+
+;; ---- manager -------------------------------------------------------------------------------------------------
+
+(defbehavior ios-fish-manager-count ios-fish-manager ()
+  "Count the fish alive in all schools, and the schools."
+  (set! (-> self fish-count) 0)
+  (set! (-> self school-count) 0)
+  (let ((child (-> self child)))
+    (while child
+      (let ((school (the-as ios-fish-school (-> child 0))))
+        (+! (-> self fish-count) (-> school count))
+        (+! (-> self school-count) 1)
+        (set! child (-> school brother)))))
+  0)
+
+(defbehavior ios-fish-manager-clear ios-fish-manager ()
+  "Remove every school (and so every fish)."
+  (let ((child (-> self child)))
+    (while child
+      (let ((next (-> child 0 brother)))
+        (deactivate (-> child 0))
+        (set! child next))))
+  0)
+
+(defun ios-fish-shore-clear? ((pos vector) (proc process))
+  "Fish water all around POS too (four points IOS_FISH_SHORE_CLEAR away), so no fish starts right at a shore."
+  (let ((test (new 'stack-no-clear 'vector))
+        (col (new 'stack-no-clear 'vector))
+        (clear #t))
+    (dotimes (k 4)
+      (when clear
+        (let ((yaw (* 16384.0 (the float k))))
+          (set-vector! test
+                       (+ (-> pos x) (* IOS_FISH_SHORE_CLEAR (sin yaw)))
+                       0.0
+                       (+ (-> pos z) (* IOS_FISH_SHORE_CLEAR (cos yaw)))
+                       1.0)
+          (if (not (ios-fish-water-column test proc col)) (set! clear #f)))))
+    clear))
+
+(defbehavior ios-fish-manager-try-spawn ios-fish-manager ()
+  "Try one spot around Jak for a new fish; most tries on land, in shallows or at a shore just fail."
+  (ios-fish-manager-count)
+  (let ((fish (-> self fish-count)))
+    (when (and (< fish IOS_FISH_MAX) (< (-> self school-count) IOS_FISH_MAX_SCHOOLS))
+      (let* ((jak (target-pos 0))
+             (angle (rand-vu-float-range 0.0 65536.0))
+             (dist (rand-vu-float-range IOS_FISH_SPAWN_MIN IOS_FISH_SPAWN_MAX))
+             (pos (new 'stack-no-clear 'vector))
+             (col (new 'stack-no-clear 'vector)))
+        (set-vector! pos (+ (-> jak x) (* dist (sin angle))) 0.0 (+ (-> jak z) (* dist (cos angle))) 1.0)
+        (when (and
+                ;; close by, only where the camera isn't looking, so schools don't pop in right in front of it
+                (or (< IOS_FISH_HIDDEN_DIST dist)
+                    (let ((to (vector-! (new 'stack-no-clear 'vector) pos (-> *math-camera* trans)))
+                          (fwd (-> *math-camera* inv-camera-rot vector 2)))
+                      (set! (-> to y) 0.0)
+                      (vector-normalize! to 1.0)
+                      (< (+ (* (-> to x) (-> fwd x)) (* (-> to z) (-> fwd z))) 0.3)))
+                (ios-fish-water-column pos self col)
+                (ios-fish-shore-clear? pos self))
+          (let* ((species (ios-fish-random-species (<= IOS_FISH_DEEP_WATER (- (-> col y) (-> col x)))))
+                 (top (- (-> col y) IOS_FISH_SURFACE_GAP (meters 1)))
+                 (bottom (+ (-> col x) IOS_FISH_FLOOR_GAP (meters 1))))
+            (when (>= species 0)
+              ;; any depth of the water column
+              (set! (-> pos y) (if (< bottom top) (rand-vu-float-range bottom top) (* 0.5 (+ top bottom))))
+              (process-spawn ios-fish-school species pos col :to self)))))))
+  0)
+
+(defbehavior ios-fish-manager-init-by-other ios-fish-manager ()
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! *ios-fish-manager-ppointer* (-> self ppointer))
+  (set! *ios-fish-manager-pid* (-> self pid))
+  (set-time! (-> self spawn-time))
+  (set-time! (-> self sea-time))
+  (set! (-> self vol-time) 0)
+  (go ios-fish-manager-run)
+  (none))
+
+(defstate ios-fish-manager-run (ios-fish-manager)
+  :trans
+    (behavior ()
+      (cond
+        ((or (!= *ios-ocean-fish* #t)
+             (not *target*)
+             (not *ocean-map*)
+             (movie?)
+             (level-get *level* 'title)
+             ;; under Lost Precursor City's ocean, not the sea
+             (< (-> (target-pos 0) y) (meters -30)))
+         (set! *ios-fish-at-sea* #f)
+         (set! (-> *ios-fish-vol-list* count) 0)
+         (ios-fish-manager-clear))
+        (else
+         (when (time-elapsed? (-> self sea-time) (seconds 0.15))
+           (set-time! (-> self sea-time))
+           (set! *ios-fish-at-sea* (ios-fish-jak-at-sea? self)))
+         (when (time-elapsed? (-> self vol-time) (seconds 1))
+           (set-time! (-> self vol-time))
+           (ios-fish-refresh-vols))
+         (when (and (time-elapsed? (-> self spawn-time) (seconds 0.3))
+                    (< (- (-> (target-pos 0) y) (ios-fish-jak-surface (target-pos 0))) IOS_FISH_JAK_ABOVE_SEA))
+           (set-time! (-> self spawn-time))
+           (ios-fish-manager-try-spawn)))))
+  :code
+    (behavior ()
+      (loop
+        (suspend))))
+
+;; ---- can fish ------------------------------------------------------------------------------------------------
+;; User 2026-10-18: standing on shores that looked close enough to the water often didn't allow fishing. Was: fish
+;; water exactly 4 m away in 8 fixed directions, Jak at most 6 m above the sea, not while wading. Now: rings out to
+;; 12 m, checked in the directions nearest Jak's facing first, up to 10 m above the water, wading counts, and the
+;; direction found is kept (*ios-fish-water-yaw*) so fishing starts facing the water.
+
+(defconstant IOS_FISH_CAST_REACH (meters 12)) ;; fishable water must be this close to Jak (xz)
+(defconstant IOS_FISH_REACH_STEP (meters 4))  ;; rings at 4, 8 and 12 m
+(defconstant IOS_FISH_MAX_ABOVE (meters 10))  ;; Jak at most this high above the water (docks, rocks, low cliffs)
+
+(define *ios-can-fish-time* (the-as time-frame 0))
+;; world yaw (atan x z) from Jak to the fishable water found last
+(define *ios-fish-water-yaw* 0.0)
+
+(defun ios-fish-standing? ()
+  "Jak standing, walking or wading on his own feet (not swimming, ducking, jumping, grabbed, at the boat wheel)."
+  (let ((state (-> *target* next-state)))
+    (and state
+         (!= *ios-boat-driving* #t)
+         (member (-> state name)
+                 '(target-stance target-walk target-turn-around target-stance-look-around target-stance-ambient
+                   target-wade-stance target-wade-walk)))))
+
+(defun ios-fish-near-water? ((proc process))
+  "Water deep enough for fish within IOS_FISH_CAST_REACH of Jak, with Jak at most IOS_FISH_MAX_ABOVE above it: a
+   shore, a dock, the boat's deck or shallows he wades in. Sets *ios-fish-water-yaw*."
+  (let* ((pos (target-pos 0))
+         (above (- (-> pos y) (ios-fish-jak-surface pos))))
+    (and (< (meters -1.5) above)
+         (< above IOS_FISH_MAX_ABOVE)
+         (let* ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> *target* control quat)))
+                (facing (atan (-> fwd x) (-> fwd z)))
+                (test (new 'stack-no-clear 'vector))
+                (col (new 'stack-no-clear 'vector))
+                (found #f))
+           ;; directions 0, +45, -45, +90, -90, +135, -135, 180 degrees from his facing; nearest ring first
+           (dotimes (k 8)
+             (let ((yaw (+ facing (* 8192.0 (the float (* (if (logtest? k 1) 1 -1) (/ (+ k 1) 2)))))))
+               (dotimes (ring 3)
+                 (when (not found)
+                   (let ((dist (* IOS_FISH_REACH_STEP (the float (+ ring 1)))))
+                     (set-vector! test (+ (-> pos x) (* dist (sin yaw))) 0.0 (+ (-> pos z) (* dist (cos yaw))) 1.0)
+                     (when (ios-fish-water-column test proc col)
+                       (set! found #t)
+                       (set! *ios-fish-water-yaw* yaw)))))))
+           found))))
+
+(defun ios-fish-update-can-fish ((on basic))
+  "*ios-can-fish*, rechecked about 4 times a second (the probes aren't free)."
+  (cond
+    ((not (and on *target* *ocean-map* (not (movie?)) (ios-fish-manager-get)))
+     (set! *ios-can-fish* #f))
+    ((time-elapsed? *ios-can-fish-time* (seconds 0.25))
+     (set! *ios-can-fish-time* (current-time))
+     (set! *ios-can-fish* (if (and (ios-fish-standing?) (ios-fish-near-water? (ios-fish-manager-get))) #t #f))))
+  0)
+
+;; ---- per frame -----------------------------------------------------------------------------------------------
+
+(defun ios-ocean-fish-update ()
+  (let ((on (and (= *ios-ocean-fish* #t) *target* (not (level-get *level* 'title)))))
+    (if (and on (not (ios-fish-manager-get))) (process-spawn ios-fish-manager :to *entity-pool*))
+    ;; no manager (just removed by a death's reset-actors, or off): normal water
+    (set! *ios-clear-ocean* (if (and on (ios-fish-manager-get) *ios-fish-at-sea*) #t #f))
+    (ios-fish-update-can-fish on))
+  0)
+
+;; Chain into *menu-hook* (after ios-dynamic-save's). This file's top-level only runs once, at boot.
+(define *ios-fish-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-fish-menu-hook ()
+  (ios-ocean-fish-update)
+  (*ios-fish-prev-menu-hook*)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-fish-menu-hook))
diff --git a/goal_src/jak1/pc/ios/ios-open-ocean.gc b/goal_src/jak1/pc/ios/ios-open-ocean.gc
new file mode 100644
index 000000000..3e37482a4
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-open-ocean.gc
@@ -0,0 +1,3105 @@
+;;-*-Lisp-*-
+(in-package goal)
+(require "engine/ui/progress/progress.gc")
+(require "engine/ui/progress/progress-draw.gc")
+(require "engine/target/logic-target.gc")
+(require "engine/common-obs/collectables.gc")
+(require "engine/common-obs/crates.gc")
+(require "engine/common-obs/water.gc")
+
+;; og:ios Open Ocean "level" (open-ocean-plan.md phase 0, user 2026-10-19), behind the experimental option OPEN OCEAN
+;; LEVEL (*ios-open-ocean-level*). With it off nothing here runs and the page stays closed; the ocean's progress is
+;; still kept in saves.
+;;
+;; The sea between the islands is treated as its own level: once Jak is farther out than every surrounding level's
+;; territory he is in the Open Ocean, and the pause menu gets an OPEN OCEAN page with its own orbs (500), scout flies
+;; (7) and power cells (6: five from drifting barrels, one for all seven flies; user 2026-10-23, was 8). Undiscovered
+;; cells read "???".
+;;
+;; The stock task table can't hold them: *game-info* task-perm-list is allocated with 116 entries in the captured
+;; image (game-info.gc), and money-per-level is a uint8 (max 255). So the ocean's progress is kept by the host in the
+;; save file's bank header (Jak1MemoryCardManager, "iOSO", next to the fishing log) and mirrored into
+;; *ios-ocean-progress* every frame. The ocean page is *level-task-data* entry 16 (the relinked progress-static still
+;; ends with the parked Eroded Coast entry; it is replaced here), drawn by the wrappers below. Ocean items are a
+;; separate bonus: calculate-completion and the stock totals ignore the page (user decision).
+;;
+;; progress, progress-draw and logic-target are captured engine objects on iOS, so this file is linked as a startup
+;; object (aot_level_code_link.py --startup-object ios-open-ocean, LAST, after ios-fishing). Its top-level runs once
+;; at boot: it installs the page, wraps the progress functions/methods and chains the per-frame update into
+;; *menu-hook*.
+
+;; set by the host every frame (OpenGOALRuntimeHost.mm SyncOpenOceanLevel)
+(define-perm *ios-open-ocean-level* symbol #f)
+;; experimental option STORMS (OpenGOALRuntimeHost.mm SyncStormsOption): the Open Ocean's storms also come, more
+;; rarely, over Sandover, Sentinel Beach, Forbidden Jungle, Misty Island and Geyser Rock (weather, below). Works
+;; with OPEN OCEAN LEVEL off too.
+(define-perm *ios-storms* symbol #f)
+
+;; weather (phase 5, defined below)
+(define-extern *ios-ocean-storm* float)
+(define-extern *ios-ocean-rain* float)
+
+(defconstant IOS_OCEAN_PAGE 16)          ;; *level-task-data* index of the ocean page
+(defconstant IOS_OCEAN_GLACIER_PAGE 17)  ;; the Glacier mod level's page (ios-glacier.gc IOS_OCEAN_GLACIER_PAGE)
+(define-extern *ios-glacier-warp* symbol)
+(defconstant IOS_OCEAN_ORB_TOTAL 500)
+(defconstant IOS_OCEAN_FLY_TOTAL 7)
+(defconstant IOS_OCEAN_CELL_TOTAL 6)
+(defconstant IOS_OCEAN_BARREL_CELLS 5)   ;; cells 0-4 come from drifting barrels
+(defconstant IOS_OCEAN_FLY_CELL 5)       ;; cell 5 (the last) is the reward for all seven scout flies (user 2026-10-23)
+(defconstant IOS_OCEAN_CELL_MASK #x3f)
+(defconstant IOS_OCEAN_OLD_FLY_CELL_BIT #x80) ;; saves from the 8-cell layout kept the fly cell in bit 7
+
+;; text ids (game_custom_text_*.json)
+(defconstant IOS_OCEAN_TEXT_LEVEL_NAME #x1670)  ;; OPEN OCEAN
+(defconstant IOS_OCEAN_TEXT_BARREL_CELL #x1671) ;; FIND IN DRIFTING BARREL
+(defconstant IOS_OCEAN_TEXT_UNKNOWN #x1672)     ;; ???
+(defconstant IOS_OCEAN_TEXT_RUIN_CELL #x1674)   ;; SOLVE THE PRECURSOR RUIN
+;; The Precursor ruin's tile puzzle (phase 7b, ruin disabled) no longer awards a cell (user 2026-10-23: 6 cells, five
+;; barrels + the fly cell); -1 = none.
+(defconstant IOS_OCEAN_RUIN_CELL -1)
+
+;; The ocean's progress, kept by the host (OpenGOALRuntimeHost.mm SyncOpenOcean). orbs/flies/cells/visited are
+;; the save's values, written by the host after every frame. GOAL never writes them: it adds to the add-* fields,
+;; which the host folds into the save and clears. Bits: flies 0-6, cells 0-5.
+(deftype ios-ocean-progress (structure)
+  ((orbs        int32)
+   (flies       uint32)
+   (cells       uint32)
+   (visited     int32)
+   (add-orbs    int32)
+   (add-flies   uint32)
+   (add-cells   uint32)
+   (add-visited int32)
+   (ready       int32)    ;; 1 once the host wrote the save's values
+   (in-ocean    int32)))  ;; 1 while Jak is in the Open Ocean (written by GOAL, read by the host)
+
+(define-perm *ios-ocean-progress* ios-ocean-progress (new 'global 'ios-ocean-progress))
+
+;; The Open Ocean's long-lived processes. Handles are 64 bits (process pointer + pid) but a global symbol holds 32,
+;; so a handle kept in a symbol loses its pid and never matches again (that respawned these every frame: hundreds of
+;; spawners and gulls, the sound RPC buffer overflowed, crash 2026-10-19). They live in this structure instead.
+(deftype ios-ocean-handles (structure)
+  ((music    handle)
+   (ambience handle)
+   (spawner  handle)
+   (weather  handle)))
+
+(define-perm *ios-ocean-handles* ios-ocean-handles (new 'global 'ios-ocean-handles))
+
+(set! (-> *ios-ocean-handles* music) (the-as handle #f))
+(set! (-> *ios-ocean-handles* ambience) (the-as handle #f))
+(set! (-> *ios-ocean-handles* spawner) (the-as handle #f))
+(set! (-> *ios-ocean-handles* weather) (the-as handle #f))
+
+(let ((p *ios-ocean-progress*))
+  (set! (-> p orbs) 0)
+  (set! (-> p flies) (the-as uint 0))
+  (set! (-> p cells) (the-as uint 0))
+  (set! (-> p visited) 0)
+  (set! (-> p add-orbs) 0)
+  (set! (-> p add-flies) (the-as uint 0))
+  (set! (-> p add-cells) (the-as uint 0))
+  (set! (-> p add-visited) 0)
+  (set! (-> p ready) 0)
+  (set! (-> p in-ocean) 0))
+
+(defun ios-ocean-bit-count ((bits uint))
+  (let ((n 0))
+    (dotimes (i 8)
+      (if (logtest? bits (ash 1 i)) (+! n 1)))
+    n))
+
+(defun ios-ocean-orbs ()
+  "Orbs collected in the Open Ocean (save + this frame's)."
+  (min IOS_OCEAN_ORB_TOTAL (+ (-> *ios-ocean-progress* orbs) (-> *ios-ocean-progress* add-orbs))))
+
+(defun ios-ocean-flies ()
+  "Scout fly bits (0-6)."
+  (logior (-> *ios-ocean-progress* flies) (-> *ios-ocean-progress* add-flies)))
+
+(defun ios-ocean-cells ()
+  "Power cell bits (0-5). An old save's fly cell (bit 7) counts as the fly cell (bit 5)."
+  (let ((bits (logior (-> *ios-ocean-progress* cells) (-> *ios-ocean-progress* add-cells))))
+    (if (logtest? bits IOS_OCEAN_OLD_FLY_CELL_BIT) (set! bits (logior bits (ash 1 IOS_OCEAN_FLY_CELL))))
+    (logand IOS_OCEAN_CELL_MASK bits)))
+
+(defun ios-ocean-cell-collected? ((index int))
+  (and (>= index 0) (logtest? (ios-ocean-cells) (ash 1 index))))
+
+(defun ios-ocean-visited? ()
+  (or (nonzero? (-> *ios-ocean-progress* visited)) (nonzero? (-> *ios-ocean-progress* add-visited))))
+
+(defun ios-in-open-ocean? ()
+  (nonzero? (-> *ios-ocean-progress* in-ocean)))
+
+;; ---- the pause menu page -------------------------------------------------------------------------------------
+
+(defun ios-ocean-make-task ((name text-id))
+  "A page entry: name 0 is shown until the cell is collected, name 1 after."
+  (let ((info (new 'global 'task-info-data)))
+    (set! (-> info task-id) (game-task none))
+    (set! (-> info task-name 0) (the-as text-id IOS_OCEAN_TEXT_UNKNOWN))
+    (set! (-> info task-name 1) name)
+    (set! (-> info task-name 2) name)
+    (set! (-> info task-name 3) (text-id zero))
+    (set! (-> info text-index-when-resolved) 1)
+    info))
+
+(define-perm *ios-ocean-level-tasks* level-tasks-info
+  (let ((page (new 'global 'level-tasks-info)))
+    (set! (-> page level-name-id) (the-as text-id IOS_OCEAN_TEXT_LEVEL_NAME))
+    (set! (-> page text-group-index) 1)
+    (set! (-> page nb-of-tasks) IOS_OCEAN_CELL_TOTAL)
+    (set! (-> page buzzer-task-index) IOS_OCEAN_FLY_CELL)
+    (dotimes (i IOS_OCEAN_CELL_TOTAL)
+      (set! (-> page task-info i)
+            (ios-ocean-make-task (if (= i IOS_OCEAN_FLY_CELL)
+                                     (text-id beach-buzzer) ;; FREE 7 SCOUT FLIES
+                                     (the-as text-id IOS_OCEAN_TEXT_BARREL_CELL)))))
+    page))
+
+;; The relinked progress-static ends with a placeholder for this page (16) and the Glacier mod level's page (17).
+(when (> (-> *level-task-data* allocated-length) IOS_OCEAN_PAGE)
+  (set! (-> *level-task-data* IOS_OCEAN_PAGE) *ios-ocean-level-tasks*)
+  (set! (-> *level-task-data* length) (max (-> *level-task-data* length) (+ IOS_OCEAN_PAGE 1))))
+
+(defun ios-ocean-page? ((lev-idx int))
+  (and (= lev-idx IOS_OCEAN_PAGE) (= (-> *level-task-data* IOS_OCEAN_PAGE) *ios-ocean-level-tasks*)))
+
+;; the captured stock functions and methods (define-perm: never wrap the wrapper)
+(define-perm *ios-ocean-stock-draw-fuel-cell-screen* (function progress int none)
+  (the-as (function progress int none) (method-of-type progress draw-fuel-cell-screen)))
+(define-perm *ios-ocean-stock-draw-money-screen* (function progress int none)
+  (the-as (function progress int none) (method-of-type progress draw-money-screen)))
+(define-perm *ios-ocean-stock-draw-buzzer-screen* (function progress int none)
+  (the-as (function progress int none) (method-of-type progress draw-buzzer-screen)))
+(define-perm *ios-ocean-stock-get-next-task-up* (function int int int) get-next-task-up)
+(define-perm *ios-ocean-stock-get-next-task-down* (function int int int) get-next-task-down)
+(define-perm *ios-ocean-stock-activate-progress* (function process progress-screen none) activate-progress)
+
+;; Stock draw-fuel-cell-screen (progress-draw.gc) for the ocean page: every cell can be highlighted, a collected
+;; cell shows as got with its name and TASK COMPLETED, the others as unknown with "???".
+(defun ios-ocean-draw-fuel-cell-screen ((this progress))
+  (hide-progress-icons)
+  (let ((s5-0 *ios-ocean-level-tasks*))
+    (set! (-> *progress-process* 0 particles 14 init-pos x) -320.0)
+    (set! (-> *progress-process* 0 particles 15 init-pos x) -320.0)
+    (set! (-> *progress-process* 0 icons 4 icon-x) -320)
+    (let ((sv-112 (- (-> *task-egg-starting-x* (-> s5-0 nb-of-tasks)) (-> this left-x-offset)))
+          (sv-128 (the int (* 47.0 (-> this transition-percentage-invert)))))
+      (let ((s0-0 6)
+            (s2-0 0)
+            (s4-1 (if (= (-> this level-transition) 1) (- (-> this transition-offset)) (-> this transition-offset)))
+            (f30-0 (-> this transition-percentage-invert))
+            (s1-0 0)
+            (s3-0 #f))
+        (when (-> this stat-transition)
+          (set! sv-128 47)
+          (set! s2-0
+                (if (!= (-> this display-state) (-> this next-display-state)) (- (-> this transition-offset)) (-> this transition-offset)))
+          (set! s4-1 0)
+          (set! f30-0 1.0))
+        (dotimes (i 4)
+          (let ((a0-18 (-> this icons i icon 0 root)))
+            (set-yaw-angle-clear-roll-pitch! a0-18 (+ (y-angle a0-18) (* 182.04445 (/ (-> *display* time-adjust-ratio) 2))))))
+        (let ((sv-192 (+ sv-112 (/ (- (* 47 (-> s5-0 nb-of-tasks)) (* sv-128 (-> s5-0 nb-of-tasks))) 2))))
+          (dotimes (sv-208 (-> s5-0 nb-of-tasks))
+            (let* ((got (ios-ocean-cell-collected? sv-208))
+                   (name-index (if got 1 0)))
+              (set! (-> this particle-state s0-0) (if got 3 1))
+              (set! (-> this particles s0-0 init-pos x) (the float (+ sv-192 s2-0)))
+              (set! (-> this particles s0-0 init-pos y) (the float (+ s4-1 204)))
+              (+! s0-0 1)
+              (when (= sv-208 (-> this task-index))
+                (set! s1-0 name-index)
+                (set! s3-0 got)
+                (set! (-> this particles 5 init-pos x) (the float (+ sv-192 s2-0)))
+                (set! (-> this particles 5 init-pos y) (the float (+ s4-1 204)))))
+            (+! sv-192 sv-128)))
+        (dotimes (v1-77 (- 8 (-> s5-0 nb-of-tasks)))
+          (set! (-> *progress-process* 0 particles s0-0 init-pos x) (the float (+ s2-0 -320)))
+          (set! (-> this particles s0-0 init-pos y) (the float (+ s4-1 194)))
+          (+! s0-0 1))
+        (when (and *common-text* (>= (-> this task-index) 0) (< (-> this task-index) (-> s5-0 nb-of-tasks)))
+          (let ((s0-1 (new 'stack
+                           'font-context
+                           *font-default-matrix*
+                           (- (+ s2-0 32) (-> this left-x-offset))
+                           (+ (/ s4-1 2) 125)
+                           8325000.0
+                           (font-color progress-yellow)
+                           (font-flags shadow kerning))))
+            (set-width! s0-1 328)
+            (set-height! s0-1 50)
+            (set-scale! s0-1 0.7)
+            (set! (-> s0-1 flags) (font-flags shadow kerning middle middle-vert large))
+            (print-game-text-scaled (lookup-text! *common-text* (-> s5-0 task-info (-> this task-index) task-name s1-0) #f)
+                                    f30-0
+                                    s0-1
+                                    (the int (* 128.0 f30-0)))
+            (when s3-0
+              (set! (-> s0-1 origin x) (the float (- (+ s2-0 32) (-> this left-x-offset))))
+              (set! (-> s0-1 origin y) (the float (+ (/ s4-1 2) 175)))
+              (set! (-> s0-1 color) (font-color progress-blue))
+              (set-height! s0-1 15)
+              (set-scale! s0-1 0.5)
+              (print-game-text-scaled (lookup-text! *common-text* (text-id task-completed) #f) f30-0 s0-1 (the int (* 128.0 f30-0)))))))))
+  0)
+
+;; Stock draw-money-screen / draw-buzzer-screen (progress-draw.gc) with the ocean's counts. The TOTAL COLLECTED line
+;; stays the stock game total (ocean items are a separate bonus).
+(defun ios-ocean-draw-count-screen ((this progress) (orbs? symbol))
+  (hide-progress-icons)
+  (let* ((v1-1 (/ (-> this transition-offset) 16))
+         (s4-0 (if (= (-> this level-transition) 1) (- (-> this transition-offset)) (-> this transition-offset)))
+         (f30-0 (-> this transition-percentage-invert))
+         (s3-0 (- v1-1)))
+    (when (-> this stat-transition)
+      (set! v1-1
+            (if (!= (-> this display-state) (-> this next-display-state)) (- (-> this transition-offset)) (-> this transition-offset)))
+      (set! s3-0 v1-1)
+      (set! s4-0 0)
+      (set! f30-0 1.0))
+    (cond
+      (orbs?
+       (set! (-> this particles 15 init-pos x) (the float (- (+ v1-1 150) (-> this left-x-offset))))
+       (set! (-> this particles 15 init-pos y) (the float (+ s4-0 214)))
+       (set! (-> this icons 4 icon-x) (- (+ v1-1 148) (-> this left-x-offset)))
+       (set! (-> this icons 4 icon-y) (+ (-> this big-orb-y-offset) s4-0))
+       (let ((a0-15 (-> this icons 4 icon 0 root)))
+         (set-yaw-angle-clear-roll-pitch! a0-15 (- (y-angle a0-15) (* 182.04445 (* 4.0 (-> *display* time-adjust-ratio)))))))
+      (else
+       (set! (-> this particles 14 init-pos x) (the float (- (+ v1-1 150) (-> this left-x-offset))))
+       (set! (-> this particles 14 init-pos y) (the float (+ s4-0 214)))))
+    (let ((s4-1 (new 'stack
+                     'font-context
+                     *font-default-matrix*
+                     (- (+ s3-0 200) (-> this left-x-offset))
+                     (+ (/ s4-0 2) 96)
+                     8325000.0
+                     (font-color default)
+                     (font-flags shadow kerning))))
+      (set-width! s4-1 328)
+      (set-height! s4-1 70)
+      (set! (-> s4-1 flags) (font-flags shadow kerning large))
+      (if orbs?
+        (format (clear *temp-string*) "~D/~D" (ios-ocean-orbs) IOS_OCEAN_ORB_TOTAL)
+        (format (clear *temp-string*) "~D/~D" (ios-ocean-bit-count (ios-ocean-flies)) IOS_OCEAN_FLY_TOTAL))
+      (print-game-text-scaled *temp-string* f30-0 s4-1 (the int (* 128.0 f30-0)))
+      (set-width! s4-1 428)
+      (+! (-> s4-1 origin x) -220.0)
+      (+! (-> s4-1 origin y) 40.0)
+      (set! (-> s4-1 flags) (font-flags shadow kerning middle large))
+      (print-game-text-scaled (lookup-text! *common-text* (text-id total-collected) #f)
+                              (* 0.7 f30-0)
+                              s4-1
+                              (the int (* 128.0 f30-0)))
+      (+! (-> s4-1 origin y) 15.0)
+      (if orbs?
+        (format (clear *temp-string*) "~D/~D" (the int (-> *game-info* money-total)) (-> this total-nb-of-orbs))
+        (format (clear *temp-string*) "~D/~D" (the int (-> *game-info* buzzer-total)) (-> this total-nb-of-buzzers)))
+      (print-game-text-scaled *temp-string* f30-0 s4-1 (the int (* 128.0 f30-0)))))
+  0)
+
+(defmethod draw-fuel-cell-screen ((this progress) (arg0 int))
+  (if (ios-ocean-page? arg0)
+    (ios-ocean-draw-fuel-cell-screen this)
+    (*ios-ocean-stock-draw-fuel-cell-screen* this arg0))
+  0
+  (none))
+
+(defmethod draw-money-screen ((this progress) (arg0 int))
+  (if (ios-ocean-page? arg0)
+    (ios-ocean-draw-count-screen this #t)
+    (*ios-ocean-stock-draw-money-screen* this arg0))
+  0
+  (none))
+
+(defmethod draw-buzzer-screen ((this progress) (arg0 int))
+  (if (ios-ocean-page? arg0)
+    (ios-ocean-draw-count-screen this #f)
+    (*ios-ocean-stock-draw-buzzer-screen* this arg0))
+  0
+  (none))
+
+;; Stock skips cells it doesn't know about; on the ocean page every cell can be highlighted (it shows "???").
+(defun get-next-task-up ((cur-task-idx int) (lev-idx int))
+  (if (ios-ocean-page? lev-idx)
+    (if (< (+ cur-task-idx 1) (-> *ios-ocean-level-tasks* nb-of-tasks)) (+ cur-task-idx 1) (max 0 cur-task-idx))
+    (*ios-ocean-stock-get-next-task-up* cur-task-idx lev-idx)))
+
+(defun get-next-task-down ((cur-task-idx int) (lev-idx int))
+  (if (ios-ocean-page? lev-idx)
+    (if (> cur-task-idx 0) (+ cur-task-idx -1) cur-task-idx)
+    (*ios-ocean-stock-get-next-task-down* cur-task-idx lev-idx)))
+
+;; Stock make-levels-with-tasks-available-to-progress (progress.gc) over the stock pages only; the ocean page is
+;; open once Jak has been in the Open Ocean in this save (and the option is on). (level-opened 16 is in the save file, but the parked
+;; Eroded Coast may have set it, so it is always rewritten from the host's flag.)
+(defun make-levels-with-tasks-available-to-progress ()
+  (dotimes (i (min IOS_OCEAN_PAGE (length *level-task-data*)))
+    (let ((tasks (-> *level-task-data* i)))
+      (unless (or (= tasks #f) (= (-> *game-info* level-opened i) 1))
+        (cond
+          ((!= *kernel-boot-message* 'play)
+           (if (= (-> tasks level-name-id) (text-id misty-level-name)) (set! (-> *game-info* level-opened i) (the-as uint 1))))
+          (*cheat-mode* (set! (-> *game-info* level-opened i) (the-as uint 1)))
+          (else
+           (dotimes (ii (-> tasks nb-of-tasks))
+             (if (and (zero? (-> *game-info* level-opened ii))
+                      (!= ii (-> tasks buzzer-task-index))
+                      (task-known? (-> tasks task-info ii task-id)))
+               (set! (-> *game-info* level-opened ii) (the-as uint 1)))))))))
+  (when (ios-ocean-page? IOS_OCEAN_PAGE)
+    (set! (-> *game-info* level-opened IOS_OCEAN_PAGE)
+          (the-as uint (if (and *ios-open-ocean-level* (= *kernel-boot-message* 'play) (ios-ocean-visited?)) 1 0))))
+  ;; the Glacier mod level's page (ios-glacier.gc): open while its warp gate slot is (like the ocean page, a
+  ;; bonus outside the stock totals)
+  (when (> (length *level-task-data*) IOS_OCEAN_GLACIER_PAGE)
+    (set! (-> *game-info* level-opened IOS_OCEAN_GLACIER_PAGE)
+          (the-as uint (if (and *ios-glacier-warp* (= *kernel-boot-message* 'play)) 1 0))))
+  0
+  (none))
+
+;; Stock calculate-completion (progress.gc) over the stock pages only: ocean items don't count toward 100%.
+(defun calculate-completion ((the-progress progress))
+  (let ((current-cells 0)
+        (current-buzzers 0)
+        (current-orbs 0)
+        (total-cells 0)
+        (total-buzzers 0)
+        (total-orbs 0))
+    (dotimes (s5-0 (min IOS_OCEAN_PAGE (length *level-task-data*)))
+      (let ((s4-0 (-> *level-task-data* s5-0)))
+        (when (!= s4-0 #f)
+          (when (or (= *kernel-boot-message* 'play) (= (-> s4-0 level-name-id) (text-id misty-level-name)))
+            (dotimes (s3-0 (-> s4-0 nb-of-tasks))
+              (if (= (get-task-status (-> s4-0 task-info s3-0 task-id)) (task-status invalid)) (1+! current-cells)))
+            (set! total-cells (+ total-cells (-> s4-0 nb-of-tasks)))
+            (set! current-orbs (+ current-orbs (-> *game-info* money-per-level s5-0)))
+            (set! total-orbs (+ total-orbs (-> *game-counts* data s5-0 money-count)))
+            (let ((v1-20 (-> s4-0 buzzer-task-index)))
+              (when (!= v1-20 -1)
+                (set! current-buzzers (+ current-buzzers (buzzer-count *game-info* (-> s4-0 task-info v1-20 task-id))))
+                (set! total-buzzers (+ total-buzzers (-> *game-counts* data s5-0 buzzer-count)))))))))
+    (when the-progress
+      (set! (-> the-progress total-nb-of-power-cells) total-cells)
+      (set! (-> the-progress total-nb-of-buzzers) total-buzzers)
+      (set! (-> the-progress total-nb-of-orbs) total-orbs))
+    (+ (/ (* 80.0 (the float current-cells)) (the float total-cells))
+       (/ (* 10.0 (the float current-orbs)) (the float total-orbs))
+       (/ (* 10.0 (the float current-buzzers)) (the float total-buzzers)))))
+
+;; Pausing in the Open Ocean opens the collectibles on the ocean page (stock picks Jak's current level, which out
+;; at sea is whichever level the boat keeps loaded).
+(defun activate-progress ((creator process) (screen progress-screen))
+  (let ((fresh (not *progress-process*)))
+    (*ios-ocean-stock-activate-progress* creator screen)
+    (when (and fresh
+               *progress-process*
+               (= *kernel-boot-message* 'play)
+               (ios-in-open-ocean?)
+               (ios-ocean-page? IOS_OCEAN_PAGE)
+               (= (-> *game-info* level-opened IOS_OCEAN_PAGE) 1))
+      (set! (-> *progress-process* 0 display-level-index) IOS_OCEAN_PAGE)
+      (set! (-> *progress-process* 0 next-level-index) IOS_OCEAN_PAGE)
+      (set! (-> *progress-process* 0 task-index) (get-next-task-up -1 IOS_OCEAN_PAGE))))
+  0
+  (none))
+
+;; ---- the boundary ----------------------------------------------------------------------------------------------
+;;
+;; Every level around the sea has a territory: a circle around its land (centre x, z and land radius in meters,
+;; from the ocean manager's island zones in fishermans-boat.gc) widened by the same margin for every level, so the
+;; boundary is the same distance out from each of them. Outside all of them is the Open Ocean. Leaving the ocean
+;; needs IOS_OPEN_OCEAN_HYSTERESIS more, so riding along the line doesn't flicker.
+
+(defconstant IOS_OPEN_OCEAN_MARGIN (meters 120))
+;; Rock Village, Boggy Swamp and Precursor City (zones 5-7): their land only, no margin, so the sea around Rock Village
+;; is Open Ocean too (barrels, flies, gulls, the serpent) -- the whole sea is one area (user 2026-10-21)
+(defconstant IOS_OPEN_OCEAN_SOUTH_MARGIN (meters 0))
+(defconstant IOS_OPEN_OCEAN_FIRST_SOUTH 5)
+(defconstant IOS_OPEN_OCEAN_HYSTERESIS (meters 15))
+
+;; x z land-radius (meters) per level, in the order of ios-open-ocean-zone-name
+(define *ios-open-ocean-zones*
+  (new 'static 'boxed-array :type float
+       0.0     40.0   210.0   ;; Sandover Village (village1)
+       -320.0  -310.0 160.0   ;; Sentinel Beach
+       360.0   -240.0 210.0   ;; Forbidden Jungle
+       0.0     1000.0 210.0   ;; Misty Island
+       -1230.0 1000.0 130.0   ;; Geyser Rock (training)
+       340.0   -1630.0 210.0  ;; Rock Village (village2)
+       480.0   -2000.0 210.0  ;; Boggy Swamp
+       700.0   -1600.0 130.0  ;; Lost Precursor City (sunken)
+       1095.0  -850.0 380.0   ;; Glacier (mod level, ios-glacier.gc, moved east of the coast): only while *ios-glacier-warp*
+       ))
+(defconstant IOS_OPEN_OCEAN_GLACIER_ZONE 8)
+
+(defun ios-ocean-in-glacier? ()
+  "Jak inside the Glacier mod level's fog ring (it lies out east of the coast)."
+  (and (= *ios-glacier-warp* #t) *target*
+       (let ((dx (- (-> *target* control trans x) (meters 1095.0)))
+             (dz (- (-> *target* control trans z) (meters -850.0))))
+         ;; its fog ring (fishermans-boat.gc IOS_GLACIER_FOG_RING)
+         (< (sqrtf (+ (* dx dx) (* dz dz))) (meters 640.0)))))
+
+(defun ios-open-ocean-zone-name ((zone int))
+  (case zone
+    ((0) "SANDOVER")
+    ((1) "SENTINEL BEACH")
+    ((2) "FORBIDDEN JUNGLE")
+    ((3) "MISTY ISLAND")
+    ((4) "GEYSER ROCK")
+    ((5) "ROCK VILLAGE")
+    ((6) "BOGGY SWAMP")
+    ((7) "PRECURSOR CITY")
+    ((8) "GLACIER")
+    (else "?")))
+
+;; on-screen readout of the region and the distance to the line, for tuning on device (open-ocean-plan.md 0b)
+(define-perm *ios-open-ocean-debug* symbol #f)  ;; off (user 2026-10-21: boundary tuned)
+;; storms, the serpent and the ruin come much sooner (testing only; user 2026-10-21: too common with it on)
+(define-perm *ios-open-ocean-fast* symbol #f)
+(define *ios-open-ocean-nearest* 0)
+(define *ios-open-ocean-edge* 0.0) ;; distance to the nearest territory's line (game units, > 0 outside it)
+
+(defun ios-open-ocean-measure ((pos vector))
+  "Sets *ios-open-ocean-nearest* / -edge for pos; returns the edge distance."
+  (let ((zones *ios-open-ocean-zones*)
+        (best 0)
+        (best-edge 0.0))
+    (dotimes (i (if (= *ios-glacier-warp* #t) (/ (length zones) 3) IOS_OPEN_OCEAN_GLACIER_ZONE))
+      (let* ((dx (- (-> pos x) (* 4096.0 (-> zones (* i 3)))))
+             (dz (- (-> pos z) (* 4096.0 (-> zones (+ (* i 3) 1)))))
+             (edge (- (sqrtf (+ (* dx dx) (* dz dz)))
+                      (+ (* 4096.0 (-> zones (+ (* i 3) 2)))
+                         (if (and (>= i IOS_OPEN_OCEAN_FIRST_SOUTH) (< i IOS_OPEN_OCEAN_GLACIER_ZONE))
+                             IOS_OPEN_OCEAN_SOUTH_MARGIN
+                             IOS_OPEN_OCEAN_MARGIN)))))
+        (when (or (zero? i) (< edge best-edge))
+          (set! best i)
+          (set! best-edge edge))))
+    (set! *ios-open-ocean-nearest* best)
+    (set! *ios-open-ocean-edge* best-edge)
+    best-edge))
+
+(defun ios-open-ocean-draw-debug ()
+  (let ((font (new 'stack 'font-context *font-default-matrix* 16 180 0.0 (font-color default) (font-flags shadow kerning))))
+    (set-scale! font 0.5)
+    (set-width! font 300)
+    (set-height! font 20)
+    (set! (-> font flags) (font-flags shadow kerning large))
+    (if (ios-in-open-ocean?)
+      (format (clear *temp-string*) "OPEN OCEAN  ~D M FROM ~S" (the int (/ *ios-open-ocean-edge* 4096.0))
+              (ios-open-ocean-zone-name *ios-open-ocean-nearest*))
+      (format (clear *temp-string*) "~S  ~D M TO OPEN OCEAN" (ios-open-ocean-zone-name *ios-open-ocean-nearest*)
+              (the int (/ (- *ios-open-ocean-edge*) 4096.0))))
+    (print-game-text *temp-string* font #f 128 22)
+    (when (< 0.0 *ios-ocean-storm*)
+      (+! (-> font origin y) 12.0)
+      (format (clear *temp-string*) "STORM ~D%  RAIN ~D%" (the int (* 100.0 *ios-ocean-storm*)) (the int (* 100.0 *ios-ocean-rain*)))
+      (print-game-text *temp-string* font #f 128 22)))
+  0)
+
+;; ---- music ---------------------------------------------------------------------------------------------------
+;;
+;; No music in the Open Ocean (user 2026-10-19; its ambience comes in phase 3): while Jak is out there the music
+;; volume fades to silence and stays there, so whatever the loaded levels want to play is never heard, then fades
+;; back once he is in a level's territory again. A setting needs a process to own it: ios-open-ocean-music holds a
+;; 'rel music-volume setting while the fade is below full and removes it after.
+
+(defconstant IOS_OPEN_OCEAN_MUSIC_FADE_OUT 3.0)  ;; seconds to silence
+(defconstant IOS_OPEN_OCEAN_MUSIC_FADE_IN 2.0)   ;; seconds back to full
+
+(deftype ios-open-ocean-music (process)
+  ((fade float))  ;; 1.0 = the level's music volume, 0.0 = silent
+  (:states
+   ios-open-ocean-music-idle))
+
+(defstate ios-open-ocean-music-idle (ios-open-ocean-music)
+  :code
+    (behavior ()
+      (loop
+        (if (ios-in-open-ocean?)
+          (seek! (-> self fade) 0.0 (/ (seconds-per-frame) IOS_OPEN_OCEAN_MUSIC_FADE_OUT))
+          (seek! (-> self fade) 1.0 (/ (seconds-per-frame) IOS_OPEN_OCEAN_MUSIC_FADE_IN)))
+        (if (< (-> self fade) 1.0)
+          (set-setting! 'music-volume 'rel (* 100.0 (-> self fade)) 0)
+          (remove-setting! 'music-volume))
+        (suspend))))
+
+(defbehavior ios-open-ocean-music-init-by-other ios-open-ocean-music ()
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! (-> self fade) 1.0)
+  (go ios-open-ocean-music-idle))
+
+(defun ios-open-ocean-music-ensure ()
+  (if (not (handle->process (-> *ios-ocean-handles* music)))
+    (set! (-> *ios-ocean-handles* music)
+          (ppointer->handle (process-spawn ios-open-ocean-music :init ios-open-ocean-music-init-by-other :to *entity-pool*))))
+  0)
+
+;; ---- weather (phase 5) ----------------------------------------------------------------------------------------
+;;
+;; Now and then a storm rolls over the Open Ocean (user 2026-10-19): the sky and the world darken slowly and a dark
+;; grey fog closes in, Boggy Swamp's rain starts (weather-part.gc update-rain: drops, splashes, drips on the camera),
+;; lightning flickers over everything with Rock Village's "thunder" after it, and the rain ("swamp-amb"), Rock
+;; Village's ambience and stronger wind join the sea sounds. It rains for a good while, then may stop at random and
+;; clears slowly. Only in the Open Ocean: leaving it fades the storm away (and back on return while it lasts).
+;;
+;; With the STORMS option (*ios-storms*, user 2026-10-23) the same storm also comes over the land levels in
+;; *ios-storm-levels* (Sandover, Sentinel Beach, Forbidden Jungle, Misty Island, Geyser Rock), rarer than at sea
+;; (IOS_LAND_STORM_*). Storms only START in the Open Ocean / those levels, but once one is on it carries over
+;; seamlessly to wherever Jak goes until it clears (user 2026-10-23), except into indoor levels
+;; (*ios-storm-dry-levels*: it fades there and is back outside). Drops stop on whatever is under them -- roofs,
+;; rocks, platforms, the ground, the sea (rain collision, below).
+;;
+;; How the sky darkens: the background and actors are drawn straight after update-time-of-day, inside the draw hook
+;; (drawable.gc real-main-draw-hook), so the storm has to act inside it. The update-time-of-day wrapper below puts
+;; ios-storm-mood-func in place of each loaded level's mood function while a storm is on: it runs the level's own
+;; mood, then darkens its palette weights (times w -> itimes, the background's time-of-day colours) and lights,
+;; pulls its fog in, turns its sky textures toward that level's night sky and hides the stars. Everything the stock
+;; code then does with the two moods (blend, sky textures, fog, sky base colour) carries the storm.
+
+(define *ios-ocean-storm* 0.0)  ;; 0..1 how stormy it is where Jak is (written by ios-ocean-weather)
+(define *ios-ocean-rain* 0.0)   ;; 0..1 how hard it rains
+(define *ios-ocean-flash* 0.0)  ;; 0..1 lightning flash this frame
+
+;; roughly 11-12 min of clear weather between storms (user 2026-10-23: 50 % every 45 s, was 8 % every 2 min);
+;; land storms use the same odds
+(defconstant IOS_STORM_CHECK (seconds 45))      ;; how often a storm may start ...
+(defconstant IOS_STORM_CHANCE 0.5)               ;; ... and how likely
+(defconstant IOS_STORM_COOLDOWN (seconds 600))  ;; clear time after a storm before the next may start
+(defconstant IOS_STORM_BUILD 30.0)              ;; seconds to darken fully / to clear
+(defconstant IOS_STORM_MIN (seconds 150))       ;; it rains at least this long ...
+(defconstant IOS_STORM_MAX (seconds 300))
+(defconstant IOS_STORM_END_CHECK (seconds 20))  ;; ... then may stop at each check
+(defconstant IOS_STORM_END_CHANCE 0.3)
+;; storms over land (STORMS option): the same odds as at sea (user 2026-10-23); kept separate for tuning
+(defconstant IOS_LAND_STORM_CHECK IOS_STORM_CHECK)
+(defconstant IOS_LAND_STORM_CHANCE IOS_STORM_CHANCE)
+(defconstant IOS_LAND_STORM_COOLDOWN IOS_STORM_COOLDOWN)
+(defconstant IOS_STORM_DARK 0.42)               ;; palette / light scale at full storm
+(defconstant IOS_STORM_FLASH 1.6)               ;; extra palette / light scale at a full lightning flash
+(defconstant IOS_STORM_FOG_START (meters 15))
+(defconstant IOS_STORM_FOG_END (meters 260))
+
+(define *ios-storm-fog-color* (new 'static 'vector :x 62.0 :y 66.0 :z 76.0 :w 128.0))
+(define *ios-storm-erase-color* (new 'static 'vector :x 48.0 :y 52.0 :z 62.0 :w 128.0))
+(define *ios-storm-flash-color* (new 'static 'vector :x 190.0 :y 196.0 :z 215.0 :w 128.0))
+
+;; the levels' own mood functions while ios-storm-mood-func stands in for them (one per level slot)
+(define *ios-storm-orig-mood-0* (the-as (function mood-context float int none) #f))
+(define *ios-storm-orig-mood-1* (the-as (function mood-context float int none) #f))
+
+;; each level slot's palette colour weights (times xyz) from before the storm, to darken from and restore
+(define-perm *ios-storm-saved-times* (inline-array vector) (new 'global 'inline-array 'vector 16))
+(define-perm *ios-storm-saved-ctx* (pointer mood-context) (the-as (pointer mood-context) (malloc 'global 8)))
+(set! (-> *ios-storm-saved-ctx* 0) (the-as mood-context #f))
+(set! (-> *ios-storm-saved-ctx* 1) (the-as mood-context #f))
+
+(defun ios-storm-saved-times ((m mood-context) (slot int))
+  "Level SLOT's saved times (8 vectors); saved first if the slot's mood isn't this one yet (a level loaded)."
+  (when (!= (-> *ios-storm-saved-ctx* slot) m)
+    (set! (-> *ios-storm-saved-ctx* slot) m)
+    (dotimes (i 8)
+      (set! (-> *ios-storm-saved-times* (+ (* 8 slot) i) quad) (-> m times i quad))))
+  (the-as (inline-array vector) (-> *ios-storm-saved-times* (* 8 slot))))
+
+(defun ios-storm-restore-times ((m mood-context))
+  "Puts a mood's saved colour weights back (storm over) and forgets it."
+  (dotimes (slot 2)
+    (when (and m (= (-> *ios-storm-saved-ctx* slot) m))
+      (dotimes (i 8)
+        (let ((t (-> m times i))
+              (base (-> *ios-storm-saved-times* (+ (* 8 slot) i))))
+          (set! (-> t x) (-> base x))
+          (set! (-> t y) (-> base y))
+          (set! (-> t z) (-> base z))))
+      (set! (-> *ios-storm-saved-ctx* slot) (the-as mood-context #f))))
+  0)
+
+(defun ios-storm-apply ((m mood-context) (slot int))
+  "Darkens one level's mood for the storm (after its mood function ran)."
+  (let* ((s *ios-ocean-storm*)
+         (f *ios-ocean-flash*)
+         (dark (+ (lerp 1.0 IOS_STORM_DARK s) (* f IOS_STORM_FLASH))))
+    ;; background colours: the time-of-day palette weights (reset by every mood function each frame). Only the colour
+    ;; part (xyz): update-mood-itimes gives the palette's rgb times.xyz * w but its ALPHA plain w, so scaling w faded
+    ;; out alpha-tested background (Sandover windmill's door frame flickered and vanished, user 2026-10-23).
+    ;; The mood functions never write xyz (clear-mood-times only resets w), so they are set from the level's own
+    ;; values saved when the storm took over (restored by ios-storm-hook-moods), not multiplied (that would compound).
+    (let ((saved (ios-storm-saved-times m (if (zero? slot) 0 1))))
+      (dotimes (i 8)
+        (let ((t (-> m times i))
+              (base (-> saved i)))
+          (set! (-> t x) (* dark (-> base x)))
+          (set! (-> t y) (* dark (-> base y)))
+          (set! (-> t z) (* dark (-> base z))))))
+    (update-mood-itimes m)
+    ;; actor lights
+    (dotimes (i 8)
+      (let ((lg (-> m light-group i)))
+        (set! (-> lg ambi levels x) (* dark (-> lg ambi levels x)))
+        (set! (-> lg dir0 levels x) (* dark (-> lg dir0 levels x)))
+        (set! (-> lg dir1 levels x) (* dark (-> lg dir1 levels x)))
+        (set! (-> lg dir2 levels x) (* dark (-> lg dir2 levels x)))))
+    (vector-float*! (-> m current-prt-color) (-> m current-prt-color) (lerp 1.0 0.6 s))
+    (vector-float*! (-> m current-sun sun-color) (-> m current-sun sun-color) (lerp 1.0 0.25 s))
+    (vector-float*! (-> m current-sun env-color) (-> m current-sun env-color) (lerp 1.0 0.5 s))
+    ;; fog and horizon: dark grey, closer; a flash lights them up
+    (let ((fog (-> m current-fog)))
+      (vector4-lerp! (-> fog fog-color) (-> fog fog-color) *ios-storm-fog-color* (* 0.85 s))
+      (vector4-lerp! (-> fog erase-color) (-> fog erase-color) *ios-storm-erase-color* (* 0.85 s))
+      (when (< 0.0 f)
+        (vector4-lerp! (-> fog fog-color) (-> fog fog-color) *ios-storm-flash-color* (* 0.5 f))
+        (vector4-lerp! (-> fog erase-color) (-> fog erase-color) *ios-storm-flash-color* (* 0.5 f)))
+      (set! (-> fog fog-dists x) (lerp (-> fog fog-dists x) IOS_STORM_FOG_START s))
+      (set! (-> fog fog-dists y) (lerp (-> fog fog-dists y) IOS_STORM_FOG_END s)))
+    ;; sky textures: toward the level's own night sky (its snapshots at 1 am), no stars
+    (let* ((h (-> m sky-texture-interp hour 1))
+           (a (-> h snapshot1))
+           (b (-> h snapshot2))
+           (t (* 0.8 s)))
+      (dotimes (i 8)
+        (let ((night (+ (if (= i a) (- 1.0 (-> h morph-start)) 0.0) (if (= i b) (-> h morph-start) 0.0))))
+          (set! (-> m sky-times i) (lerp (-> m sky-times i) night t)))))
+    (set! (-> m num-stars) (* (-> m num-stars) (- 1.0 s))))
+  0)
+
+(defun ios-storm-mood-func ((m mood-context) (time float) (slot int))
+  (let ((orig (if (zero? slot) *ios-storm-orig-mood-0* *ios-storm-orig-mood-1*)))
+    (if orig (orig m time slot)))
+  (ios-storm-apply m slot)
+  (none))
+
+(defun ios-storm-hook-moods ()
+  "While a storm is on, ios-storm-mood-func stands in for the loaded levels' mood functions (a level that loads
+   afresh brings its own back, which is taken over again here); with none, the levels' own are put back."
+  (dotimes (slot 2)
+    (let ((lev (-> *level* level slot)))
+      (cond
+        ((< 0.0 *ios-ocean-storm*)
+         (when (and (!= (-> lev mood-func) ios-storm-mood-func) (nonzero? (-> lev mood-func)))
+           (if (zero? slot)
+             (set! *ios-storm-orig-mood-0* (-> lev mood-func))
+             (set! *ios-storm-orig-mood-1* (-> lev mood-func)))
+           (set! (-> lev mood-func) ios-storm-mood-func)))
+        ((= (-> lev mood-func) ios-storm-mood-func)
+         (set! (-> lev mood-func) (if (zero? slot) *ios-storm-orig-mood-0* *ios-storm-orig-mood-1*))
+         (ios-storm-restore-times (-> lev mood))))))
+  0)
+
+;; the captured stock function (define-perm: never wrap the wrapper)
+(define-perm *ios-ocean-stock-update-time-of-day* (function time-of-day-context none) update-time-of-day)
+
+(defun update-time-of-day ((arg0 time-of-day-context))
+  (ios-storm-hook-moods)
+  (*ios-ocean-stock-update-time-of-day* arg0)
+  (none))
+
+;; the land levels a storm may come over with the STORMS option (level names)
+(define *ios-storm-levels* '(village1 beach jungle misty training))
+
+(defun ios-storm-land? ()
+  "With the STORMS option: Jak is playing in one of the storm levels (and not out in the Open Ocean)."
+  (and *ios-storms*
+       *target*
+       (= *kernel-boot-message* 'play)
+       (not (ios-in-open-ocean?))
+       (let ((lev (level-get-target-inside *level*)))
+         (and lev (member (-> lev name) *ios-storm-levels*)))))
+
+;; indoor levels: a storm that is on never reaches in there (it fades, and is back outside)
+(define *ios-storm-dry-levels* '(jungleb sunken sunkenb maincave darkcave robocave lavatube citadel finalboss glacier))
+
+(defun ios-storm-must-stop? ()
+  "A storm ends at once, without carrying over (user 2026-10-28): when Jak goes through a warp gate, and anywhere in
+   the Glacier mod level (by level or inside its fog ring, also when sailed into from the Open Ocean): it never rains
+   there."
+  (and *target*
+       (or (let ((state (-> *target* next-state)))
+             (and state (or (= (-> state name) 'target-warp-out) (= (-> state name) 'target-warp-in))))
+           (ios-ocean-in-glacier?)
+           (let ((lev (level-get-target-inside *level*)))
+             (and lev (= (-> lev name) 'glacier))))))
+
+(defun ios-storm-carry? ()
+  "A storm that has started (at sea or over a storm level) stays with Jak wherever he goes until it clears
+   (user 2026-10-23: no sudden end on leaving the Open Ocean), except indoors."
+  (and (or *ios-open-ocean-level* *ios-storms*)
+       *target*
+       (= *kernel-boot-message* 'play)
+       (let ((lev (level-get-target-inside *level*)))
+         (not (and lev (member (-> lev name) *ios-storm-dry-levels*))))))
+
+;; Boggy Swamp's rain, as many drops as the storm wants (part 37/38 :num, restored when it stops)
+(defconstant IOS_RAIN_NUM_37 1.5)
+(defconstant IOS_RAIN_NUM_38 4.5)
+
+;; ---- rain collision (user 2026-10-23: no rain through roofs) ----
+;;
+;; Stock rain drops only stop at one fixed height (part 37's :userdata, 0 = sea level in the swamp) and part 38's
+;; never stop, so they fell through Sandover's roofs. Drops can't probe the collision themselves: their :func runs
+;; in sp-process-block with the particle data copied into the scratchpad, which the collide cache also uses. So the
+;; weather process keeps a height map instead: for every 1 m cell around Jak, the first surface below the drops'
+;; spawn height (background, platforms, walls/doors, the boat; or sea level). A few cells are probed each frame;
+;; cells follow the world (only new ones are probed as Jak moves). While it rains the drops' :func only looks the
+;; map up: a drop ends (37: with the stock splash) on its cell's surface, the same on a roof as on the ground.
+;; Cells not probed yet (the far edge while moving fast) let no drops through.
+;;
+;; Buildings (user 2026-10-23): roofs Jak can't stand on have no collision, so the downward probe went through them
+;; to the floor inside (and a wall-probe "indoors" test proved unreliable offline: doorways, windows and furniture leave
+;; interiors open). So no rain falls at all over the roof footprints in *ios-rain-dry-circles* (Sandover's buildings;
+;; drops there are killed where they spawn, above the roof; from Jak's low view it isn't noticeable).
+
+(defconstant IOS_RAIN_MAP_SIZE 64)       ;; slots per side (world cell & 63), > the probed window
+(defconstant IOS_RAIN_MAP_RADIUS 23)     ;; cells probed around Jak (drops spawn up to 20 m out)
+(defconstant IOS_RAIN_MAP_WINDOW 47)     ;; 2 * radius + 1
+(defconstant IOS_RAIN_PROBES 24)         ;; probes per frame
+
+;; x z radius (meters) of Sandover's buildings: no rain under their roofs. Measured offline (2026-10-23) from the
+;; roof geometry itself (TIE vil1-rooftile-1 + vil-under-roof clusters; Samos's vil1-sages-strawroof-01): the roofs
+;; overhang the walls by ~10 m, so circles fitted to the wall collision (first try) let rain fall under the eaves.
+(define *ios-rain-dry-circles*
+  (new 'static 'boxed-array :type float
+       -126.5  210.3  23.0   ;; Samos's hut (straw roof; Keira's workshop under it)
+       -113.0  43.0   24.0   ;; mayor's house (stone tower, windmill)
+       -58.5   33.5   18.5   ;; explorer's house
+       -70.0   69.0   19.0   ;; hut north of the explorer's
+       -127.5  -19.0  19.0   ;; sculptor's house
+       -61.5   -28.0  18.5   ;; bird lady's house
+       -20.5   -75.0  19.0   ;; farmer's hut
+       ))
+
+(defun ios-rain-dry? ((x float) (z float))
+  "Under one of Sandover's roofs (no rain there)."
+  (let ((c *ios-rain-dry-circles*))
+    (dotimes (i (/ (length c) 3))
+      (let ((dx (- x (* 4096.0 (-> c (* i 3)))))
+            (dz (- z (* 4096.0 (-> c (+ (* i 3) 1)))))
+            (r (* 4096.0 (-> c (+ (* i 3) 2)))))
+        (if (< (+ (* dx dx) (* dz dz)) (* r r)) (return #t)))))
+  #f)
+(defconstant IOS_RAIN_SCAN 400)          ;; window cells looked at per frame
+(defconstant IOS_RAIN_PROBE_ABOVE (meters 20))  ;; probes start this far above Jak (drops spawn 16 m above)
+(defconstant IOS_RAIN_PROBE_LENGTH (meters 90))
+(defconstant IOS_RAIN_UNKNOWN 409600000.0) ;; floor of a cell not probed yet (100 km up: every drop ends)
+
+(deftype ios-rain-cell (structure)
+  ((x      int32)   ;; world cell (meters, floor)
+   (z      int32)
+   (height float)   ;; first surface below top
+   (top    float))) ;; where its probe started
+
+;; The cells are a separate array: a type's size is a uint16, so 4096 inline cells (64 KB) wrapped it to 4 bytes and
+;; the map overwrote the types allocated after it (ios-ocean-weather's method table -> crash when a storm began,
+;; 2026-10-23).
+(deftype ios-rain-map (structure)
+  ((cells (inline-array ios-rain-cell))  ;; IOS_RAIN_MAP_SIZE squared
+   (sweep int32)))
+
+(define-perm *ios-rain-map* ios-rain-map
+  (let ((rain-map (new 'global 'ios-rain-map)))
+    (set! (-> rain-map cells) (new 'global 'inline-array 'ios-rain-cell (* IOS_RAIN_MAP_SIZE IOS_RAIN_MAP_SIZE)))
+    rain-map))
+
+(defun ios-rain-map-clear ()
+  (dotimes (i (* IOS_RAIN_MAP_SIZE IOS_RAIN_MAP_SIZE))
+    (set! (-> *ios-rain-map* cells i x) #x7fffffff))
+  (set! (-> *ios-rain-map* sweep) 0)
+  0)
+
+(ios-rain-map-clear)
+
+(defmacro ios-rain-cell-of (ix iz)
+  `(-> *ios-rain-map* cells (+ (logand ,ix (+ IOS_RAIN_MAP_SIZE -1)) (* IOS_RAIN_MAP_SIZE (logand ,iz (+ IOS_RAIN_MAP_SIZE -1))))))
+
+(defun ios-rain-cell-index ((v float))
+  "World cell (whole meters, rounded down) of a coordinate."
+  (let* ((m (/ v 4096.0))
+         (i (the int m)))
+    (if (< m (the float i)) (- i 1) i)))
+
+(defun ios-rain-floor-at ((x float) (z float))
+  "The surface a drop at x z stops on, or IOS_RAIN_UNKNOWN. Safe inside particle funcs (no collision)."
+  (let* ((ix (ios-rain-cell-index x))
+         (iz (ios-rain-cell-index z))
+         (cell (ios-rain-cell-of ix iz)))
+    (if (and (= (-> cell x) ix) (= (-> cell z) iz))
+      (-> cell height)
+      IOS_RAIN_UNKNOWN)))
+
+(defun ios-rain-map-update ()
+  "Probes up to IOS_RAIN_PROBES cells around Jak that are new, or were probed from too far above/below."
+  (let* ((jak (-> *target* control trans))
+         (cx (ios-rain-cell-index (-> jak x)))
+         (cz (ios-rain-cell-index (-> jak z)))
+         (need (+ (-> jak y) (meters 16.5)))   ;; a cell's probe must start above the drops ...
+         (limit (+ (-> jak y) (meters 26)))    ;; ... but not far above them (an overhang they spawn under)
+         (probes 0)
+         (start (new 'stack-no-clear 'vector))
+         (result (new 'stack-no-clear 'collide-tri-result)))
+    (dotimes (n IOS_RAIN_SCAN)
+      (when (< probes IOS_RAIN_PROBES)
+        (let* ((s (-> *ios-rain-map* sweep))
+               (dx (- (mod s IOS_RAIN_MAP_WINDOW) IOS_RAIN_MAP_RADIUS))
+               (dz (- (/ s IOS_RAIN_MAP_WINDOW) IOS_RAIN_MAP_RADIUS)))
+          (set! (-> *ios-rain-map* sweep) (mod (+ s 1) (* IOS_RAIN_MAP_WINDOW IOS_RAIN_MAP_WINDOW)))
+          (when (<= (+ (* dx dx) (* dz dz)) (* IOS_RAIN_MAP_RADIUS IOS_RAIN_MAP_RADIUS))
+            (let* ((ix (+ cx dx))
+                   (iz (+ cz dz))
+                   (cell (ios-rain-cell-of ix iz)))
+              (when (not (and (= (-> cell x) ix) (= (-> cell z) iz) (<= need (-> cell top)) (<= (-> cell top) limit)))
+                (+! probes 1)
+                (set-vector! start (* 4096.0 (+ 0.5 (the float ix))) (+ (-> jak y) IOS_RAIN_PROBE_ABOVE) (* 4096.0 (+ 0.5 (the float iz))) 1.0)
+                (set! (-> cell x) ix)
+                (set! (-> cell z) iz)
+                (set! (-> cell top) (-> start y))
+                ;; nothing below (open sea, or no collision loaded): sea level
+                (cond
+                  ;; under one of Sandover's roofs: no rain in this column
+                  ((ios-rain-dry? (-> start x) (-> start z))
+                   (set! (-> cell height) IOS_RAIN_UNKNOWN))
+                  ((and (>= (fill-and-probe-using-y-probe *collide-cache*
+                                                          start
+                                                          IOS_RAIN_PROBE_LENGTH
+                                                          (collide-kind background ground-object wall-object)
+                                                          (the-as process-drawable #f)
+                                                          result
+                                                          (new 'static 'pat-surface :noentity #x1))
+                            0.0)
+                        (< 0.0 (-> result intersect y)))
+                   (set! (-> cell height) (-> result intersect y)))
+                  (else (set! (-> cell height) 0.0))))))))))
+  0)
+
+(defun ios-rain-drop-37 ((sys sparticle-system) (cpu sparticle-cpuinfo) (pos vector))
+  "Part 37 (drops that splash) while our rain is on: as check-drop-level-rain, on the height map; ring on water only."
+  (let ((floor-y (ios-rain-floor-at (-> pos x) (-> pos z))))
+    (cond
+      ((= floor-y IOS_RAIN_UNKNOWN) (sp-kill-particle sys cpu))
+      ((< (-> pos y) floor-y)
+       (let ((spot (new 'stack-no-clear 'vector)))
+         (sp-kill-particle sys cpu)
+         (set-vector! spot (-> pos x) floor-y (-> pos z) 1.0)
+         (launch-particles (-> *part-id-table* 39) spot :rate 1.0)
+         ;; the expanding ring (part 40) only on water (user 2026-10-23); the map gives the sea exactly sea level
+         (if (= floor-y 0.0)
+           (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 40) spot :rate 1.0))))))
+  (none))
+
+(defun ios-rain-drop-38 ((sys sparticle-system) (cpu sparticle-cpuinfo) (pos vector))
+  "Part 38 (stock: no splash, no floor) while our rain is on: ends on the height map's surface."
+  (if (< (-> pos y) (ios-rain-floor-at (-> pos x) (-> pos z))) (sp-kill-particle sys cpu))
+  (none))
+
+;; part 38's specs with a :func added (its static array has no room), and the stock array
+(define-perm *ios-rain-38-stock* (inline-array sp-field-init-spec) (the-as (inline-array sp-field-init-spec) #f))
+(define-perm *ios-rain-38-specs* (inline-array sp-field-init-spec) (the-as (inline-array sp-field-init-spec) #f))
+
+(defun ios-rain-38-make-specs ()
+  "Copy of part 38's specs with a :func ios-rain-drop-38 inserted in field order."
+  (let ((stock (-> *part-id-table* 38 init-specs))
+        (out (new 'global 'inline-array 'sp-field-init-spec 24))
+        (n 0)
+        (added #f))
+    (set! *ios-rain-38-stock* stock)
+    (dotimes (i 22)
+      (let ((field (-> stock i field)))
+        (when (and (not added) (> field (sp-field-id spt-func)))
+          (set! added #t)
+          (set! (-> out n field) (sp-field-id spt-func))
+          (set! (-> out n flags) (sp-flag symbol))
+          (set! (-> out n sym) 'ios-rain-drop-38)
+          (+! n 1))
+        (mem-copy! (the-as pointer (-> out n)) (the-as pointer (-> stock i)) 16)
+        (+! n 1)
+        (if (= field (sp-field-id spt-end)) (return out))))
+    out))
+
+(defun ios-rain-funcs-set! ((ours symbol))
+  "Our drop funcs on parts 37/38 while our rain is on (in-flight drops keep the func they were born with)."
+  (let ((specs (-> *part-id-table* 37 init-specs))
+        (i 0))
+    (while (!= (-> specs i field) (sp-field-id spt-end))
+      (if (= (-> specs i field) (sp-field-id spt-func))
+        (set! (-> specs i sym) (if ours 'ios-rain-drop-37 'check-drop-level-rain)))
+      (+! i 1)))
+  (if (not *ios-rain-38-specs*) (set! *ios-rain-38-specs* (ios-rain-38-make-specs)))
+  (set! (-> *part-id-table* 38 init-specs) (if ours *ios-rain-38-specs* *ios-rain-38-stock*))
+  0)
+
+(defun ios-ocean-rain-update ((rain float) (raining symbol))
+  "Launches this frame's rain around Jak. Returns whether it rained."
+  (cond
+    ((and (< 0.0 rain) *target*)
+     (if (not raining) (ios-rain-funcs-set! #t))
+     (set! (-> *part-id-table* 37 init-specs 1 initial-valuef) (* rain IOS_RAIN_NUM_37))
+     (set! (-> *part-id-table* 38 init-specs 1 initial-valuef) (* rain IOS_RAIN_NUM_38))
+     (update-rain *target*)
+     #t)
+    (else
+     (when raining
+       (ios-rain-funcs-set! #f)
+       (set! (-> *part-id-table* 37 init-specs 1 initial-valuef) IOS_RAIN_NUM_37)
+       (set! (-> *part-id-table* 38 init-specs 1 initial-valuef) IOS_RAIN_NUM_38))
+     #f)))
+
+(defconstant IOS_STORM_CLEAR 0)
+(defconstant IOS_STORM_BUILDING 1)
+(defconstant IOS_STORM_RAINING 2)
+(defconstant IOS_STORM_CLEARING 3)
+
+;; storm sounds (percent): Boggy Swamp's ambience as the rain, Rock Village's under the storm
+(defconstant IOS_STORM_RAIN_VOLUME 80.0)
+(defconstant IOS_STORM_GLOOM_VOLUME 50.0)
+
+(defun ios-ocean-bed ((name sound-name) (id sound-id) (volume float))
+  "Keeps a looping bed playing at VOLUME percent, everywhere (no position)."
+  (sound-play-by-name name id (the int (* 10.24 volume)) 0 0 (sound-group sfx) #f)
+  0)
+
+(deftype ios-ocean-weather (process)
+  ((phase        int32)
+   (phase-time   time-frame)
+   (check-time   time-frame)
+   (last-storm   time-frame)
+   (length       time-frame)   ;; how long this storm rains at least
+   (base         float)        ;; the storm's own strength 0..1
+   (presence     float)        ;; 1 in the Open Ocean (or a storm level with STORMS on), 0 away from them
+   (raining      symbol)
+   (flash-time   time-frame)   ;; the current flash started
+   (flash-next   time-frame)   ;; the next flash may come this long after the last
+   (flashing     symbol)
+   (thunder-time time-frame)   ;; thunder due at this time (0: none)
+   (thunder-vol  float)
+   ;; the storm's beds (here rather than in the ocean ambience, so they play over land too)
+   (rain         sound-id)
+   (gloom        sound-id)
+   (beds         symbol))
+  (:states
+   ios-ocean-weather-idle))
+
+(defbehavior ios-ocean-weather-beds ios-ocean-weather ()
+  "Rain (swamp-amb) with the rain, Rock Village's ambience (village2-amb) with the storm."
+  (cond
+    ((< 0.0 *ios-ocean-storm*)
+     (set! (-> self beds) #t)
+     (if (< 0.0 *ios-ocean-rain*)
+       (ios-ocean-bed (static-sound-name "swamp-amb") (-> self rain) (* *ios-ocean-rain* IOS_STORM_RAIN_VOLUME))
+       (sound-stop (-> self rain)))
+     (ios-ocean-bed (static-sound-name "village2-amb") (-> self gloom) (* *ios-ocean-storm* IOS_STORM_GLOOM_VOLUME)))
+    ((-> self beds)
+     (set! (-> self beds) #f)
+     (sound-stop (-> self rain))
+     (sound-stop (-> self gloom))))
+  0)
+
+(defbehavior ios-ocean-weather-go ios-ocean-weather ((phase int))
+  (set! (-> self phase) phase)
+  (set-time! (-> self phase-time))
+  (set-time! (-> self check-time))
+  (format 0 "ios-open-ocean: weather ~D~%" phase)
+  0)
+
+(defbehavior ios-ocean-weather-flash ios-ocean-weather ()
+  "Lightning: a quick double flicker, then thunder 0.3-2 s later."
+  (let ((s *ios-ocean-storm*))
+    (when (and (< 0.75 s) (time-elapsed? (-> self flash-time) (-> self flash-next)))
+      (set-time! (-> self flash-time))
+      (set! (-> self flash-next) (the-as time-frame (rand-vu-int-range (seconds 6) (seconds 20))))
+      (set! (-> self flashing) #t)
+      (set! (-> self thunder-time) (+ (current-time) (rand-vu-int-range (seconds 0.3) (seconds 2))))
+      (set! (-> self thunder-vol) (rand-vu-float-range 150.0 300.0)))
+    (cond
+      ((-> self flashing)
+       (let ((t (the float (- (current-time) (-> self flash-time)))))
+         (set! *ios-ocean-flash*
+               (cond
+                 ((< t (seconds 0.08)) 1.0)
+                 ((< t (seconds 0.16)) 0.2)
+                 ((< t (seconds 0.26)) 0.8)
+                 ((< t (seconds 0.7)) (* 0.8 (- 1.0 (/ (- t (seconds 0.26)) (seconds 0.44)))))
+                 (else (set! (-> self flashing) #f) 0.0)))))
+      (else (set! *ios-ocean-flash* 0.0)))
+    (when (and (nonzero? (-> self thunder-time)) (>= (current-time) (-> self thunder-time)))
+      (set! (-> self thunder-time) 0)
+      (let ((spot (new 'stack-no-clear 'vector)))
+        (set! (-> spot quad) (-> (ear-trans) quad))
+        (+! (-> spot y) (meters 40))
+        (sound-play "thunder"
+                    :vol (* s (-> self thunder-vol))
+                    :pitch (rand-vu-float-range -1.0 1.0)
+                    :position (the-as symbol spot)))))
+  0)
+
+(defstate ios-ocean-weather-idle (ios-ocean-weather)
+  :code
+    (behavior ()
+      (loop
+        (when (not (paused?))
+          (let* ((dt (seconds-per-frame))
+                 (in-ocean (ios-in-open-ocean?))
+                 (on-land (ios-storm-land?))
+                 ;; with the fast-test switch on, storms come quickly for testing; over land they are rarer
+                 (check (cond (*ios-open-ocean-fast* (seconds 20)) (in-ocean IOS_STORM_CHECK) (else IOS_LAND_STORM_CHECK)))
+                 (chance (cond (*ios-open-ocean-fast* 0.5) (in-ocean IOS_STORM_CHANCE) (else IOS_LAND_STORM_CHANCE)))
+                 (cooldown (cond
+                             (*ios-open-ocean-fast* (seconds 60))
+                             (in-ocean IOS_STORM_COOLDOWN)
+                             (else IOS_LAND_STORM_COOLDOWN))))
+            ;; storms start only where they may (the ocean, the storm levels); once on, they follow Jak around
+            (seek! (-> self presence)
+                   (if (or in-ocean on-land (and (!= (-> self phase) IOS_STORM_CLEAR) (ios-storm-carry?))) 1.0 0.0)
+                   (/ dt 8.0))
+            (case (-> self phase)
+              ((IOS_STORM_CLEAR)
+               (when (and (or in-ocean on-land) (time-elapsed? (-> self check-time) check))
+                 (set-time! (-> self check-time))
+                 (if (and (time-elapsed? (-> self last-storm) cooldown) (rand-vu-percent? chance))
+                   (ios-ocean-weather-go IOS_STORM_BUILDING))))
+              ((IOS_STORM_BUILDING)
+               (seek! (-> self base) 1.0 (/ dt IOS_STORM_BUILD))
+               (when (= (-> self base) 1.0)
+                 (set! (-> self length) (the-as time-frame (rand-vu-int-range IOS_STORM_MIN IOS_STORM_MAX)))
+                 (ios-ocean-weather-go IOS_STORM_RAINING)))
+              ((IOS_STORM_RAINING)
+               (when (and (time-elapsed? (-> self phase-time) (-> self length))
+                          (time-elapsed? (-> self check-time) IOS_STORM_END_CHECK))
+                 (set-time! (-> self check-time))
+                 (if (rand-vu-percent? IOS_STORM_END_CHANCE) (ios-ocean-weather-go IOS_STORM_CLEARING))))
+              ((IOS_STORM_CLEARING)
+               (seek! (-> self base) 0.0 (/ dt IOS_STORM_BUILD))
+               (when (= (-> self base) 0.0)
+                 (set-time! (-> self last-storm))
+                 (ios-ocean-weather-go IOS_STORM_CLEAR))))
+            ;; warp gates and the Glacier: the storm is over, now (no fade, nothing carried back out)
+            (when (ios-storm-must-stop?)
+              (set! (-> self base) 0.0)
+              (set! (-> self presence) 0.0)
+              (when (!= (-> self phase) IOS_STORM_CLEAR)
+                (set-time! (-> self last-storm))
+                (ios-ocean-weather-go IOS_STORM_CLEAR)))
+            (set! *ios-ocean-storm* (* (-> self base) (-> self presence)))
+            ;; the rain starts once the sky is half dark
+            (set! *ios-ocean-rain* (fmax 0.0 (fmin 1.0 (/ (- *ios-ocean-storm* 0.4) 0.6))))
+            (ios-ocean-weather-flash)
+            (ios-ocean-weather-beds)
+            ;; music (user 2026-10-23): fades out as the rain comes in, silent once the storm is full (volume 0 also
+            ;; keeps new music from starting), back in as it clears. 'rel settings multiply, so this combines with
+            ;; the Open Ocean's own silence (ios-open-ocean-music).
+            (if (< 0.0 *ios-ocean-rain*)
+              (set-setting! 'music-volume 'rel (* 100.0 (- 1.0 *ios-ocean-rain*)) 0)
+              (remove-setting! 'music-volume))
+            ;; the rain's height map is ready before the rain starts (storm 0.4)
+            (if (and (< 0.0 *ios-ocean-storm*) *target*) (ios-rain-map-update))))
+        (set! (-> self raining) (ios-ocean-rain-update (if (paused?) 0.0 *ios-ocean-rain*) (-> self raining)))
+        (suspend))))
+
+(defbehavior ios-ocean-weather-init-by-other ios-ocean-weather ()
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! (-> self phase) IOS_STORM_CLEAR)
+  (set-time! (-> self phase-time))
+  (set-time! (-> self check-time))
+  (set! (-> self last-storm) 0)
+  (set! (-> self base) 0.0)
+  (set! (-> self presence) 0.0)
+  (set! (-> self raining) #f)
+  (set! (-> self flash-next) (seconds 4))
+  (set! (-> self flashing) #f)
+  (set! (-> self thunder-time) 0)
+  (set! (-> self rain) (new-sound-id))
+  (set! (-> self gloom) (new-sound-id))
+  (set! (-> self beds) #f)
+  (go ios-ocean-weather-idle))
+
+(defmethod deactivate ((this ios-ocean-weather))
+  ;; no storm left behind
+  (set! *ios-ocean-storm* 0.0)
+  (set! *ios-ocean-rain* 0.0)
+  (set! *ios-ocean-flash* 0.0)
+  (if (-> this raining) (ios-ocean-rain-update 0.0 #t))
+  (when (-> this beds)
+    (sound-stop (-> this rain))
+    (sound-stop (-> this gloom)))
+  ((method-of-type process deactivate) this)
+  (none))
+
+;; ---- ambience (phase 3: waves and wind) -----------------------------------------------------------------------
+;;
+;; In place of music (above), the Open Ocean sounds like open water (user 2026-10-19): two beds that follow the
+;; camera, Sandover's "ocean-bg" (waves) and "wind-loop", plus now and then a wave lapping close by ("water-lap")
+;; and a gust of wind from somewhere around ("tower-winds" / "tower-wind2" / "tower-wind3", Sentinel Beach's
+;; lighthouse wind). All fade in over IOS_OCEAN_AMBIENCE_FADE when Jak enters the Open Ocean and out when he leaves.
+;; Every level sound bank is loaded once at boot and kept (level.gc update-sound-banks), so these play anywhere.
+
+(defconstant IOS_OCEAN_AMBIENCE_FADE 3.0)        ;; seconds
+(defconstant IOS_OCEAN_WAVES_VOLUME 75.0)        ;; percent
+(defconstant IOS_OCEAN_WIND_VOLUME 45.0)
+(defconstant IOS_OCEAN_LAP_VOLUME 55.0)
+(defconstant IOS_OCEAN_GUST_VOLUME 60.0)
+
+(deftype ios-open-ocean-ambience (process)
+  ((fade      float)
+   (playing   symbol)
+   ;; the beds: plain looping sounds with no position (sound-play-by-name with the same id every frame, as stock
+   ;; ambient-sound does; positioned on the ear they cut in and out while fishing moved the camera, user 2026-10-21)
+   (waves     sound-id)
+   (wind      sound-id)   ;; (the storm's rain and gloom beds are the weather process's)
+   (lap-time  time-frame)
+   (lap-delay time-frame)
+   (gust-time time-frame)
+   (gust-delay time-frame))
+  (:states
+   ios-open-ocean-ambience-idle))
+
+(defun ios-open-ocean-sound-spot ((out vector) (near float) (far float))
+  "A spot around the ear, NEAR-FAR away (horizontally)."
+  (let ((angle (rand-vu-float-range 0.0 (degrees 360)))
+        (dist (rand-vu-float-range near far)))
+    (set! (-> out quad) (-> (ear-trans) quad))
+    (+! (-> out x) (* dist (sin angle)))
+    (+! (-> out z) (* dist (cos angle)))
+    out))
+
+(defstate ios-open-ocean-ambience-idle (ios-open-ocean-ambience)
+  :code
+    (behavior ()
+      (loop
+        ;; while paused the game's pause holds the sounds; nothing new starts
+        (when (not (paused?))
+          (seek! (-> self fade) (if (ios-in-open-ocean?) 1.0 0.0) (/ (seconds-per-frame) IOS_OCEAN_AMBIENCE_FADE))
+          (cond
+            ((< 0.0 (-> self fade))
+             (set! (-> self playing) #t)
+             (ios-ocean-bed (static-sound-name "ocean-bg") (-> self waves) (* (-> self fade) IOS_OCEAN_WAVES_VOLUME))
+             ;; a storm doubles the wind
+             (ios-ocean-bed (static-sound-name "wind-loop")
+                            (-> self wind)
+                            (* (-> self fade) IOS_OCEAN_WIND_VOLUME (+ 1.0 *ios-ocean-storm*)))
+             (let ((spot (new 'stack-no-clear 'vector)))
+               (when (time-elapsed? (-> self lap-time) (-> self lap-delay))
+                 (set-time! (-> self lap-time))
+                 (set! (-> self lap-delay) (the-as time-frame (rand-vu-int-range (seconds 3) (seconds 9))))
+                 (sound-play "water-lap"
+                             :vol (* (-> self fade) IOS_OCEAN_LAP_VOLUME)
+                             :position (the-as symbol (ios-open-ocean-sound-spot spot (meters 3) (meters 8)))))
+               (when (time-elapsed? (-> self gust-time) (-> self gust-delay))
+                 (set-time! (-> self gust-time))
+                 (set! (-> self gust-delay) (the-as time-frame (rand-vu-int-range (seconds 8) (seconds 20))))
+                 (ios-open-ocean-sound-spot spot (meters 10) (meters 25))
+                 (case (rand-vu-int-range 0 2)
+                   ((0) (sound-play "tower-winds" :vol (* (-> self fade) IOS_OCEAN_GUST_VOLUME) :position (the-as symbol spot)))
+                   ((1) (sound-play "tower-wind2" :vol (* (-> self fade) IOS_OCEAN_GUST_VOLUME) :position (the-as symbol spot)))
+                   (else (sound-play "tower-wind3" :vol (* (-> self fade) IOS_OCEAN_GUST_VOLUME) :position (the-as symbol spot)))))))
+            ((-> self playing)
+             (set! (-> self playing) #f)
+             (sound-stop (-> self waves))
+             (sound-stop (-> self wind)))))
+        (suspend))))
+
+(defbehavior ios-open-ocean-ambience-init-by-other ios-open-ocean-ambience ()
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! (-> self fade) 0.0)
+  (set! (-> self playing) #f)
+  (set! (-> self waves) (new-sound-id))
+  (set! (-> self wind) (new-sound-id))
+  (set-time! (-> self lap-time))
+  (set! (-> self lap-delay) (seconds 2))
+  (set-time! (-> self gust-time))
+  (set! (-> self gust-delay) (seconds 5))
+  (go ios-open-ocean-ambience-idle))
+
+(defun ios-ocean-weather-ensure ()
+  (if (not (handle->process (-> *ios-ocean-handles* weather)))
+    (set! (-> *ios-ocean-handles* weather)
+          (ppointer->handle (process-spawn ios-ocean-weather :init ios-ocean-weather-init-by-other :to *entity-pool*))))
+  0)
+
+(defun ios-open-ocean-ambience-ensure ()
+  (if (not (handle->process (-> *ios-ocean-handles* ambience)))
+    (set! (-> *ios-ocean-handles* ambience)
+          (ppointer->handle (process-spawn ios-open-ocean-ambience :init ios-open-ocean-ambience-init-by-other :to *entity-pool*))))
+  0)
+
+;; ---- drifting barrels and floating orbs (phase 2) -------------------------------------------------------------
+;;
+;; Barrels drift in the Open Ocean, lying on their side and bobbing on the waves: Misty's keg, or the common
+;; green eco barrel (the crate system's crate-barrel, user 2026-10-19; always resident, so it needs no extra art).
+;; They are rare (user 2026-10-19: the first numbers flooded the sea). Only a dive attack (the
+;; ground pound, 'flop) breaks it; other hits bounce off like an iron crate's. It holds one of the five barrel power
+;; cells (and hums like a power cell, so it can be found by ear), a bundle of orbs, or a big green eco cluster.
+;; Orbs and eco are collected straight away (instant-collect: no chasing them through the water); the cell pops up
+;; above the water to be touched (an ios-ocean-cell: counted without the stock victory sequence). Barrels are the only source
+;; of ocean orbs (no orbs float in the water, user 2026-10-19). Orbs and cells stop once the ocean's are all
+;; collected; then barrels only hold eco.
+;;
+;; The keg art is not tied to Misty: the host (OpenGOALRuntimeHost.mm LoadResidentOceanArt) loads it into the
+;; global heap as level-default art (*ios-ocean-art* says it is there) and every ocean object has a stand-in entity
+;; whose level is level-default (*ios-ocean-entity*). The renderer draws it from Jak1Level-ios-ocean.fr3z.
+;;
+;; Ocean pickups (their process's entity is *ios-ocean-entity*) are counted by the pickup-collectable! wrapper
+;; below: orbs go to the ocean's 500 (and to Jak's spendable orbs, so the HUD counter moves) but not to the stock
+;; per-level/total counts; cells (amount IOS_OCEAN_CELL_PICKUP_BASE + cell index) only set the ocean's cell bit.
+
+;; set by the host every frame (SyncOpenOceanLevelOption): the keg art is resident, barrels may spawn
+(define-perm *ios-ocean-art* symbol #f)
+
+(defconstant IOS_OCEAN_CELL_PICKUP_BASE 200)   ;; fuel-cell pickup amount of ocean cell i = base + i (> any task)
+
+(defconstant IOS_OCEAN_BARREL_MAX 2)
+(defconstant IOS_OCEAN_SPAWN_MIN (meters 60))
+(defconstant IOS_OCEAN_SPAWN_MAX (meters 140))
+(defconstant IOS_OCEAN_DESPAWN (meters 230))
+(defconstant IOS_OCEAN_BARREL_CHECK (seconds 20))  ;; how often a barrel may spawn (~1 per minute on average)
+(defconstant IOS_OCEAN_BARREL_CHANCE 0.3)
+(defconstant IOS_OCEAN_CELL_CHANCE 0.15)           ;; a new barrel holds a power cell (if one is left)
+(defconstant IOS_OCEAN_ORB_CHANCE 0.55)            ;; else orbs (if any are left), else green eco
+(defconstant IOS_OCEAN_BARREL_FLOAT_Y (meters 0.15))  ;; barrel centre above the water surface
+(defconstant IOS_OCEAN_BARREL_SCALE 1.0)
+(defconstant IOS_OCEAN_CRATE_BARREL_HALF (meters 0.75))  ;; crate-barrel origin is its base: half its height
+(defconstant IOS_OCEAN_CRATE_BARREL_CHANCE 0.5)          ;; a new barrel is the green eco barrel (else the keg)
+(defconstant IOS_OCEAN_BARREL_DRIFT (meters 0.5))     ;; per second
+(defconstant IOS_OCEAN_CELL_HOVER (meters 1.2))       ;; a barrel's cell above the water
+
+(defconstant IOS_OCEAN_BARREL_EMPTY 0)
+(defconstant IOS_OCEAN_BARREL_CELL 1)
+(defconstant IOS_OCEAN_BARREL_ORBS 2)
+(defconstant IOS_OCEAN_BARREL_ECO 3)
+(defconstant IOS_OCEAN_BARREL_FLY 4)   ;; a scout fly box (phase 4): amount = the fly's index
+
+(defconstant IOS_OCEAN_LOOK_KEG 0)
+(defconstant IOS_OCEAN_LOOK_CRATE_BARREL 1)
+(defconstant IOS_OCEAN_LOOK_FLY_BOX 2)     ;; the stock scout fly box (iron crate), upright
+
+;; scout fly boxes (phase 4): rarer than barrels, one at a time, none once the ocean's seven flies are found
+(defconstant IOS_OCEAN_FLY_BOX_CHECK (seconds 45))
+(defconstant IOS_OCEAN_FLY_BOX_CHANCE 0.25)
+
+(define-perm *ios-ocean-entity* entity-actor #f)
+
+(defun ios-ocean-entity ()
+  "The ocean objects' entity: an empty res-lump whose links point at level-default (so initialize-skeleton takes the
+   resident keg art) and whose process is never set. Same as the fish's (ios-ocean-fish.gc), but its own: pickups
+   are told apart by it. Made once."
+  (when (not *ios-ocean-entity*)
+    (let ((ent (new 'global 'entity-actor 1 0))
+          (links (new 'global 'entity-links)))
+      (set! (-> links entity) ent)
+      (set! (-> links process) #f)
+      (set! (-> links level) (-> *level* level-default))
+      (set! (-> ent extra) links)
+      (set! (-> ent etype) process-drawable)
+      (quaternion-identity! (-> ent quat))
+      (set! *ios-ocean-entity* ent)))
+  *ios-ocean-entity*)
+
+(defun ios-ocean-pickup-source? ((source-handle handle))
+  (let ((proc (handle->process source-handle)))
+    (and proc
+         *ios-ocean-entity*
+         (type-type? (-> proc type) process-drawable)
+         (= (-> (the-as process-drawable proc) entity) *ios-ocean-entity*))))
+
+;; the captured stock method (define-perm: never wrap the wrapper; this is already ios-green-eco's wrapper)
+(define-perm *ios-ocean-stock-pickup* (function fact-info-target pickup-type float handle float)
+  (the-as (function fact-info-target pickup-type float handle float)
+          (method-of-type fact-info-target pickup-collectable!)))
+
+(defmethod pickup-collectable! ((this fact-info-target) (kind pickup-type) (amount float) (source-handle handle))
+  (cond
+    ((and (= kind (pickup-type money)) (ios-ocean-pickup-source? source-handle))
+     ;; stock money pickup (game-info.gc) without the per-level and total counts
+     (when (< 0.0 amount)
+       (if (time-elapsed? (-> this money-pickup-time) (seconds 0.05)) (sound-play "money-pickup"))
+       (set-time! (-> this money-pickup-time))
+       (+! (-> *ios-ocean-progress* add-orbs) (min (the int amount) (- IOS_OCEAN_ORB_TOTAL (ios-ocean-orbs))))
+       (+! (-> *game-info* money) amount))
+     (-> *game-info* money))
+    ((and (= kind (pickup-type fuel-cell)) (ios-ocean-pickup-source? source-handle))
+     (let ((index (- (the int amount) IOS_OCEAN_CELL_PICKUP_BASE)))
+       (when (and (>= index 0) (< index IOS_OCEAN_CELL_TOTAL) (not (ios-ocean-cell-collected? index)))
+         (set-time! (-> this fuel-cell-pickup-time))
+         (logior! (-> *ios-ocean-progress* add-cells) (ash 1 index))
+         (format 0 "ios-open-ocean: got ocean power cell ~D~%" index)))
+     (-> *game-info* fuel))
+    ((and (= kind (pickup-type buzzer)) (ios-ocean-pickup-source? source-handle))
+     ;; an ocean scout fly: amount = its index; nothing stock (no buzzer task, buzzer-total or HUD count)
+     (let ((index (the int amount)))
+       (when (and (>= index 0) (< index IOS_OCEAN_FLY_TOTAL))
+         (logior! (-> *ios-ocean-progress* add-flies) (ash 1 index))
+         (format 0 "ios-open-ocean: got ocean scout fly ~D~%" index))
+       ;; the HUD's fly counter tallies this (stock sets it to the level's count on level-enter, which showed 0 or 7
+       ;; for ocean flies, user 2026-10-21): the ocean's count while it is shown
+       (set! (-> this buzzer) (the float (ios-ocean-bit-count (ios-ocean-flies))))
+       (set-time! (-> this buzzer-pickup-time)))
+     (-> this buzzer))
+    (else (*ios-ocean-stock-pickup* this kind amount source-handle))))
+
+(defun ios-open-ocean-edge-at ((pos vector))
+  "Distance from POS to the nearest level territory's line (> 0: in the Open Ocean), without touching the readout."
+  (let ((nearest *ios-open-ocean-nearest*)
+        (edge *ios-open-ocean-edge*))
+    (let ((result (ios-open-ocean-measure pos)))
+      (set! *ios-open-ocean-nearest* nearest)
+      (set! *ios-open-ocean-edge* edge)
+      result)))
+
+;; -- ocean power cells --
+;;
+;; The stock power cell (collectables.gc fuel-cell: model, glow, hum, touch pickup) without its victory sequence: in
+;; the water there is no animation for it, so touching one just plays the cell sound and starburst and counts it
+;; (user 2026-10-21). Its 'get-pickup (amount IOS_OCEAN_CELL_PICKUP_BASE + index) goes to the pickup-collectable!
+;; wrapper below.
+
+(deftype ios-ocean-cell (fuel-cell) ())
+
+(defstate pickup (ios-ocean-cell)
+  :virtual #t
+  :enter
+    (behavior ((arg0 object) (arg1 handle))
+      (set-time! (-> self state-time)))
+  :trans
+    (behavior ()
+      0)
+  :code
+    (behavior ((arg0 object) (arg1 handle))
+      (logclear! (-> self mask) (process-mask actor-pause))
+      (clear-collide-with-as (-> self root))
+      (if (nonzero? (-> self sound)) (stop! (-> self sound)))
+      (if (nonzero? (-> self part)) (kill-and-free-particles (-> self part)))
+      (logior! (-> self draw status) (draw-status hidden))
+      (sound-play "pu-powercell")
+      (process-spawn part-tracker :init part-tracker-init group-fuel-cell-starburst -1 #f #f #f (-> self root trans)
+                     :to *entity-pool*)
+      (send-event *target* 'get-pickup (-> self fact pickup-type) (-> self fact pickup-amount))
+      (auto-save-command 'auto-save 0 0 *default-pool*)
+      (suspend-for (seconds 1))
+      (deactivate self)))
+
+(defun ios-ocean-spawn-cell ((pos vector) (index int) (parent process-tree))
+  "Ocean power cell INDEX floating at POS."
+  (let ((fact (new 'static 'fact-info))
+        (vel (new 'stack-no-clear 'vector)))
+    (set! (-> fact options) (fact-options))
+    (set! (-> fact pickup-type) (pickup-type fuel-cell))
+    (set! (-> fact pickup-spawn-amount) (the float (+ IOS_OCEAN_CELL_PICKUP_BASE index)))
+    (set-vector! vel 0.0 0.0 0.0 0.0)
+    (process-spawn ios-ocean-cell :init fuel-cell-init-by-other pos vel fact (ios-ocean-entity) :to parent)))
+
+;; -- barrel --
+
+;; the ocean scout fly a fly box releases (states below, "ocean scout fly")
+(deftype ios-ocean-buzzer (buzzer) ())
+
+(defskelgroup *ios-ocean-keg-sg*
+  keg
+  keg-lod0-jg
+  keg-idle-ja
+  ((keg-lod0-mg (meters 20)) (keg-lod1-mg (meters 40)) (keg-lod2-mg (meters 999999)))
+  :bounds (static-spherem 0 0 0 4))
+
+(deftype ios-ocean-barrel (process-drawable)
+  ((root      collide-shape-moving :override)
+   (contents  int32)
+   (amount    int32)     ;; orbs, or the cell index
+   (look      int32)     ;; IOS_OCEAN_LOOK_*
+   (center    vector :inline)  ;; where the barrel's middle floats
+   (heading   float)     ;; drift direction
+   (spin      float)     ;; the barrel's own yaw
+   (spin-rate float)
+   (phase     float)
+   (attack-id uint32)
+   (smush     smush-control :inline))
+  (:states
+   ios-ocean-barrel-float
+   ios-ocean-barrel-break))
+
+(defbehavior ios-ocean-barrel-event ios-ocean-barrel ((proc process) (argc int) (message symbol) (block event-message-block))
+  (case message
+    (('attack)
+     (case (-> block param 1)
+       (('flop)
+        (send-event proc 'get-attack-count 1)
+        (go ios-ocean-barrel-break))
+       (else
+        ;; any other hit: bounce, like an iron crate
+        (when (!= (-> block param 2) (-> self attack-id))
+          (set! (-> self attack-id) (-> block param 2))
+          (if (= (-> self smush amp) 0.0) (sound-play "icrate-nobreak"))
+          (activate! (-> self smush) 0.1 90 150 1.0 1.0))
+        #f)))))
+
+(defbehavior ios-ocean-barrel-post ios-ocean-barrel ()
+  (rider-trans)
+  (let ((f0-0 (update! (-> self smush))))
+    (set! (-> self root scale x) (* IOS_OCEAN_BARREL_SCALE (+ 1.0 (/ f0-0 -2))))
+    (set! (-> self root scale y) (* IOS_OCEAN_BARREL_SCALE (+ 1.0 f0-0)))
+    (set! (-> self root scale z) (* IOS_OCEAN_BARREL_SCALE (+ 1.0 (/ f0-0 -2)))))
+  (rider-post))
+
+(defstate ios-ocean-barrel-float (ios-ocean-barrel)
+  :event ios-ocean-barrel-event
+  :code
+    (behavior ()
+      (loop
+        (let ((trans (-> self center))
+              (step (* IOS_OCEAN_BARREL_DRIFT (seconds-per-frame))))
+          ;; drift, and turn away from anything that isn't open water ahead
+          (let ((ahead (new 'stack-no-clear 'vector))
+                (col (new 'stack-no-clear 'vector)))
+            (set-vector! ahead
+                         (+ (-> trans x) (* (meters 6) (sin (-> self heading))))
+                         (-> trans y)
+                         (+ (-> trans z) (* (meters 6) (cos (-> self heading))))
+                         1.0)
+            (when (and (zero? (logand (-> *display* base-frame-counter) 31))
+                       (not (ios-fish-water-column ahead self col)))
+              (+! (-> self heading) (degrees 150))))
+          (+! (-> trans x) (* step (sin (-> self heading))))
+          (+! (-> trans z) (* step (cos (-> self heading))))
+          (set! (-> trans y) (+ (ocean-get-height trans) IOS_OCEAN_BARREL_FLOAT_Y))
+          ;; slow turn, and a gentle roll on the waves
+          (+! (-> self spin) (* (-> self spin-rate) (seconds-per-frame)))
+          (+! (-> self phase) (* (degrees 60) (seconds-per-frame)))
+          (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (-> self spin))
+          (quaternion-rotate-local-z! (-> self root quat) (-> self root quat) (* (degrees 6) (sin (-> self phase))))
+          (quaternion-rotate-local-x! (-> self root quat) (-> self root quat) (* (degrees 3) (sin (* 0.7 (-> self phase)))))
+          ;; the crate barrel stands upright with its origin at the base: tip it over. Crate models (barrel, fly box)
+          ;; have their origin at the base, so it moves for their middle to stay on the floating point.
+          (if (= (-> self look) IOS_OCEAN_LOOK_CRATE_BARREL)
+            (quaternion-rotate-local-x! (-> self root quat) (-> self root quat) (degrees 90)))
+          (cond
+            ((!= (-> self look) IOS_OCEAN_LOOK_KEG)
+             (let ((half (new 'stack-no-clear 'vector)))
+               (set-vector! half 0.0 IOS_OCEAN_CRATE_BARREL_HALF 0.0 1.0)
+               (vector-orient-by-quat! half half (-> self root quat))
+               (vector-! (-> self root trans) trans half)
+               (set! (-> self root trans w) 1.0)))
+            (else (set! (-> self root trans quad) (-> trans quad)))))
+        ;; a fly box jiggles now and then, like the stock scout fly crate (crate-buzzer wait)
+        (when (and (= (-> self look) IOS_OCEAN_LOOK_FLY_BOX) (= (-> self smush amp) 0.0) (rand-vu-percent? 0.01))
+          (spawn (-> self part) (-> self center))
+          (activate! (-> self smush) 0.2 90 150 1.0 1.0))
+        (when (nonzero? (-> self sound))
+          (update-trans! (-> self sound) (-> self center))
+          (update! (-> self sound)))
+        (suspend)))
+  :post ios-ocean-barrel-post)
+
+(defstate ios-ocean-barrel-break (ios-ocean-barrel)
+  :code
+    (behavior ()
+      (clear-collide-with-as (-> self root))
+      (when (nonzero? (-> self sound))
+        (stop! (-> self sound))
+        (set! (-> self sound) (the-as ambient-sound 0)))
+      (if (= (-> self look) IOS_OCEAN_LOOK_CRATE_BARREL) (sound-play "wcrate-break") (sound-play "icrate-break"))
+      (sound-play "smack-surface")
+      (if (= (-> self look) IOS_OCEAN_LOOK_FLY_BOX)
+        (process-spawn part-tracker :init part-tracker-init group-crate-steel-explode -1 #f #f #f (-> self center) :to *entity-pool*)
+        (process-spawn part-tracker :init part-tracker-init group-crate-explode -1 #f #f #f (-> self center) :to *entity-pool*))
+      (process-spawn part-tracker :init part-tracker-init group-part-water-splash -1 #f #f #f (-> self center) :to *entity-pool*)
+      (logior! (-> self draw status) (draw-status hidden))
+      (let ((pos (new 'stack-no-clear 'vector)))
+        (set! (-> pos quad) (-> self center quad))
+        (case (-> self contents)
+          ((IOS_OCEAN_BARREL_CELL)
+           ;; above the water, to be touched
+           (set! (-> pos y) (+ (ocean-get-height pos) IOS_OCEAN_CELL_HOVER))
+           (ios-ocean-spawn-cell pos (-> self amount) *entity-pool*))
+          ((IOS_OCEAN_BARREL_FLY)
+           ;; the scout fly hops up out of the box and hovers above the water
+           (set! (-> pos y) (+ (ocean-get-height pos) IOS_OCEAN_CELL_HOVER))
+           (set! (-> self fact options) (fact-options))
+           (set! (-> self fact pickup-type) (pickup-type buzzer))
+           (set! (-> self fact pickup-spawn-amount) (the float (-> self amount)))
+           (let ((vel (new 'stack-no-clear 'vector)))
+             (set-vector! vel 0.0 57001.605 0.0 1.0)
+             (process-spawn ios-ocean-buzzer :init buzzer-init-by-other pos vel (-> self fact) (-> self entity)
+                            :to *entity-pool*)))
+          ((IOS_OCEAN_BARREL_ORBS)
+           (+! (-> pos y) (meters 1))
+           (set! (-> self fact options) (fact-options instant-collect))
+           (birth-pickup-at-point pos (pickup-type money) (the float (-> self amount)) #t *entity-pool* (-> self fact)))
+          (else
+           (+! (-> pos y) (meters 1))
+           (set! (-> self fact options) (fact-options instant-collect))
+           (birth-pickup-at-point pos (pickup-type eco-green) 1.0 #f *entity-pool* (-> self fact)))))
+      (suspend-for (seconds 0.2))
+      (deactivate self)))
+
+(defbehavior ios-ocean-barrel-init-by-other ios-ocean-barrel ((pos vector) (contents int) (amount int) (look int))
+  (set! (-> self entity) (ios-ocean-entity))
+  (stack-size-set! (-> self main-thread) 512)
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (logior! (-> self mask) (process-mask crate))
+  (let ((cshape (new 'process 'collide-shape-moving self (collide-list-enum usually-hit-by-player))))
+    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
+    (set! (-> cshape reaction) default-collision-reaction)
+    (set! (-> cshape no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
+    (alloc-riders cshape 1)
+    ;; the art's own collision mesh, as the stock keg and crates use (a sphere around it left Jak standing on air
+    ;; above the barrel, user 2026-10-21); an iron crate's: solid, rideable, only a strong attack (the dive) breaks it
+    (let ((prim (new 'process 'collide-shape-prim-mesh cshape (the-as uint 0) (the-as uint 0))))
+      (set! (-> prim prim-core collide-as) (collide-kind crate))
+      (set! (-> prim collide-with) (collide-kind target))
+      (set! (-> prim prim-core action) (collide-action solid rider-plat-sticky))
+      (set! (-> prim prim-core offense) (collide-offense normal-attack))
+      (set! (-> prim transform-index) 3)
+      ;; bounds: the keg's (misty-conveyor.gc keg-init-by-other) or the crates' (crates.gc params-init)
+      (if (= look IOS_OCEAN_LOOK_KEG)
+        (set-vector! (-> prim local-sphere) 0.0 0.0 0.0 16384.0)
+        (set-vector! (-> prim local-sphere) 0.0 3072.0 0.0 6963.2))
+      (set-root-prim! cshape prim))
+    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
+    (backup-collide-with-as cshape)
+    (set! (-> self root) cshape))
+  (set! (-> self center quad) (-> pos quad))
+  (set! (-> self center y) (+ (ocean-get-height pos) IOS_OCEAN_BARREL_FLOAT_Y))
+  (set! (-> self root trans quad) (-> self center quad))
+  (quaternion-identity! (-> self root quat))
+  (set! (-> self look) look)
+  (set-vector! (-> self root scale) IOS_OCEAN_BARREL_SCALE IOS_OCEAN_BARREL_SCALE IOS_OCEAN_BARREL_SCALE 1.0)
+  (set! (-> self contents) contents)
+  (set! (-> self amount) amount)
+  (set! (-> self heading) (rand-vu-float-range 0.0 (degrees 360)))
+  (set! (-> self spin) (rand-vu-float-range 0.0 (degrees 360)))
+  (set! (-> self spin-rate) (rand-vu-float-range (degrees -8) (degrees 8)))
+  (set! (-> self phase) (rand-vu-float-range 0.0 (degrees 360)))
+  (set! (-> self fact) (new 'process 'fact-info self (pickup-type none) 0.0))
+  (initialize-skeleton self
+                       (case look
+                         ((IOS_OCEAN_LOOK_CRATE_BARREL) *crate-barrel-sg*)
+                         ((IOS_OCEAN_LOOK_FLY_BOX) *crate-iron-sg*)
+                         (else *ios-ocean-keg-sg*))
+                       '())
+  ;; still: the keg's idle animation is Misty's conveyor roll
+  (set! (-> self skel effect) #f)
+  (cond
+    ((= contents IOS_OCEAN_BARREL_CELL)
+     (set! (-> self sound) (new 'process 'ambient-sound (static-sound-spec "powercell-idle" :fo-max 40) (-> self root trans))))
+    ((= contents IOS_OCEAN_BARREL_FLY)
+     ;; the stock scout fly crate's buzz and puff (crates.gc crate-buzzer art-init)
+     (set! (-> self part) (create-launch-control group-buzzer-crate self))
+     (set! (-> self sound)
+           (new 'process 'ambient-sound (static-sound-spec "buzzer" :pitch-mod -762 :fo-max 40) (-> self root trans)))))
+  (go ios-ocean-barrel-float))
+
+;; -- ocean scout fly (phase 4) --
+;;
+;; The stock scout fly (collectables.gc buzzer: model, particles, buzz, pickup sound) without its task: stock wait
+;; checks the buzzer task's reminder bits and stock pickup closes the task and births that level's cell. Collecting
+;; it sends 'get-pickup buzzer with its index (amount), which the pickup-collectable! wrapper puts into the ocean's
+;; flies; the seventh one then pops out the ocean's last power cell (IOS_OCEAN_FLY_CELL), like stock.
+
+(defstate wait (ios-ocean-buzzer)
+  :virtual #t
+  :code
+    (behavior ()
+      (loop
+        (transform-post)
+        (animate self)
+        (suspend))))
+
+(defstate pickup (ios-ocean-buzzer)
+  :virtual #t
+  :code
+    (behavior ((arg0 object) (arg1 handle))
+      (logclear! (-> self mask) (process-mask actor-pause))
+      (sound-play "buzzer-pickup")
+      (ja-channel-set! 0)
+      (clear-collide-with-as (-> self root))
+      (ja-post)
+      (if (nonzero? (-> self sound)) (stop! (-> self sound)))
+      ;; stock: a fly flies to the HUD's fly counter (now showing the ocean's count)
+      (let ((fly (manipy-spawn (-> self root trans) #f *buzzer-sg* #f :to *entity-pool*)))
+        (send-event (ppointer->process fly) 'become-hud-object (ppointer->process (-> *hud-parts* buzzers))))
+      (when (and (= (ios-ocean-bit-count (ios-ocean-flies)) IOS_OCEAN_FLY_TOTAL)
+                 (not (ios-ocean-cell-collected? IOS_OCEAN_FLY_CELL)))
+        (when (ios-ocean-spawn-cell (vector+! (new 'stack-no-clear 'vector) (-> self root trans) (new 'static 'vector :y 4096.0 :w 1.0))
+                                    IOS_OCEAN_FLY_CELL
+                                    self)
+          (while (-> self child)
+            (suspend))))))
+
+;; -- seagulls (phase 1) --
+;;
+;; Sentinel Beach's seagull circles over the Open Ocean, alone or in small groups (user 2026-10-19), flapping and now
+;; and then gliding, banked into its turn. A flock's centre wanders around Jak, high above the water; each gull
+;; orbits it at its own radius, speed and height. The flock cries now and then ("seagulls-2", the stock squall,
+;; which is in Sandover's sound bank: heard while village1 is loaded, silent elsewhere). Like the barrels, the art is
+;; resident level-default art (*ios-ocean-gull-art*), the model in Jak1Level-ios-ocean.fr3z.
+
+;; set by the host every frame (SyncOpenOceanLevelOption): the seagull art is resident, gulls may spawn
+(define-perm *ios-ocean-gull-art* symbol #f)
+
+(defconstant IOS_OCEAN_FLOCK_MAX 2)
+(defconstant IOS_OCEAN_FLOCK_CHECK (seconds 12))
+(defconstant IOS_OCEAN_FLOCK_CHANCE 0.5)
+(defconstant IOS_OCEAN_FLOCK_SPAWN_MIN (meters 40))
+(defconstant IOS_OCEAN_FLOCK_SPAWN_MAX (meters 90))
+(defconstant IOS_OCEAN_FLOCK_NEAR (meters 20))       ;; the centre wanders to spots this far ...
+(defconstant IOS_OCEAN_FLOCK_FAR (meters 60))        ;; ... to this far from Jak
+(defconstant IOS_OCEAN_FLOCK_SPEED (meters 5))       ;; per second
+(defconstant IOS_OCEAN_FLOCK_HEIGHT_MIN (meters 14)) ;; above the water
+(defconstant IOS_OCEAN_FLOCK_HEIGHT_MAX (meters 26))
+(defconstant IOS_OCEAN_GULL_BANK (degrees 25))
+
+(defskelgroup *ios-ocean-gull-sg*
+  seagull
+  seagull-lod0-jg
+  seagull-idle-ja
+  ((seagull-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 0 0 2))
+
+(deftype ios-ocean-gull-flock (process)
+  ((center    vector :inline)
+   (goal      vector :inline)
+   (goal-time time-frame)
+   (cry-time  time-frame)
+   (cry-delay time-frame))
+  (:states
+   ios-ocean-gull-flock-idle))
+
+(deftype ios-ocean-gull (process-drawable)
+  ((radius float)
+   (angle  float)
+   (rate   float)    ;; orbit speed (angle units per second); the sign is the direction
+   (lift   float)    ;; height above the flock centre
+   (bob    float))
+  (:states
+   ios-ocean-gull-fly))
+
+(defun ios-ocean-flock-pick-goal ((flock ios-ocean-gull-flock))
+  (let ((angle (rand-vu-float-range 0.0 (degrees 360)))
+        (dist (rand-vu-float-range IOS_OCEAN_FLOCK_NEAR IOS_OCEAN_FLOCK_FAR)))
+    (set-vector! (-> flock goal)
+                 (+ (-> (target-pos 0) x) (* dist (sin angle)))
+                 0.0
+                 (+ (-> (target-pos 0) z) (* dist (cos angle)))
+                 1.0)
+    (set! (-> flock goal y)
+          (+ (ocean-get-height (-> flock goal)) (rand-vu-float-range IOS_OCEAN_FLOCK_HEIGHT_MIN IOS_OCEAN_FLOCK_HEIGHT_MAX)))
+    (set-time! (-> flock goal-time)))
+  0)
+
+(defstate ios-ocean-gull-flock-idle (ios-ocean-gull-flock)
+  :code
+    (behavior ()
+      (loop
+        (if (or (not (-> self child)) (not *target*)) (deactivate self))
+        (if (time-elapsed? (-> self goal-time) (seconds 10)) (ios-ocean-flock-pick-goal self))
+        (let ((to (new 'stack-no-clear 'vector)))
+          (vector-! to (-> self goal) (-> self center))
+          (let ((dist (vector-length to))
+                (step (* IOS_OCEAN_FLOCK_SPEED (seconds-per-frame))))
+            (if (< step dist) (vector+*! (-> self center) (-> self center) to (/ step dist)))))
+        (when (time-elapsed? (-> self cry-time) (-> self cry-delay))
+          (set-time! (-> self cry-time))
+          (set! (-> self cry-delay) (the-as time-frame (rand-vu-int-range (seconds 4) (seconds 12))))
+          (sound-play "seagulls-2" :position (the-as symbol (-> self center))))
+        (suspend))))
+
+(defbehavior ios-ocean-gull-move ios-ocean-gull ()
+  (let ((flock (the-as ios-ocean-gull-flock (ppointer->process (-> self parent))))
+        (trans (-> self root trans)))
+    (+! (-> self angle) (* (-> self rate) (seconds-per-frame)))
+    (+! (-> self bob) (* (degrees 40) (seconds-per-frame)))
+    (set-vector! trans
+                 (+ (-> flock center x) (* (-> self radius) (sin (-> self angle))))
+                 (+ (-> flock center y) (-> self lift) (* (meters 1.5) (sin (-> self bob))))
+                 (+ (-> flock center z) (* (-> self radius) (cos (-> self angle))))
+                 1.0)
+    ;; facing along the orbit (the gull faces +z, yaw = atan(x, z) as stock seagull.gc), banked into the turn
+    (let ((dir (if (< 0.0 (-> self rate)) 1.0 -1.0)))
+      (quaternion-axis-angle! (-> self root quat)
+                              0.0
+                              1.0
+                              0.0
+                              (atan (* dir (cos (-> self angle))) (* dir (- (sin (-> self angle))))))
+      (quaternion-rotate-local-z! (-> self root quat) (-> self root quat) (* dir (- IOS_OCEAN_GULL_BANK)))))
+  0)
+
+(defstate ios-ocean-gull-fly (ios-ocean-gull)
+  :code
+    (behavior ()
+      (loop
+        (ja-no-eval :group! seagull-fly-ja :num! (seek!) :frame-num 0.0)
+        (until (ja-done? 0)
+          (ja-blend-eval)
+          (ios-ocean-gull-move)
+          (suspend)
+          (ja :num! (seek!)))
+        ;; now and then a glide
+        (when (rand-vu-percent? 0.35)
+          (ja-channel-push! 1 (seconds 0.25))
+          (dotimes (i (rand-vu-int-range 2 4))
+            (ja-no-eval :group! seagull-slowfly-ja :num! (seek!) :frame-num 0.0)
+            (until (ja-done? 0)
+              (ja-blend-eval)
+              (ios-ocean-gull-move)
+              (suspend)
+              (ja :num! (seek!))))
+          (ja-channel-push! 1 (seconds 0.25)))))
+  :post ja-post)
+
+(defbehavior ios-ocean-gull-init-by-other ios-ocean-gull ((radius float) (angle float) (rate float) (lift float))
+  (set! (-> self entity) (ios-ocean-entity))
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! (-> self root) (new 'process 'trsqv))
+  (set! (-> self radius) radius)
+  (set! (-> self angle) angle)
+  (set! (-> self rate) rate)
+  (set! (-> self lift) lift)
+  (set! (-> self bob) (rand-vu-float-range 0.0 (degrees 360)))
+  (initialize-skeleton self *ios-ocean-gull-sg* '())
+  ;; silent wings (the flap sounds are the beach's)
+  (set! (-> self skel effect) #f)
+  (ios-ocean-gull-move)
+  (go ios-ocean-gull-fly))
+
+(defbehavior ios-ocean-gull-flock-init-by-other ios-ocean-gull-flock ((pos vector) (count int))
+  (set! (-> self entity) (ios-ocean-entity))
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! (-> self center quad) (-> pos quad))
+  (set! (-> self center y)
+        (+ (ocean-get-height pos) (rand-vu-float-range IOS_OCEAN_FLOCK_HEIGHT_MIN IOS_OCEAN_FLOCK_HEIGHT_MAX)))
+  (ios-ocean-flock-pick-goal self)
+  (set-time! (-> self cry-time))
+  (set! (-> self cry-delay) (the-as time-frame (rand-vu-int-range (seconds 1) (seconds 5))))
+  ;; one orbit direction per flock, each gull its own ring
+  (let ((dir (if (rand-vu-percent? 0.5) 1.0 -1.0)))
+    (dotimes (i count)
+      (process-spawn ios-ocean-gull
+                     :init ios-ocean-gull-init-by-other
+                     (rand-vu-float-range (meters 6) (meters 16))
+                     (rand-vu-float-range 0.0 (degrees 360))
+                     (* dir (rand-vu-float-range (degrees 25) (degrees 45)))
+                     (rand-vu-float-range (meters -3) (meters 3))
+                     :to self)))
+  (go ios-ocean-gull-flock-idle))
+
+;; -- sea serpent (phase 6) --
+;;
+;; A rare encounter (user 2026-10-19): Sentinel Beach's lurkerworm, much larger, rises out of the sea near Jak,
+;; slower than the stock worm, turns to face him and bites (the stock chomp; its head hurts Jak like the stock
+;; worm's). Now and then it sinks back and may surface again somewhere else close by; after a few dives it is gone.
+;; Hitting it only makes it dive. Rising and sinking throw up heavy splashes all around it (common water splash
+;; particles; stock worm-rise1 / worm-sink with water-explosion, large-splash and boulder-splash). The worm's own sand
+;; particles and body twister are beach level code, so they aren't used; the whole body turns instead. Art: resident
+;; level-default lurkerworm (*ios-ocean-worm-art*), model in Jak1Level-ios-ocean.fr3z.
+
+(defun ios-ocean-spawn-spot-at ((out vector) (proc process) (near float) (far float))
+  "A random open-water spot in the Open Ocean NEAR-FAR from Jak, or #f."
+  (let ((col (new 'stack-no-clear 'vector))
+        (found #f))
+    (dotimes (try 4)
+      (when (not found)
+        (let ((angle (rand-vu-float-range 0.0 (degrees 360)))
+              (dist (rand-vu-float-range near far)))
+          (set-vector! out (+ (-> (target-pos 0) x) (* dist (sin angle))) 0.0 (+ (-> (target-pos 0) z) (* dist (cos angle))) 1.0)
+          (set! (-> out y) (ocean-get-height out))
+          (if (and (< 0.0 (ios-open-ocean-edge-at out)) (ios-fish-water-column out proc col)) (set! found #t)))))
+    found))
+
+;; fishermans-boat.gc (village1 level code): Jak at the free boat's wheel
+(define-extern *ios-boat-driving* symbol)
+
+;; set by the host every frame (SyncOpenOceanLevelOption): the lurkerworm art is resident, the serpent may come
+(define-perm *ios-ocean-worm-art* symbol #f)
+
+(defconstant IOS_SERPENT_SCALE 4.0)
+(defconstant IOS_SERPENT_ANIM 0.55)              ;; animation speed (the stock worm's is 1)
+;; much rarer (user 2026-10-21): about one an hour at sea
+(defconstant IOS_SERPENT_CHECK (seconds 180))    ;; how often it may come ...
+(defconstant IOS_SERPENT_CHANCE 0.06)            ;; ... and how likely
+(defconstant IOS_SERPENT_COOLDOWN (seconds 900)) ;; after one is gone
+(defconstant IOS_SERPENT_CHASE (meters 2))       ;; per second, toward Jak while it is up
+(defconstant IOS_SERPENT_CLOSE (meters 14))      ;; ... until this close
+;; Seen from far off its body doesn't draw right (user 2026-10-21, only the eyes): it never stays up that far away.
+(defconstant IOS_SERPENT_LEAVE (meters 45))      ;; Jak this far: it dives (and doesn't come back up)
+(defconstant IOS_SERPENT_VANISH (meters 70))     ;; this far: straight under, whatever it is doing
+(defconstant IOS_SERPENT_BOAT_BITE (meters 9))   ;; its head this close to Jak at the wheel: off the boat and bitten
+(defconstant IOS_SERPENT_SPAWN_MIN (meters 20))
+(defconstant IOS_SERPENT_SPAWN_MAX (meters 35))
+(defconstant IOS_SERPENT_REACH (meters 24))      ;; strikes when Jak is this close
+(defconstant IOS_SERPENT_SURFACINGS 3)           ;; at most this many risings per encounter
+(defconstant IOS_SERPENT_TURN (degrees 35))      ;; per second
+
+(defskelgroup *ios-ocean-serpent-sg*
+  lurkerworm
+  lurkerworm-lod0-jg
+  lurkerworm-idle-ja
+  ((lurkerworm-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 8 0 26)
+  :longest-edge (meters 6))
+
+(deftype ios-ocean-serpent (process-drawable)
+  ((root        collide-shape-moving :override)
+   (head-tilt   float)
+   (yaw         float)
+   (surfacings  int32)
+   (strikes     int32)
+   (splash-time time-frame)
+   (bite-pending symbol))  ;; Jak was just taken off the boat's wheel: bite him next frame
+  (:states
+   ios-ocean-serpent-under
+   ios-ocean-serpent-rise
+   ios-ocean-serpent-rest
+   ios-ocean-serpent-strike
+   ios-ocean-serpent-sink))
+
+(defbehavior ios-ocean-serpent-prebind ios-ocean-serpent ((arg0 pointer) (arg1 int) (arg2 ios-ocean-serpent))
+  "Stock lurkerworm-prebind-function: tilts the head joint toward Jak."
+  (let ((q (new 'stack-no-clear 'quaternion))
+        (joint (&+ arg0 432)))
+    (quaternion-axis-angle! q -1.0 0.0 0.0 (-> arg2 head-tilt))
+    (quaternion*! (the-as quaternion joint) (the-as quaternion joint) q))
+  0
+  (none))
+
+(defbehavior ios-ocean-serpent-splash ios-ocean-serpent ((count int) (radius float))
+  "Splashes in a ring around the serpent's base on the water."
+  (let ((pos (new 'stack-no-clear 'vector))
+        (base (ocean-get-height (-> self root trans))))
+    (dotimes (i count)
+      (let ((angle (rand-vu-float-range 0.0 (degrees 360)))
+            (dist (rand-vu-float-range (* 0.3 radius) radius)))
+        (set-vector! pos
+                     (+ (-> self root trans x) (* dist (sin angle)))
+                     base
+                     (+ (-> self root trans z) (* dist (cos angle)))
+                     1.0)
+        (process-spawn part-tracker :init part-tracker-init group-part-water-splash -1 #f #f #f pos :to *entity-pool*))))
+  0)
+
+(defbehavior ios-ocean-serpent-face ios-ocean-serpent ()
+  "Turn the body toward Jak and the head up/down at him, slowly."
+  (when *target*
+    (let ((to (vector-! (new 'stack-no-clear 'vector) (target-pos 0) (-> self root trans))))
+      (set! (-> self yaw)
+            (deg-seek (-> self yaw) (atan (-> to x) (-> to z)) (* IOS_SERPENT_TURN (seconds-per-frame))))
+      (let ((tilt (atan (- (-> to y) (meters 20)) (sqrtf (+ (* (-> to x) (-> to x)) (* (-> to z) (-> to z)))))))
+        (seek! (-> self head-tilt) tilt (* (degrees 30) (seconds-per-frame))))
+      (set! (-> self head-tilt) (fmin (degrees 45) (fmax (degrees -30) (-> self head-tilt))))))
+  (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (-> self yaw))
+  ;; the base stays on the waves
+  (set! (-> self root trans y) (ocean-get-height (-> self root trans)))
+  0)
+
+(defbehavior ios-ocean-serpent-chase ios-ocean-serpent ()
+  "While it is up it slowly closes in on Jak, through open water only (user 2026-10-21)."
+  (when *target*
+    (let* ((to (vector-! (new 'stack-no-clear 'vector) (target-pos 0) (-> self root trans)))
+           (dist (sqrtf (+ (* (-> to x) (-> to x)) (* (-> to z) (-> to z))))))
+      (when (< IOS_SERPENT_CLOSE dist)
+        (let ((step (fmin (* IOS_SERPENT_CHASE (seconds-per-frame)) (- dist IOS_SERPENT_CLOSE)))
+              (next (new 'stack-no-clear 'vector))
+              (col (new 'stack-no-clear 'vector)))
+          (set! (-> next quad) (-> self root trans quad))
+          (+! (-> next x) (* step (/ (-> to x) dist)))
+          (+! (-> next z) (* step (/ (-> to z) dist)))
+          (if (ios-fish-water-column next self col)
+            (set! (-> self root trans quad) (-> next quad)))))))
+  0)
+
+(defbehavior ios-ocean-serpent-boat-bite ios-ocean-serpent ()
+  "Jak at the boat's wheel is grabbed, so the head's touch never reaches him: when the head comes close, take him
+   off the wheel (the boat leaves drive mode when Jak is no longer grabbed) and bite him the next frame."
+  (cond
+    ((-> self bite-pending)
+     (set! (-> self bite-pending) #f)
+     (if *target* (send-event *target* 'attack #f (new 'static 'attack-info))))
+    ((and *target* (= *ios-boat-driving* #t))
+     (let ((head (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data 11))))
+       (when (< (vector-vector-distance head (target-pos 0)) IOS_SERPENT_BOAT_BITE)
+         (process-release? *target*)
+         (set! (-> self bite-pending) #t)))))
+  0)
+
+(defbehavior ios-ocean-serpent-far-check ios-ocean-serpent ((sinking symbol))
+  "Every frame it is up (state :trans, so `go` leaves the state cleanly): Jak IOS_SERPENT_LEAVE away -> it dives;
+   IOS_SERPENT_VANISH away -> it is gone under the waves at once, in a burst of splashes."
+  (let ((dist (if *target* (vector-vector-xz-distance (-> self root trans) (target-pos 0)) (meters 10000))))
+    (cond
+      ((< IOS_SERPENT_VANISH dist)
+       (ios-ocean-serpent-splash 8 (meters 7))
+       (sound-play "large-splash" :position (the-as symbol (-> self root trans)))
+       (go ios-ocean-serpent-under))
+      ((and (not sinking) (< IOS_SERPENT_LEAVE dist))
+       (go ios-ocean-serpent-sink))))
+  0)
+
+(defbehavior ios-ocean-serpent-event ios-ocean-serpent ((proc process) (argc int) (message symbol) (block event-message-block))
+  (case message
+    (('attack)
+     ;; hitting it only sends it under
+     (if (and (!= (-> self next-state name) 'ios-ocean-serpent-sink) (!= (-> self next-state name) 'ios-ocean-serpent-under))
+       (go ios-ocean-serpent-sink)))
+    (('touch)
+     ;; the head bites (prim 1), like the stock worm
+     (if ((method-of-type touching-shapes-entry prims-touching?)
+          (the-as touching-shapes-entry (-> block param 0))
+          (-> self root)
+          (the-as uint 1))
+       (send-event proc 'attack (-> block param 0) (new 'static 'attack-info))))))
+
+(defbehavior ios-ocean-serpent-post ios-ocean-serpent ()
+  (ios-ocean-serpent-face)
+  (transform-post)
+  0
+  (none))
+
+(defstate ios-ocean-serpent-under (ios-ocean-serpent)
+  :code
+    (behavior ()
+      ;; hidden below the waves; surface somewhere near Jak, or leave
+      (ja-channel-set! 0)
+      (logior! (-> self draw status) (draw-status hidden))
+      (clear-collide-with-as (-> self root))
+      (suspend-for (the-as time-frame (rand-vu-int-range (seconds 2) (seconds 5))))
+      (let ((spot (new 'stack-no-clear 'vector)))
+        (when (or (>= (-> self surfacings) IOS_SERPENT_SURFACINGS)
+                  (not (ios-in-open-ocean?))
+                  (not *target*)
+                  (< IOS_SERPENT_LEAVE (vector-vector-xz-distance (-> self root trans) (target-pos 0)))
+                  (not (ios-ocean-spawn-spot-at spot self IOS_SERPENT_SPAWN_MIN IOS_SERPENT_SPAWN_MAX)))
+          (deactivate self))
+        (set! (-> self root trans quad) (-> spot quad)))
+      (go ios-ocean-serpent-rise)))
+
+(defstate ios-ocean-serpent-rise (ios-ocean-serpent)
+  :event ios-ocean-serpent-event
+  :trans
+    (behavior ()
+      (ios-ocean-serpent-far-check #f))
+  :code
+    (behavior ()
+      (+! (-> self surfacings) 1)
+      (set! (-> self strikes) (rand-vu-int-range 2 4))
+      (logclear! (-> self draw status) (draw-status hidden))
+      (restore-collide-with-as (-> self root))
+      (ios-ocean-serpent-face)
+      (sound-play "water-explosion" :position (the-as symbol (-> self root trans)))
+      (sound-play "worm-rise1" :position (the-as symbol (-> self root trans)))
+      (sound-play "large-splash" :position (the-as symbol (-> self root trans)))
+      (ios-ocean-serpent-splash 8 (meters 7))
+      (ja-channel-set! 1)
+      (ja-no-eval :group! lurkerworm-rise-ja :num! (seek! max IOS_SERPENT_ANIM) :frame-num 0.0)
+      (until (ja-done? 0)
+        (when (time-elapsed? (-> self splash-time) (seconds 0.12))
+          (set-time! (-> self splash-time))
+          (ios-ocean-serpent-splash 2 (meters 5)))
+        (suspend)
+        (ja :num! (seek! max IOS_SERPENT_ANIM)))
+      (sound-play "boulder-splash" :position (the-as symbol (-> self root trans)))
+      (go ios-ocean-serpent-rest))
+  :post ios-ocean-serpent-post)
+
+(defstate ios-ocean-serpent-rest (ios-ocean-serpent)
+  :event ios-ocean-serpent-event
+  :trans
+    (behavior ()
+      (ios-ocean-serpent-far-check #f))
+  :code
+    (behavior ()
+      (let ((loops 0))
+        (loop
+          (ja-no-eval :group! lurkerworm-idle-ja :num! (seek! max IOS_SERPENT_ANIM) :frame-num 0.0)
+          (until (ja-done? 0)
+            (ja-blend-eval)
+            ;; water running off it
+            (when (time-elapsed? (-> self splash-time) (seconds 0.6))
+              (set-time! (-> self splash-time))
+              (ios-ocean-serpent-splash 1 (meters 4)))
+            (ios-ocean-serpent-chase)
+            (when (and (> (-> self strikes) 0)
+                       *target*
+                       (< (vector-vector-xz-distance (-> self root trans) (target-pos 0)) IOS_SERPENT_REACH)
+                       (rand-vu-percent? 0.02))
+              (go ios-ocean-serpent-strike))
+            (suspend)
+            (ja :num! (seek! max IOS_SERPENT_ANIM)))
+          (+! loops 1)
+          ;; it may go back under at any time (and does once out of bites)
+          (if (or (<= (-> self strikes) 0) (and (>= loops 2) (rand-vu-percent? 0.3)) (>= loops 6))
+            (go ios-ocean-serpent-sink)))))
+  :post ios-ocean-serpent-post)
+
+(defstate ios-ocean-serpent-strike (ios-ocean-serpent)
+  :event ios-ocean-serpent-event
+  :trans
+    (behavior ()
+      (ios-ocean-serpent-far-check #f))
+  :code
+    (behavior ()
+      (+! (-> self strikes) -1)
+      (sound-play "worm-taunt" :position (the-as symbol (-> self root trans)))
+      (ja-channel-push! 1 (seconds 0.2))
+      (ja-no-eval :group! lurkerworm-chomp-ja :num! (seek! max (* 1.3 IOS_SERPENT_ANIM)) :frame-num 0.0)
+      (until (ja-done? 0)
+        (ja-blend-eval)
+        (ios-ocean-serpent-boat-bite)
+        (suspend)
+        (ja :num! (seek! max (* 1.3 IOS_SERPENT_ANIM))))
+      ;; the bite that took Jak off the wheel on the last frame
+      (if (-> self bite-pending) (ios-ocean-serpent-boat-bite))
+      (ja-channel-push! 1 (seconds 0.2))
+      (go ios-ocean-serpent-rest))
+  :post ios-ocean-serpent-post)
+
+(defstate ios-ocean-serpent-sink (ios-ocean-serpent)
+  :event ios-ocean-serpent-event
+  :trans
+    (behavior ()
+      (ios-ocean-serpent-far-check #t))
+  :code
+    (behavior ()
+      (sound-play "worm-sink" :position (the-as symbol (-> self root trans)))
+      (sound-play "water-explosion" :position (the-as symbol (-> self root trans)))
+      (ja-channel-push! 1 (seconds 0.2))
+      (ja-no-eval :group! lurkerworm-sink-ja :num! (seek! max IOS_SERPENT_ANIM) :frame-num 0.0)
+      (until (ja-done? 0)
+        (ja-blend-eval)
+        (when (time-elapsed? (-> self splash-time) (seconds 0.12))
+          (set-time! (-> self splash-time))
+          (ios-ocean-serpent-splash 2 (meters 5)))
+        (suspend)
+        (ja :num! (seek! max IOS_SERPENT_ANIM)))
+      (sound-play "large-splash" :position (the-as symbol (-> self root trans)))
+      (ios-ocean-serpent-splash 8 (meters 7))
+      (go ios-ocean-serpent-under))
+  :post ios-ocean-serpent-post)
+
+(defbehavior ios-ocean-serpent-init-by-other ios-ocean-serpent ((pos vector))
+  (set! (-> self entity) (ios-ocean-entity))
+  (stack-size-set! (-> self main-thread) 512)
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (logior! (-> self mask) (process-mask enemy))
+  ;; the stock worm's collision (lurkerworm init-from-entity!), radii scaled up: solid body spheres, biting head
+  (let ((cshape (new 'process 'collide-shape-moving self (collide-list-enum usually-hit-by-player))))
+    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
+    (set! (-> cshape reaction) default-collision-reaction)
+    (set! (-> cshape no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
+    (let ((group (new 'process 'collide-shape-prim-group cshape (the-as uint 6) 0)))
+      (set! (-> group prim-core collide-as) (collide-kind enemy))
+      (set! (-> group collide-with) (collide-kind target))
+      (set! (-> group prim-core action) (collide-action solid))
+      (set-vector! (-> group local-sphere) 0.0 (* IOS_SERPENT_SCALE 10240.0) 0.0 (* IOS_SERPENT_SCALE 24576.0))
+      (set-root-prim! cshape group)
+      (let ((joints (new 'static 'boxed-array :type int32 3 5 6 7 8)))
+        (dotimes (i 5)
+          (let ((body (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
+            (set! (-> body prim-core collide-as) (collide-kind enemy))
+            (set! (-> body collide-with) (collide-kind target))
+            (set! (-> body prim-core action) (collide-action solid))
+            (set! (-> body prim-core offense) (collide-offense indestructible))
+            (set! (-> body transform-index) (-> joints i))
+            (set-vector! (-> body local-sphere) 0.0 0.0 0.0 (* IOS_SERPENT_SCALE 4096.0))
+            (append-prim group body))))
+      (let ((head (new 'process 'collide-shape-prim-sphere cshape (the-as uint 1))))
+        (set! (-> head prim-core collide-as) (collide-kind enemy))
+        (set! (-> head collide-with) (collide-kind target))
+        (set! (-> head prim-core offense) (collide-offense normal-attack))
+        (set! (-> head transform-index) 11)
+        (set-vector! (-> head local-sphere) 0.0 0.0 0.0 (* IOS_SERPENT_SCALE 6144.0))
+        (append-prim group head)))
+    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
+    (backup-collide-with-as cshape)
+    (set! (-> self root) cshape))
+  (set! (-> self root trans quad) (-> pos quad))
+  (quaternion-identity! (-> self root quat))
+  (set-vector! (-> self root scale) IOS_SERPENT_SCALE IOS_SERPENT_SCALE IOS_SERPENT_SCALE 1.0)
+  (initialize-skeleton self *ios-ocean-serpent-sg* '())
+  (set! (-> self fact) (new 'process 'fact-info-enemy self (pickup-type none) 0.0))
+  (set! (-> self skel prebind-function) ios-ocean-serpent-prebind)
+  (set! (-> self head-tilt) 0.0)
+  (set! (-> self surfacings) 0)
+  (set! (-> self bite-pending) #f)
+  (let ((to (vector-! (new 'stack-no-clear 'vector) (target-pos 0) pos)))
+    (set! (-> self yaw) (atan (-> to x) (-> to z))))
+  (format 0 "ios-open-ocean: sea serpent~%")
+  (go ios-ocean-serpent-rise))
+
+;; -- Precursor ruin (phase 7a: rising, sinking, pillars, beacon) --
+;;
+;; Now and then an ancient Precursor ruin rises out of the Open Ocean some way off (user 2026-10-19): a cluster of Lost
+;; Precursor City's square-platform pillars (tall columns with a walkable top and their stock collision mesh, rideable
+;; while they move) climbing out of deep water with the jungle's Precursor tower rumble and splashes all around, a blue
+;; eco stream over the middle as a beacon. After a while (or once Jak has sailed far away) it sinks back. Later steps
+;; add the tile puzzle (7b), blue eco vent + launcher to an upper deck (7c) and the warp gate (7d). Art: resident
+;; level-default square-platform (*ios-ocean-ruin-art*), model in Jak1Level-ios-ocean.fr3z.
+
+;; set by the host every frame (SyncOpenOceanLevelOption): the square-platform art is resident, the ruin may rise
+(define-perm *ios-ocean-ruin-art* symbol #f)
+
+;; off for now (user 2026-10-21: until it is refined further)
+(defconstant IOS_RUIN_ENABLED #f)
+(defconstant IOS_RUIN_CHECK (seconds 180))     ;; how often it may rise ...
+(defconstant IOS_RUIN_CHANCE 0.3)              ;; ... and how likely (about every 10-15 min in the ocean)
+(defconstant IOS_RUIN_COOLDOWN (seconds 300))  ;; after it sank
+;; close enough to see and hear it rise (user 2026-10-19: at 150-250 m, low and in a storm, it went unnoticed)
+(defconstant IOS_RUIN_SPAWN_MIN (meters 70))
+(defconstant IOS_RUIN_SPAWN_MAX (meters 110))
+(defconstant IOS_RUIN_CLEARANCE (meters 40))   ;; this far inside the Open Ocean, away from every level
+(defconstant IOS_RUIN_DEPTH (meters 22))       ;; how far down it starts
+(defconstant IOS_RUIN_RISE 20.0)               ;; seconds to rise / to sink
+(defconstant IOS_RUIN_UP_MIN (seconds 480))    ;; stays up 8-10 minutes ...
+(defconstant IOS_RUIN_UP_MAX (seconds 600))
+(defconstant IOS_RUIN_LEAVE (meters 350))      ;; ... or until Jak is this far away
+(defconstant IOS_RUIN_TOP (meters 2.2))        ;; the lowest pillar tops above mean sea level (waves reach +-1.3 m)
+(defconstant IOS_RUIN_SPACING (meters 8.2))    ;; ring radius around the middle pillar (pillars are 8 m wide)
+(defconstant IOS_RUIN_SOUND_DIST (meters 35))  ;; its sounds play this far from Jak toward it (always heard)
+(defconstant IOS_RUIN_SHAKE_DIST (meters 150)) ;; the camera rumbles while it moves within this
+
+(defskelgroup *ios-ocean-pillar-sg*
+  square-platform
+  square-platform-lod0-jg
+  square-platform-idle-ja
+  ((square-platform-lod0-mg (meters 20)) (square-platform-lod1-mg (meters 999999)))
+  :bounds (static-spherem 0 -11 0 8))
+
+;; the pillars: x z offset from the middle (x IOS_RUIN_SPACING) and the top's height above IOS_RUIN_TOP (meters).
+;; The middle is the upper deck (phase 7c): two pillars stacked (13 m each) into a tower 16 m over the lowest tops,
+;; only reached with the launcher. Around it a stepped ring: low tops to climb on from the water, higher ones.
+(defconstant IOS_RUIN_DECK 0)        ;; layout index of the upper deck pillar
+(defconstant IOS_RUIN_VENT 1)        ;; the blue eco vent's pillar (a low one)
+(defconstant IOS_RUIN_LAUNCHER 2)    ;; the launcher's pillar (next to it)
+
+(define *ios-ruin-layout*
+  (new 'static 'boxed-array :type float
+       0.0 0.0 16.0
+       1.0 0.0 0.0
+       0.5 0.866 2.5
+       -0.5 0.866 0.0
+       -1.0 0.0 2.5
+       -0.5 -0.866 0.0
+       0.5 -0.866 2.5
+       0.0 0.0 3.0))
+
+(deftype ios-ocean-ruin (process)
+  ((center   vector :inline)   ;; the middle, at sea level
+   (offset   float)            ;; how far below its risen height the whole ruin is (IOS_RUIN_DEPTH .. 0)
+   (tiles    uint32)           ;; lit puzzle tiles (bits 0-8)
+   (solved   symbol)
+   (up-time  time-frame)
+   (up-for   time-frame)
+   (splash-time time-frame))
+  (:states
+   ios-ocean-ruin-rise
+   ios-ocean-ruin-up
+   ios-ocean-ruin-sink))
+
+(deftype ios-ocean-pillar (process-drawable)
+  ((root   collide-shape-moving :override)
+   (base   vector :inline)     ;; risen top position
+   (beacon symbol))
+  (:states
+   ios-ocean-pillar-idle))
+
+;; -- the tile puzzle (phase 7b) --
+;;
+;; A 3x3 grid of Lost Precursor City's floating tiles beside the ruin (rising with it, then bobbing on the waves like
+;; the stock ones). Landing on a dark tile lights it (stock plat-light-on, the qbert-plat-on overlay glowing blue as
+;; stock); landing on a lit one puts it out again. All nine lit: cell-prize, and the ocean's power cell
+;; IOS_OCEAN_RUIN_CELL pops up over the middle tile. Once that cell is collected the tiles come up lit.
+
+(defconstant IOS_TILE_COUNT 9)
+(defconstant IOS_TILE_SPACING (meters 7.2))  ;; tiles are 6.8 m wide
+(defconstant IOS_TILE_GRID (meters 24))      ;; grid centre from the ruin's middle (beside the ring)
+(defconstant IOS_TILE_FLOAT (meters 0.6))    ;; tile tops above the wave under them
+(defconstant IOS_TILE_ALL #x1ff)
+
+(defskelgroup *ios-ocean-tile-sg*
+  qbert-plat
+  qbert-plat-lod0-jg
+  qbert-plat-idle-ja
+  ((qbert-plat-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 -2 0 4.5))
+
+(defskelgroup *ios-ocean-tile-on-sg*
+  qbert-plat-on
+  qbert-plat-on-lod0-jg
+  qbert-plat-on-idle-ja
+  ((qbert-plat-on-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 -2 0 4.5))
+
+(deftype ios-ocean-tile (process-drawable)
+  ((root    collide-shape-moving :override)
+   (index   int32)
+   (spot    vector :inline)   ;; xz of the tile, y = mean sea level
+   (riding  symbol)
+   (lit     symbol))
+  (:states
+   ios-ocean-tile-idle))
+
+(deftype ios-ocean-tile-glow (process-drawable)
+  ()
+  (:states
+   ios-ocean-tile-glow-idle))
+
+(defstate ios-ocean-tile-glow-idle (ios-ocean-tile-glow)
+  :event
+    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
+      (case message
+        (('die) (deactivate self))))
+  :code
+    (behavior ()
+      ;; stock qbert-plat-on-mimic: follow the tile, glowing
+      (set-vector! (-> self draw color-emissive) 0.0 0.0 1.0 0.0)
+      (loop
+        (let ((tile (the-as ios-ocean-tile (ppointer->process (-> self parent)))))
+          (set! (-> self root trans quad) (-> tile root trans quad))
+          (quaternion-copy! (-> self root quat) (-> tile root quat)))
+        (suspend)))
+  :post ja-post)
+
+(defbehavior ios-ocean-tile-glow-init-by-other ios-ocean-tile-glow ((tile ios-ocean-tile))
+  (set! (-> self entity) (ios-ocean-entity))
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! (-> self root) (new 'process 'trsqv))
+  (set! (-> self root trans quad) (-> tile root trans quad))
+  (quaternion-copy! (-> self root quat) (-> tile root quat))
+  (vector-identity! (-> self root scale))
+  (initialize-skeleton self *ios-ocean-tile-on-sg* '())
+  (logior! (-> self skel status) (janim-status inited))
+  (ja-channel-set! 1)
+  (ja :group! qbert-plat-on-idle-ja :num! min)
+  (go ios-ocean-tile-glow-idle))
+
+(defbehavior ios-ocean-tile-show ios-ocean-tile ((lit symbol))
+  "The lit look is the qbert-plat-on overlay (a child); the dark tile hides under it."
+  (when (!= lit (-> self lit))
+    (set! (-> self lit) lit)
+    (cond
+      (lit
+       (process-spawn ios-ocean-tile-glow :init ios-ocean-tile-glow-init-by-other self :to self)
+       (logior! (-> self draw status) (draw-status hidden)))
+      (else
+       (let ((child (-> self child)))
+         (while child
+           (send-event (ppointer->process child) 'die)
+           (set! child (-> child 0 brother))))
+       (logclear! (-> self draw status) (draw-status hidden)))))
+  0)
+
+(defstate ios-ocean-tile-idle (ios-ocean-tile)
+  :code
+    (behavior ()
+      (loop
+        (let ((ruin (the-as ios-ocean-ruin (ppointer->process (-> self parent))))
+              (trans (-> self root trans)))
+          ;; float: on the wave under it (like the stock tiles), raised/lowered with the ruin
+          (set! (-> trans x) (-> self spot x))
+          (set! (-> trans z) (-> self spot z))
+          (set! (-> trans y) (+ (ocean-get-height (-> self spot)) IOS_TILE_FLOAT (-> ruin offset)))
+          (+! (-> self spot w) (* (degrees 40) (seconds-per-frame)))
+          (quaternion-axis-angle! (-> self root quat) 1.0 0.0 0.0 (* (degrees 1.5) (sin (-> self spot w))))
+          ;; Jak lands on it (stock: the riders count goes from none to some)
+          (let ((riding (nonzero? (-> self root riders num-riders))))
+            (if (and riding (not (-> self riding)) (= (-> ruin offset) 0.0))
+              (send-event ruin 'tile (-> self index)))
+            (set! (-> self riding) riding))
+          (ios-ocean-tile-show (logtest? (-> ruin tiles) (ash 1 (-> self index)))))
+        (suspend)))
+  :post
+    (behavior ()
+      (rider-trans)
+      (rider-post)))
+
+(defbehavior ios-ocean-tile-init-by-other ios-ocean-tile ((spot vector) (index int))
+  (set! (-> self entity) (ios-ocean-entity))
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (logior! (-> self mask) (process-mask platform))
+  ;; stock qbert-plat collision (rigid-body-platform-method-30)
+  (let ((cshape (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player))))
+    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
+    (set! (-> cshape reaction) default-collision-reaction)
+    (set! (-> cshape no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
+    (alloc-riders cshape 1)
+    (let ((mesh (new 'process 'collide-shape-prim-mesh cshape (the-as uint 0) (the-as uint 0))))
+      (set! (-> mesh prim-core collide-as) (collide-kind ground-object))
+      (set! (-> mesh collide-with) (collide-kind target))
+      (set! (-> mesh prim-core action) (collide-action solid rider-plat-sticky))
+      (set! (-> mesh prim-core offense) (collide-offense indestructible))
+      (set! (-> mesh transform-index) 0)
+      (set-vector! (-> mesh local-sphere) 0.0 -8192.0 0.0 18432.0)
+      (set-root-prim! cshape mesh))
+    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
+    (backup-collide-with-as cshape)
+    (set! (-> self root) cshape))
+  (set! (-> self index) index)
+  (set! (-> self spot quad) (-> spot quad))
+  (set! (-> self spot w) (rand-vu-float-range 0.0 (degrees 360)))  ;; its own rocking phase
+  (set! (-> self root trans quad) (-> spot quad))
+  (quaternion-identity! (-> self root quat))
+  (vector-identity! (-> self root scale))
+  (initialize-skeleton self *ios-ocean-tile-sg* '())
+  (logior! (-> self skel status) (janim-status inited))
+  (ja-channel-set! 1)
+  (ja :group! qbert-plat-idle-ja :num! min)
+  (set! (-> self skel effect) #f)
+  (set! (-> self riding) #f)
+  (set! (-> self lit) #f)
+  (go ios-ocean-tile-idle))
+
+(defbehavior ios-ocean-ruin-event ios-ocean-ruin ((proc process) (argc int) (message symbol) (block event-message-block))
+  (case message
+    (('tile)
+     ;; a tile was landed on: toggle it, and check the puzzle
+     (when (not (-> self solved))
+       (let ((bit (ash 1 (the-as int (-> block param 0)))))
+         (cond
+           ((logtest? (-> self tiles) bit)
+            (set! (-> self tiles) (logclear (-> self tiles) bit))
+            (sound-play "plat-light-off"))
+           (else
+            (set! (-> self tiles) (logior (-> self tiles) bit))
+            (sound-play "plat-light-on"))))
+       (when (= (-> self tiles) IOS_TILE_ALL)
+         (set! (-> self solved) #t)
+         (sound-play "cell-prize")
+         (when (and (>= IOS_OCEAN_RUIN_CELL 0) (not (ios-ocean-cell-collected? IOS_OCEAN_RUIN_CELL)))
+           ;; the cell over the middle tile; the power cell sequence plays where it is (movie-pos -1)
+           (let ((pos (new 'stack-no-clear 'vector)))
+             (set! (-> pos quad) (-> self center quad))
+             (+! (-> pos x) IOS_TILE_GRID)
+             (set! (-> pos y) (+ (ocean-get-height pos) IOS_TILE_FLOAT (meters 1.5)))
+             (ios-ocean-spawn-cell pos IOS_OCEAN_RUIN_CELL *entity-pool*))))))))
+
+(defun ios-ocean-ruin-top ((ruin ios-ocean-ruin) (i int) (out vector))
+  "Where layout pillar I's top is once risen."
+  (let ((layout *ios-ruin-layout*))
+    (set-vector! out
+                 (+ (-> ruin center x) (* IOS_RUIN_SPACING (-> layout (* i 3))))
+                 (+ (-> ruin center y) IOS_RUIN_TOP (* 4096.0 (-> layout (+ (* i 3) 2))))
+                 (+ (-> ruin center z) (* IOS_RUIN_SPACING (-> layout (+ (* i 3) 1))))
+                 1.0))
+  out)
+
+;; -- blue eco vent + launcher to the upper deck (phase 7c) --
+;;
+;; Once the ruin is up, a blue eco vent (a stock `vent`, set up like ios-green-eco.gc's green ones) stands on a low
+;; ring pillar and a stock launcher on the pillar next to it: charged with blue eco, the launcher throws Jak up onto
+;; the upper deck (its dest/seek-time steer him there, as an entity's alt-vector would). Both go when it sinks.
+
+(defconstant IOS_RUIN_SPRING (meters 20))  ;; launch height (the deck is 13.5 m over the launcher's pillar)
+
+(deftype ios-ocean-blue-vent (vent) ())
+
+(defbehavior ios-ocean-blue-vent-init-by-other ios-ocean-blue-vent ((pos vector))
+  "Stock vent initialize (collectables.gc) for blue eco, without an entity's trans and blocker."
+  (set! (-> self entity) (ios-ocean-entity))
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (let ((cshape (new 'process 'collide-shape self (collide-list-enum hit-by-player))))
+    (let ((sphere (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
+      (set! (-> sphere prim-core collide-as) (collide-kind powerup))
+      (set! (-> sphere collide-with) (collide-kind target))
+      (set-vector! (-> sphere local-sphere) 0.0 4915.2 0.0 6553.6)
+      (set-root-prim! cshape sphere))
+    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
+    (backup-collide-with-as cshape)
+    (set! (-> self root) cshape))
+  (set! (-> self root trans quad) (-> pos quad))
+  (update-transforms! (-> self root))
+  (set! (-> self root pause-adjust-distance) 409600.0)
+  (set! (-> self fact) (new 'process 'fact-info self (pickup-type eco-blue) (-> *FACT-bank* eco-full-inc)))
+  (set! (-> self block-func) (the-as (function vent symbol) true-func))
+  (set! (-> self part) (create-launch-control group-part-vent-blue-active self))
+  (set! (-> self collect-effect) group-blue-collect)
+  (set! (-> self collect-effect2) group-eco-blue-collect)
+  (set! (-> self sound) (new 'process 'ambient-sound 'eco-bg-blue (-> self root trans)))
+  (set! (-> self blocker) #f)
+  (set! (-> self pickup-handle) (the-as handle #f))
+  (set! (-> self show-particles) #t)
+  (go vent-wait-for-touch)
+  (none))
+
+(defbehavior ios-ocean-ruin-deck-open ios-ocean-ruin ()
+  "The vent and the launcher, once the ruin is up."
+  (let ((pos (new 'stack-no-clear 'vector))
+        (deck (ios-ocean-ruin-top self IOS_RUIN_DECK (new 'stack-no-clear 'vector))))
+    (process-spawn ios-ocean-blue-vent :init ios-ocean-blue-vent-init-by-other (ios-ocean-ruin-top self IOS_RUIN_VENT pos)
+                   :to self)
+    (let ((proc (process-spawn launcher
+                               :init launcher-init-by-other
+                               (ios-ocean-ruin-top self IOS_RUIN_LAUNCHER pos)
+                               IOS_RUIN_SPRING
+                               0
+                               (meters 100)
+                               :to self)))
+      (when proc
+        (let ((l (the-as launcher (ppointer->process proc))))
+          (set! (-> l dest quad) (-> deck quad))
+          (set! (-> l seek-time) (seconds 1.2))))))
+  0)
+
+(defbehavior ios-ocean-ruin-deck-close ios-ocean-ruin ()
+  (let ((child (-> self child)))
+    (while child
+      (let ((proc (ppointer->process child)))
+        (set! child (-> proc brother))
+        (if (or (type-type? (-> proc type) vent) (type-type? (-> proc type) launcher)) (deactivate proc)))))
+  0)
+
+(defbehavior ios-ocean-ruin-splash ios-ocean-ruin ((count int))
+  "Splashes where the pillars break the surface."
+  (let ((layout *ios-ruin-layout*)
+        (pos (new 'stack-no-clear 'vector)))
+    (dotimes (n count)
+      (let ((i (rand-vu-int-range 0 (+ (/ (length layout) 3) -1)))
+            (angle (rand-vu-float-range 0.0 (degrees 360))))
+        (set-vector! pos
+                     (+ (-> self center x) (* IOS_RUIN_SPACING (-> layout (* i 3))) (* (meters 3) (sin angle)))
+                     (-> self center y)
+                     (+ (-> self center z) (* IOS_RUIN_SPACING (-> layout (+ (* i 3) 1))) (* (meters 3) (cos angle)))
+                     1.0)
+        (process-spawn part-tracker :init part-tracker-init group-part-water-splash -1 #f #f #f pos :to *entity-pool*))))
+  0)
+
+(defbehavior ios-ocean-ruin-sound-spot ios-ocean-ruin ((out vector))
+  "Where the ruin's sounds play: toward it from the ear, at most IOS_RUIN_SOUND_DIST away, so it is always heard."
+  (let ((to (vector-! (new 'stack-no-clear 'vector) (-> self center) (ear-trans))))
+    (let ((dist (vector-length to)))
+      (if (< IOS_RUIN_SOUND_DIST dist) (vector-float*! to to (/ IOS_RUIN_SOUND_DIST dist))))
+    (vector+! out (ear-trans) to)
+    (set! (-> out w) 1.0)
+    out))
+
+(defbehavior ios-ocean-ruin-move ios-ocean-ruin ((goal float))
+  "Moves the ruin toward GOAL offset; splashes while it moves. Returns #t once there."
+  (seek! (-> self offset) goal (/ (* IOS_RUIN_DEPTH (seconds-per-frame)) IOS_RUIN_RISE))
+  (when (time-elapsed? (-> self splash-time) (seconds 0.2))
+    (set-time! (-> self splash-time))
+    (ios-ocean-ruin-splash 3)
+    ;; the ground shakes while it moves
+    (if (and *target* (< (vector-vector-xz-distance (-> self center) (target-pos 0)) IOS_RUIN_SHAKE_DIST))
+      (activate! *camera-smush-control* 409.6 37 300 1.0 0.995)))
+  (= (-> self offset) goal))
+
+(defstate ios-ocean-ruin-rise (ios-ocean-ruin)
+  :event ios-ocean-ruin-event
+  :code
+    (behavior ()
+      (let ((spot (ios-ocean-ruin-sound-spot (new 'stack-no-clear 'vector))))
+        (sound-play "eco-tower-rise" :position (the-as symbol spot))
+        (sound-play "water-explosion" :position (the-as symbol spot)))
+      (until (ios-ocean-ruin-move 0.0)
+        (suspend))
+      (let ((spot (ios-ocean-ruin-sound-spot (new 'stack-no-clear 'vector))))
+        (sound-play "eco-tower-stop" :position (the-as symbol spot))
+        (sound-play "large-splash" :position (the-as symbol spot)))
+      (ios-ocean-ruin-splash 8)
+      (ios-ocean-ruin-deck-open)
+      (go ios-ocean-ruin-up)))
+
+(defstate ios-ocean-ruin-up (ios-ocean-ruin)
+  :event ios-ocean-ruin-event
+  :code
+    (behavior ()
+      (set-time! (-> self up-time))
+      (until (or (time-elapsed? (-> self up-time) (-> self up-for))
+                 (not *target*)
+                 (< IOS_RUIN_LEAVE (vector-vector-xz-distance (-> self center) (target-pos 0))))
+        (suspend))
+      (go ios-ocean-ruin-sink)))
+
+(defstate ios-ocean-ruin-sink (ios-ocean-ruin)
+  :event ios-ocean-ruin-event
+  :code
+    (behavior ()
+      (ios-ocean-ruin-deck-close)
+      (sound-play "eco-tower-rise" :position (the-as symbol (ios-ocean-ruin-sound-spot (new 'stack-no-clear 'vector))))
+      (until (ios-ocean-ruin-move (- IOS_RUIN_DEPTH))
+        (suspend))
+      (sound-play "large-splash" :position (the-as symbol (ios-ocean-ruin-sound-spot (new 'stack-no-clear 'vector))))
+      (deactivate self)))
+
+(defstate ios-ocean-pillar-idle (ios-ocean-pillar)
+  :code
+    (behavior ()
+      (loop
+        (let ((ruin (the-as ios-ocean-ruin (ppointer->process (-> self parent)))))
+          (set! (-> self root trans quad) (-> self base quad))
+          (+! (-> self root trans y) (-> ruin offset))
+          ;; the beacon: a blue eco stream over the middle pillar while it is up
+          (when (and (-> self beacon) (< (- (meters 2)) (-> ruin offset)))
+            ;; a tall column over the sea: the eco stream at one of four heights (0-15 m) each frame (a launch control
+            ;; spawns once per frame)
+            (let ((pos (new 'stack-no-clear 'vector)))
+              (set! (-> pos quad) (-> self root trans quad))
+              (+! (-> pos y) (* (meters 5) (the float (logand (-> *display* base-frame-counter) 3))))
+              (spawn (-> self part) pos))))
+        (suspend)))
+  :post
+    (behavior ()
+      (rider-trans)
+      (rider-post)))
+
+(defbehavior ios-ocean-pillar-init-by-other ios-ocean-pillar ((top vector) (beacon symbol))
+  (set! (-> self entity) (ios-ocean-entity))
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (logior! (-> self mask) (process-mask platform))
+  ;; stock square-platform collision (square-platform.gc init-from-entity!)
+  (let ((cshape (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player))))
+    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
+    (set! (-> cshape reaction) default-collision-reaction)
+    (set! (-> cshape no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
+    (alloc-riders cshape 1)
+    (let ((mesh (new 'process 'collide-shape-prim-mesh cshape (the-as uint 0) (the-as uint 0))))
+      (set! (-> mesh prim-core collide-as) (collide-kind ground-object))
+      (set! (-> mesh collide-with) (collide-kind target))
+      (set! (-> mesh prim-core action) (collide-action solid rider-plat-sticky))
+      (set! (-> mesh prim-core offense) (collide-offense indestructible))
+      (set! (-> mesh transform-index) 3)
+      (set-vector! (-> mesh local-sphere) 0.0 -24576.0 0.0 32768.0)
+      (set-root-prim! cshape mesh))
+    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
+    (backup-collide-with-as cshape)
+    (set! (-> self root) cshape))
+  (set! (-> self base quad) (-> top quad))
+  (set! (-> self root trans quad) (-> top quad))
+  (quaternion-identity! (-> self root quat))
+  (vector-identity! (-> self root scale))
+  (initialize-skeleton self *ios-ocean-pillar-sg* '())
+  (ja-channel-set! 1)
+  (ja :group! square-platform-idle-ja :num! min)
+  (set! (-> self skel effect) #f)
+  (set! (-> self beacon) beacon)
+  (if beacon (set! (-> self part) (create-launch-control group-part-vent-blue-active self)))
+  (go ios-ocean-pillar-idle))
+
+(defbehavior ios-ocean-ruin-init-by-other ios-ocean-ruin ((pos vector))
+  (set! (-> self entity) (ios-ocean-entity))
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! (-> self center quad) (-> pos quad))
+  ;; mean sea level, not the wave at this spot right now: built on a trough, the low tops sank under every crest
+  ;; (user screenshot 2026-10-19)
+  (set! (-> self center y) (if *ocean-map* (-> *ocean-map* start-corner y) 0.0))
+  (set! (-> self offset) (- IOS_RUIN_DEPTH))
+  (set! (-> self up-for) (the-as time-frame (rand-vu-int-range IOS_RUIN_UP_MIN IOS_RUIN_UP_MAX)))
+  (let ((top (new 'stack-no-clear 'vector)))
+    (dotimes (i (/ (length *ios-ruin-layout*) 3))
+      (process-spawn ios-ocean-pillar :init ios-ocean-pillar-init-by-other (ios-ocean-ruin-top self i top) (= i IOS_RUIN_DECK)
+                     :to self)))
+  ;; the tile puzzle beside the ring (all lit once its cell is collected)
+  (set! (-> self solved) (ios-ocean-cell-collected? IOS_OCEAN_RUIN_CELL))
+  (set! (-> self tiles) (the-as uint (if (-> self solved) IOS_TILE_ALL 0)))
+  (let ((spot (new 'stack-no-clear 'vector)))
+    (dotimes (i IOS_TILE_COUNT)
+      (set-vector! spot
+                   (+ (-> self center x) IOS_TILE_GRID (* IOS_TILE_SPACING (the float (+ (mod i 3) -1))))
+                   (-> self center y)
+                   (+ (-> self center z) (* IOS_TILE_SPACING (the float (+ (/ i 3) -1))))
+                   1.0)
+      (process-spawn ios-ocean-tile :init ios-ocean-tile-init-by-other spot i :to self)))
+  (format 0 "ios-open-ocean: Precursor ruin rising at ~M ~M~%" (-> self center x) (-> self center z))
+  (go ios-ocean-ruin-rise))
+
+;; -- spawner --
+
+;; fly bits held by live fly boxes (ios-ocean-spawner-tally)
+(define *ios-ocean-fly-box-held* 0)
+;; a sea serpent is about (ios-ocean-spawner-tally)
+(define *ios-ocean-serpent-live* #f)
+;; the Precursor ruin is up (ios-ocean-spawner-tally)
+(define *ios-ocean-ruin-live* #f)
+
+(deftype ios-ocean-spawner (process)
+  ((barrel-time time-frame)
+   (flock-time  time-frame)
+   (fly-time    time-frame)
+   (serpent-time time-frame)   ;; last serpent check
+   (serpent-last time-frame)   ;; last serpent came
+   (ruin-time    time-frame)   ;; last ruin check
+   (ruin-last    time-frame))  ;; the last ruin rose
+  (:states
+   ios-ocean-spawner-idle))
+
+(defun ios-ocean-spawn-spot ((out vector) (proc process))
+  "A random open-water spot in the Open Ocean IOS_OCEAN_SPAWN_MIN-MAX from Jak, or #f."
+  (ios-ocean-spawn-spot-at out proc IOS_OCEAN_SPAWN_MIN IOS_OCEAN_SPAWN_MAX))
+
+(defbehavior ios-ocean-spawner-tally ios-ocean-spawner ((info vector))
+  "Live barrels: x count, z orbs they hold, w bits of the barrel cells they hold; y gull flocks. Far ones are
+   removed first."
+  (set-vector! info 0.0 0.0 0.0 0.0)
+  (set! *ios-ocean-fly-box-held* 0)
+  (set! *ios-ocean-serpent-live* #f)
+  (set! *ios-ocean-ruin-live* #f)
+  (let ((cells 0)
+        (child (-> self child)))
+    (while child
+      (let ((proc (ppointer->process child)))
+        (set! child (-> proc brother))
+        (cond
+          ((type-type? (-> proc type) ios-ocean-barrel)
+           (let ((barrel (the-as ios-ocean-barrel proc)))
+             (cond
+               ((< IOS_OCEAN_DESPAWN (vector-vector-xz-distance (-> barrel center) (target-pos 0))) (deactivate barrel))
+               ((= (-> barrel next-state name) 'ios-ocean-barrel-break))
+               ((= (-> barrel contents) IOS_OCEAN_BARREL_FLY)
+                (set! *ios-ocean-fly-box-held* (logior *ios-ocean-fly-box-held* (ash 1 (-> barrel amount)))))
+               (else
+                (+! (-> info x) 1.0)
+                (case (-> barrel contents)
+                  ((IOS_OCEAN_BARREL_CELL) (set! cells (logior cells (ash 1 (-> barrel amount)))))
+                  ((IOS_OCEAN_BARREL_ORBS) (+! (-> info z) (the float (-> barrel amount)))))))))
+          ((type-type? (-> proc type) ios-ocean-ruin)
+           ;; it sinks by itself once Jak is far; this is only the safety net
+           (if (< (* 2.0 IOS_RUIN_LEAVE) (vector-vector-xz-distance (-> (the-as ios-ocean-ruin proc) center) (target-pos 0)))
+             (deactivate proc)
+             (set! *ios-ocean-ruin-live* #t)))
+          ((type-type? (-> proc type) ios-ocean-serpent)
+           (if (< IOS_OCEAN_DESPAWN (vector-vector-xz-distance (-> (the-as ios-ocean-serpent proc) root trans) (target-pos 0)))
+             (deactivate proc)
+             (set! *ios-ocean-serpent-live* #t)))
+          ((type-type? (-> proc type) ios-ocean-gull-flock)
+           (let ((flock (the-as ios-ocean-gull-flock proc)))
+             (if (< IOS_OCEAN_DESPAWN (vector-vector-xz-distance (-> flock center) (target-pos 0)))
+               (deactivate flock)
+               (+! (-> info y) 1.0)))))))
+    (set! (-> info w) (the float cells)))
+  info)
+
+(defbehavior ios-ocean-spawner-update ios-ocean-spawner ()
+  (let* ((info (ios-ocean-spawner-tally (new 'stack-no-clear 'vector)))
+         (held-cells (the int (-> info w)))
+         (orbs-left (- IOS_OCEAN_ORB_TOTAL (ios-ocean-orbs) (the int (-> info z))))
+         (spot (new 'stack-no-clear 'vector)))
+    (when (and (< (the int (-> info x)) IOS_OCEAN_BARREL_MAX)
+               (time-elapsed? (-> self barrel-time) IOS_OCEAN_BARREL_CHECK))
+      (set-time! (-> self barrel-time))
+      (when (and (rand-vu-percent? IOS_OCEAN_BARREL_CHANCE) (ios-ocean-spawn-spot spot self))
+        (let ((cell -1)
+              (r (rand-vu))
+              ;; the keg needs its resident art
+              (look (if (or (not *ios-ocean-art*) (rand-vu-percent? IOS_OCEAN_CRATE_BARREL_CHANCE))
+                      IOS_OCEAN_LOOK_CRATE_BARREL
+                      IOS_OCEAN_LOOK_KEG)))
+          (dotimes (i IOS_OCEAN_BARREL_CELLS)
+            (if (and (< cell 0) (not (ios-ocean-cell-collected? i)) (not (logtest? held-cells (ash 1 i)))) (set! cell i)))
+          (cond
+            ((and (>= cell 0) (< r IOS_OCEAN_CELL_CHANCE))
+             (process-spawn ios-ocean-barrel :init ios-ocean-barrel-init-by-other spot IOS_OCEAN_BARREL_CELL cell look :to self))
+            ((and (> orbs-left 0) (< r (+ IOS_OCEAN_CELL_CHANCE IOS_OCEAN_ORB_CHANCE)))
+             (process-spawn ios-ocean-barrel :init ios-ocean-barrel-init-by-other spot IOS_OCEAN_BARREL_ORBS
+                            (min orbs-left (rand-vu-int-range 5 15)) look :to self))
+            (else
+             (process-spawn ios-ocean-barrel :init ios-ocean-barrel-init-by-other spot IOS_OCEAN_BARREL_ECO 0 look :to self))))))
+    ;; a scout fly box: one at a time, for the lowest fly not found yet
+    (when (and (zero? *ios-ocean-fly-box-held*)
+               (< (ios-ocean-bit-count (ios-ocean-flies)) IOS_OCEAN_FLY_TOTAL)
+               (time-elapsed? (-> self fly-time) IOS_OCEAN_FLY_BOX_CHECK))
+      (set-time! (-> self fly-time))
+      (when (and (rand-vu-percent? IOS_OCEAN_FLY_BOX_CHANCE) (ios-ocean-spawn-spot spot self))
+        (let ((fly -1))
+          (dotimes (i IOS_OCEAN_FLY_TOTAL)
+            (if (and (< fly 0) (not (logtest? (ios-ocean-flies) (ash 1 i)))) (set! fly i)))
+          (if (>= fly 0)
+            (process-spawn ios-ocean-barrel :init ios-ocean-barrel-init-by-other spot IOS_OCEAN_BARREL_FLY fly
+                           IOS_OCEAN_LOOK_FLY_BOX :to self)))))
+    ;; the sea serpent: rare (with the debug readout on, sooner, for testing)
+    (when (and *ios-ocean-worm-art*
+               (not *ios-ocean-serpent-live*)
+               (time-elapsed? (-> self serpent-time) (if *ios-open-ocean-fast* (seconds 30) IOS_SERPENT_CHECK)))
+      (set-time! (-> self serpent-time))
+      (when (and (time-elapsed? (-> self serpent-last) (if *ios-open-ocean-fast* (seconds 60) IOS_SERPENT_COOLDOWN))
+                 (rand-vu-percent? (if *ios-open-ocean-fast* 0.4 IOS_SERPENT_CHANCE))
+                 (ios-ocean-spawn-spot-at spot self IOS_SERPENT_SPAWN_MIN IOS_SERPENT_SPAWN_MAX))
+        (set-time! (-> self serpent-last))
+        (process-spawn ios-ocean-serpent :init ios-ocean-serpent-init-by-other spot :to self)))
+    ;; the Precursor ruin: rare, well out in the Open Ocean (debug readout on: sooner)
+    (when (and IOS_RUIN_ENABLED
+               *ios-ocean-ruin-art*
+               (not *ios-ocean-ruin-live*)
+               (time-elapsed? (-> self ruin-time) (if *ios-open-ocean-fast* (seconds 45) IOS_RUIN_CHECK)))
+      (set-time! (-> self ruin-time))
+      (when (and (time-elapsed? (-> self ruin-last) (if *ios-open-ocean-fast* (seconds 60) IOS_RUIN_COOLDOWN))
+                 (rand-vu-percent? (if *ios-open-ocean-fast* 0.5 IOS_RUIN_CHANCE)))
+        (let ((found #f))
+          (dotimes (try 3)
+            (if (and (not found)
+                     (ios-ocean-spawn-spot-at spot self IOS_RUIN_SPAWN_MIN IOS_RUIN_SPAWN_MAX)
+                     (< IOS_RUIN_CLEARANCE (ios-open-ocean-edge-at spot)))
+              (set! found #t)))
+          (when found
+            (set-time! (-> self ruin-last))
+            (process-spawn ios-ocean-ruin :init ios-ocean-ruin-init-by-other spot :to self)))))
+    ;; seagulls: alone or in a small group, anywhere in the Open Ocean (land under them is fine)
+    (when (and *ios-ocean-gull-art*
+               (< (the int (-> info y)) IOS_OCEAN_FLOCK_MAX)
+               (time-elapsed? (-> self flock-time) IOS_OCEAN_FLOCK_CHECK))
+      (set-time! (-> self flock-time))
+      (when (rand-vu-percent? IOS_OCEAN_FLOCK_CHANCE)
+        (let ((angle (rand-vu-float-range 0.0 (degrees 360)))
+              (dist (rand-vu-float-range IOS_OCEAN_FLOCK_SPAWN_MIN IOS_OCEAN_FLOCK_SPAWN_MAX)))
+          (set-vector! spot (+ (-> (target-pos 0) x) (* dist (sin angle))) 0.0 (+ (-> (target-pos 0) z) (* dist (cos angle))) 1.0)
+          (if (< 0.0 (ios-open-ocean-edge-at spot))
+            (process-spawn ios-ocean-gull-flock
+                           :init ios-ocean-gull-flock-init-by-other
+                           spot
+                           (if (rand-vu-percent? 0.4) 1 (rand-vu-int-range 2 4))
+                           :to self))))))
+  0)
+
+(defstate ios-ocean-spawner-idle (ios-ocean-spawner)
+  :code
+    (behavior ()
+      (loop
+        (cond
+          ((not (and *ios-open-ocean-level* *target* (= *kernel-boot-message* 'play)))
+           ;; option off (or no game): everything goes
+           (deactivate self))
+          ((and (ios-in-open-ocean?) (nonzero? (-> *ios-ocean-progress* ready)) (not (movie?)))
+           (ios-ocean-spawner-update))
+          (else
+           ;; out of the ocean: keep what is there (it goes once far away), spawn nothing
+           (ios-ocean-spawner-tally (new 'stack-no-clear 'vector))))
+        (suspend))))
+
+(defbehavior ios-ocean-spawner-init-by-other ios-ocean-spawner ()
+  (set! (-> self entity) (ios-ocean-entity))
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set-time! (-> self barrel-time))
+  (set-time! (-> self flock-time))
+  (set-time! (-> self fly-time))
+  (set-time! (-> self serpent-time))
+  (set! (-> self serpent-last) 0)
+  (set-time! (-> self ruin-time))
+  (set! (-> self ruin-last) 0)
+  (go ios-ocean-spawner-idle))
+
+(defun ios-ocean-spawner-ensure ()
+  (if (and (not (handle->process (-> *ios-ocean-handles* spawner))) (ios-in-open-ocean?))
+    (set! (-> *ios-ocean-handles* spawner)
+          (ppointer->handle (process-spawn ios-ocean-spawner :init ios-ocean-spawner-init-by-other :to *entity-pool*))))
+  0)
+
+;; ---- mist over the Sandover / Rock Village hand-over -------------------------------------------------------------
+;;
+;; Where the boat code swaps the north (Sandover) and south (Rock Village / Boggy Swamp) level pairs, the distance fog
+;; closes in (fishermans-boat.gc ios-ocean-transition-fog, *ios-sea-fog* 0..1). On top of it a thick mist now lies on
+;; the water (user 2026-10-21), so the levels changing behind it don't show: Misty's ground fog (misty-part.gc
+;; group-misty-fog, part 982: wide flat bigpuff2 sheets) launched around the camera just above the waves, as many as
+;; *ios-sea-fog* asks for, tinted with the current fog colour. Parts 2971-2973 (past the last stock / iOS ones).
+
+(defconstant IOS_MIST_RATE 14.0)            ;; sheets per second at full strength
+(defconstant IOS_MIST_RANGE (meters 90))    ;; around the camera
+(defconstant IOS_MIST_LOW (meters 1.6))     ;; over mean sea level (waves reach 1.3 m)
+(defconstant IOS_MIST_HIGH (meters 3.4))
+
+(defpart 2971
+  :init-specs
+  ((:texture (bigpuff2 effects))
+   (:num 1.0)
+   (:scale-x (meters 30) (meters 16))
+   (:rot-y (degrees 0) (degrees 360))
+   (:scale-y :copy scale-x)
+   (:r 127.0)
+   (:g 127.0)
+   (:b 127.0)
+   (:a 0.0)
+   (:scalevel-x (meters 0.013333334) (meters 0.006666667))
+   (:rotvel-y (degrees -0.033333335) (degrees 0.06666667))
+   (:scalevel-y :copy scalevel-x)
+   (:fade-a 0.5)
+   (:timer (seconds 8))
+   (:flags (bit2 bit14 left-multiply-quat))
+   (:next-time (seconds 1.2))
+   (:next-launcher 2972)
+   (:conerot-x (degrees 90))
+   (:conerot-y (degrees 0) (degrees 360))
+   (:rotate-y (degrees 25.000002))))
+
+(defpart 2972
+  :init-specs ((:fade-a 0.0) (:next-time (seconds 4.5)) (:next-launcher 2973)))
+
+(defpart 2973
+  :init-specs ((:fade-a -0.25)))
+
+;; Fog with height (user 2026-10-22: "covering space above the water ... like moving through real fog"): besides the
+;; flat sheets on the waves, soft camera-facing bigpuff clouds fill the air around the camera from the water up to
+;; ~30 m, drifting and slowly turning, each fading in, holding and fading out; their layers give the fog body as you
+;; sail through it. Parts 2974-2976.
+(defconstant IOS_MIST_PUFF_RATE 22.0)            ;; puffs per second at full strength (~8 s each: ~170 in the air)
+(defconstant IOS_MIST_PUFF_NEAR (meters 4))
+(defconstant IOS_MIST_PUFF_FAR (meters 60))
+(defconstant IOS_MIST_PUFF_TOP (meters 30))     ;; over mean sea level
+
+(defpart 2974
+  :init-specs
+  ((:texture (bigpuff effects))
+   (:num 1.0)
+   (:scale-x (meters 10) (meters 16))
+   (:rot-z (degrees 0) (degrees 360))
+   (:scale-y :copy scale-x)
+   (:r 127.0)
+   (:g 127.0)
+   (:b 127.0)
+   (:a 0.0)
+   (:vel-x (meters -0.008) (meters 0.016))
+   (:vel-y (meters -0.002) (meters 0.004))
+   (:vel-z (meters -0.008) (meters 0.016))
+   (:scalevel-x (meters 0.01) (meters 0.01))
+   (:rotvel-z (degrees -0.05) (degrees 0.1))
+   (:scalevel-y :copy scalevel-x)
+   (:fade-a 0.2)
+   (:timer (seconds 8))
+   (:flags (bit2 bit14))
+   (:next-time (seconds 1.5))
+   (:next-launcher 2975)))
+
+(defpart 2975
+  :init-specs ((:fade-a 0.0) (:next-time (seconds 3.5)) (:next-launcher 2976)))
+
+(defpart 2976
+  :init-specs ((:fade-a -0.1)))
+
+(define *ios-mist-carry* 0.0)
+(define *ios-mist-puff-carry* 0.0)
+(define-extern ios-sea-fog-color (function vector vector))  ;; fishermans-boat.gc
+
+(defun ios-ocean-mist-update ()
+  ;; Off (user 2026-10-22: one kind of fog): the fog bank's own clouds (fishermans-boat.gc ios-sea-fog-bank-update)
+  ;; now thicken around Jak as he sails in. Kept for reference.
+  (let ((f 0.0))
+    (when (and (< 0.0 f) (not (paused?)))
+      ;; the sea fog's own colour (fishermans-boat.gc), the same as the far fog bank's, so the mist you sail into
+      ;; matches the wall you saw from afar
+      (let ((spec (-> *part-id-table* 2971 init-specs))
+            (col (ios-sea-fog-color (new 'stack-no-clear 'vector))))
+        (set! (-> spec 5 initial-valuef) (-> col x))
+        (set! (-> spec 6 initial-valuef) (-> col y))
+        (set! (-> spec 7 initial-valuef) (-> col z))
+        (let ((puff (-> *part-id-table* 2974 init-specs)))
+          (set! (-> puff 5 initial-valuef) (-> col x))
+          (set! (-> puff 6 initial-valuef) (-> col y))
+          (set! (-> puff 7 initial-valuef) (-> col z))))
+      (+! *ios-mist-carry* (* f IOS_MIST_RATE (seconds-per-frame)))
+      (let ((pos (new 'stack-no-clear 'vector))
+            (cam (math-camera-pos))
+            (sea (if *ocean-map* (-> *ocean-map* start-corner y) 0.0)))
+        (while (<= 1.0 *ios-mist-carry*)
+          (+! *ios-mist-carry* -1.0)
+          (let ((angle (rand-vu-float-range 0.0 (degrees 360)))
+                (dist (* IOS_MIST_RANGE (sqrtf (rand-vu)))))
+            (set-vector! pos
+                         (+ (-> cam x) (* dist (sin angle)))
+                         (+ sea (rand-vu-float-range IOS_MIST_LOW IOS_MIST_HIGH))
+                         (+ (-> cam z) (* dist (cos angle)))
+                         1.0)
+            (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 2971) pos)))
+        ;; the clouds in the air (coloured above)
+        (+! *ios-mist-puff-carry* (* f IOS_MIST_PUFF_RATE (seconds-per-frame)))
+        (while (<= 1.0 *ios-mist-puff-carry*)
+          (+! *ios-mist-puff-carry* -1.0)
+          (let* ((angle (rand-vu-float-range 0.0 (degrees 360)))
+                 (dist (lerp IOS_MIST_PUFF_NEAR IOS_MIST_PUFF_FAR (sqrtf (rand-vu))))
+                 (up (rand-vu)))
+            ;; more of them low down, thinning upward
+            (set-vector! pos
+                         (+ (-> cam x) (* dist (sin angle)))
+                         (+ sea (* IOS_MIST_PUFF_TOP up up))
+                         (+ (-> cam z) (* dist (cos angle)))
+                         1.0)
+            (launch-particles (-> *part-id-table* 2974) pos))))))
+  0)
+
+;; ---- Rock Village's floating pontoons ------------------------------------------------------------------------------
+;;
+;; Stock pontoons (village2-obs.gc) only run within 20 m of the camera (actor pause-dist 50 m + their
+;; pause-adjust-distance -30 m), and one that never ran has no pose to draw: sailing in from the ocean they popped up
+;; right in front of the boat (user 2026-10-21). While the option is on they run as far out as actors are born
+;; (*ACTOR-bank* birth-dist 220 m), so they show with the rest of Rock Village and go when the level does.
+
+(defconstant IOS_PONTOON_PAUSE_ADJUST (meters 200))
+;; Stock actors are only born within *ACTOR-bank* birth-dist (220 m) of the camera, so the pontoons still appeared
+;; well after the rest of Rock Village (user 2026-10-22). They are now born as soon as Rock Village is in and the
+;; camera is within this distance, and kept (entity perm bit-3, as carried actors are) instead of being killed
+;; again beyond 220 m; they go with the level.
+(defconstant IOS_PONTOON_BIRTH_DIST (meters 900))
+
+(defun ios-pontoon-type? ((type type))
+  (let ((name (-> type symbol)))
+    (or (= name 'pontoon) (= name 'pontoonfive) (= name 'pontoonten))))
+
+(defun ios-ocean-pontoons-birth ()
+  (let ((lev (level-get *level* 'village2))
+        (cam (math-camera-pos)))
+    (when (and lev (= (-> lev status) 'active) (nonzero? (-> lev entity)))
+      (let ((links (-> lev entity)))
+        (dotimes (i (-> links length))
+          (let* ((link (-> links data i))
+                 (ent (-> link entity)))
+            (when (and ent
+                       (type-type? (-> ent type) entity-actor)
+                       (ios-pontoon-type? (-> (the-as entity-actor ent) etype))
+                       (not (logtest? (-> link perm status) (entity-perm-status bit-0 dead)))
+                       (< (vector-vector-distance (-> link trans) cam) IOS_PONTOON_BIRTH_DIST))
+              (logior! (-> link perm status) (entity-perm-status bit-3))
+              (if (not (-> link process)) (birth! ent))))))))
+  0)
+
+(defun ios-ocean-pontoons-update ()
+  (ios-ocean-pontoons-birth)
+  (let ((child (-> *entity-pool* child)))
+    (while child
+      (let ((proc (ppointer->process child)))
+        (set! child (-> proc brother))
+        (when (and (type-type? (-> proc type) process-drawable)
+                   (let ((name (-> proc type symbol)))
+                     (or (= name 'pontoon) (= name 'pontoonfive) (= name 'pontoonten)))
+                   (nonzero? (-> (the-as process-drawable proc) root)))
+          (set! (-> (the-as process-drawable proc) root pause-adjust-distance) IOS_PONTOON_PAUSE_ADJUST)))))
+  0)
+
+;; ---- dying in the Open Ocean ---------------------------------------------------------------------------------------
+;;
+;; Out there the respawn the boat code picks (the nearest island's checkpoint) can leave the screen black forever
+;; (user 2026-10-21). Dying in the Open Ocean now respawns where the game was last saved (that save's checkpoint, the
+;; stock one when Dynamic Save Points stood in for it), and the boat goes to the dock nearest it.
+
+;; the checkpoint of the last save made or loaded (#f: none yet this session)
+(define-perm *ios-ocean-saved-continue* continue-point #f)
+(define *ios-ocean-dying-at-sea* #f)
+
+(defun ios-ocean-note-saved-continue ((this game-info))
+  (let ((cont (-> this current-continue)))
+    (set! *ios-ocean-saved-continue* (if (and cont (= cont *ios-dsp-continue*)) *ios-dsp-stock-continue* cont)))
+  0)
+
+;; the captured stock methods (define-perm: never wrap the wrapper; these are ios-dynamic-save's wrappers)
+(define-perm *ios-ocean-stock-save-game* function (method-of-type game-info save-game!))
+(define-perm *ios-ocean-stock-load-game* function (method-of-type game-info load-game!))
+
+;; A save made in the Open Ocean shows OPEN OCEAN on its file (user 2026-10-23) instead of the nearest checkpoint's
+;; level. The file's name comes from the save's level-index (a level-info index) through *level-task-data-remap*
+;; (progress-draw.gc draw-memcard-file-select), and nothing else reads a save's level-index. The ocean has no level-info, so
+;; it borrows test-zone's (27, a dev level never loaded in play): its remap entry points at the ocean page while the
+;; option is on and at Sandover while it is off.
+(defconstant IOS_OCEAN_SAVE_LEVEL_INDEX 27)
+(defconstant IOS_OCEAN_SANDOVER_PAGE 1)    ;; level-task-data-index village1
+(defconstant IOS_OCEAN_SANDOVER_CONTINUE "village1-hut")
+
+(defun ios-ocean-save-remap-update ()
+  (when (>= (length *level-task-data-remap*) IOS_OCEAN_SAVE_LEVEL_INDEX)
+    (set! (-> *level-task-data-remap* (+ IOS_OCEAN_SAVE_LEVEL_INDEX -1))
+          (if (and *ios-open-ocean-level* (ios-ocean-page? IOS_OCEAN_PAGE)) IOS_OCEAN_PAGE IOS_OCEAN_SANDOVER_PAGE)))
+  0)
+
+(defmethod save-game! ((this game-info) (arg0 game-save) (arg1 string))
+  ((the-as (function game-info game-save string none) *ios-ocean-stock-save-game*) this arg0 arg1)
+  (when (and (zero? (-> arg0 new-game)) (ios-in-open-ocean?))
+    (set! (-> arg0 level-index) IOS_OCEAN_SAVE_LEVEL_INDEX))
+  (ios-ocean-note-saved-continue this)
+  (none))
+
+(defmethod load-game! ((this game-info) (save game-save))
+  ((the-as (function game-info game-save game-save) *ios-ocean-stock-load-game*) this save)
+  ;; an Open Ocean save loaded with the option off: start in Sandover (no exact spot out at sea, no checkpoint of the
+  ;; level that happened to be nearest)
+  (when (and (zero? (-> save new-game)) (= (-> save level-index) IOS_OCEAN_SAVE_LEVEL_INDEX) (not *ios-open-ocean-level*))
+    (let ((cont (get-continue-by-name this IOS_OCEAN_SANDOVER_CONTINUE)))
+      (when cont
+        (format 0 "ios-open-ocean: Open Ocean save with the option off, starting at ~A~%" IOS_OCEAN_SANDOVER_CONTINUE)
+        (set! *ios-dsp-phase* #f)
+        (set! (-> this current-continue) cont))))
+  (ios-ocean-note-saved-continue this)
+  save)
+
+(defun ios-ocean-death-update ()
+  (let ((dying (and *target*
+                    (-> *target* next-state)
+                    (member (-> *target* next-state name) '(target-death target-flut-death)))))
+    (cond
+      ((not dying) (set! *ios-ocean-dying-at-sea* #f))
+      ((and (not *ios-ocean-dying-at-sea*) (ios-in-open-ocean?) *ios-ocean-saved-continue*)
+       (set! *ios-ocean-dying-at-sea* #t)
+       (format 0 "ios-open-ocean: died at sea, respawning at ~A~%" (-> *ios-ocean-saved-continue* name))
+       (ios-boat-park-return-home (-> *ios-ocean-saved-continue* trans))))
+    ;; every frame of the death: the boat code may set its own respawn meanwhile
+    (if (and dying *ios-ocean-dying-at-sea*)
+      (set! (-> *game-info* current-continue) *ios-ocean-saved-continue*)))
+  0)
+
+;; The HUD's scout fly counter and the pause screen's fly number both show *target* fact buzzer, which stock sets to
+;; the current level's count on every level-enter (target-handler.gc). Out at sea that left Sandover's / Rock
+;; Village's count on screen (7 before any ocean fly was found, user 2026-10-23). While Jak is in the Open Ocean it is
+;; held on the ocean's count every frame; on leaving, the level he is in gets its own count back. A change that is
+;; not a pickup (the pickup wrapper already set the new count, so the HUD tallies up by one) snaps the HUD with 'sync.
+(define *ios-ocean-hud-flies-shown* #f)
+
+(defun ios-ocean-hud-sync-flies ((value float))
+  (when (!= (-> *target* fact buzzer) value)
+    (set! (-> *target* fact buzzer) value)
+    (send-event (ppointer->process (-> *hud-parts* buzzers)) 'sync))
+  0)
+
+(defun ios-ocean-hud-flies-update ()
+  (cond
+    ((and *target* (ios-in-open-ocean?))
+     (set! *ios-ocean-hud-flies-shown* #t)
+     (ios-ocean-hud-sync-flies (the float (ios-ocean-bit-count (ios-ocean-flies)))))
+    (*ios-ocean-hud-flies-shown*
+     (set! *ios-ocean-hud-flies-shown* #f)
+     (when *target*
+       ;; stock level-enter's recount for the level Jak is in
+       (let* ((lev (-> *target* current-level))
+              (task (if lev (-> lev info buzzer) 0)))
+         (ios-ocean-hud-sync-flies
+           (if (zero? task)
+             0.0
+             (*ios-ocean-stock-pickup* (-> *target* fact) (pickup-type buzzer) (the float (logior -65536 task)) (the-as handle #f))))))))
+  0)
+
+(define *ios-open-ocean-tick* 0)
+
+;; pc/ios/ios-brume.gc (linked after this file): a Brume Village level is loaded. Those mod levels sit high above
+;; the sea west of Geyser Rock, outside every territory, so none of the sea's code runs while they are in.
+(define-extern ios-brume-here? (function symbol))
+
+(defun ios-open-ocean-update ()
+  (when (ios-brume-here?)
+    (set! (-> *ios-ocean-progress* in-ocean) 0)
+    (return 0))
+  (+! *ios-open-ocean-tick* 1)
+  (ios-ocean-save-remap-update)
+  (when *ios-open-ocean-level*
+    (ios-ocean-death-update)
+    (ios-ocean-mist-update)
+    (if (zero? (logand *ios-open-ocean-tick* 31)) (ios-ocean-pontoons-update)))
+  (when (and *ios-open-ocean-level* *target*)
+    (ios-open-ocean-music-ensure)
+    (ios-open-ocean-ambience-ensure))
+  ;; the weather also runs for the STORMS option alone (storms over land); not in the Glacier, where it snows
+  (if (and (or *ios-open-ocean-level* *ios-storms*) *target* (not (ios-ocean-in-glacier?))) (ios-ocean-weather-ensure))
+  (if (and *ios-open-ocean-level* *target* (= *kernel-boot-message* 'play)) (ios-ocean-spawner-ensure))
+  (let ((p *ios-ocean-progress*))
+    (cond
+      ((and *ios-open-ocean-level* *target* (= *kernel-boot-message* 'play) (not (movie?)))
+       (let* ((edge (ios-open-ocean-measure (target-pos 0)))
+              (inside (if (nonzero? (-> p in-ocean)) (> edge (- IOS_OPEN_OCEAN_HYSTERESIS)) (> edge 0.0))))
+         (when (!= inside (nonzero? (-> p in-ocean)))
+           (format 0 "ios-open-ocean: ~A the Open Ocean (nearest ~S)~%" (if inside "entered" "left")
+                   (ios-open-ocean-zone-name *ios-open-ocean-nearest*)))
+         (set! (-> p in-ocean) (if inside 1 0))
+         (if (and inside (not (ios-ocean-visited?))) (set! (-> p add-visited) 1)))
+       (if (and *ios-open-ocean-debug* (not (paused?))) (ios-open-ocean-draw-debug)))
+      (else (set! (-> p in-ocean) 0))))
+  (ios-ocean-hud-flies-update)
+  0)
+
+;; Chain into *menu-hook* (after ios-fishing's). This file's top-level only runs once, at boot.
+(define *ios-open-ocean-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-open-ocean-menu-hook ()
+  (ios-open-ocean-update)
+  (*ios-open-ocean-prev-menu-hook*)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-open-ocean-menu-hook))
