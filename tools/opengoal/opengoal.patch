+(defun update-snow-valley ((arg0 target))
+  (let* ((target-trans (-> arg0 control trans))
+         (target-dist (vector-vector-distance target-trans (static-vectorm 2075.1 20.0 1852.2))))
+    (if (and (< target-dist (meters 600)) 
+             (> target-dist (meters 90)) 
+             (> (-> target-trans y) (meters -3.5))
+             (< (-> target-trans x) (meters 2075)))
+      (let ((transv-lerp (lerp-scale 0.0 3.0 (vector-length (-> arg0 control transv)) (meters 0.5) (meters 30)))
+            (dist-lerp (lerp-scale 0.0 1.5 target-dist (meters 600) (meters 260))))
+        (if (< target-dist (meters 260))
+          (set! dist-lerp (lerp-scale 1.5 0.0 target-dist (meters 260) (meters 90))))
+        (set! (-> *part-id-table* 34 init-specs 1 initial-valuef) (* (- 3.0 transv-lerp) dist-lerp))
+        (set! (-> *part-id-table* 33 init-specs 1 initial-valuef) (* (* 4.0 transv-lerp) dist-lerp))
+        (set! (-> *part-id-table* 33 init-specs 19 initial-valuef) (+ 32768.0 (vector-y-angle (-> arg0 control transv))))
+        (launch-particles (-> *part-id-table* 34) target-trans)
+        (launch-particles (-> *part-id-table* 33) target-trans))))
+  0
+  (none))
