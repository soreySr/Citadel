+(defun ios-free-boat ()
+  "The free boat (not a village1 actor; free-boat-plan.md), or #f."
+  (let ((pp *ios-free-boat-ppointer*))
+    (the-as fishermans-boat
+            (when pp
+              (let ((proc (-> pp 0)))
+                (if (and proc (= (-> proc pid) *ios-free-boat-pid*)) proc))))))
+
+(defun fishermans-boat-ios-free? ((boat fishermans-boat))
+  "Is this the free boat rather than the village1 actor?"
+  (and *ios-free-boat-entity* (= (-> boat entity) *ios-free-boat-entity*)))
+
+(define-extern fishermans-boat-ios-take-wheel (function none :behavior fishermans-boat))
