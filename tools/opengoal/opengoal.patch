diff --git a/tools/ios/aot_captured_runtime_image.py b/tools/ios/aot_captured_runtime_image.py
new file mode 100644
index 000000000..08d91e530
--- /dev/null
+++ b/tools/ios/aot_captured_runtime_image.py
@@ -0,0 +1,214 @@
+#!/usr/bin/env python3
+"""Build signed-code artifacts from a captured, fully linked Jak 1 runtime."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import struct
+from pathlib import Path
+
+
+PAGE_SIZE = 16 * 1024
+AOT_HEADER = struct.Struct("<8sIIIII32s")
+CODE_HEADER = struct.Struct("<8sIII")
+CODE_ENTRY = struct.Struct("<II")
+
+
+def align_down(value: int, alignment: int) -> int:
+    return value & -alignment
+
+
+def align_up(value: int, alignment: int) -> int:
+    return (value + alignment - 1) & -alignment
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("capture", type=Path)
+    parser.add_argument("runtime_state", type=Path)
+    parser.add_argument("aot_image", type=Path)
+    parser.add_argument("code_ranges", type=Path)
+    parser.add_argument("kernel_entry", type=Path)
+    parser.add_argument("runtime_symbols", type=Path)
+    parser.add_argument("--bootstrap-manifest", type=Path, help="also write Jak1AOTBootstrapManifest.json")
+    args = parser.parse_args()
+
+    capture = json.loads(args.capture.read_text())
+    state = args.runtime_state.read_bytes()
+    if len(state) != 128 * 1024 * 1024:
+        parser.error("runtime state must be exactly 128 MiB")
+
+    ranges = []
+    for load_index, obj in enumerate(capture["objects"]):
+        if obj["version"] != 3:
+            continue
+        segment = obj["segments"]["main"]
+        if segment["size"] == 0:
+            continue
+        start = segment["goal_offset"]
+        end = start + segment["size"]
+        if start < 4 or end > len(state):
+            raise RuntimeError(f"captured main segment is outside GOAL memory: {obj['name']}")
+        ranges.append((start, end, obj["name"], load_index))
+
+    ranges.sort()
+    for previous, current in zip(ranges, ranges[1:]):
+        if current[0] < previous[1]:
+            raise RuntimeError(
+                f"permanent main segments overlap: {previous[2]} and {current[2]}"
+            )
+
+    base = align_down(ranges[0][0], PAGE_SIZE)
+    image_end = align_up(max(item[1] for item in ranges), PAGE_SIZE)
+    image = bytearray(image_end - base)
+    for start, end, _, _ in ranges:
+        image[start - base : end - base] = state[start:end]
+
+    # Stock-iOS native helpers use C-style null for an unavailable optional HUD
+    # process-drawable. The captured GOAL function normally compares this field
+    # only with GOAL #f and then reads its type tag at pointer - 4. Accept both
+    # representations at this one optional-field branch.
+    compatibility_instructions = {
+        0x01E379A8: 0xB4000140,  # cbz x0, 0x01e379d0
+        0x01E379AC: 0xEB15001F,  # cmp x0, x21 (#f)
+        # A second optional process-drawable callback is represented by C null
+        # on iOS. Skip its argument setup and indirect call when absent; the
+        # original non-null relocation and call sequence remains unchanged.
+        0x01E342D0: 0xB40000CF,  # cbz x15, 0x01e342e8
+        # The adjacent optional callback already skips GOAL #f. Also accept
+        # the C-null representation used by the native iOS host.
+        0x01E342F8: 0xB400028F,  # cbz x15, 0x01e34348
+        0x01E342FC: 0xEB1501FF,  # cmp x15, x21 (#f)
+        # Per-entry draw callback uses the same optional representation.
+        0x01E34378: 0xB400014F,  # cbz x15, 0x01e343a0
+        0x01E3437C: 0xEB1501FF,  # cmp x15, x21 (#f)
+        # The paired loop's callback has an independent optional slot.
+        0x01E3441C: 0xB40000CF,  # cbz x15, 0x01e34434
+        0x01E34420: 0xEB1501FF,  # cmp x15, x21 (#f)
+        # Per-item callback uses its existing fallback when absent.
+        0x01E344B4: 0xB400010F,  # cbz x15, 0x01e344d4
+        0x01E344B8: 0xEB1501FF,  # cmp x15, x21 (#f)
+        # Final object callback is optional and already has a #f skip path.
+        0x01E34510: 0xB400016F,  # cbz x15, 0x01e3453c
+        0x01E34514: 0xEB1501FF,  # cmp x15, x21 (#f)
+    }
+    for goal_offset, instruction in compatibility_instructions.items():
+        image_offset = goal_offset - base
+        if image_offset < 0 or image_offset + 4 > len(image):
+            raise RuntimeError(f"compatibility patch is outside the signed image: 0x{goal_offset:08x}")
+        struct.pack_into("<I", image, image_offset, instruction)
+
+    # Native HUD placeholders can have zeroed type-method slots. Route every
+    # HUD indirect GOAL call with the standard `add x15, x15, x27; blr x15`
+    # sequence through the signed guard appended immediately after the image,
+    # goal-nothing, and goal-zero. The guard skips only a zero method and
+    # tail-calls all valid relocated targets.
+    hud_range = next((item for item in ranges if item[2] == "hud"), None)
+    if hud_range is None:
+        raise RuntimeError("captured HUD code range is missing")
+    guard_image_offset = len(image) + 12
+    add_and_call = struct.pack("<II", 0x8B1B01EF, 0xD63F01E0)
+    hud_start = hud_range[0] - base
+    hud_end = hud_range[1] - base
+    guarded_hud_calls = 0
+    cursor = hud_start
+    while True:
+        sequence_offset = image.find(add_and_call, cursor, hud_end)
+        if sequence_offset < 0:
+            break
+        call_offset = sequence_offset + 4
+        branch_delta = guard_image_offset - call_offset
+        if branch_delta % 4 != 0 or not -(1 << 27) <= branch_delta < (1 << 27):
+            raise RuntimeError("HUD optional-call guard is out of branch range")
+        branch = 0x94000000 | ((branch_delta // 4) & 0x03FFFFFF)
+        struct.pack_into("<I", image, call_offset, branch)
+        guarded_hud_calls += 1
+        cursor = sequence_offset + len(add_and_call)
+    if guarded_hud_calls != 78:
+        raise RuntimeError(
+            f"expected 78 HUD indirect calls, found {guarded_hud_calls}"
+        )
+
+    dispatcher = capture.get("kernel_dispatcher_goal_offset")
+    dispatcher_range = next(
+        (item for item in ranges if dispatcher is not None and item[0] <= dispatcher < item[1]),
+        None,
+    )
+    if dispatcher_range is None:
+        raise RuntimeError("captured kernel dispatcher is not in permanent signed code")
+
+    digest = hashlib.sha256(image).digest()
+    args.aot_image.parent.mkdir(parents=True, exist_ok=True)
+    args.aot_image.write_bytes(
+        AOT_HEADER.pack(
+            b"JAK1AOT\0", 1, base, len(image), len(ranges), 0, digest
+        )
+        + image
+    )
+
+    args.code_ranges.parent.mkdir(parents=True, exist_ok=True)
+    with args.code_ranges.open("wb") as output:
+        output.write(CODE_HEADER.pack(b"JAK1COD\0", 1, base, len(ranges)))
+        for start, end, _, _ in ranges:
+            output.write(CODE_ENTRY.pack(start, end - start))
+
+    entry = {
+        "format": "OpenGOAL Jak 1 iOS kernel entry v1",
+        "symbol": "kernel-dispatcher",
+        "goalOffset": dispatcher,
+        "sourceObject": dispatcher_range[2],
+        "sourceMainRelativeOffset": dispatcher - dispatcher_range[0],
+        "capture": {
+            "s7GoalOffset": capture["s7_goal_offset"],
+            "loadIndex": dispatcher_range[3],
+        },
+        "execution": "signed-native-kernel-dispatch-ready",
+    }
+    args.kernel_entry.parent.mkdir(parents=True, exist_ok=True)
+    args.kernel_entry.write_text(json.dumps(entry, indent=2) + "\n")
+
+    # Keep the last record for repeated names, matching the final symbol table
+    # visible in the captured arena.
+    symbols_by_name = {item["name"]: item["goal_offset"] for item in capture["symbols"]}
+    symbol_metadata = {
+        "format": "OpenGOAL Jak 1 iOS captured runtime symbols v1",
+        "s7GoalOffset": capture["s7_goal_offset"],
+        "symbolCount": len(symbols_by_name),
+        "symbols": [
+            {"name": name, "goalOffset": goal_offset}
+            for name, goal_offset in sorted(symbols_by_name.items())
+        ],
+    }
+    args.runtime_symbols.parent.mkdir(parents=True, exist_ok=True)
+    args.runtime_symbols.write_text(json.dumps(symbol_metadata, separators=(",", ":")) + "\n")
+
+    if args.bootstrap_manifest:
+        manifest = {
+            "format": "OpenGOAL Jak 1 iOS AOT bootstrap manifest v1",
+            "game": "jak1",
+            "capturedObjectCount": len(capture["objects"]),
+            "signedMainSegmentCount": len(ranges),
+            "capturedSymbolCount": len(capture["symbols"]),
+            "capturedTypeCount": len(capture["types"]),
+            "s7GoalOffset": capture["s7_goal_offset"],
+            "kernelDispatcherGoalOffset": dispatcher,
+            "codeBaseOffset": base,
+            "codeImageSize": len(image),
+            "runtimeStateSize": len(state),
+            "execution": "signed-native-kernel-dispatch-ready",
+        }
+        args.bootstrap_manifest.parent.mkdir(parents=True, exist_ok=True)
+        args.bootstrap_manifest.write_text(json.dumps(manifest, indent=2) + "\n")
+    print(
+        f"Wrote captured signed image at GOAL 0x{base:08x} "
+        f"({len(image)} bytes, {len(ranges)} permanent code ranges)"
+    )
+    print(f"Kernel dispatcher: 0x{dispatcher:08x} in {dispatcher_range[2]}")
+    print(f"Captured symbol addresses: {len(symbols_by_name)}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/ios/aot_image_pack.py b/tools/ios/aot_image_pack.py
new file mode 100644
index 000000000..e66c6b549
--- /dev/null
+++ b/tools/ios/aot_image_pack.py
@@ -0,0 +1,166 @@
+#!/usr/bin/env python3
+"""Package Jak 1 AOT object segments and static relocations for an iOS loader.
+
+The result is data only: no executable pages are allocated and no code is
+generated at runtime. Static object-to-object relocations, and optionally all
+resolved startup relocations, are applied offline. The optional mode produces
+the fully linked payload that can be compiled into signed Mach-O text.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import struct
+import tempfile
+from pathlib import Path
+
+
+MAGIC = b"JAK1AOT\0"
+VERSION = 1
+HEADER = struct.Struct("<8sIIIII32s")
+PATCH_KINDS = {
+    "intra_segment_pointer": 1,
+    "arm64_other_segment_mov32": 2,
+}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("object_directory", type=Path)
+    parser.add_argument("layout", type=Path)
+    parser.add_argument("link_plan", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument(
+        "--startup-patch-plan",
+        type=Path,
+        help="apply resolved symbol/type startup relocations before packaging",
+    )
+    args = parser.parse_args()
+
+    layout = json.loads(args.layout.read_text())
+    plan = json.loads(args.link_plan.read_text())
+    base = layout["goal_base_offset"]
+    image_size = layout["image_size"]
+    image = bytearray(image_size)
+    intervals: list[tuple[int, int, str]] = []
+
+    for segment in layout["segments"]:
+        destination = segment["goal_offset"] - base
+        size = segment["size"]
+        source = segment["source_file_offset"]
+        end = destination + size
+        if destination < 0 or end > image_size:
+            raise RuntimeError(f"segment outside image: {segment}")
+        intervals.append((destination, end, f"{segment['object']}:{segment['segment']}"))
+        source_data = (args.object_directory / segment["object"]).read_bytes()
+        if source < 0 or source + size > len(source_data):
+            raise RuntimeError(f"segment outside source object: {segment}")
+        image[destination:end] = source_data[source : source + size]
+
+    for (_, previous_end, previous_name), (start, _, name) in zip(
+        sorted(intervals), sorted(intervals)[1:]
+    ):
+        if start < previous_end:
+            raise RuntimeError(f"overlapping AOT layout segments: {previous_name}, {name}")
+
+    patched_offsets: set[int] = set()
+    for patch in plan["static_patches"]:
+        offset = patch["patch_goal_offset"] - base
+        if offset < 0 or offset in patched_offsets:
+            raise RuntimeError(f"static patch outside image or duplicated: {patch}")
+        try:
+            kind = PATCH_KINDS[patch["kind"]]
+        except KeyError as error:
+            raise RuntimeError(f"unsupported static patch: {patch['kind']}") from error
+        value = patch["value"]
+        if kind == PATCH_KINDS["intra_segment_pointer"]:
+            if offset + 4 > image_size:
+                raise RuntimeError(f"static pointer patch outside image: {patch}")
+            struct.pack_into("<I", image, offset, value)
+        else:
+            if offset + 8 > image_size:
+                raise RuntimeError(f"ARM64 static patch outside image: {patch}")
+            movz, movk = struct.unpack_from("<II", image, offset)
+            movz = (movz & ~(0xFFFF << 5)) | ((value & 0xFFFF) << 5)
+            movk = (movk & ~(0xFFFF << 5)) | (((value >> 16) & 0xFFFF) << 5)
+            struct.pack_into("<II", image, offset, movz, movk)
+        patched_offsets.add(offset)
+
+    startup_patch_count = 0
+    if args.startup_patch_plan:
+        startup_plan = json.loads(args.startup_patch_plan.read_text())
+        segment_bases = {
+            (segment["object"], segment["segment"]): segment["goal_offset"]
+            for segment in layout["segments"]
+        }
+        for record in startup_plan["patches"]:
+            kind = record["kind"]
+            if kind == "type_pointer":
+                value = record["type_address"]
+                alternate = None
+                patch_size = 4
+            elif kind == "symbol_offset":
+                value = record["symbol_address"]
+                alternate = record["s7_relative_value"]
+                patch_size = 4
+            elif kind == "arm64_symbol_mov32":
+                value = record["symbol_address"]
+                alternate = record["s7_relative_value"]
+                patch_size = 8
+            else:
+                raise RuntimeError(f"unsupported startup patch kind: {kind}")
+            if value is None:
+                raise RuntimeError(f"unresolved startup patch: {record}")
+            segment_base = segment_bases[(record["object"], record["segment"])]
+            for patch_offset in record["patch_offsets"]:
+                offset = segment_base + patch_offset - base
+                if offset < 0 or offset + patch_size > image_size or offset in patched_offsets:
+                    raise RuntimeError(f"startup patch outside image or duplicated: {record}")
+                if kind == "arm64_symbol_mov32":
+                    movz, movk = struct.unpack_from("<II", image, offset)
+                    current = ((movz >> 5) & 0xFFFF) | (((movk >> 5) & 0xFFFF) << 16)
+                    patched_value = value if current == 0xFFFFFFFF else alternate
+                    movz = (movz & ~(0xFFFF << 5)) | ((patched_value & 0xFFFF) << 5)
+                    movk = (movk & ~(0xFFFF << 5)) | (((patched_value >> 16) & 0xFFFF) << 5)
+                    struct.pack_into("<II", image, offset, movz, movk)
+                else:
+                    current = struct.unpack_from("<i", image, offset)[0]
+                    patched_value = value if current == -1 or alternate is None else alternate
+                    struct.pack_into("<I", image, offset, patched_value)
+                patched_offsets.add(offset)
+                startup_patch_count += 1
+
+    image_digest = hashlib.sha256(image).digest()
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.NamedTemporaryFile(dir=args.output.parent, delete=False) as file:
+        temporary_path = Path(file.name)
+        try:
+            file.write(
+                HEADER.pack(
+                    MAGIC,
+                    VERSION,
+                    base,
+                    image_size,
+                    len(layout["segments"]),
+                    len(patched_offsets),
+                    image_digest,
+                )
+            )
+            file.write(image)
+        except BaseException:
+            temporary_path.unlink(missing_ok=True)
+            raise
+    os.replace(temporary_path, args.output)
+    print(
+        f"Wrote {args.output} ({image_size} image bytes, "
+        f"{len(patched_offsets)} total patches ({startup_patch_count} startup), "
+        f"sha256={image_digest.hex()})"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
