+;; The Fish menu's list, drawn here on the left (the stock option rows are blank: progress-pc.gc draws them at a fixed
+;; x and moving that (left-x-offset) moves the menu backdrop too). Rows line up with the stock ones, so taps, the
+;; cursor and scrolling still work through them: row k of the 6 shown from *progress-scroll* start-index at
+;; y = 40 + 25 k (draw-options 115 25). Text and caught flags are written by the host (SyncIOSFishMenu).
+(defconstant IOS_FISH_MENU_ROWS 64)
+(defconstant IOS_FISH_MENU_SCREEN 41)
+
+(deftype ios-fish-menu-list (structure)
+  ((count  int32 :offset 0)
+   (start  int32 :offset 4)  ;; first row shown (the host copies *progress-scroll* start-index)
+   (rows   string IOS_FISH_MENU_ROWS :offset 16)
+   (caught uint8 IOS_FISH_MENU_ROWS :offset 272))
+  :size-assert #x150)
+
+(define *ios-fish-menu-list* (new 'global 'ios-fish-menu-list))
+(set! (-> *ios-fish-menu-list* count) 0)
+(dotimes (i IOS_FISH_MENU_ROWS)
+  (set! (-> *ios-fish-menu-list* rows i) (new 'global 'string 64 (the-as string #f))))
+
+(defun ios-fish-menu-draw-list ()
+  (let* ((progress (-> *progress-process* 0))
+         (list *ios-fish-menu-list*)
+         (count (-> list count))
+         (start (-> list start))
+         (fade (-> progress transition-percentage-invert))
+         (font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning))))
+    (set-width! font 300)
+    (set-height! font 25)
+    (set! (-> font flags) (font-flags shadow kerning middle-vert large))
+    (set-scale! font (* 0.65 fade))
+    (dotimes (k 6)
+      (let ((index (+ start k)))
+        (when (< index count)
+          (set-color! font
+                      (cond
+                        ((zero? (-> list caught index)) (font-color menu-invalid))
+                        ((and (= index (-> progress option-index)) (not (-> progress in-transition))) (font-color progress-selected))
+                        (else (font-color default))))
+          (set! (-> font origin x) 36.0)
+          (set! (-> font origin y) (the float (+ 40 (* 25 k))))
+          (print-game-text (-> list rows index) font #f (the int (* 128.0 fade)) 22)))))
+  0)
+
+(defun ios-fish-menu-preview-update ()
+  (if (and *progress-process* (= (-> *progress-process* 0 display-state) IOS_FISH_MENU_SCREEN) (< 0 (-> *ios-fish-menu-list* count)))
+    (begin
+      (ios-fish-menu-draw-list)
+      ;; The fish rows are copies of the Back button with their own text ids, so progress's X handling matches none
+      ;; of its cases and stays silent: give a press on a caught fish (pad X, or a touch tap, which the host injects as
+      ;; X) the menus' usual select sound. Pad up/down already plays the stock cursor sound.
+      (if (and (cpad-pressed? 0 x) (not (-> *progress-process* 0 in-transition)) (>= *ios-fish-menu-preview* 0))
+        (sound-play "select-option"))
+      (let ((shown (ios-fish-menu-preview-get)))
+        (if shown (ios-fish-menu-preview-draw-text (-> shown species))))))
+  (let ((want *ios-fish-menu-preview*)
+        (cur (ios-fish-menu-preview-get)))
+    (when (and cur (or (!= (-> cur species) want) (!= *ios-ocean-fish* #t)))
+      (deactivate cur)
+      (set! cur #f))
+    (if (and (not cur) (= *ios-ocean-fish* #t) (>= want 0) (< want (-> *ios-fish-roster* count)))
+      (process-spawn ios-fish-menu-preview want :to *entity-pool*)))
+  0)
+
+;; ---- per frame -----------------------------------------------------------------------------------------------
+
+;; Action menu > Fish: start fishing mode (only where Jak can fish, and once).
+(defun ios-fishing-update ()
+  (ios-fish-menu-preview-update)
+  (when (= *ios-fishing-request* #t)
+    (set! *ios-fishing-request* #f)
+    (if (and (= *ios-can-fish* #t) *target* (not (ios-fisher-get)) (not (paused?)))
+      (process-spawn ios-fisher :to *entity-pool*)))
+  0)
+
+;; Chain into *menu-hook* (after ios-action-menu's). This file's top-level only runs once, at boot.
+(define *ios-fishing-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-fishing-menu-hook ()
+  (ios-fishing-update)
+  (*ios-fishing-prev-menu-hook*)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-fishing-menu-hook))
