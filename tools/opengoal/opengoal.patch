@@ -0,0 +1,73 @@
+#!/usr/bin/env python3
+"""Resolve deterministic OpenGOAL relocations against an iOS AOT layout.
+
+Only relocations whose target is fully known from the object and layout are
+resolved here. Symbol and type links deliberately remain in a startup-table
+plan; resolving them requires the deterministic kernel symbol/type image.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("manifest", type=Path)
+    parser.add_argument("layout", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+
+    manifest = json.loads(args.manifest.read_text())
+    layout = json.loads(args.layout.read_text())
+    offsets = {(item["object"], item["segment"]): item["goal_offset"] for item in layout["segments"]}
+    static_patches = []
+    startup_records = []
+
+    for obj in manifest["objects"]:
+        object_name = obj["path"]
+        for record in obj["relocations"]:
+            segment = record["segment"]
+            source = offsets[(object_name, segment)]
+            kind = record["kind"]
+            if kind == "arm64_other_segment_mov32":
+                target = offsets[(object_name, record["target_segment"])] + record["target_offset"]
+                static_patches.append({
+                    "object": object_name,
+                    "segment": segment,
+                    "patch_goal_offset": source + record["patch_offset"],
+                    "kind": kind,
+                    "value": target,
+                })
+            elif kind == "intra_segment_pointer":
+                static_patches.append({
+                    "object": object_name,
+                    "segment": segment,
+                    "patch_goal_offset": source + record["patch_offset"],
+                    "kind": kind,
+                    "value": source + record["target_offset"],
+                })
+            else:
+                startup_records.append({"object": object_name, **record})
+
+    report = {
+        "format": "OpenGOAL iOS AOT link plan v1",
+        "layout_format": layout["format"],
+        "static_patch_count": len(static_patches),
+        "startup_record_count": len(startup_records),
+        "static_patches": static_patches,
+        "startup_records": startup_records,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + "\n")
+    print(
+        f"Wrote {args.output} ({len(static_patches)} static patches, "
+        f"{len(startup_records)} startup records)"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
