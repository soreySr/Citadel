+      (set! (-> v1-34 direction x) 0.72)
+      (set! (-> v1-34 direction y) -0.6)
+      (set! (-> v1-34 direction z) -0.20)
+      (set! (-> v1-34 direction w) 1.0))
+    (set-vector! (-> s5-1 dir2 color) 0.40 0.40 0.40 1.0) ;; COLOR OF THE KEY LIGHT
+    (set! (-> s5-1 dir2 levels x) 1.0)
+    (set-vector! (-> s5-1 ambi color) -0.18 -0.24 -0.24 1.0) ;; COLOR OF THE AMBIANT LIGHT
