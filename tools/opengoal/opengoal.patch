+;; og:ios ---------------------------------------------------------------------------------------------------------
+;; Expanded Flut Flut (experimental option)
+;;
+;; The flut can be ridden outside Boggy Swamp / Snowy Mountain. On iOS the host links this file's code and loads
+;; eichar-flut+0 (Jak's flut animations) and flut-saddle from the player's SWA.DGO into the global heap, as
+;; level-default art (OpenGOALRuntimeHost.mm LoadExpandedFlut), so the flut survives every level change. Swamp and
+;; Snowy then skip their own copies. ios-flut-spawner is a stand-alone flut pad: no entity, blocking planes,
+;; power cell or hint. Spawned by a level's actor (Sandover: sage.gc) through ios-flut-spawner-spawn.
+
+;; Jak swims at 7 m/s (*swim-mods*); the flut a bit faster.
+(define *flut-ios-swim-mods*
+  (new 'static
+       'surface
+       :name 'swim
+       :turnv 49152.0
+       :turnvv 524288.0
+       :tiltv 65536.0
+       :tiltvv 131072.0
+       :transv-max 32972.8
+       :target-speed 32972.8
+       :seek0 0.75
+       :seek90 0.2
+       :seek180 0.2
+       :fric 0.05
+       :nonlin-fric-dist 1.0
+       :slip-factor 1.0
+       :slide-factor 1.0
+       :slope-up-factor 1.0
+       :slope-down-factor 1.0
+       :slope-slip-angle 1.0
+       :impact-fric 1.0
+       :bend-factor 1.0
+       :bend-speed 1.0
+       :alignv 1.0
+       :slope-up-traction 1.0
+       :align-speed 1.0
+       :mode 'swim))
+
+(defun ios-flut-link-art ()
+  "Called once by the host after loading the flut art into level-default: link Jak's flut animations into eichar."
+  (let ((ag (art-group-get-by-name (-> *level* level-default) "eichar-flut+0")))
+    (if ag (link-art! ag)))
+  0)
+
+(defun ios-flut-riding? ()
+  (and *target* (logtest? (-> *target* control root-prim prim-core action) (collide-action flut))))
+
+;; Not a stock mechanic: the flut floats like swimming Jak (water-control swim-ground) and paddles with its run cycle.
+(defstate target-flut-ios-swim (target)
+  :event
+    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
+      ;; water-control sends 'swim every frame while we float; the standard handler would restart this state
+      (if (= message 'swim) #f (target-flut-standard-event-handler proc argc message block)))
+  :enter
+    (behavior ()
+      (set-time! (-> self state-time))
+      (set! (-> self control mod-surface) *flut-ios-swim-mods*)
+      (logior! (-> self water flag) (water-flag swim-ground)))
+  :exit
+    (behavior ()
+      (set! (-> self control mod-surface) *flut-walk-mods*)
+      ((-> target-flut-start exit)))
+  :trans
+    (behavior ()
+      (if (and (logtest? (-> self control status) (cshape-moving-flags onsurf))
+               (not (logtest? (-> self control status) (cshape-moving-flags on-water))))
+        (set-zero! (-> self water bob)))
+      ;; out of the water (no 'swim for a moment): back to running
+      (when (and (time-elapsed? (-> self water swim-time) (seconds 0.1)) (time-elapsed? (-> self state-time) (seconds 0.1)))
+        (go target-flut-stance))
+      ;; og:preserve-this - High FPS Fix
+      (if (and (recently-pressed? x)
+               (time-elapsed? (-> self water enter-swim-time) (seconds 0.1))
+               (not (logtest? (-> self state-flags) (state-flags prevent-jump))))
+        (go target-flut-jump (-> *FLUT-bank* jump-height-min) (-> *FLUT-bank* jump-height-max))))
+  :code
+    (behavior ()
+      (ja-channel-push! 2 (seconds 0.15))
+      (ja-no-eval :group! eichar-flut-walk-ja :num! (loop!) :dist 49152.0 :frame-num 0.0)
+      (ja-no-eval :chan 1 :group! eichar-flut-run-ja :num! (identity 0.0) :frame-interp 0.0 :dist 40960.0)
+      (let ((f30-0 0.0))
+        (loop
+          (suspend)
+          (set! f30-0 (seek f30-0
+                            (lerp-scale (the-as float 0.0) (the-as float 1.0) (-> self control ctrl-xz-vel) (the-as float 16384.0) (the-as float 32768.0))
+                            (* 4.0 (seconds-per-frame))))
+          (set! (-> self skel root-channel 1 frame-interp) f30-0)
+          ;; keep paddling slowly while floating in place
+          (let ((f0-cycle (current-cycle-distance (-> self skel))))
+            (ja :num! (loop! (fmax 0.35 (/ (* 58.0 (-> self control ctrl-xz-vel)) (* 60.0 f0-cycle))))))
+          (ja :chan 1 :num-func num-func-identity :frame-num (* 0.5 (ja-frame-num 0)))
+          (when (and (< (- (-> self water height) (-> self control trans y)) 4096.0)
+                     (zero? (mod (- (current-time) (-> self state-time)) 21))
+                     (< 8192.0 (-> self control ctrl-xz-vel)))
+            (create-splash (-> self water) (the-as float 0.4) (-> self control trans) 0 (-> self control transv))))))
+  :post
+    (behavior ()
+      (target-swim-post)
+      (target-flut-post-post)))
+
+;; Where the host draws the flut pad (Sandover's zoomer pad model, Jak1Level-ios-flut.fr3z): x y z = pad top in
+;; game units, w = 1 while a spawner exists. Only one pad is shown at a time.
+(define *ios-flut-pad* (new 'static 'vector))
+
+;; The pad model is 1 m tall but has no collision, so it is sunk into the ground leaving this much above it.
+;; The pad is hidden for now (host kDrawFlutPad), so the flut stands on the ground: restore 0.15 m with the pad.
+(defconstant IOS_FLUT_PAD_LIFT (meters 0.0))
+
+;; Where the flut is parked. Kept in the global heap (define-perm), so it survives target-flut.o being relinked when
+;; Swamp/Snowy load: the parked flut stays where Jak left it for the whole session.
+(deftype ios-flut-park (structure)
+  ((pos              vector :inline) ;; ground position, w = yaw
+   (home             vector :inline) ;; the level's flut spot (pre-ground-snap), w = yaw
+   (home-part        sparticle-launch-group)
+   (valid            symbol) ;; pos set
+   (has-home         symbol)
+   (at-home          symbol) ;; parked at home: snap to the ground, show the pad
+   (riding-ours      symbol) ;; Jak rides our flut (not a stock swamp/snow one)
+   (ride-seen-time   time-frame)))
+
+(define-perm *ios-flut-park* ios-flut-park #f)
+
+(when (not *ios-flut-park*)
+  (set! *ios-flut-park* (new 'global 'ios-flut-park))
+  (set! (-> *ios-flut-park* home-part) #f)
+  (set! (-> *ios-flut-park* valid) #f)
+  (set! (-> *ios-flut-park* has-home) #f)
+  (set! (-> *ios-flut-park* at-home) #f)
+  (set! (-> *ios-flut-park* riding-ours) #f)
+  (set! (-> *ios-flut-park* ride-seen-time) 0))
+
+;; The parked flut is only a process while Jak is near it (the model unloads farther away).
+(defconstant IOS_FLUT_SPAWN_DIST (meters 80))
+(defconstant IOS_FLUT_DESPAWN_DIST (meters 100))
+
+(defun ios-flut-park-at-home ()
+  "Losing the flut any other way than getting off (death, respawn) sends it back to its home spot."
+  (let ((park *ios-flut-park*))
+    (set! (-> park pos quad) (-> park home quad))
+    (set! (-> park at-home) #t)
+    (set! (-> park valid) #t))
+  0)
+
+(deftype ios-flut-spawner (process-drawable)
+  ((root        collide-shape-moving :override)
+   (extra-trans vector :inline)
+   (mode        symbol))
+  (:states
+   ios-flut-spawner-idle
+   (ios-flut-spawner-pickup symbol)
+   ios-flut-spawner-wait-for-return))
+
+(defmethod deactivate ((this ios-flut-spawner))
+  (if (= (-> this mode) 'home) (set! (-> *ios-flut-pad* w) 0.0))
+  ((method-of-type process-drawable deactivate) this)
+  (none))
+
+(defbehavior ios-flut-spawner-effect ios-flut-spawner ()
+  "The pad's glow (the level's trans-pad particles, if it has them)."
+  (if (nonzero? (-> self part)) (spawn (-> self part) (-> self root trans)))
+  0
+  (none))
+
+(defbehavior ios-flut-spawner-alive? ios-flut-spawner ()
+  "Stays while the option is on and Jak is near; the parked spot itself is remembered in *ios-flut-park*."
+  (and (= *ios-expanded-flut* #t)
+       (or (not *target*)
+           (>= IOS_FLUT_DESPAWN_DIST (vector-vector-distance (-> self root trans) (-> *target* control trans))))))
+
+(defbehavior ios-flut-spawner-park-here ios-flut-spawner ()
+  "Jak got off at this spawner: it becomes the parked spot."
+  (let ((park *ios-flut-park*))
+    (set! (-> park pos quad) (-> self root trans quad))
+    (set! (-> park pos w) (y-angle (-> self root)))
+    (set! (-> park at-home) (= (-> self mode) 'home))
+    (set! (-> park valid) #t)
+    (set! (-> park riding-ours) #f))
+  0)
+
+(defbehavior ios-flut-spawner-event ios-flut-spawner ((proc process) (argc int) (message symbol) (block event-message-block))
+  (case message
+    (('trans) (vector+! (the-as vector (-> block param 0)) (-> self root trans) (-> self extra-trans)))))
+
+(defstate ios-flut-spawner-idle (ios-flut-spawner)
+  :event ios-flut-spawner-event
+  :exit
+    (behavior ()
+      (set! (-> self root root-prim prim-core action) (collide-action))
+      (set! (-> self root root-prim prim-core offense) (collide-offense no-offense))
+      0)
+  :code
+    (behavior ()
+      (ja-channel-set! 1)
+      (ja :group! flut-saddle-flut-idle-ja)
+      (set! (-> self root root-prim prim-core action) (collide-action solid attackable-unused))
+      (set! (-> self root root-prim prim-core offense) (collide-offense indestructible))
+      (loop
+        (if (not (ios-flut-spawner-alive?)) (deactivate self))
+        (if (ios-flut-riding?) (go ios-flut-spawner-wait-for-return))
+        ;; same prompt as the stock flutflut pad
+        (when (and (and *target* (>= 20480.0 (vector-vector-distance (-> self root trans) (-> *target* control trans))))
+                   (not (movie?))
+                   (not (level-hint-displayed?)))
+          (hide-hud)
+          (level-hint-surpress!)
+          (kill-current-level-hint '() '(sidekick voicebox) 'exit)
+          (when (and (hud-hidden?) (can-grab-display? self))
+            (let ((gp-0 (new 'stack 'font-context *font-default-matrix* 32 160 0.0 (font-color default) (font-flags shadow kerning))))
+              (set-width! gp-0 440)
+              (set-height! gp-0 80)
+              (set! (-> gp-0 flags) (font-flags shadow kerning large))
+              (print-game-text (lookup-text! *common-text* (text-id press-to-use) #f) gp-0 #f 128 22))
+            (when (and (cpad-pressed? 0 circle) (send-event *target* 'change-mode 'flut self))
+              ;; while ridden, the flut belongs at home if Jak loses it without getting off
+              (ios-flut-park-at-home)
+              (set! (-> *ios-flut-park* riding-ours) #t)
+              (set-time! (-> *ios-flut-park* ride-seen-time))
+              (go ios-flut-spawner-pickup 'wait-for-return))))
+        (ios-flut-spawner-effect)
+        (suspend)
+        (ja :num! (loop!))))
+  :post ja-post)
+
+;; Hidden while Jak gets on (until he moves away) or off (until target-flut-get-off-jump sends 'draw).
+(defstate ios-flut-spawner-pickup (ios-flut-spawner)
+  :event
+    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
+      (case message
+        (('draw)
+         (ja-channel-set! 1)
+         (ja :group! flut-saddle-flut-idle-ja)
+         (set! (-> self root root-prim prim-core action) (collide-action solid attackable-unused))
+         (set! (-> self root root-prim prim-core offense) (collide-offense indestructible))
+         (transform-post))
+        (('trans) (vector+! (the-as vector (-> block param 0)) (-> self root trans) (-> self extra-trans)))))
+  :code
+    (behavior ((next symbol))
+      (ja-channel-set! 0)
+      (ja-post)
+      (while (and (zero? (ja-group-size))
+                  *target*
+                  (>= 24576.0 (vector-vector-distance (-> self root trans) (-> *target* control trans))))
+        (ios-flut-spawner-effect)
+        (suspend))
+      (when (nonzero? (ja-group-size))
+        (while (ios-flut-riding?)
+          (ios-flut-spawner-effect)
+          (suspend))
+        (suspend-for (seconds 1)
+          (ios-flut-spawner-effect)))
+      (cond
+        ((= next 'idle) (go ios-flut-spawner-idle))
+        ;; got off somewhere else meanwhile: the flut isn't here
+        ((not (ios-flut-riding?)) (deactivate self))
+        (else (go ios-flut-spawner-wait-for-return)))))
+
+;; Jak rides the flut (anywhere). Touching the spot again gets him off, like the stock pad.
+(defstate ios-flut-spawner-wait-for-return (ios-flut-spawner)
+  :event
+    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
+      (when (and (or (= message 'touch) (= message 'attack)) (send-event *target* 'end-mode))
+        (ios-flut-spawner-park-here)
+        (go ios-flut-spawner-pickup 'idle))
+      (if (= message 'trans) (vector+! (the-as vector (-> block param 0)) (-> self root trans) (-> self extra-trans))))
+  :code
+    (behavior ()
+      (ja-channel-set! 0)
+      (ja-post)
+      (loop
+        (if (not (ios-flut-spawner-alive?)) (deactivate self))
+        ;; the flut was lost (death, respawn): it is parked at home now, not here (the manager respawns it)
+        (if (not (ios-flut-riding?)) (deactivate self))
+        (ios-flut-spawner-effect)
+        (suspend))))
+
+(defbehavior ios-flut-spawner-init-by-other ios-flut-spawner ((pos vector) (yaw float) (mode symbol))
+  (let ((s4-0 (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player))))
+    (set! (-> s4-0 dynam) (copy *standard-dynamics* 'process))
+    (set! (-> s4-0 reaction) default-collision-reaction)
+    (set! (-> s4-0 no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
+    (let ((s3-0 (new 'process 'collide-shape-prim-sphere s4-0 (the-as uint 0))))
+      (set! (-> s3-0 prim-core collide-as) (collide-kind wall-object))
+      (set! (-> s3-0 collide-with) (collide-kind target))
+      (set-vector! (-> s3-0 local-sphere) 0.0 6144.0 0.0 6144.0)
+      (set-root-prim! s4-0 s3-0))
+    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
+    (backup-collide-with-as s4-0)
+    (set! (-> self root) s4-0))
+  (set! (-> self entity) #f)
+  (set! (-> self mode) mode)
+  (set! (-> self root trans quad) (-> pos quad))
+  (set! (-> self root trans w) 1.0)
+  (set-yaw-angle-clear-roll-pitch! (-> self root) yaw)
+  (initialize-skeleton self *flutflut-sg* '())
+  (logior! (-> self skel status) (janim-status eye))
+  (set! (-> self draw shadow-ctrl) *flutflut-shadow-control*)
+  (let ((v1-24 (-> self node-list data)))
+    (set! (-> v1-24 0 param0) cspace<-transformq+trans!)
+    (set! (-> v1-24 0 param1) (the-as basic (-> self root trans)))
+    (set! (-> v1-24 0 param2) (the-as basic (-> self extra-trans))))
+  (set! (-> self part) (the-as sparticle-launch-control 0))
+  (when (= mode 'home)
+    ;; the home spot is given above the ground: drop onto it, then stand on the pad
+    (move-to-ground (-> self root) 40960.0 40960.0 #t (collide-kind background))
+    (+! (-> self root trans y) IOS_FLUT_PAD_LIFT)
+    (set! (-> *ios-flut-pad* quad) (-> self root trans quad))
+    (set! (-> *ios-flut-pad* w) 1.0)
+    (let ((part-group (-> *ios-flut-park* home-part)))
+      (if part-group (set! (-> self part) (create-launch-control part-group self)))))
+  (update-transforms! (-> self root))
+  (cond
+    ;; Jak is getting off here (target-flut-ios-dismount): hidden until target-flut-get-off-jump sends 'draw
+    ((= mode 'dismount) (go ios-flut-spawner-pickup 'idle))
+    ((ios-flut-riding?) (go ios-flut-spawner-wait-for-return))
+    (else (go ios-flut-spawner-idle)))
+  (none))
+
+;; Watches the parked spot: spawns the flut when Jak comes near it, and sends a lost flut home.
+;; In the default pool (not *entity-pool*, which reset-actors clears when Jak dies).
+(deftype ios-flut-manager (process)
+  ()
+  (:states
+   ios-flut-manager-idle))
+
+(defstate ios-flut-manager-idle (ios-flut-manager)
+  :code
+    (behavior ()
+      (loop
+        (let ((park *ios-flut-park*))
+          (when (and (= *ios-expanded-flut* #t) (-> park valid))
+            (cond
+              ((ios-flut-riding?) (set-time! (-> park ride-seen-time)))
+              ;; rode our flut but lost it without getting off: it is at home already (set when mounting)
+              ((and (-> park riding-ours) (time-elapsed? (-> park ride-seen-time) (seconds 1.5)))
+               (set! (-> park riding-ours) #f)))
+            (when (and *target*
+                       (not (ios-flut-riding?))
+                       (not (-> park riding-ours))
+                       (not (process-by-name 'ios-flut-parked *entity-pool*))
+                       (>= IOS_FLUT_SPAWN_DIST (vector-vector-distance (-> park pos) (-> *target* control trans))))
+              (process-spawn ios-flut-spawner
+                             (-> park pos)
+                             (-> park pos w)
+                             (if (-> park at-home) 'home 'parked)
+                             :name 'ios-flut-parked
+                             :to *entity-pool*))))
+        (suspend))))
+
+(defbehavior ios-flut-manager-init-by-other ios-flut-manager ()
+  ;; keep running through pauses for death (target-death sets a process-mask setting)
+  (logclear! (-> self mask) (process-mask actor-pause platform enemy projectile death))
+  (go ios-flut-manager-idle)
+  (none))
+
+(defun ios-flut-ensure-manager ()
+  (if (not (process-by-name 'ios-flut-manager *default-pool*))
+    (process-spawn ios-flut-manager :name 'ios-flut-manager :to *default-pool*))
+  0)
+
+;; Get off anywhere on land with circle (the same button that gets on), using the stock get-off sequence the pad
+;; uses: a flut spawner is created where Jak stands, and that spot becomes the parked spot.
+(defbehavior target-flut-ios-dismount target ()
+  (when (and (= *ios-expanded-flut* #t)
+             (-> *ios-flut-park* riding-ours)
+             (cpad-pressed? (-> self control cpad number) circle)
+             ;; on the driveable boat O takes the wheel, with Jak still on the flut
+             (not (= *ios-boat-boardable* #t))
+             (logtest? (-> self control status) (cshape-moving-flags onsurf))
+             (not (logtest? (-> self water flag) (water-flag touch-water)))
+             (not (movie?)))
+    (let ((old (process-by-name 'ios-flut-parked *entity-pool*)))
+      (if old (deactivate old)))
+    (let ((park *ios-flut-park*))
+      (set! (-> park pos quad) (-> self control trans quad))
+      (set! (-> park pos w) (y-angle (-> self control)))
+      (set! (-> park at-home) #f)
+      (set! (-> park valid) #t)
+      (set! (-> park riding-ours) #f)
+      (ios-flut-ensure-manager)
+      (let ((spawner (process-spawn ios-flut-spawner (-> park pos) (-> park pos w) 'dismount
+                                    :name 'ios-flut-parked :to *entity-pool*)))
+        (when spawner
+          (go target-flut-get-off (ppointer->handle spawner))))))
+  0)
+
+(defun ios-flut-spawner-spawn ((name symbol) (level-name symbol) (pos vector) (yaw float) (part-group sparticle-launch-group))
+  "A level's flut spot (Sandover: sage.gc). The flut starts there and returns there when lost; once Jak gets off
+   somewhere else, it stays parked there instead (*ios-flut-park*)."
+  (when (= *ios-expanded-flut* #t)
+    (let ((park *ios-flut-park*))
+      (set! (-> park home quad) (-> pos quad))
+      (set! (-> park home w) yaw)
+      (set! (-> park home-part) part-group)
+      (set! (-> park has-home) #t)
+      (if (not (-> park valid)) (ios-flut-park-at-home)))
+    (ios-flut-ensure-manager))
+  0)
