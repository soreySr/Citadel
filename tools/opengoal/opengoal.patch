+;; og:ios driveable boat, open ocean (experimental) ------------------------------------------------------------
+;;
+;; With the option on, the sea between Sandover (village1 + beach), Misty Island and Geyser Rock (training) is
+;; sailable, as is the coast down to Rock Village / Boggy Swamp. Village1 stays loaded the whole time: it owns the boat and the med-res-level low-res models of the
+;; other islands (each hides itself once its real level is active). The second level slot streams in the nearest
+;; other island; it is displayed (full detail, interactive) once it is the closest island, otherwise its low-res
+;; model shows. On arrival the island's continue point is set, which switches the music and respawn like a normal
+;; level transition, and the stock load boundaries take over again. The manager also provides ocean water outside
+;; every level's water volumes and sends a shark after Jak when he swims there.
+
+;; Island centres and "home" radii (xz, game units). Inside a home zone the stock level logic is in charge.
+(defconstant IOS_SEA_VILLAGE_X (meters 0))
+(defconstant IOS_SEA_VILLAGE_Z (meters 40))
+(defconstant IOS_SEA_VILLAGE_R (meters 330))
+(defconstant IOS_SEA_BEACH_X (meters -320))
+(defconstant IOS_SEA_BEACH_Z (meters -310))
+(defconstant IOS_SEA_BEACH_R (meters 280))
+(defconstant IOS_SEA_MISTY_X (meters 0))
+(defconstant IOS_SEA_MISTY_Z (meters 1000))
+(defconstant IOS_SEA_MISTY_R (meters 330))
+(defconstant IOS_SEA_TRAINING_X (meters -1230))
+(defconstant IOS_SEA_TRAINING_Z (meters 1000))
+(defconstant IOS_SEA_TRAINING_R (meters 250))
+(defconstant IOS_SEA_JUNGLE_X (meters 360))
+(defconstant IOS_SEA_JUNGLE_Z (meters -240))
+(defconstant IOS_SEA_JUNGLE_R (meters 330))
+;; Rock Village (village2) and Boggy Swamp, ~1.6-2 km down the coast past Fire Canyon (collision extents:
+;; village2 x 150..525 z -1793..-1474, swamp x 270..691 z -2167..-1829).
+(defconstant IOS_SEA_VILLAGE2_X (meters 340))
+(defconstant IOS_SEA_VILLAGE2_Z (meters -1630))
+(defconstant IOS_SEA_VILLAGE2_R (meters 330))
+(defconstant IOS_SEA_SWAMP_X (meters 480))
+(defconstant IOS_SEA_SWAMP_Z (meters -2000))
+(defconstant IOS_SEA_SWAMP_R (meters 330))
+;; The two are only ~400 m apart, with no low-res models of each other. With the free boat (free-boat-plan.md
+;; phase 4) nothing needs Sandover down there, so at sea the "south" pair takes both level slots: village2 + swamp,
+;; like the stock levels there. Jak switches between the Sandover (north) and south pairs when the nearest south
+;; destination is this much nearer than the nearest north one (or the other way round).
+(defconstant IOS_SEA_REGION_HYSTERESIS 0.9)
+;; Arrival is deliberately tighter than the streaming radii. Several Sandover level spheres overlap, so using
+;; them as arrival zones skips sea mode entirely and prevents Beach/Jungle from ever receiving a preload.
+(defconstant IOS_SEA_ARRIVE_R (meters 150))
+;; Land radius around each island centre: no open-ocean water inside it (the island's own water volumes cover
+;; its shores; this keeps the fallback water away from dry land that has none).
+(defconstant IOS_SEA_LAND_R (meters 150))
+
+(defun ios-sea-distance ((pos vector) (x float) (z float))
+  (sqrtf (+ (square (- (-> pos x) x)) (square (- (-> pos z) z)))))
+
+(deftype ios-ocean-manager (process)
+  ((sea-mode     symbol)
+   (primary      symbol)
+   (water-claim  symbol)
+   (swim-time    time-frame)
+   (shark        handle)
+   (shark-time   time-frame)
+   (shark-delay  time-frame)
+   (boat-shark-time  time-frame)
+   (boat-shark-delay time-frame)
+   (tick         int32)
+   (walls-bsp     bsp-header)  ;; jungle bsp whose sea walls were last set (ios-ocean-sync-sea-walls)
+   (walls-removed symbol)
+   (coast-safe    vector :inline)  ;; last spot of Jak's outside the stand-in coastline (w = 1 once set)
+   (south         symbol)  ;; at sea in the Rock Village / Boggy Swamp pair (ios-ocean-update-levels)
+   (death-seen    symbol))  ;; Jak's current death was already handled (ios-ocean-return-boat-on-death)
+  (:states
+   ios-ocean-manager-idle))
+
+(defun ios-ocean-boat ()
+  "The boat: the free boat (free-boat-plan.md), else the village1 actor while it is alive, else #f."
+  (let ((free (ios-free-boat)))
+    (the-as fishermans-boat
+            (cond
+              (free free)
+              (else
+               ;; fishermans-boat-2, IOS_BOAT_PARK_AID in pc/ios/ios-boat-park.gc
+               (let* ((ent (entity-by-aid (the-as uint 10419)))
+                      (proc (if ent (-> ent extra process))))
+                 (if (and proc (type-type? (-> proc type) fishermans-boat)) proc)))))))
+
+(defun ios-ocean-manager-get ()
+  "The standalone ocean manager (ios-ocean-manager-ensure), or #f."
+  (let ((pp *ios-ocean-manager-ppointer*))
+    (the-as ios-ocean-manager
+            (when pp
+              (let ((proc (-> pp 0)))
+                (if (and proc (= (-> proc pid) *ios-ocean-manager-pid*)) proc))))))
+
+(deftype ios-ocean-shark (process-drawable)
+  ((dir      vector :inline)
+   (start    vector :inline)
+   (vel      vector :inline)
+   (boat     handle)
+   (boat-mode symbol)
+   (sound-id sound-id)
+   (chase-time  time-frame)
+   (breach-time time-frame))
+  (:states
+   ios-ocean-shark-chase
+   ios-ocean-shark-breach
+   ios-ocean-shark-bite
+   ios-ocean-shark-leave))
+
+(define *ios-ocean-in-stock-water* #f)
+
+(defun ios-ocean-target-in-stock-water? ()
+  "Is Jak inside any loaded level's water volume (ocean, pools, rivers)?"
+  (set! *ios-ocean-in-stock-water* #f)
+  (iterate-process-tree *entity-pool*
+                        (lambda ((arg0 process))
+                          (when (and *target*
+                                     (type-type? (-> arg0 type) water-vol)
+                                     (nonzero? (-> (the-as water-vol arg0) vol))
+                                     (point-in-vol? (-> (the-as water-vol arg0) vol) (-> *target* control trans)))
+                            (set! *ios-ocean-in-stock-water* #t))
+                          #t)
+                        *null-kernel-context*)
+  *ios-ocean-in-stock-water*)
+
+(defun ios-ocean-open-sea? ((pos vector))
+  "Far enough from every island's land to be open water."
+  (and (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_VILLAGE_X IOS_SEA_VILLAGE_Z))
+       (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_BEACH_X IOS_SEA_BEACH_Z))
+       (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_MISTY_X IOS_SEA_MISTY_Z))
+       (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_TRAINING_X IOS_SEA_TRAINING_Z))
+       (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_JUNGLE_X IOS_SEA_JUNGLE_Z))
+       (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_VILLAGE2_X IOS_SEA_VILLAGE2_Z))
+       (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_SWAMP_X IOS_SEA_SWAMP_Z))))
+
+(defun ios-ocean-set-respawn ((zone symbol))
+  "Keep an open-sea death tied to the island whose full-detail level is currently linked. Village and
+   Misty use their docks; levels without a dedicated dock retain their normal initial continue."
+  (case zone
+    (('misty)
+     (set-continue! *game-info* "misty-start")
+     (set-vector! (-> *game-info* current-continue trans) 49971.2 28672.0 2924544.0 1.0)
+     (set-vector! (-> *game-info* current-continue camera-trans) 49971.2 49152.0 2859008.0 1.0))
+    (('training) (set-continue! *game-info* "training-start"))
+    (('beach) (set-continue! *game-info* "beach-start"))
+    (('jungle) (set-continue! *game-info* "jungle-start"))
+    (('village2) (set-continue! *game-info* "village2-dock"))
+    (('swamp) (set-continue! *game-info* "swamp-dock1"))
+    (else
+     (set-continue! *game-info* "village1-hut")
+     (set-vector! (-> *game-info* current-continue trans) -88473.6 28672.0 425984.0 1.0)
+     (set-vector! (-> *game-info* current-continue camera-trans) -88473.6 49152.0 360448.0 1.0)))
+  0
+  (none))
+
+(defun ios-ocean-mark-low-res-models ()
+  "Keep village1's low-res island models (and the boat) alive while village1 is in 'special display mode,
+   like the misty / training continue points do."
+  (dolist (name '("med-res-level-1"
+                  "med-res-level-2"
+                  "med-res-level-3"
+                  "med-res-level-4"
+                  "med-res-level-6"
+                  "med-res-level-7"
+                  "med-res-level-8"
+                  "med-res-level-9"
+                  "med-res-level-11"
+                  "med-res-level-14"
+                  "med-res-level-22"
+                  "med-res-level-23"
+                  "fishermans-boat-2"))
+    (let ((ent (entity-by-name (the-as string (car name)))))
+      (if ent (set-or-clear-status! (the-as entity-actor ent) (entity-perm-status bit-7) #t))))
+  0
+  (none))
+
+(defbehavior ios-ocean-claim-water ios-ocean-manager ()
+  "Act as an ocean water-vol for Jak (same settings as the levels' ocean volumes)."
+  (let ((w (-> *target* water)))
+    (set! (-> w volume) (process->handle self))
+    (logior! (-> w flag) (water-flag active can-wade can-swim use-ocean part-water))
+    (set! (-> w base-height) 0.0)
+    (set! (-> w ocean-offset) 0.0)
+    (set! (-> w wade-height) 2048.0)
+    (set! (-> w swim-height) 8192.0)
+    (set! (-> w bottom-height) 32768.0)
+    (set-zero! (-> w bob)))
+  (set! (-> self water-claim) #t)
+  0
+  (none))
+
+(defbehavior ios-ocean-release-water ios-ocean-manager ()
+  "Same as water-vol on-exit-water: drop the water flags and let the level water volumes re-check Jak."
+  (when (-> self water-claim)
+    (set! (-> self water-claim) #f)
+    (when (and *target* (= (handle->process (-> *target* water volume)) self))
+      (logclear! (-> *target* water flag)
+                 (water-flag active
+                             can-wade
+                             can-swim
+                             use-ocean
+                             tar
+                             mud
+                             deadly
+                             use-ripple-offset
+                             no-grab-sound
+                             part-water
+                             dark-eco
+                             lava
+                             wt26))
+      (set! (-> *target* water volume) (the-as handle #f))
+      (iterate-process-tree *entity-pool*
+                            (lambda ((arg0 water-vol))
+                              (if (type-type? (-> arg0 type) water-vol) (send-event arg0 'update)))
+                            *null-kernel-context*)))
+  0
+  (none))
+
+(defun ios-ocean-birth-water-vols ()
+  "Spawn the active levels' water volumes near Jak. A level streamed in with force-vis gets no actor births at
+   all while Jak is outside its bsp (actors-update skips it while all-visible?), and the sea around an island lies
+   outside it, so its water would never spawn and Jak would sink through. bit-3 keeps actors-update from killing them."
+  (let ((pos (-> *target* control trans)))
+    (dotimes (i (-> *level* length))
+      (let ((lev (-> *level* level i)))
+        ;; inside a level's bsp its stock vis decides
+        (when (and (= (-> lev status) 'active) (not (-> lev inside-boxes?)) (nonzero? (-> lev entity)))
+          (dotimes (j (-> lev entity length))
+            (let* ((link (-> lev entity data j))
+                   (ent (-> link entity)))
+              (when (and (type-type? (-> ent type) entity-actor)
+                         ;; subtypes too (water-anim)
+                         (type-type? (-> (the-as entity-actor ent) etype) water-vol)
+                         (not (-> link process))
+                         (not (logtest? (-> link perm status) (entity-perm-status bit-0 dead)))
+                         (< (vector-vector-xz-distance (-> link trans) pos) (meters 300)))
+                (entity-birth-no-kill ent))))))))
+  0
+  (none))
+
+(defbehavior ios-ocean-update-water ios-ocean-manager ()
+  "Ocean water anywhere outside the levels' own water volumes."
+  (cond
+    ((not *target*) (set! (-> self water-claim) #f))
+    ((-> self water-claim)
+     ;; release once a level volume covers Jak again (checked every 8 frames) or he is back near land
+     (when (or (not (= (handle->process (-> *target* water volume)) self))
+               (not (ios-ocean-open-sea? (-> *target* control trans)))
+               (and (zero? (logand (-> self tick) 7)) (ios-ocean-target-in-stock-water?)))
+       (ios-ocean-release-water)))
+    ((and (not (handle->process (-> *target* water volume)))
+          (zero? (logand (-> self tick) 7))
+          (ios-ocean-open-sea? (-> *target* control trans))
+          (not (ios-ocean-target-in-stock-water?)))
+     (ios-ocean-claim-water)))
+  0
+  (none))
+
+(defbehavior ios-ocean-arrive ios-ocean-manager ((zone symbol))
+  "Back in an island's home zone: the same level setup as its continue point, and its continue (music, respawn)."
+  (case zone
+    (('misty)
+     (load-state-want-levels 'village1 'misty)
+     (load-state-want-display-level 'misty 'display)
+     (load-state-want-display-level 'village1 'special)
+     (load-state-want-vis 'mis)
+     (load-state-want-force-vis 'misty #f)
+     (ios-ocean-set-respawn 'misty))
+    (('training)
+     (load-state-want-levels 'village1 'training)
+     (load-state-want-display-level 'training 'display)
+     (load-state-want-display-level 'village1 'special)
+     (load-state-want-vis 'tra)
+     (load-state-want-force-vis 'training #f)
+     (ios-ocean-set-respawn 'training))
+    (('beach)
+     (load-state-want-levels 'village1 'beach)
+     (load-state-want-display-level 'village1 'display)
+     (load-state-want-display-level 'beach 'display)
+     (load-state-want-vis 'bea)
+     (load-state-want-force-vis 'village1 #f)
+     ;; sea mode streamed it in with force-vis, which suppresses its actors outside its bsp
+     (load-state-want-force-vis 'beach #f)
+     (ios-ocean-set-respawn 'beach))
+    (('jungle)
+     ;; same as the stock jungle-start continue: both levels in full (Sandover borders the jungle)
+     (load-state-want-levels 'village1 'jungle)
+     (load-state-want-display-level 'jungle 'display)
+     (load-state-want-display-level 'village1 'display)
+     (load-state-want-vis 'jun)
+     (load-state-want-force-vis 'village1 #f)
+     (load-state-want-force-vis 'jungle #f)
+     (ios-ocean-set-respawn 'jungle))
+    (('village2 'swamp)
+     (cond
+       (*ios-boat-art-resident*
+        ;; the free boat needs no level: the stock pair here, Rock Village and Boggy Swamp both in full
+        (load-state-want-levels 'village2 'swamp)
+        (load-state-want-display-level 'village2 'display)
+        (load-state-want-display-level 'swamp 'display)
+        (load-state-want-vis (if (= zone 'swamp) 'swa 'vi2))
+        (load-state-want-force-vis 'village2 #f)
+        (load-state-want-force-vis 'swamp #f))
+       (else
+        ;; the boat is a village1 actor: keep village1 in the other slot so it survives docking
+        (load-state-want-levels 'village1 zone)
+        (load-state-want-display-level zone 'display)
+        (load-state-want-display-level 'village1 'special)
+        (load-state-want-vis (if (= zone 'swamp) 'swa 'vi2))
+        (load-state-want-force-vis zone #f)))
+     (ios-ocean-set-respawn zone))
+    (else
+     ;; like fishermans-boat-entering-village
+     (load-commands-set! *level* '())
+     (load-state-want-levels 'village1 'beach)
+     (load-state-want-display-level 'village1 'display)
+     (load-state-want-vis 'vi1)
+     (load-state-want-force-vis 'village1 #f)
+     (ios-ocean-set-respawn 'village1)))
+  0
+  (none))
+
+(defbehavior ios-ocean-update-south-levels ios-ocean-manager ((d-village2 float) (d-swamp float))
+  "At sea near Rock Village / Boggy Swamp with the free boat: both level slots for them, each shown in full once
+   loaded. Out at sea neither bsp can work out visibility, so both are drawn whole (force-vis); vis data and the
+   respawn follow the nearer one."
+  (let ((near (if (< d-swamp d-village2) 'swamp 'village2)))
+    (when (!= near (-> self primary))
+      (set! (-> self primary) near)
+      (ios-ocean-set-respawn near))
+    (load-state-want-levels 'village2 'swamp)
+    (dolist (lev '(village2 swamp))
+      (let ((status (level-status *level* (the-as symbol (car lev)))))
+        (load-state-want-display-level (the-as symbol (car lev))
+                                       (if (or (= status 'loaded) (= status 'alive) (= status 'active)) 'display #f))
+        (load-state-want-force-vis (the-as symbol (car lev)) #t)))
+    (load-state-want-vis (if (= near 'swamp) 'swa 'vi2)))
+  0
+  (none))
+
+(defbehavior ios-ocean-update-levels ios-ocean-manager ()
+  "Pick the levels for Jak's position at sea (every 10 frames)."
+  (let* ((pos (-> *target* control trans))
+         (d-village (ios-sea-distance pos IOS_SEA_VILLAGE_X IOS_SEA_VILLAGE_Z))
+         (d-beach (ios-sea-distance pos IOS_SEA_BEACH_X IOS_SEA_BEACH_Z))
+         (d-misty (ios-sea-distance pos IOS_SEA_MISTY_X IOS_SEA_MISTY_Z))
+         (d-training (ios-sea-distance pos IOS_SEA_TRAINING_X IOS_SEA_TRAINING_Z))
+         (d-jungle (ios-sea-distance pos IOS_SEA_JUNGLE_X IOS_SEA_JUNGLE_Z))
+         (d-village2 (ios-sea-distance pos IOS_SEA_VILLAGE2_X IOS_SEA_VILLAGE2_Z))
+         (d-swamp (ios-sea-distance pos IOS_SEA_SWAMP_X IOS_SEA_SWAMP_Z))
+         (zone (cond
+                 ((< d-misty IOS_SEA_ARRIVE_R) 'misty)
+                 ((< d-training IOS_SEA_ARRIVE_R) 'training)
+                 ((< d-jungle IOS_SEA_ARRIVE_R) 'jungle)
+                 ((< d-village2 IOS_SEA_ARRIVE_R) 'village2)
+                 ((< d-swamp IOS_SEA_ARRIVE_R) 'swamp)
+                 ((< d-beach IOS_SEA_ARRIVE_R) 'beach)
+                 ((< d-village IOS_SEA_ARRIVE_R) 'village1)
+                 (else #f)))
+         ;; Only a trip over water is managed. Much of Sandover's land (village1-hut, ~215 m out) lies outside
+         ;; the arrival zones, so walking or loading a save there must not switch to sea mode.
+         (at-sea? (or *ios-boat-driving*
+                      (logtest? (-> *target* water flag) (water-flag swimming under-water)))))
+    (cond
+      (zone
+       ;; only take over again if we were managing the trip
+       (when (-> self sea-mode)
+         (set! (-> self sea-mode) #f)
+         (ios-ocean-arrive zone)))
+      ((not at-sea?)
+       ;; back on land outside the arrival zones: hand the nearest island back to the stock level logic
+       (when (-> self sea-mode)
+         (set! (-> self sea-mode) #f)
+         (let ((nearest 'village1)
+               (d-nearest d-village))
+           (when (< d-beach d-nearest) (set! nearest 'beach) (set! d-nearest d-beach))
+           (when (< d-misty d-nearest) (set! nearest 'misty) (set! d-nearest d-misty))
+           (when (< d-training d-nearest) (set! nearest 'training) (set! d-nearest d-training))
+           (when (< d-jungle d-nearest) (set! nearest 'jungle) (set! d-nearest d-jungle))
+           (when (< d-village2 d-nearest) (set! nearest 'village2) (set! d-nearest d-village2))
+           (when (< d-swamp d-nearest) (set! nearest 'swamp) (set! d-nearest d-swamp))
+           (ios-ocean-arrive nearest))))
+      ;; Rock Village / Boggy Swamp at sea with the free boat: both slots, no Sandover (see IOS_SEA_REGION_HYSTERESIS)
+      ((and *ios-boat-art-resident*
+            (let ((d-south (fmin d-village2 d-swamp))
+                  (d-north (fmin (fmin (fmin d-village d-beach) (fmin d-misty d-training)) d-jungle)))
+              (set! (-> self south)
+                    (if (-> self south)
+                      (not (< d-north (* IOS_SEA_REGION_HYSTERESIS d-south)))
+                      (< d-south (* IOS_SEA_REGION_HYSTERESIS d-north))))
+              (-> self south)))
+       (set! (-> self sea-mode) #t)
+       (ios-ocean-update-south-levels d-village2 d-swamp))
+      (else
+       (when (not (-> self sea-mode))
+         (set! (-> self sea-mode) #t)
+         (set! (-> self primary) 'village1)
+         (ios-ocean-mark-low-res-models))
+       (when (and *ios-boat-art-resident* (or (= (-> self primary) 'village2) (= (-> self primary) 'swamp)))
+         ;; back from the south pair: #f so the primary check below sets the respawn again
+         (set! (-> self primary) #f)
+         (ios-ocean-mark-low-res-models))
+       ;; The second slot always streams the nearest destination. Beach and Jungle must participate here too;
+       ;; otherwise their low-res stand-ins remain visible all the way to shore and their real actors never link.
+       (let ((other 'misty)
+             (d-other d-misty)
+             (other-radius IOS_SEA_MISTY_R))
+         (when (< d-training d-other)
+           (set! other 'training)
+           (set! d-other d-training)
+           (set! other-radius IOS_SEA_TRAINING_R))
+         (when (< d-beach d-other)
+           (set! other 'beach)
+           (set! d-other d-beach)
+           (set! other-radius IOS_SEA_BEACH_R))
+         (when (< d-jungle d-other)
+           (set! other 'jungle)
+           (set! d-other d-jungle)
+           (set! other-radius IOS_SEA_JUNGLE_R))
+         ;; Rock Village and Boggy Swamp (no low-res stand-ins in village1, so they only appear once streamed). With
+         ;; the free boat they are never reached here (the south pair takes over first); this is the fallback for a
+         ;; boat that is still a village1 actor.
+         (when (not *ios-boat-art-resident*)
+           (when (< d-village2 d-other)
+             (set! other 'village2)
+             (set! d-other d-village2)
+             (set! other-radius IOS_SEA_VILLAGE2_R))
+           (when (< d-swamp d-other)
+             (set! other 'swamp)
+             (set! d-other d-swamp)
+             (set! other-radius IOS_SEA_SWAMP_R)))
+         (load-state-want-levels 'village1 other)
+         ;; Begin displaying full detail at twice the destination's former home-zone distance.
+         (let ((new-primary (if (< d-other (* 2.0 other-radius)) other 'village1)))
+           (when (!= new-primary (-> self primary))
+             (set! (-> self primary) new-primary)
+             (ios-ocean-set-respawn new-primary)))
+         (let ((status (level-status *level* other))
+               ;; Experiment (user, 2026-10-07): long view from the boat. While Jak is on the boat in open water,
+               ;; show the streamed island in full as soon as it is loaded, at any distance, and keep Sandover
+               ;; in full too, instead of the low-res stand-ins. Only two level slots exist, so islands other
+               ;; than the streamed one still show their low-res models.
+               (long-view? (and (ios-ocean-open-sea? pos)
+                                (or *ios-boat-driving*
+                                    (let* ((boat (ios-ocean-boat))
+                                           (riders (if boat (-> boat root-overlay riders))))
+                                      (and riders
+                                           (nonzero? riders)
+                                           (> (-> riders num-riders) 0)
+                                           (= (handle->process (-> riders rider 0 rider-handle)) *target*)))))))
+           (cond
+             ((and long-view? (or (= status 'loaded) (= status 'alive) (= status 'active)))
+              (load-state-want-display-level other 'display)
+              (load-state-want-display-level 'village1 'display)
+              ;; out at sea neither bsp can work out visibility, so draw both whole
+              (load-state-want-vis (if (= (-> self primary) other)
+                                       (case other (('misty) 'mis) (('training) 'tra) (('beach) 'bea) (('village2) 'vi2) (('swamp) 'swa) (else 'jun))
+                                       'vi1))
+              (load-state-want-force-vis other #t)
+              (load-state-want-force-vis 'village1 #t))
+             ((and (= (-> self primary) other) (or (= status 'loaded) (= status 'alive) (= status 'active)))
+              (load-state-want-display-level other 'display)
+              ;; Beach and Jungle border Sandover and show alongside it in full, like the stock load boundaries.
+              (load-state-want-display-level 'village1 (if (or (= other 'beach) (= other 'jungle)) 'display 'special))
+              (load-state-want-vis (case other (('misty) 'mis) (('training) 'tra) (('beach) 'bea) (('village2) 'vi2) (('swamp) 'swa) (else 'jun)))
+              (load-state-want-force-vis other #t))
+             (else
+              ;; still loading, or Sandover is closer: village1 in full, the far island as its low-res model
+              (load-state-want-display-level 'village1 'display)
+              (load-state-want-display-level other #f)
+              (load-state-want-vis 'vi1)
+              (load-state-want-force-vis 'village1 #t))))))))
+  0
+  (none))
+
+(defbehavior ios-ocean-shark-depth-tint ios-ocean-shark ()
+  "Darken with depth, like sharkey common-post."
+  (let ((f0-2 (fmax 0.0 (fmin 1.0 (- 1.0 (/ (- -36864.0 (-> self root trans y)) (meters 3)))))))
+    (set-vector! (-> self draw color-mult) f0-2 f0-2 f0-2 1.0))
+  0
+  (none))
+
+(defun ios-ocean-jak-aboard? ((boat fishermans-boat))
+  "Jak at the wheel or standing on the boat (its only sticky rider slot)."
+  (and boat
+       *target*
+       (or *ios-boat-driving*
+           (let ((riders (-> boat root-overlay riders)))
+             (and (nonzero? riders)
+                  (> (-> riders num-riders) 0)
+                  (= (handle->process (-> riders rider 0 rider-handle)) *target*))))))
+
+;; Fog over the hand-over between the Sandover (north) and Rock Village / Boggy Swamp (south) level pairs, so the
+;; levels unloading / streaming in there (ios-ocean-update-levels) fade instead of popping (user 2026-10-10).
+;; Strength follows how even Jak's distances to the nearest north and south destinations are:
+;; t = (d-north - d-south) / (d-north + d-south), 0 halfway (the pair switches at about |t| 0.05).
+(defconstant IOS_SEA_FOG_FULL 0.1)   ;; |t| below this: full transition fog
+(defconstant IOS_SEA_FOG_EDGE 0.4)   ;; |t| above this: none
+(defconstant IOS_SEA_FOG_START (meters 20))
+(defconstant IOS_SEA_FOG_END (meters 220))
+;; current strength 0..1, eased so it never pops (define-perm: survives VI1 relinks)
+(define-perm *ios-sea-fog* float 0.0)
+
+(defun ios-ocean-transition-fog ()
+  "Called every frame from pc/ios/ios-boat-park.gc's *menu-hook*, which runs after the draw hook's
+   update-time-of-day has copied the level moods' fog into *math-camera* and before the next update-camera
+   turns those into the renderers' fog constants: pull the fog in while Jak is at sea in the hand-over zone."
+  (let ((want 0.0))
+    (when (and *target*
+               (= *ios-driveable-boat* #t)
+               (not (level-get *level* 'title))
+               ;; on land in Fire Canyon the same distances say "halfway": only over the water
+               (not (level-get *level* 'firecanyon))
+               (or (= *ios-boat-driving* #t)
+                   (ios-ocean-jak-aboard? (ios-free-boat))
+                   (logtest? (-> *target* water flag) (water-flag swimming under-water))))
+      (let* ((pos (-> *target* control trans))
+             (d-south (fmin (ios-sea-distance pos IOS_SEA_VILLAGE2_X IOS_SEA_VILLAGE2_Z)
+                            (ios-sea-distance pos IOS_SEA_SWAMP_X IOS_SEA_SWAMP_Z)))
+             (d-north (fmin (fmin (fmin (ios-sea-distance pos IOS_SEA_VILLAGE_X IOS_SEA_VILLAGE_Z)
+                                        (ios-sea-distance pos IOS_SEA_BEACH_X IOS_SEA_BEACH_Z))
+                                  (fmin (ios-sea-distance pos IOS_SEA_MISTY_X IOS_SEA_MISTY_Z)
+                                        (ios-sea-distance pos IOS_SEA_TRAINING_X IOS_SEA_TRAINING_Z)))
+                            (ios-sea-distance pos IOS_SEA_JUNGLE_X IOS_SEA_JUNGLE_Z)))
+             (bal (fabs (/ (- d-north d-south) (fmax 1.0 (+ d-north d-south))))))
+        (set! want (fmax 0.0 (fmin 1.0 (/ (- IOS_SEA_FOG_EDGE bal) (- IOS_SEA_FOG_EDGE IOS_SEA_FOG_FULL)))))))
+    ;; about 2 s from clear to full
+    (set! *ios-sea-fog* (seek *ios-sea-fog* want (* 0.5 (seconds-per-frame))))
+    (when (< 0.0 *ios-sea-fog*)
+      (let ((f *ios-sea-fog*)
+            (cam *math-camera*))
+        (set! (-> cam fog-start) (lerp (-> cam fog-start) IOS_SEA_FOG_START f))
+        (set! (-> cam fog-end) (lerp (-> cam fog-end) IOS_SEA_FOG_END f))
+        (set! (-> cam fog-min) (lerp (-> cam fog-min) 0.0 f)))))
+  0)
+
+;; Boat shark spacing (xz from the boat's centre; the hull is ~12-15 m long, the shark ~6 m).
+(defconstant IOS_SHARK_BOAT_CLEAR (meters 10)) ;; never closer: keeps it beside the hull, not under it
+(defconstant IOS_SHARK_ORBIT_R (meters 16))    ;; circling a stopped boat
+(defconstant IOS_SHARK_BREACH_R (meters 14))   ;; a chasing shark this close breaches
+
+(defbehavior ios-ocean-shark-keep-clear ios-ocean-shark ((boat fishermans-boat))
+  "Push the shark back out to the boat's clearance ring if it got inside."
+  (let ((off (vector-! (new 'stack-no-clear 'vector) (-> self root trans) (-> boat root-overlay trans))))
+    (set! (-> off y) 0.0)
+    (let ((len (vector-length off)))
+      (when (< len IOS_SHARK_BOAT_CLEAR)
+        (if (< len 1.0)
+          ;; dead centre: step out behind the boat
+          (begin
+            (vector-z-quaternion! off (-> boat root-overlay quat))
+            (set! (-> off y) 0.0)
+            (vector-normalize! off -1.0))
+          (vector-normalize! off 1.0))
+        (set! (-> self root trans x) (+ (-> boat root-overlay trans x) (* IOS_SHARK_BOAT_CLEAR (-> off x))))
+        (set! (-> self root trans z) (+ (-> boat root-overlay trans z) (* IOS_SHARK_BOAT_CLEAR (-> off z)))))))
+  0
+  (none))
+
+(defbehavior ios-ocean-shark-init-by-other ios-ocean-shark ((pos vector) (boat basic) (boat-mode symbol))
+  (set! (-> self root) (new 'process 'trsqv))
+  (set! (-> self root trans quad) (-> pos quad))
+  (initialize-skeleton self *sharkey-sg* '())
+  ;; Spawned under the boat (via the manager) we inherit its 'platform bit, and target-death stops every
+  ;; enemy/platform/projectile/death process from running: the shark froze mid-bite, never sent 'end-mode, and
+  ;; Jak never respawned. The stock sharkey clears 'enemy before its bite for the same reason.
+  (logclear! (-> self mask) (process-mask actor-pause platform enemy projectile death))
+  (set! (-> self boat-mode) boat-mode)
+  (set! (-> self boat) (if boat (process->handle (the-as fishermans-boat boat)) (the-as handle #f)))
+  (set! (-> self sound-id) (new-sound-id))
+  (set-time! (-> self chase-time))
+  (set-time! (-> self breach-time))
+  (go ios-ocean-shark-chase)
+  (none))
+
+;; Swim at Jak at the stock chase speed (12 m/s), rising from 12 m deep to just under the surface as it closes in.
+;; Boat mode (Jak aboard, driving or not) keeps up with the hull, stays shallow enough to see, and breaches nearby.
+(defstate ios-ocean-shark-chase (ios-ocean-shark)
+  :exit
+    (behavior ()
+      (sound-stop (-> self sound-id)))
+  :trans
+    (behavior ()
+      (let ((boat (the-as fishermans-boat (handle->process (-> self boat)))))
+        ;; follow Jak between the water and the boat: diving off makes him the prey again, climbing aboard
+        ;; turns the hunt into stalking the hull
+        (when (and boat *target*)
+          (cond
+            ((and (-> self boat-mode)
+                  (not (ios-ocean-jak-aboard? boat))
+                  (logtest? (-> *target* water flag) (water-flag touch-water)))
+             (set! (-> self boat-mode) #f))
+            ((and (not (-> self boat-mode)) (ios-ocean-jak-aboard? boat))
+             (set! (-> self boat-mode) #t)
+             (set-time! (-> self chase-time)))))
+        (if (cond
+              ((-> self boat-mode)
+               (or (not boat)
+                   (time-elapsed? (-> self chase-time) (seconds 25))
+                   (not (ios-ocean-open-sea? (-> boat root-overlay trans)))))
+              (else
+               (or (not *target*)
+                   (not (logtest? (-> *target* water flag) (water-flag touch-water)))
+                   (not (ios-ocean-open-sea? (-> *target* control trans))))))
+          (go ios-ocean-shark-leave))
+      (let* ((tpos (new 'stack-no-clear 'vector))
+             (surface (begin
+                        (set! (-> tpos quad)
+                              (if (-> self boat-mode) (-> boat root-overlay trans quad) (-> (target-pos 0) quad)))
+                        (ocean-get-height tpos)))
+             (dir (new 'stack-no-clear 'vector))
+             (dist (begin
+                     (vector-! dir tpos (-> self root trans))
+                     (set! (-> dir y) 0.0)
+                     (vector-length dir))))
+        (if (and (not (-> self boat-mode)) (< dist (meters 2))) (go ios-ocean-shark-bite))
+        (let ((circling (and (-> self boat-mode) (< (vector-xz-length (-> boat rbody lin-velocity)) (meters 0.75))))
+              (step (* (if (-> self boat-mode)
+                         ;; a hull under way would outrun the stock 12 m/s
+                         (fmax (meters 12) (+ (vector-xz-length (-> boat rbody lin-velocity)) (meters 3)))
+                         (meters 12))
+                       (seconds-per-frame))))
+          (vector-normalize! dir 1.0)
+          (cond
+            (circling
+             ;; A stopped boat gets a circling shark: swim along the tangent, steering in or out toward the orbit.
+             (let ((radial-x (-> dir x))
+                   (pull (fmax -1.0 (fmin 1.0 (/ (- dist IOS_SHARK_ORBIT_R) (meters 6))))))
+               (set! (-> dir x) (+ (- (-> dir z)) (* pull radial-x)))
+               (set! (-> dir z) (+ radial-x (* pull (-> dir z)))))
+             (vector-normalize! dir 1.0)
+             (vector+*! (-> self root trans) (-> self root trans) dir step))
+            ((-> self boat-mode)
+             ;; Chasing a moving boat: close in up to the hull's clearance ring, never through it.
+             (vector+*! (-> self root trans) (-> self root trans) dir (fmax 0.0 (fmin (- dist IOS_SHARK_BOAT_CLEAR) step))))
+            (else
+             (vector+*! (-> self root trans) (-> self root trans) dir (fmin dist step))))
+          (set! (-> self dir quad) (-> dir quad))
+          (if (-> self boat-mode) (ios-ocean-shark-keep-clear boat))
+          ;; breach only from a real chase, once close to the boat; a circling shark just circles
+          (if (and (-> self boat-mode)
+                   (not circling)
+                   (< dist IOS_SHARK_BREACH_R)
+                   (time-elapsed? (-> self breach-time) (seconds 4)))
+            (go ios-ocean-shark-breach)))
+        ;; the ocean surface hides anything a few metres down, so the boat shark rides just under it
+        (set! (-> self root trans y)
+              (if (-> self boat-mode)
+                (lerp (+ surface (meters -0.3)) (+ surface (meters -4)) (fmax 0.0 (fmin 1.0 (/ dist (meters 40)))))
+                (lerp (+ surface (meters -0.5)) (+ surface (meters -12.5)) (fmax 0.0 (fmin 1.0 (/ dist (meters 30)))))))
+        (forward-up->quaternion (-> self root quat) dir *up-vector*)
+        (sound-play "bigshark-alert"
+                    :id (-> self sound-id)
+                    :pitch (+ 0.5 (* 1.5 (fmax 0.0 (fmin 1.0 (- 1.0 (/ dist (meters 30)))))))
+                    :position (the-as symbol (-> self root trans))))))
+  :code
+    (behavior ()
+      (sound-play "bigshark-idle")
+      (loop
+        (ja-no-eval :group! sharkey-idle-ja :num! (seek!) :frame-num 0.0)
+        (until (ja-done? 0)
+          (suspend)
+          (ja :num! (seek!)))))
+  :post
+    (behavior ()
+      (ios-ocean-shark-depth-tint)
+      (ja-post)))
+
+;; Boat mode: leap out of the water beside the boat with the chomp animation (harmless), then dive back in.
+;; It keeps pace with the hull and stays outside its clearance ring the whole time.
+(defstate ios-ocean-shark-breach (ios-ocean-shark)
+  :trans
+    (behavior ()
+      (let ((boat (the-as fishermans-boat (handle->process (-> self boat)))))
+        (if boat (ios-ocean-shark-keep-clear boat))))
+  :code
+    (behavior ()
+      (sound-play "bigshark-bite" :position (the-as symbol (-> self root trans)))
+      (let ((boat (the-as fishermans-boat (handle->process (-> self boat)))))
+        (if boat
+          (vector+*! (-> self vel) (-> boat rbody lin-velocity) (-> self dir) (meters 4))
+          (vector-float*! (-> self vel) (-> self dir) (meters 10))))
+      (set! (-> self vel y) (meters 14))
+      (ja-channel-push! 1 (seconds 0.1))
+      (ja-no-eval :group! sharkey-chomp-ja :num! (seek!) :frame-num 0.0)
+      (set-time! (-> self state-time))
+      (until (or (time-elapsed? (-> self state-time) (seconds 2.5))
+                 (and (< (-> self vel y) 0.0)
+                      (< (-> self root trans y) (+ (ocean-get-height (-> self root trans)) (meters -2)))))
+        (+! (-> self vel y) (* (meters -40) (seconds-per-frame)))
+        (vector+*! (-> self root trans) (-> self root trans) (-> self vel) (seconds-per-frame))
+        (let ((fwd (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> self vel) 1.0)))
+          (forward-up->quaternion (-> self root quat) fwd *up-vector*))
+        (suspend)
+        (ja :num! (seek!)))
+      (set-time! (-> self breach-time))
+      (ja-channel-push! 1 (seconds 0.2))
+      (go ios-ocean-shark-chase))
+  :post
+    (behavior ()
+      (ios-ocean-shark-depth-tint)
+      (ja-post)))
+
+(defun ios-ocean-nearest-continue ((pos vector))
+  "The plain continue point (no warp / intro / cutscene flags) of the sea's islands closest to pos, or #f."
+  (let ((best (the-as continue-point #f))
+        (best-dist 0.0))
+    (dolist (lev-name '(village1 beach jungle misty training village2 swamp))
+      (let ((info (lookup-level-info (the-as symbol (car lev-name)))))
+        (when info
+          (dolist (c (-> info continues))
+            (let ((cp (the-as continue-point (car c))))
+              (when (zero? (-> cp flags))
+                (let ((d (vector-vector-xz-distance pos (-> cp trans))))
+                  (when (or (not best) (< d best-dist))
+                    (set! best cp)
+                    (set! best-dist d)))))))))
+    best))
+
+;; The stock sharkey bite: lunge up at Jak, eat him (target-death 'sharkey hides him while we exist), then fall back.
+(defstate ios-ocean-shark-bite (ios-ocean-shark)
+  :code
+    (behavior ()
+      (sound-play "bigshark-bite")
+      (set! (-> self start quad) (-> self root trans quad))
+      (ja-channel-push! 1 (seconds 0.1))
+      (ja-no-eval :group! sharkey-chomp-ja :num! (seek! (ja-aframe 3.0 0) 2.0) :frame-num 0.0)
+      (until (ja-done? 0)
+        (let ((tpos (target-pos 5)))
+          (vector-lerp! (-> self root trans)
+                        (-> self start)
+                        tpos
+                        (fmin 1.0 (/ (ja-aframe-num 0) 3.0))))
+        (suspend)
+        (ja :num! (seek! (ja-aframe 3.0 0) 2.0)))
+      (cond
+        ((send-event *target* 'attack-invinc #f (static-attack-info ((mode 'sharkey))))
+         ;; Respawn at the dock of the nearest island when it has one (Sandover, Misty), like the boat's other
+         ;; open-sea respawns; near an island without a dock, at the spawn closest to where Jak was eaten.
+         (let* ((pos (-> *target* control trans))
+                (d-village (ios-sea-distance pos IOS_SEA_VILLAGE_X IOS_SEA_VILLAGE_Z))
+                (d-misty (ios-sea-distance pos IOS_SEA_MISTY_X IOS_SEA_MISTY_Z))
+                (d-other (fmin (fmin (ios-sea-distance pos IOS_SEA_BEACH_X IOS_SEA_BEACH_Z)
+                                     (fmin (ios-sea-distance pos IOS_SEA_JUNGLE_X IOS_SEA_JUNGLE_Z)
+                                           (ios-sea-distance pos IOS_SEA_TRAINING_X IOS_SEA_TRAINING_Z)))
+                               (fmin (ios-sea-distance pos IOS_SEA_VILLAGE2_X IOS_SEA_VILLAGE2_Z)
+                                     (ios-sea-distance pos IOS_SEA_SWAMP_X IOS_SEA_SWAMP_Z)))))
+           (cond
+             ((and (<= d-village d-misty) (<= d-village d-other)) (ios-ocean-set-respawn 'village1))
+             ((<= d-misty d-other) (ios-ocean-set-respawn 'misty))
+             (else
+              (let ((cp (ios-ocean-nearest-continue pos)))
+                (if cp (set-continue! *game-info* (-> cp name)))))))
+         (vector-float*! (-> self vel) (-> self dir) (meters 8))
+         (set! (-> self vel y) (meters 20))
+         (set-time! (-> self state-time))
+         (until (time-elapsed? (-> self state-time) (seconds 3))
+           (ja-no-eval :group! sharkey-chomp-ja :num! (seek!) :frame-num (ja-aframe 3.0 0))
+           (until (ja-done? 0)
+             (+! (-> self vel y) (* (meters -100) (seconds-per-frame)))
+             (when (< (-> self root trans y) (ocean-get-height (-> self root trans)))
+               (vector-float*! (-> self vel) (-> self vel) 0.9))
+             (vector+*! (-> self root trans) (-> self root trans) (-> self vel) (seconds-per-frame))
+             (let ((fwd (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> self vel) 1.0)))
+               (forward-up->quaternion (-> self root quat) fwd *up-vector*))
+             (suspend)
+             (ja :num! (seek!))))
+         0)
+        (else (go ios-ocean-shark-leave)))
+      ;; Release Jak as soon as the complete stock bite/fall animation finishes, then remain alive long
+      ;; enough to visibly swim away. Deactivating here could strand target-death's sharkey mode in water.
+      (send-event *target* 'end-mode)
+      (go ios-ocean-shark-leave))
+  :post
+    (behavior ()
+      (ios-ocean-shark-depth-tint)
+      (ja-post)))
