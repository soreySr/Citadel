index 000000000..407d568d7
--- /dev/null
+++ b/tools/ios/aot_startup_table_plan.py
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Generate a deterministic Jak 1 symbol/type bootstrap plan for iOS AOT.
+
+The plan mirrors the relevant Jak 1 linker behavior: symbols are interned by
+name, and types are interned with the largest requested method count.  It does
+not assign final heap addresses; those depend on the fixed kernel bootstrap
+image and are resolved by the native startup-table builder.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from collections import defaultdict
+from pathlib import Path
+
+
+SYMBOL_KINDS = {"symbol_offset", "arm64_symbol_mov32"}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("link_plan", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+
+    plan = json.loads(args.link_plan.read_text())
+    symbols: set[str] = set()
+    type_methods: dict[str, int] = defaultdict(int)
+    for record in plan["startup_records"]:
+        if record["kind"] in SYMBOL_KINDS:
+            symbols.add(record["symbol"])
+        elif record["kind"] == "type_pointer":
+            symbols.add(record["symbol"])
+            type_methods[record["symbol"]] = max(type_methods[record["symbol"]], record["method_count"])
+
+    # Sorting is intentional: collisions in the fixed symbol table must resolve
+    # the same way for every developer build.
+    output = {
+        "format": "OpenGOAL Jak 1 iOS AOT startup-table plan v1",
+        "symbol_intern_order": sorted(symbols),
+        "type_intern_order": [
+            {"name": name, "method_count": type_methods[name]}
+            for name in sorted(type_methods)
+        ],
+    }
+    output["symbol_count"] = len(output["symbol_intern_order"])
+    output["type_count"] = len(output["type_intern_order"])
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(output, indent=2) + "\n")
+    print(f"Wrote {args.output} ({output['symbol_count']} symbols, {output['type_count']} types)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
