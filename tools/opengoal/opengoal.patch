+namespace {
+void capture_ios_aot_state_if_requested() {
+  const char* snapshot_path = std::getenv("OPENGOAL_IOS_AOT_STATE_PATH");
+  if (!snapshot_path || !snapshot_path[0]) {
+    return;
+  }
+
+  FILE* snapshot = std::fopen(snapshot_path, "wb");
+  if (!snapshot) {
+    std::perror("OPENGOAL_IOS_AOT_STATE_PATH");
+    std::_Exit(2);
+  }
+
+  // The desktop runtime deliberately protects the low 512 KiB. It is unused GOAL
+  // address space, but it remains part of the fixed 128 MiB iOS arena image.
+  static constexpr size_t kZeroChunkSize = 4096;
+  const u8 zero_chunk[kZeroChunkSize] = {};
+  for (size_t offset = 0; offset < EE_MAIN_MEM_LOW_PROTECT; offset += kZeroChunkSize) {
+    if (std::fwrite(zero_chunk, 1, kZeroChunkSize, snapshot) != kZeroChunkSize) {
+      std::perror("writing iOS AOT state prefix");
+      std::fclose(snapshot);
+      std::_Exit(2);
+    }
+  }
+  const size_t readable_size = EE_MAIN_MEM_SIZE - EE_MAIN_MEM_LOW_PROTECT;
+  if (std::fwrite(g_ee_main_mem + EE_MAIN_MEM_LOW_PROTECT, 1, readable_size, snapshot) !=
+      readable_size) {
+    std::perror("writing iOS AOT state image");
+    std::fclose(snapshot);
+    std::_Exit(2);
+  }
+  if (std::fclose(snapshot) != 0) {
+    std::perror("closing iOS AOT state image");
+    std::_Exit(2);
+  }
+  std::fprintf(stderr, "OPENGOAL_IOS_AOT_STATE %s %d\n", snapshot_path, EE_MAIN_MEM_SIZE);
+  std::_Exit(0);
+}
