new file mode 100644
index 000000000..b8e883f72
--- /dev/null
+++ b/tools/ios/aot_signed_text_embed.py
@@ -0,0 +1,99 @@
+#!/usr/bin/env python3
+"""Split an AOT image into a signed-Mach-O assembly payload and source stub.
+
+The assembly is compiled by Xcode, placing immutable prelinked bytes in the
+app's signed __TEXT segment. The payload becomes executable only after all
+text relocations are prelinked and the native runtime supplies the two GOAL
+views expected by ARM64 code: x27 for signed code and x22 for a 128 MB writable
+state arena. This script never creates an entry point or enables execution.
+"""
+
+from __future__ import annotations
+
+import argparse
+import struct
+from pathlib import Path
+
+
+HEADER = struct.Struct("<8sIIIII32s")
+MAGIC = b"JAK1AOT\0"
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("aot_image", type=Path)
+    parser.add_argument("payload_output", type=Path)
+    # jakIOS/Runtime/Jak1AOTSignedImage.s is now hand-maintained; this writes only the original skeleton.
+    parser.add_argument("assembly_output", type=Path, nargs="?")
+    parser.add_argument(
+        "--assembly-incbin-path",
+        help="Path emitted in the assembly .incbin directive (relative to Xcode's build directory)",
+    )
+    args = parser.parse_args()
+
+    data = args.aot_image.read_bytes()
+    if len(data) < HEADER.size:
+        raise RuntimeError("AOT image is shorter than its header")
+    magic, version, _, image_size, _, _, _ = HEADER.unpack_from(data)
+    if magic != MAGIC or version != 1 or len(data) != HEADER.size + image_size:
+        raise RuntimeError("invalid AOT image header")
+
+    args.payload_output.parent.mkdir(parents=True, exist_ok=True)
+    args.payload_output.write_bytes(data[HEADER.size:])
+    if args.assembly_output is None:
+        print(f"Wrote {args.payload_output} ({image_size} signed-text bytes)")
+        return 0
+    args.assembly_output.parent.mkdir(parents=True, exist_ok=True)
+    native_thunks = "".join(
+        f"mov x16, #{index}\n"
+        "b _og_jak1_native_thunk_dispatch\n"
+        for index in range(144)
+    )
+    args.assembly_output.write_text(
+        "// Generated by tools/ios/aot_signed_text_embed.py.\n"
+        "// Not executable until the native x22/x27 GOAL runtime is present.\n"
+        ".section __TEXT,__text,regular,pure_instructions\n"
+        ".p2align 14\n"
+        ".globl _og_jak1_aot_signed_image_begin\n"
+        "_og_jak1_aot_signed_image_begin:\n"
+        f".incbin \"{args.assembly_incbin_path or args.payload_output.name}\"\n"
+        ".globl _og_jak1_aot_signed_image_end\n"
+        "_og_jak1_aot_signed_image_end:\n"
+        "// Fixed GOAL functions use offsets derived from these signed labels.\n"
+        ".p2align 2\n"
+        ".globl _og_jak1_goal_nothing\n"
+        "_og_jak1_goal_nothing:\n"
+        "ret\n"
+        ".globl _og_jak1_goal_zero\n"
+        "_og_jak1_goal_zero:\n"
+        "mov x0, xzr\n"
+        "ret\n"
+        ".p2align 2\n"
+        ".globl _og_jak1_native_thunks_begin\n"
+        "_og_jak1_native_thunks_begin:\n"
+        f"{native_thunks}"
+        ".globl _og_jak1_native_thunks_end\n"
+        "_og_jak1_native_thunks_end:\n"
+        "_og_jak1_native_thunk_dispatch:\n"
+        "sub sp, sp, #96\n"
+        "stp x0, x1, [sp, #0]\n"
+        "stp x2, x3, [sp, #16]\n"
+        "stp x4, x5, [sp, #32]\n"
+        "stp x6, x7, [sp, #48]\n"
+        "str x30, [sp, #64]\n"
+        # arguments[9] is the caller's pp (MIPS s6 lives in x20), needed for 'process allocations.
+        "str x20, [sp, #72]\n"
+        "mov x0, x16\n"
+        "mov x1, sp\n"
+        "bl _og_jak1_dispatch_native_helper\n"
+        "ldr x30, [sp, #64]\n"
+        "add sp, sp, #96\n"
+        "ret\n"
+    )
+    print(f"Wrote {args.payload_output} ({image_size} signed-text bytes)")
+    print(f"Wrote {args.assembly_output}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/ios/aot_startup_patch_pack.py b/tools/ios/aot_startup_patch_pack.py
new file mode 100644
index 000000000..93a006623
--- /dev/null
+++ b/tools/ios/aot_startup_patch_pack.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""Pack resolved Jak 1 symbol/type startup relocations for the iOS data loader."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import struct
+from pathlib import Path
+
+
+MAGIC = b"JAK1STP\0"
+VERSION = 1
+HEADER = struct.Struct("<8sIIII")
+OPERATION = struct.Struct("<B3xIIi")
+TYPE_POINTER = 1
+SYMBOL_WORD = 2
+ARM64_SYMBOL_MOV32 = 3
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("startup_patch_plan", type=Path)
+    parser.add_argument("layout", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+
+    plan = json.loads(args.startup_patch_plan.read_text())
+    layout = json.loads(args.layout.read_text())
+    base = layout["goal_base_offset"]
+    image_size = layout["image_size"]
+    segment_bases = {
+        (segment["object"], segment["segment"]): segment["goal_offset"]
+        for segment in layout["segments"]
+    }
+    operations: list[bytes] = []
+    deferred_operations = 0
+    seen_offsets: set[int] = set()
+
+    for record in plan["patches"]:
+        kind = record["kind"]
+        if kind == "type_pointer":
+            operation_kind = TYPE_POINTER
+            primary = record["type_address"]
+            alternate = 0
+            patch_size = 4
+        elif kind == "symbol_offset":
+            operation_kind = SYMBOL_WORD
+            primary = record["symbol_address"]
+            alternate = record["s7_relative_value"]
+            patch_size = 4
+        elif kind == "arm64_symbol_mov32":
+            operation_kind = ARM64_SYMBOL_MOV32
+            primary = record["symbol_address"]
+            alternate = record["s7_relative_value"]
+            patch_size = 8
+        else:
+            raise RuntimeError(f"unsupported startup patch kind: {kind}")
+
+        if primary is None:
+            deferred_operations += len(record["patch_offsets"])
+            continue
+        segment_base = segment_bases[(record["object"], record["segment"])]
+        for patch_offset in record["patch_offsets"]:
+            image_offset = segment_base + patch_offset - base
+            if image_offset < 0 or image_offset + patch_size > image_size:
+                raise RuntimeError(f"startup patch outside image: {record}")
+            if image_offset in seen_offsets:
+                raise RuntimeError(f"duplicate startup patch offset: {record}")
+            seen_offsets.add(image_offset)
+            operations.append(OPERATION.pack(operation_kind, image_offset, primary, alternate))
+
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open("wb") as file:
+        file.write(HEADER.pack(MAGIC, VERSION, plan["s7_goal_offset"], len(operations), deferred_operations))
+        file.writelines(operations)
+    print(
+        f"Wrote {args.output} ({len(operations)} resolved operations, "
+        f"{deferred_operations} deferred operations)"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/ios/aot_startup_patch_plan.py b/tools/ios/aot_startup_patch_plan.py
new file mode 100644
index 000000000..4662ffd01
--- /dev/null
+++ b/tools/ios/aot_startup_patch_plan.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Bind AOT startup relocations to captured Jak 1 bootstrap addresses.
+
+Symbol addresses are derived from the captured s7 base and deterministic slots.
+Types are bound from the runtime capture and, optionally, from a fixed-address
+type-arena plan for a native iOS bootstrap allocator.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("link_plan", type=Path)
+    parser.add_argument("symbol_slots", type=Path)
+    parser.add_argument("bootstrap_addresses", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument(
+        "--type-image",
+        type=Path,
+        help="optional output from aot_type_image.py for unobserved type addresses",
+    )
+    args = parser.parse_args()
+
+    link_plan = json.loads(args.link_plan.read_text())
+    slots = json.loads(args.symbol_slots.read_text())
+    capture = json.loads(args.bootstrap_addresses.read_text())
+    slot_by_name = {entry["name"]: entry["s7_relative_offset"] for entry in slots["assignments"]}
+    captured_symbols = {entry["name"]: entry["goal_offset"] for entry in capture["symbols"]}
+    s7 = capture["s7_goal_offset"]
+    known_types = {entry["name"]: entry["goal_offset"] for entry in capture["types"]}
+    type_image_types = {}
+    if args.type_image:
+        type_image = json.loads(args.type_image.read_text())
+        type_image_types = {entry["name"]: entry["goal_offset"] for entry in type_image["types"]}
+
+    patches = []
+    unresolved_types = set()
+    for record in link_plan["startup_records"]:
+        kind = record["kind"]
+        if kind in {"symbol_offset", "arm64_symbol_mov32"}:
+            slot_offset = slot_by_name.get(record["symbol"])
+            if slot_offset is None:
+                raise RuntimeError(f"startup symbol is missing from slot plan: {record['symbol']}")
+            address = s7 + slot_offset
+            captured_address = captured_symbols.get(record["symbol"])
+            if captured_address is not None and captured_address != address:
+                raise RuntimeError(
+                    f"captured symbol address disagrees with slot plan: {record['symbol']}"
+                )
+            patches.append({
+                "object": record["object"],
+                "segment": record["segment"],
+                "kind": kind,
+                "symbol": record["symbol"],
+                "symbol_address": address,
+                "s7_relative_value": address - s7,
+                "patch_offsets": record["patch_offsets"],
+            })
+        elif kind == "type_pointer":
+            address = known_types.get(record["symbol"], type_image_types.get(record["symbol"]))
+            if address is None:
+                unresolved_types.add(record["symbol"])
+            patches.append({
+                "object": record["object"],
+                "segment": record["segment"],
+                "kind": kind,
+                "type": record["symbol"],
+                "type_address": address,
+                "method_count": record["method_count"],
+                "patch_offsets": record["patch_offsets"],
+            })
+        else:
+            raise RuntimeError(f"unexpected startup relocation {kind}")
+
+    report = {
+        "format": "OpenGOAL Jak 1 iOS AOT startup patch plan v1",
+        "s7_goal_offset": s7,
+        "resolved_symbol_record_count": sum(
+            item["kind"] != "type_pointer" and item["symbol_address"] is not None for item in patches
+        ),
+        "known_type_count": len(known_types),
+        "type_image_type_count": len(type_image_types),
+        "unresolved_types": sorted(unresolved_types),
+        "patches": patches,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + "\n")
+    print(
+        f"Wrote {args.output} ({report['resolved_symbol_record_count']} symbol records, "
+        f"{len(unresolved_types)} unresolved types)"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/ios/aot_startup_table_plan.py b/tools/ios/aot_startup_table_plan.py
