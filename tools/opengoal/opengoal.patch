index 000000000..4af67799f
--- /dev/null
+++ b/tools/ios/aot_level_code_link.py
@@ -0,0 +1,382 @@
+#!/usr/bin/env python3
+"""Prelink Jak 1 level code (v3) objects at fixed GOAL addresses for the stock-iOS runtime.
+
+iOS only executes signed code, so level code cannot be linked when a DGO loads. Instead every
+level code object's main and top-level segments are linked here, at build time, into a fixed
+region R of the GOAL address space. The region's bytes are embedded in the signed image at
+x27 + R (code) and copied into the writable arena at x22 + R (statics).
+
+Everything except type pointers is resolved at build time:
+  * Symbol links need the symbol-table slot of every symbol. Slots depend on the hash table's
+    contents and insertion order, so this tool simulates jak1 intern_from_c on the captured
+    table, and the iOS host interns the same new symbols in the same order at boot (verifying
+    each slot) before any GOAL code runs.
+  * Type links point at type objects that only exist at runtime, so they are emitted per object
+    and applied by the host (intern_type_from_c) each time the object is "linked" from a DGO.
+
+Outputs:
+  <blob>      raw bytes of R (page aligned), embedded with .incbin by Jak1AOTSignedImage.s
+  <manifest>  JSON: region, boot symbol list, per-object segments/entry/type links
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import re
+import struct
+import zlib
+from pathlib import Path
+
+# common/goal_constants.h / symbols.h (jak1, OpenGOAL's doubled symbol table)
+MAX_SYMBOLS = 16384
+SYM_INFO_OFFSET = MAX_SYMBOLS * 8 - 4
+SYMBOL_TABLE_END = MAX_SYMBOLS - 32
+BITS_FOR_SYMBOL = 15  # bits_for_sym(): log2(MAX_SYMBOLS) + 1
+FIX_FIXED_SYM_END_OFFSET = 0x1D0
+EMPTY_HASH = 0x8454B6E6
+
+LINK_TABLE_END = 0
+LINK_SYMBOL_OFFSET = 1
+LINK_TYPE_PTR = 2
+LINK_DISTANCE_TO_OTHER_SEG_64 = 3
+LINK_DISTANCE_TO_OTHER_SEG_32 = 4
+LINK_PTR = 5
+LINK_ARM64_SYMBOL_MOV32 = 6
+LINK_ARM64_OTHER_SEG_MOV32 = 7
+
+MAIN_SEGMENT, DEBUG_SEGMENT, TOP_LEVEL_SEGMENT = 0, 1, 2
+OBJECT_HEADER = struct.Struct("<HHII6I6II")  # after the 4-byte type-tag slot
+STATE_HEADER = struct.Struct("<8sIIIII")
+PAGE = 16 * 1024
+
+
+def make_crc_table() -> list[int]:
+    table = []
+    for i in range(256):
+        n = i << 24
+        for _ in range(8):
+            n = ((n << 1) ^ 0x04C11DB7) if (n & 0x80000000) else (n << 1)
+            n &= 0xFFFFFFFF
+        table.append(n)
+    return table
+
+
+CRC_TABLE = make_crc_table()
+
+
+def symbol_hash(name: str) -> int:
+    crc = 0
+    for c in name.encode():
+        crc = CRC_TABLE[crc >> 24] ^ (((crc << 8) & 0xFFFFFFFF) | c)
+    return (~crc) & 0xFFFFFFFF
+
+
+def s32(value: int) -> int:
+    value &= 0xFFFFFFFF
+    return value - (1 << 32) if value & 0x80000000 else value
+
+
+class SymbolTable:
+    """Simulation of jak1 find_symbol_from_c / intern_from_c over a captured arena."""
+
+    def __init__(self, memory: bytes, s7: int):
+        self.memory = memory
+        self.s7 = s7
+        self.added_hash: dict[int, int] = {}  # slot -> hash for symbols created by this tool
+        self.added_name: dict[int, str] = {}
+        self.new_symbols: list[tuple[str, int]] = []
+        self.slot = 0
+
+    def u32(self, address: int) -> int:
+        return struct.unpack_from("<I", self.memory, address)[0]
+
+    def slot_hash(self, sym: int) -> int:
+        return self.added_hash.get(sym, self.u32(sym + SYM_INFO_OFFSET))
+
+    def slot_name(self, sym: int) -> str:
+        if sym in self.added_name:
+            return self.added_name[sym]
+        string = self.u32(sym + SYM_INFO_OFFSET + 4)
+        end = self.memory.index(b"\0", string + 4)
+        return self.memory[string + 4:end].decode()
+
+    def find_in_fixed(self, h: int, name: str) -> int:
+        for sym in range(self.s7, self.s7 + FIX_FIXED_SYM_END_OFFSET, 8):
+            if self.slot_hash(sym) == h and self.slot_name(sym) == name:
+                return sym
+        return 0
+
+    def find_in_area(self, h: int, name: str, start: int, end: int) -> int:
+        for sym in range(start, end, 8):
+            sh = self.slot_hash(sym)
+            if sh == h and self.slot_name(sym) == name:
+                return sym
+            if sh == 0:
+                self.slot = sym
+                return self.find_in_fixed(h, name)
+        return 1
+
+    def find(self, name: str) -> int:
+        self.slot = 0
+        h = symbol_hash(name)
+        if h == EMPTY_HASH and name == "_empty_":
+            return self.s7 - 0xA
+        table = self.s7 - 4 - (MAX_SYMBOLS // 2) * 8
+        table2 = table + 4
+        last = table + SYMBOL_TABLE_END * 8
+        bits = BITS_FOR_SYMBOL - 1
+        sh1 = s32(h << (32 - bits))
+        sh2 = sh1 >> (32 - bits - 3)
+        start = self.s7 + sh2
+        if sh2 > 0:
+            probe = self.find_in_area(h, name, start, last)
+            if probe == 1:
+                probe = self.find_in_area(h, name, table2, self.s7 - 0x10)
+        else:
+            probe = self.find_in_area(h, name, start, self.s7 - 0x10)
+            if probe == 1:
+                probe = self.find_in_area(h, name, self.s7 + FIX_FIXED_SYM_END_OFFSET, last)
+        return self.find_in_fixed(h, name) if probe == 1 else probe
+
+    def intern(self, name: str) -> int:
+        existing = self.find(name)
+        if existing:
+            return existing
+        if not self.slot:
+            raise RuntimeError(f"symbol table full interning {name}")
+        sym = self.slot
+        self.added_hash[sym] = symbol_hash(name)
+        self.added_name[sym] = name
+        self.new_symbols.append((name, sym))
+        return sym
+
+
+def read_cstring(data: bytes, offset: int) -> tuple[str, int]:
+    end = data.index(b"\0", offset)
+    return data[offset:end].decode(), end + 1
+
+
+def mov32_read(region: bytearray, offset: int) -> int:
+    w0, w1 = struct.unpack_from("<II", region, offset)
+    return ((w0 >> 5) & 0xFFFF) | (((w1 >> 5) & 0xFFFF) << 16)
+
+
+def mov32_write(region: bytearray, offset: int, value: int) -> None:
+    w0, w1 = struct.unpack_from("<II", region, offset)
+    w0 = (w0 & ~(0xFFFF << 5) & 0xFFFFFFFF) | ((value & 0xFFFF) << 5)
+    w1 = (w1 & ~(0xFFFF << 5) & 0xFFFFFFFF) | (((value >> 16) & 0xFFFF) << 5)
+    struct.pack_into("<II", region, offset, w0, w1)
+
+
+class RegionLinker:
+    def __init__(self, base: int, symbols: SymbolTable):
+        self.base = base
+        self.cursor = base
+        self.region = bytearray()
+        self.symbols = symbols
+
+    def allocate(self, size: int) -> int:
+        start = (self.cursor + 15) & ~15
+        self.cursor = start + size
+        needed = self.cursor - self.base
+        if len(self.region) < needed:
+            self.region.extend(bytes(needed - len(self.region)))
+        return start
+
+    def r(self, address: int) -> int:
+        return address - self.base
+
+    def link_object(self, name: str, data: bytes) -> dict:
+        header = OBJECT_HEADER.unpack_from(data, 4)
+        major, _minor, version, segment_count = header[:4]
+        link_infos = [(header[4 + 2 * i], header[5 + 2 * i]) for i in range(3)]
+        code_infos = [(header[10 + 2 * i], header[11 + 2 * i]) for i in range(3)]
+        link_block_length = header[16]
+        if major != 1 or version != 3 or segment_count != 3:
+            raise RuntimeError(f"{name}: unsupported object (GOAL {major}, v{version})")
+        link_block = 4  # file offset of the link block (link_control m_link_block_ptr)
+        object_data = link_block_length  # file offset of segment data (m_object_data)
+
+        # State 0: place segments (debug segments are discarded: *debug-segment* is #f).
+        segment_address = [0, 0, 0]
+        for seg in (MAIN_SEGMENT, TOP_LEVEL_SEGMENT):
+            offset, size = code_infos[seg]
+            if size == 0:
+                continue
+            address = self.allocate(size)
+            src = object_data + offset
+            self.region[self.r(address):self.r(address) + size] = data[src:src + size]
+            segment_address[seg] = address
+
+        type_links: list = []
+        # State 1: links, for every segment that was placed.
+        for seg in range(3):
+            if not segment_address[seg]:
+                continue
+            seg_base = segment_address[seg]
+            lp = link_block + link_infos[seg][0]
+            while data[lp] != LINK_TABLE_END:
+                kind = data[lp]
+                lp += 1
+                if kind in (LINK_SYMBOL_OFFSET, LINK_ARM64_SYMBOL_MOV32):
+                    sym_name, lp = read_cstring(data, lp)
+                    sym = self.symbols.intern(sym_name)
+                    (count,) = struct.unpack_from("<I", data, lp)
+                    lp += 4
+                    for _ in range(count):
+                        (offset,) = struct.unpack_from("<I", data, lp)
+                        lp += 4
+                        loc = self.r(seg_base + offset)
+                        mov = kind == LINK_ARM64_SYMBOL_MOV32
+                        current = s32(mov32_read(self.region, loc) if mov else
+                                      struct.unpack_from("<I", self.region, loc)[0])
+                        value = sym if current == -1 else (sym - self.symbols.s7)
+                        if mov:
+                            mov32_write(self.region, loc, value & 0xFFFFFFFF)
+                        else:
+                            struct.pack_into("<I", self.region, loc, value & 0xFFFFFFFF)
+                elif kind == LINK_TYPE_PTR:
+                    type_name, lp = read_cstring(data, lp)
+                    method_count = data[lp]
+                    lp += 1
+                    # intern_type_from_c interns the symbol: reserve its slot now.
+                    self.symbols.intern(type_name)
+                    (count,) = struct.unpack_from("<I", data, lp)
+                    lp += 4
+                    addresses = []
+                    for _ in range(count):
+                        (offset,) = struct.unpack_from("<I", data, lp)
+                        lp += 4
+                        addresses.append(seg_base + offset)
+                    type_links.append([type_name, method_count, addresses])
+                elif kind in (LINK_DISTANCE_TO_OTHER_SEG_32, LINK_DISTANCE_TO_OTHER_SEG_64):
+                    target = data[lp]
+                    mine, tgt, patch = struct.unpack_from("<III", data, lp + 1)
+                    lp += 1 + 12
+                    mine_abs = mine + seg_base
+                    if segment_address[target]:
+                        diff = (tgt + segment_address[target]) - mine_abs
+                    else:
+                        diff = -mine_abs
+                    loc = self.r(patch + seg_base)
+                    if kind == LINK_DISTANCE_TO_OTHER_SEG_32:
+                        struct.pack_into("<i", self.region, loc, diff)
+                    else:
+                        struct.pack_into("<q", self.region, loc, diff)
+                elif kind == LINK_ARM64_OTHER_SEG_MOV32:
+                    target = data[lp]
+                    target_offset, patch = struct.unpack_from("<II", data, lp + 1)
+                    lp += 1 + 8
+                    value = target_offset + segment_address[target] if segment_address[target] else 0
+                    mov32_write(self.region, self.r(patch + seg_base), value)
+                elif kind == LINK_PTR:
+                    patch, value = struct.unpack_from("<II", data, lp)
+                    lp += 8
+                    struct.pack_into("<I", self.region, self.r(patch + seg_base), value + seg_base)
+                else:
+                    raise RuntimeError(f"{name}: unknown link kind {kind}")
+
+        main_size = code_infos[MAIN_SEGMENT][1] if segment_address[MAIN_SEGMENT] else 0
+        top_size = code_infos[TOP_LEVEL_SEGMENT][1] if segment_address[TOP_LEVEL_SEGMENT] else 0
+        return {
+            "main": [segment_address[MAIN_SEGMENT], main_size],
+            "top": [segment_address[TOP_LEVEL_SEGMENT], top_size],
+            "entry": segment_address[TOP_LEVEL_SEGMENT] + 4 if top_size else 0,
+            "types": type_links,
+        }
+
+
+def load_state(path: Path) -> bytes:
+    data = path.read_bytes()
+    if data[:8] == b"JAK1STA\0":
+        magic, version, decoded, encoded, crc, flags = STATE_HEADER.unpack_from(data)
+        state = zlib.decompress(data[STATE_HEADER.size:STATE_HEADER.size + encoded], wbits=-15)
+        if len(state) != decoded or zlib.crc32(state) != crc:
+            raise RuntimeError("runtime state failed validation")
+        return state
+    return data
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("runtime_state", type=Path, help="Jak1AOTRuntimeState.bin (packed) or raw arena")
+    parser.add_argument("capture", type=Path, help="Jak1AOTRuntimeCapture.json")
+    parser.add_argument("dgo_dir", type=Path, help="goal_src/jak1/dgos")
+    parser.add_argument("obj_dir", type=Path, help="out/jak1/obj")
+    parser.add_argument("blob", type=Path)
+    parser.add_argument("manifest", type=Path)
+    parser.add_argument("--extra-dgo-dir", action="append", default=[], type=Path,
+                        help="additional directory searched recursively for custom-level .gd files")
+    parser.add_argument("--base", type=lambda v: int(v, 0), default=0x03EBC000)
+    parser.add_argument("--relink-captured", action="append", default=[], metavar="NAME",
+                        help="also link this captured object and run its top-level at startup; use "
+                             "for captured engine or level objects changed by an iOS/mod build")
+    parser.add_argument("--startup-object", action="append", default=[], metavar="NAME",
+                        help="link a new non-DGO object and run its top-level at startup")
+    args = parser.parse_args()
+
+    state = load_state(args.runtime_state)
+    capture = json.loads(args.capture.read_text())
+    s7 = capture["s7_goal_offset"]
+    captured = {o["name"] for o in capture["objects"] if o["version"] == 3}
+
+    if any(state[args.base:args.base + 8 * 1024 * 1024]):
+        raise RuntimeError("level-code region is not empty in the captured arena")
+
+    symbols = SymbolTable(state, s7)
+    linker = RegionLinker(args.base, symbols)
+    objects: dict[str, dict] = {}
+    dgos: dict[str, list[str]] = {}
+    gd_files = list(args.dgo_dir.glob("*.gd"))
+    for directory in args.extra_dgo_dir:
+        gd_files.extend(directory.rglob("*.gd"))
+    for gd in sorted(set(gd_files)):
+        text = gd.read_text()
+        dgo_name = re.search(r'"([A-Z0-9]+\.[A-Z]+)"', text).group(1)
+        if dgo_name.endswith(".CGO"):
+            continue  # KERNEL/ENGINE/GAME are in the captured image
+        # The first object shares a line with the list's opening parenthesis: `("foo.o"`.
+        # Accept that optional paren so every DGO's first code object is included.
+        names = [n for n in re.findall(r'^\s*\(?"([^"]+)\.o"', text, re.MULTILINE)]
+        dgos[dgo_name] = names
+        for name in names:
+            if name in captured or name in objects:
+                continue
+            path = args.obj_dir / f"{name}.o"
+            objects[name] = linker.link_object(name, path.read_bytes())
+
+    # Linked last so every other object keeps the address it has without overrides.
+    for name in args.relink_captured:
+        if name not in captured:
+            raise RuntimeError(f"--relink-captured {name}: not a captured code object")
+        objects[name] = linker.link_object(name, (args.obj_dir / f"{name}.o").read_bytes())
+    for name in args.startup_object:
+        if name in objects:
+            raise RuntimeError(f"--startup-object {name}: object was already linked")
+        objects[name] = linker.link_object(name, (args.obj_dir / f"{name}.o").read_bytes())
+
+    size = (len(linker.region) + PAGE - 1) & ~(PAGE - 1)
+    blob = bytes(linker.region) + bytes(size - len(linker.region))
+    args.blob.parent.mkdir(parents=True, exist_ok=True)
+    args.blob.write_bytes(blob)
+    manifest = {
+        "format": "OpenGOAL Jak 1 iOS level code v1",
+        "s7GoalOffset": s7,
+        "regionBase": args.base,
+        "regionSize": size,
+        "sha256": hashlib.sha256(blob).hexdigest(),
+        "symbols": [[name, sym] for name, sym in symbols.new_symbols],
+        "objects": objects,
+        "dgos": dgos,
+        "startupOverrides": args.relink_captured + args.startup_object,
+    }
+    args.manifest.write_text(json.dumps(manifest, separators=(",", ":")) + "\n")
+    print(f"Linked {len(objects)} level code objects into 0x{args.base:08x}-0x{args.base + size:08x} "
+          f"({size} bytes), {len(symbols.new_symbols)} new symbols")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
