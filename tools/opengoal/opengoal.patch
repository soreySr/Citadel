+(defbehavior ios-ocean-update-shark ios-ocean-manager ()
+  "A shark comes for Jak after he has swum in the open ocean for a moment, like the levels' sharks."
+  (cond
+    ;; one shark at a time; the cooldown and swim timer start once it is gone
+    ((handle->process (-> self shark))
+     (set-time! (-> self shark-time))
+     (set-time! (-> self swim-time))
+     (set-time! (-> self boat-shark-time)))
+    ((and *target*
+          (-> self water-claim)
+          (logtest? (-> *target* water flag) (water-flag swimming))
+          (= (handle->process (-> *target* water volume)) self))
+     (when (and (time-elapsed? (-> self swim-time) (-> self shark-delay))
+                (time-elapsed? (-> self shark-time) (seconds 3)))
+       (let ((pos (new 'stack-no-clear 'vector))
+             (dir (new 'stack-no-clear 'vector)))
+         ;; start 30 m behind Jak, deep under the surface (the stock sharkey spawn-distance / y-min)
+         (vector-z-quaternion! dir (-> *target* control quat))
+         (set! (-> dir y) 0.0)
+         (vector-normalize! dir 1.0)
+         (vector+*! pos (-> *target* control trans) dir (meters -30))
+         (set! (-> pos y) (+ (ocean-get-height pos) (meters -12.5)))
+         ;; the boat rides along so the shark can follow Jak if he climbs aboard
+         (set! (-> self shark)
+               (ppointer->handle (process-spawn ios-ocean-shark pos (ios-ocean-boat) #f :to self))))))
+    ;; Rarer surface encounter: while Jak is aboard in open water (at the wheel or not), the shark pursues a
+    ;; moving hull or circles a stopped one, breaching beside it. This never bites Jak and times out on its own.
+    ((let ((boat (ios-ocean-boat)))
+       (and boat
+            (ios-ocean-jak-aboard? boat)
+            (ios-ocean-open-sea? (-> boat root-overlay trans))
+            (time-elapsed? (-> self boat-shark-time) (-> self boat-shark-delay))))
+     (let* ((boat (ios-ocean-boat))
+            (pos (new 'stack-no-clear 'vector))
+            (dir (new 'stack-no-clear 'vector)))
+       (vector-z-quaternion! dir (-> boat root-overlay quat))
+       (set! (-> dir y) 0.0)
+       (vector-normalize! dir 1.0)
+       (vector+*! pos (-> boat root-overlay trans) dir (meters -35))
+       (set! (-> pos y) (+ (ocean-get-height pos) (meters -3)))
+       (set! (-> self shark) (ppointer->handle (process-spawn ios-ocean-shark pos boat #t :to self)))))
+    (else
+     (set-time! (-> self swim-time))
+     ;; Three to thirty-five seconds gives repeat swims different tension and avoids an immediate,
+     ;; predictable spawn whenever Jak touches the open ocean.
+     (set! (-> self shark-delay) (rand-vu-int-range (seconds 3) (seconds 35)))
+     ;; the boat clock only runs while Jak is aboard out at sea
+     (let ((boat (ios-ocean-boat)))
+       (when (not (and boat (ios-ocean-jak-aboard? boat) (ios-ocean-open-sea? (-> boat root-overlay trans))))
+         (set-time! (-> self boat-shark-time))
+         (set! (-> self boat-shark-delay) (rand-vu-int-range (seconds 15) (seconds 75)))))))
+  0
+  (none))
+
+;; The jungle level's background collision has an invisible wall standing in the sea along its coast
+;; (x 135..502 m, z -258..-44 m: huge pat #xa triangles - wall mode + nocamera - reaching 21-25 m below the
+;; surface) that keeps Jak, and now the boat, from going round the jungle's shore. Found by dumping the
+;; collision copy OpenGOAL keeps in out/jak1/fr3/jungle.fr3. Its collide-frag pat-array entries get the
+;; noentity bit, which every collide shape except the camera ignores (collide-shape new, and the boat's probe).
+
+(defun ios-ocean-frag-vertex-y ((mesh collide-frag-mesh) (idx int))
+  "World y of a collide-frag vertex: base-trans (ints) + 16 * packed u16 (extract_collide_frags.cpp)."
+  (+ (the float (-> (the-as (pointer int32) (-> mesh base-trans)) 1))
+     (* 16.0 (the float (-> (the-as (pointer uint16) (-> mesh packed-data)) (+ (* idx 3) 1))))))
+
+(defun ios-ocean-note-sea-wall-face ((mesh collide-frag-mesh)
+                                     (face int)
+                                     (a int)
+                                     (b int)
+                                     (c int)
+                                     (sea (pointer uint8))
+                                     (other (pointer uint8)))
+  "Mark this face's pat-array entry: used by an invisible wall below the waterline (sea) or by anything else."
+  (let* ((pat-idx (-> (the-as (pointer uint8) (-> mesh packed-data))
+                      (+ (* 16 (-> mesh vertex-data-qwc)) (-> mesh strip-data-len) face)))
+         (pat (logand (-> (the-as (pointer uint32) (-> mesh pat-array)) pat-idx) #xfffffffe)))
+    (when (= pat #xa)
+      (if (< (fmin (fmin (ios-ocean-frag-vertex-y mesh a) (ios-ocean-frag-vertex-y mesh b))
+                   (ios-ocean-frag-vertex-y mesh c))
+             (meters -1))
+        (set! (-> sea pat-idx) 1)
+        (set! (-> other pat-idx) 1))))
+  0
+  (none))
+
+(defun ios-ocean-patch-sea-wall-mesh ((mesh collide-frag-mesh) (removed symbol))
+  "Walk the mesh's triangle strips (find_faces in extract_collide_frags.cpp) and set or clear the noentity bit
+   on pat entries used only by below-water invisible walls. Returns how many entries it changed."
+  (let ((sea (new 'stack-no-clear 'array 'uint8 256))
+        (other (new 'stack-no-clear 'array 'uint8 256))
+        (strips (the-as (pointer int8) (-> mesh packed-data)))
+        (pats (the-as (pointer uint32) (-> mesh pat-array)))
+        (byte (* 16 (-> mesh vertex-data-qwc)))
+        (face 0)
+        (changed 0))
+    (dotimes (i 256)
+      (set! (-> sea i) 0)
+      (set! (-> other i) 0))
+    (while (>= (-> strips byte) 0)
+      (let ((r6 (the int (-> strips byte)))
+            (r7 (the int (-> strips (+ byte 1))))
+            (ra (the int (-> strips (+ byte 2)))))
+        (+! byte 3)
+        (ios-ocean-note-sea-wall-face mesh face r6 r7 ra sea other)
+        (+! face 1)
+        (while (nonzero? (-> strips byte))
+          (let ((next (the int (-> strips byte))))
+            (+! byte 1)
+            (if (< next 0) (set! next (- next)) (set! r6 r7))
+            (set! r7 ra)
+            (set! ra (+ next -1))
+            (ios-ocean-note-sea-wall-face mesh face r6 r7 ra sea other)
+            (+! face 1)))
+        (+! byte 1)))
+    (dotimes (i 256)
+      (when (and (nonzero? (-> sea i)) (zero? (-> other i)))
+        (let ((want (if removed (logior (-> pats i) 1) (logand (-> pats i) #xfffffffe))))
+          (when (!= want (-> pats i))
+            (set! (-> pats i) want)
+            (+! changed 1)))))
+    changed))
+
+(defun ios-ocean-set-sea-walls ((lev level) (removed symbol))
+  "Set or clear the sea walls in every background collide fragment of the level's bsp."
+  (let ((changed 0)
+        (trees (-> lev bsp drawable-trees)))
+    (when (and trees (nonzero? trees))
+      (dotimes (ti (-> trees length))
+        (let ((tree (-> trees trees ti)))
+          (when (and tree (nonzero? tree) (type-type? (-> tree type) drawable-tree-collide-fragment) (> (-> tree length) 0))
+            ;; the leaf array holds the fragments
+            (let ((frags (the-as drawable-inline-array-collide-fragment (-> tree data (+ -1 (-> tree length))))))
+              (dotimes (fi (-> frags length))
+                (+! changed (ios-ocean-patch-sea-wall-mesh (-> frags data fi mesh) removed))))))))
+    (format 0 "ios-ocean: jungle sea walls ~A (~D pat entries)~%" (if removed "removed" "restored") changed)
+    changed))
+
+(defbehavior ios-ocean-sync-sea-walls ios-ocean-manager ()
+  "Keep the jungle's sea walls removed while the driveable boat option is on (restored when it's turned off)."
+  (let ((jungle (level-get *level* 'jungle)))
+    (cond
+      ((and jungle
+            (nonzero? (-> jungle bsp))
+            (let ((status (-> jungle status))) (or (= status 'loaded) (= status 'alive) (= status 'active))))
+       (let ((want (if *ios-driveable-boat* #t #f)))
+         (when (or (!= (-> self walls-bsp) (-> jungle bsp)) (!= (-> self walls-removed) want))
+           (ios-ocean-set-sea-walls jungle want)
+           (set! (-> self walls-bsp) (-> jungle bsp))
+           (set! (-> self walls-removed) want))))
+      (else (set! (-> self walls-bsp) (the-as bsp-header #f)))))
+  0
+  (none))
+
+(defbehavior ios-ocean-update-coast ios-ocean-manager ()
+  "Show the stand-in coastline with the driveable boat option (not while Fire Canyon is loaded: its own canyon
+   geometry sits right behind it), and keep swimming Jak out of it - it is drawn natively with no collision."
+  (set! *ios-coast-visible*
+        (and *ios-driveable-boat* (not (level-get *level* 'firecanyon)) (not (level-get *level* 'title)) #t))
+  (when (and *ios-coast-visible* *target* (not *ios-boat-driving*))
+    (let* ((pos (-> *target* control trans))
+           (h (ios-coast-height (-> pos x) (-> pos z))))
+      (cond
+        ((< (+ (-> pos y) (meters 0.5)) h)
+         ;; inside the terrain: back to the last spot outside it
+         (if (= (-> self coast-safe w) 1.0) (move-to-point! (-> *target* control) (-> self coast-safe))))
+        (else
+         (set! (-> self coast-safe quad) (-> pos quad))
+         (set! (-> self coast-safe w) 1.0)))))
+  0
+  (none))
+
+(defbehavior ios-ocean-return-boat-on-death ios-ocean-manager ()
+  "When Jak dies out in the open sea and the boat is adrift there too, send it home to the nearer of Sandover's
+   dock and the Rock Village dock (ios-boat-park-return-home), so it does not get lost at sea (user 2026-10-10).
+   A boat parked by an island's shore stays put. Once per death."
+  (let ((dying (if (and *target*
+                        (-> *target* next-state)
+                        (member (-> *target* next-state name) '(target-death target-flut-death)))
+                   #t
+                   #f)))
+    (when (and dying (not (-> self death-seen)))
+      (let ((boat (ios-ocean-boat)))
+        (when (and boat
+                   (ios-ocean-open-sea? (-> *target* control trans))
+                   (ios-ocean-open-sea? (-> boat root-overlay trans)))
+          (ios-boat-park-return-home (-> boat root-overlay trans)))))
+    (set! (-> self death-seen) dying))
+  0
+  (none))
+
+(defstate ios-ocean-manager-idle (ios-ocean-manager)
+  :exit
+    (behavior ()
+      (ios-ocean-release-water))
+  :code
+    (behavior ()
+      (loop
+        (+! (-> self tick) 1)
+        ;; once the standalone manager runs, one the village1 actor spawned earlier (before the art was resident)
+        ;; is a duplicate
+        (if (and *ios-boat-art-resident* (!= self (ios-ocean-manager-get))) (deactivate self))
+        (if (zero? (mod (-> self tick) 30)) (ios-ocean-sync-sea-walls))
+        (ios-ocean-update-coast)
+        (cond
+          ;; Not on the title screen: *target* exists there (target-title, out at sea) and streaming an
+          ;; island would evict the captured title level, whose logo entity the title sequence still needs.
+          ((and *ios-driveable-boat* *target* (not (movie?)) (= *master-mode* 'game) (not (level-get *level* 'title)))
+           (if (zero? (mod (-> self tick) 8)) (ios-ocean-birth-water-vols))
+           (ios-ocean-return-boat-on-death)
+           (ios-ocean-update-water)
+           (ios-ocean-update-shark)
+           (if (zero? (mod (-> self tick) 10)) (ios-ocean-update-levels)))
+          (else (ios-ocean-release-water) (set-time! (-> self swim-time))))
+        (suspend))))
+
+(defbehavior ios-ocean-manager-init-by-other ios-ocean-manager ()
+  ;; Standalone (in *entity-pool*, ios-ocean-manager-ensure): the free boat's stand-in entity, so its shark
+  ;; (which inherits the entity) takes the resident shark art from level-default instead of village1's.
+  (when (not (-> self entity))
+    (set! (-> self entity) (ios-free-boat-entity))
+    (set! *ios-ocean-manager-ppointer* (-> self ppointer))
+    (set! *ios-ocean-manager-pid* (-> self pid)))
+  (set! (-> self sea-mode) #f)
+  (set! (-> self primary) 'village1)
+  (set! (-> self water-claim) #f)
+  (set! (-> self shark) (the-as handle #f))
+  (set-time! (-> self swim-time))
+  (set-time! (-> self shark-time))
+  (set! (-> self shark-delay) (rand-vu-int-range (seconds 3) (seconds 35)))
+  (set-time! (-> self boat-shark-time))
+  (set! (-> self boat-shark-delay) (rand-vu-int-range (seconds 15) (seconds 75)))
+  (set! (-> self tick) 0)
+  (set! (-> self walls-bsp) (the-as bsp-header #f))
+  (set! (-> self walls-removed) #f)
+  (set! (-> self coast-safe w) 0.0)
+  (set! (-> self south) #f)
+  (set! (-> self death-seen) #f)
+  (go ios-ocean-manager-idle)
+  (none))
+
+(defun ios-ocean-manager-ensure ()
+  "With the boat art resident, one ocean manager runs on its own in *entity-pool* whatever levels are loaded
