index 000000000..a1a2cc4fd
--- /dev/null
+++ b/tools/ios/aot_layout.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""Assign deterministic GOAL heap offsets to an AOT relocation manifest.
+
+The desktop linker allocates each object segment when a DGO is loaded.  iOS AOT
+needs those addresses to be fixed before code signing, so this tool reserves a
+page-aligned slot for every compiled segment.  It intentionally emits a layout
+only; code emission and symbol/type resolution are separate stages.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+
+PAGE_SIZE = 16 * 1024  # iOS arm64 memory page size
+# Keep the prelinked image out of Jak 1's global heap/symbol-table range. The
+# iOS runtime reserves this region and runs without the desktop debug heap.
+DEFAULT_BASE = 0x0600_0000
+
+
+def align(value: int, alignment: int) -> int:
+    return (value + alignment - 1) & -alignment
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("manifest", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--base", type=lambda text: int(text, 0), default=DEFAULT_BASE)
+    args = parser.parse_args()
+
+    manifest = json.loads(args.manifest.read_text())
+    cursor = align(args.base, PAGE_SIZE)
+    segments = []
+    for obj in manifest["objects"]:
+        for segment in obj["segments"]:
+            size = segment["size"]
+            if size == 0:
+                continue
+            cursor = align(cursor, PAGE_SIZE)
+            segments.append({
+                "object": obj["path"],
+                "segment": segment["name"],
+                "source_file_offset": segment["file_offset"],
+                "size": size,
+                "goal_offset": cursor,
+            })
+            cursor += size
+
+    image_size = align(cursor - align(args.base, PAGE_SIZE), PAGE_SIZE)
+    output = {
+        "format": "OpenGOAL iOS AOT deterministic layout v1",
+        "page_size": PAGE_SIZE,
+        "goal_base_offset": align(args.base, PAGE_SIZE),
+        "image_size": image_size,
+        "segment_count": len(segments),
+        "segments": segments,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(output, indent=2) + "\n")
+    print(f"Wrote {args.output} ({len(segments)} segments, {image_size} bytes reserved)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
