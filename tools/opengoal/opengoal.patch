@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+"""Extract named desktop C-function GOAL stubs for the iOS signed-thunk port.
+
+Input is either the OPENGOAL_RECORD_SYMBOLS capture log or the capture JSON made from it
+(tools/aot_inputs/Jak1AOTRuntimeCapture.json, whose "native_stubs" list holds the same records).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+
+PREFIXES = {
+    "OPENGOAL_C_FUNCTION_STUB ": "arguments",
+    "OPENGOAL_C_STACK_FUNCTION_STUB ": "stack_arguments",
+}
+
+
+def records_from_log(path: Path):
+    for line in path.read_text(errors="replace").splitlines():
+        for prefix, convention in PREFIXES.items():
+            if line.startswith(prefix):
+                name, address = line.removeprefix(prefix).rsplit(" ", 1)
+                yield name, int(address, 0), convention
+                break
+
+
+def records_from_capture(path: Path):
+    for stub in json.loads(path.read_text())["native_stubs"]:
+        yield stub["name"], stub["goal_offset"], stub["convention"]
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("capture", type=Path, help="capture log, or the capture .json")
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+
+    records = (records_from_capture if args.capture.suffix == ".json" else records_from_log)(args.capture)
+    stubs = []
+    names = set()
+    for name, address, convention in records:
+        if name in names:
+            # Later DGO loads can recreate the same named bridge. One signed thunk per
+            # name is sufficient for the iOS inventory.
+            continue
+        names.add(name)
+        stubs.append({
+            "name": name,
+            "desktop_goal_offset": address,
+            "convention": convention,
+        })
+    if not stubs:
+        parser.error("no C-function stubs found")
+    report = {
+        "format": "OpenGOAL Jak 1 iOS native stub inventory v1",
+        "stubCount": len(stubs),
+        "stubs": stubs,
+        # The host (HasValidNativeStubInventory) requires this value: Jak1AOTSignedImage.s provides the thunks.
+        "execution": "signed-native-thunks-installed",
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + "\n")
+    print(f"Wrote {args.output} ({len(stubs)} native stubs)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/ios/capture_startup_addresses.py b/tools/ios/capture_startup_addresses.py
