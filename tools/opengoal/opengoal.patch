+(defbehavior fishermans-boat-ios-player-aboard? fishermans-boat ()
+  "Is Jak standing on the boat (its only sticky rider slot)?"
+  (let ((riders (-> self root-overlay riders)))
+    (and *target*
+         (nonzero? riders)
+         (> (-> riders num-riders) 0)
+         (= (handle->process (-> riders rider 0 rider-handle)) *target*))))
+
+(defbehavior fishermans-boat-ios-board? fishermans-boat ()
+  "While Jak stands on the boat show the stock press-to-use prompt; returns #t once O grabs him.
+   Gated like the stock ride (fishing game done)."
+  (let ((boarded #f))
+    (set! *ios-boat-boardable*
+          (if (and (fishermans-boat-ios-player-aboard?)
+                   (or (task-complete? *game-info* (game-task jungle-fishgame)) (and *cheat-mode* (cpad-hold? 0 l3))))
+            #t
+            #f))
+    (when (and *ios-boat-boardable*
+               (not (level-hint-displayed?))
+               (time-elapsed? (-> self state-time) (seconds 1)))
+      (hide-hud)
+      (level-hint-surpress!)
+      (kill-current-level-hint '() '(sidekick voicebox) 'exit)
+      (when (and (hud-hidden?) (can-grab-display? self) (= *kernel-boot-message* 'play))
+        (let ((font (new 'stack 'font-context *font-default-matrix* 32 160 0.0 (font-color default) (font-flags shadow kerning))))
+          (set-width! font 440)
+          (set-height! font 80)
+          (set! (-> font flags) (font-flags shadow kerning large))
+          (print-game-text (lookup-text! *common-text* (text-id press-to-use) #f) font #f 128 22))
+        (when (and (cpad-pressed? 0 circle) (process-grab? *target*))
+          ;; don't let the same press reach anything else this frame
+          (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons circle))
+          (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons circle))
+          (set! boarded #t))))
+    boarded))
