@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Convert an opt-in OpenGOAL symbol recorder log into an ordered seed list."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+
+PREFIX = "OPENGOAL_DYNAMIC_SYMBOL "
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("capture_log", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+
+    names = []
+    seen = set()
+    for line in args.capture_log.read_text(errors="replace").splitlines():
+        if line.startswith(PREFIX):
+            # The recorder appends the GOAL address after the symbol name.
+            name = line.removeprefix(PREFIX).rsplit(" ", 1)[0]
+            if name and name not in seen:
+                seen.add(name)
+                names.append(name)
+    if not names:
+        parser.error("no recorded dynamic symbols found")
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(names, indent=2) + "\n")
+    print(f"Wrote {args.output} ({len(names)} dynamic symbols)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
