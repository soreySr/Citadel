+;; og:ios the looping engine sound is only stopped by fishermans-boat-play-sounds, so it kept playing after the boat
+;; was killed (e.g. village1 unloaded). The border-mode setting goes away with the process; forget it too.
+(defmethod deactivate ((this fishermans-boat))
+  (when (nonzero? (-> this engine-sound-id))
+    (sound-stop (-> this engine-sound-id))
+    (set! (-> this engine-sound-id) (new 'static 'sound-id)))
+  ;; a hidden actor dying (village1 unloading) must not clear the flags of the free boat Jak is on
+  (when (or (fishermans-boat-ios-free? this) (not (ios-free-boat)))
+    (set! *ios-boat-borders-off* #f)
+    (set! *ios-boat-driving* #f)
+    (set! *ios-boat-boardable* #f))
+  ((method-of-type rigid-body-platform deactivate) this)
+  (none))
