@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""Pack deterministic GOAL string objects for the Jak 1 iOS symbol table."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import struct
+from pathlib import Path
+
+
+HEADER = struct.Struct("<8sIIIII")
+ENTRY = struct.Struct("<iIH")
+MAGIC = b"JAK1STR\0"
+
+
+def align(value: int, alignment: int) -> int:
+    return (value + alignment - 1) & -alignment
+
+
+def allocation_size(name: bytes) -> int:
+    character_bytes = max(len(name) + 1, 8)
+    return align(character_bytes + 8, 16)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("symbol_slots", type=Path)
+    parser.add_argument("s7_goal_offset", type=lambda value: int(value, 0))
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--base", type=lambda value: int(value, 0), required=True)
+    args = parser.parse_args()
+    if args.base % 16:
+        parser.error("--base must be 16-byte aligned")
+
+    assignments = json.loads(args.symbol_slots.read_text())["assignments"]
+    records = []
+    cursor = args.base
+    for assignment in assignments:
+        name = assignment["name"].encode("utf-8")
+        if len(name) > 0xFFFF:
+            raise RuntimeError(f"symbol name is too long: {assignment['name']}")
+        records.append((assignment["s7_relative_offset"], cursor + 4, name))
+        cursor += allocation_size(name)
+
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open("wb") as file:
+        file.write(HEADER.pack(MAGIC, 1, args.s7_goal_offset, args.base, cursor - args.base, len(records)))
+        for relative_offset, string_goal_offset, name in records:
+            file.write(ENTRY.pack(relative_offset, string_goal_offset, len(name)))
+            file.write(name)
+    print(f"Wrote {args.output} ({len(records)} strings, {cursor - args.base} arena bytes)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/ios/aot_type_image.py b/tools/ios/aot_type_image.py
