+           )
+       )
+      (else
+        (set! (-> this rot-y) (acos (vector-dot (-> this face-vec) (new 'static 'vector :z 1.0))))
+        (if (< (vector-dot (-> this face-vec) (new 'static 'vector :x 1.0)) 0.0)
+            (set! (-> this rot-y) (- (-> this rot-y)))
+            )
