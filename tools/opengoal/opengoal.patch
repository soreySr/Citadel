index 000000000..65ae3f6d9
--- /dev/null
+++ b/tools/ios/capture_startup_addresses.py
@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""Extract dynamic Jak 1 symbol/type addresses from an opt-in runtime capture."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from pathlib import Path
+
+
+SYMBOL_PREFIX = "OPENGOAL_DYNAMIC_SYMBOL "
+TYPE_PREFIX = "OPENGOAL_DYNAMIC_TYPE "
+OBJECT_PREFIX = "OPENGOAL_OBJECT_LINK "
+OBJECT_PATTERN = re.compile(
+    r"^(?P<name>.+) v(?P<version>\d+) "
+    r"main=0x(?P<main>[0-9a-fA-F]+),0x(?P<main_size>[0-9a-fA-F]+) "
+    r"debug=0x(?P<debug>[0-9a-fA-F]+),0x(?P<debug_size>[0-9a-fA-F]+) "
+    r"top-level=0x(?P<top>[0-9a-fA-F]+),0x(?P<top_size>[0-9a-fA-F]+)$"
+)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "capture_log",
+        help="Runtime capture log path, or '-' to read the capture from standard input.",
+    )
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+
+    symbols = []
+    types = []
+    objects = []
+    native_stubs = []
+    s7_goal_offset = None
+    kernel_dispatcher_goal_offset = None
+    if args.capture_log == "-":
+        capture_text = sys.stdin.read()
+    else:
+        capture_text = Path(args.capture_log).read_text(errors="replace")
+
+    for line in capture_text.splitlines():
+        if line.startswith("OPENGOAL_S7 "):
+            s7_goal_offset = int(line.removeprefix("OPENGOAL_S7 "), 0)
+        elif line.startswith("OPENGOAL_KERNEL_DISPATCHER "):
+            kernel_dispatcher_goal_offset = int(
+                line.removeprefix("OPENGOAL_KERNEL_DISPATCHER "), 0
+            )
+        elif line.startswith(SYMBOL_PREFIX):
+            name, address = line.removeprefix(SYMBOL_PREFIX).rsplit(" ", 1)
+            symbols.append({"name": name, "goal_offset": int(address, 0)})
+        elif line.startswith(TYPE_PREFIX):
+            name, method_count, address = line.removeprefix(TYPE_PREFIX).rsplit(" ", 2)
+            types.append({
+                "name": name,
+                "method_count": int(method_count),
+                "goal_offset": int(address, 0),
+            })
+        elif line.startswith(OBJECT_PREFIX):
+            match = OBJECT_PATTERN.match(line.removeprefix(OBJECT_PREFIX))
+            if not match:
+                parser.error(f"malformed object link record: {line}")
+            objects.append({
+                "name": match.group("name"),
+                "version": int(match.group("version")),
+                "segments": {
+                    "main": {
+                        "goal_offset": int(match.group("main"), 16),
+                        "size": int(match.group("main_size"), 16),
+                    },
+                    "debug": {
+                        "goal_offset": int(match.group("debug"), 16),
+                        "size": int(match.group("debug_size"), 16),
+                    },
+                    "top_level": {
+                        "goal_offset": int(match.group("top"), 16),
+                        "size": int(match.group("top_size"), 16),
+                    },
+                },
+            })
+        elif line.startswith("OPENGOAL_C_FUNCTION_STUB "):
+            name, address = line.removeprefix("OPENGOAL_C_FUNCTION_STUB ").rsplit(" ", 1)
+            native_stubs.append({
+                "name": name,
+                "goal_offset": int(address, 0),
+                "convention": "arguments",
+            })
+        elif line.startswith("OPENGOAL_C_STACK_FUNCTION_STUB "):
+            name, address = line.removeprefix("OPENGOAL_C_STACK_FUNCTION_STUB ").rsplit(" ", 1)
+            native_stubs.append({
+                "name": name,
+                "goal_offset": int(address, 0),
+                "convention": "stack_arguments",
+            })
+    if not symbols:
+        parser.error("no recorded dynamic symbols found")
+    if s7_goal_offset is None:
+        parser.error("no captured s7 base found")
+    report = {
+        "format": "OpenGOAL Jak 1 runtime bootstrap address capture v1",
+        "s7_goal_offset": s7_goal_offset,
+        "kernel_dispatcher_goal_offset": kernel_dispatcher_goal_offset,
+        "symbols": symbols,
+        "types": types,
+        "objects": objects,
+        "native_stubs": native_stubs,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + "\n")
+    print(
+        f"Wrote {args.output} ({len(symbols)} symbols, {len(types)} types, "
+        f"{len(objects)} linked objects, {len(native_stubs)} native stubs)"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
