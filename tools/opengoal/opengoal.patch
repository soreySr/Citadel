+(defun fishermans-boat-ios-hint-line ((str string) (font font-context) (alpha int))
+  "Print one hint line. print-game-text only fades the main color, so fade the pad glyph colors too."
+  (dotimes (i 7)
+    (set-font-color-alpha (the-as font-color (-> (new 'static 'array uint8 7 1 22 23 24 25 26 27) i)) alpha))
+  (print-game-text str font #f alpha 22)
+  (dotimes (i 7)
+    (set-font-color-alpha (the-as font-color (-> (new 'static 'array uint8 7 1 22 23 24 25 26 27) i)) 128))
+  (+! (-> font origin y) 15.0)
+  0
+  (none))
