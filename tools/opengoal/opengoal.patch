+;; ---- Fish menu preview (fishing phase 6) ---------------------------------------------------------------------
+;; The pause menu's Fish menu (host: OpenGOALRuntimeHost.mm SyncIOSFishMenu, progress screen 41) shows the fish picked
+;; in its list on the right of the screen, turning. The host writes the species (-1: none); this runs while the
+;; game is paused, so it clears the pause bit from its own mask.
+
+(define *ios-fish-menu-preview* -1)
+(define *ios-fish-menu-preview-count* 0) ;; how many of it this save has caught (host)
+
+(deftype ios-fish-menu-preview (process-drawable)
+  ((species int32)
+   (kind    int32)
+   (spin    float)
+   (size    float))
+  (:states
+   ios-fish-menu-preview-show))
+
+(define *ios-fish-menu-preview-ppointer* (the-as (pointer process) #f))
+(define *ios-fish-menu-preview-pid* 0)
+
+(defun ios-fish-menu-preview-get ()
+  (let ((pp *ios-fish-menu-preview-ppointer*))
+    (the-as ios-fish-menu-preview
+            (when pp
+              (let ((proc (-> pp 0)))
+                (if (and proc (= (-> proc pid) *ios-fish-menu-preview-pid*)) proc))))))
+
+(defconstant IOS_FISH_MENU_PREVIEW_X 384.0) ;; where the fish is drawn (512 x 224 screen units), right of the list
+(defconstant IOS_FISH_MENU_PREVIEW_Y 92.0)
+
+(defbehavior ios-fish-menu-preview-place ios-fish-menu-preview ()
+  (+! (-> self spin) (* (degrees 50) (seconds-per-frame)))
+  (ios-fishing-view-place self IOS_FISH_MENU_PREVIEW_X IOS_FISH_MENU_PREVIEW_Y (+ (degrees 90) (-> self spin)))
+  0)
+
+(defbehavior ios-fish-menu-preview-init-by-other ios-fish-menu-preview ((sp int))
+  (let* ((info (-> *ios-fish-roster* species sp))
+         (kind (-> info model))
+         (tint (-> info tint))
+         (scale (* 0.75 IOS_FISHING_SHOW_SCALE (ios-fish-scale kind) (+ 0.75 (* 0.25 (-> info scale))))))
+    (set! (-> self entity) (ios-fish-entity))
+    ;; keeps running in the pause menu: like the pause menu's own 3D icons, without the menu and progress bits (with
+    ;; the progress bit it never ran while the menu was up, so it had no pose and wasn't drawn: it only showed for a
+    ;; frame on unpausing, user 2026-10-17)
+    (logclear! (-> self mask) (process-mask pause menu progress actor-pause enemy platform projectile death))
+    (set! *ios-fish-menu-preview-ppointer* (-> self ppointer))
+    (set! *ios-fish-menu-preview-pid* (-> self pid))
+    (set! (-> self species) sp)
+    (set! (-> self kind) kind)
+    (set! (-> self spin) 0.0)
+    (set! (-> self size) scale)
+    (set! (-> self root) (new 'process 'trsqv))
+    (initialize-skeleton self (ios-fish-skel kind) '())
+    (set! (-> self skel effect) #f)
+    (set-vector! (-> self root scale) scale scale scale 1.0)
+    ;; unlit: the menu's fish look the same wherever the game was paused
+    (ios-fishing-show-tint-unlit self tint)
+    (ios-fish-menu-preview-place))
+  (go ios-fish-menu-preview-show)
+  (none))
+
+(defstate ios-fish-menu-preview-show (ios-fish-menu-preview)
+  :trans
+    (behavior ()
+      (ios-fish-menu-preview-place))
+  :code
+    (behavior ()
+      (ja-channel-set! 1)
+      (let ((anim (the-as art-joint-anim (-> self draw art-group data (ios-fish-anim-index (-> self kind))))))
+        (loop
+          (ja-no-eval :group! anim :num! (seek!) :frame-num 0.0)
+          (until (ja-done? 0)
+            (suspend)
+            (ja :num! (seek!))))))
+  :post ja-post)
