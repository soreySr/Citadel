+#!/usr/bin/env python3
+"""Pack deterministic Jak 1 symbol slots and hashes for the iOS GOAL table."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import struct
+from pathlib import Path
+
+
+HEADER = struct.Struct("<8sIII")
+ENTRY = struct.Struct("<iI")
+MAGIC = b"JAK1SYM\0"
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("symbol_slots", type=Path)
+    parser.add_argument("s7_goal_offset", type=lambda value: int(value, 0))
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+
+    plan = json.loads(args.symbol_slots.read_text())
+    assignments = plan["assignments"]
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open("wb") as file:
+        file.write(HEADER.pack(MAGIC, 1, args.s7_goal_offset, len(assignments)))
+        for assignment in assignments:
+            file.write(ENTRY.pack(assignment["s7_relative_offset"], assignment["hash_crc32"]))
+    print(f"Wrote {args.output} ({len(assignments)} symbol hashes)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/ios/aot_symbol_slots.py b/tools/ios/aot_symbol_slots.py
new file mode 100644
index 000000000..c94e7209a
--- /dev/null
+++ b/tools/ios/aot_symbol_slots.py
@@ -0,0 +1,124 @@
+#!/usr/bin/env python3
+"""Plan deterministic Jak 1 symbol-table slots for an iOS AOT bootstrap.
+
+The fixed symbol region is extracted from the checked-out kernel source. Dynamic
+symbols are placed with Jak 1's CRC32C linear-probe scheme. A kernel seed list
+is accepted because kernel-created dynamic symbols must be inserted before game
+symbols to reproduce a real boot.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+from pathlib import Path
+
+
+GOAL_MAX_SYMBOLS = 16384
+FIXED_REGION_END = 0x1D0
+SLOT_SIZE = 8
+LOWER_END = -0x10
+UPPER_END = (GOAL_MAX_SYMBOLS // 2) * SLOT_SIZE
+
+
+def goal_crc32(data: bytes) -> int:
+    """Match game/kernel/common/kscheme.cpp's non-reflected CRC32."""
+    table = []
+    for index in range(256):
+        value = index << 24
+        for _ in range(8):
+            value = ((value << 1) ^ 0x04C11DB7) & 0xFFFFFFFF if value & 0x80000000 else (
+                value << 1
+            ) & 0xFFFFFFFF
+        table.append(value)
+
+    value = 0
+    for byte in data:
+        value = (table[value >> 24] ^ ((value << 8) | byte)) & 0xFFFFFFFF
+    return (~value) & 0xFFFFFFFF
+
+
+def signed32(value: int) -> int:
+    value &= 0xFFFFFFFF
+    return value - (1 << 32) if value & (1 << 31) else value
+
+
+def slot_start(name: str) -> int:
+    # Equivalent to find_symbol_from_c's sh1/sh2 calculation for 16,384 symbols.
+    sh1 = signed32(goal_crc32(name.encode("utf-8")) << 18)
+    return sh1 >> 15
+
+
+def fixed_symbols(symbols_header: Path, kernel_source: Path) -> list[tuple[str, int]]:
+    header = symbols_header.read_text()
+    section = header.split("namespace jak1_symbols {", 1)[1].split("}  // namespace jak1_symbols", 1)[0]
+    constants = {
+        name: int(value, 0)
+        for name, value in re.findall(r"constexpr int (FIX_SYM_[A-Z0-9_]+)\s*=\s*([^;\s]+)", section)
+    }
+    source = kernel_source.read_text()
+    matches = re.findall(
+        r'set_fixed_(?:symbol|type)\s*\(\s*(FIX_SYM_[A-Z0-9_]+)\s*,\s*"([^"]+)"',
+        source,
+    )
+    return [(name, constants[constant]) for constant, name in matches]
+
+
+def allocate(name: str, slots: dict[int, str]) -> int:
+    start = slot_start(name)
+    ranges = ((start, UPPER_END), (-((GOAL_MAX_SYMBOLS // 2) * SLOT_SIZE), LOWER_END)) if start > 0 else (
+        (start, LOWER_END),
+        (FIXED_REGION_END, UPPER_END),
+    )
+    for begin, end in ranges:
+        for offset in range(begin, end, SLOT_SIZE):
+            if offset not in slots:
+                slots[offset] = name
+                return offset
+    raise RuntimeError(f"symbol table is full while inserting {name}")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("startup_plan", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--kernel-source", type=Path, default=Path("game/kernel/jak1/kscheme.cpp"))
+    parser.add_argument("--symbols-header", type=Path, default=Path("common/symbols.h"))
+    parser.add_argument("--kernel-seed", type=Path, help="JSON array of dynamic kernel symbols")
+    args = parser.parse_args()
+
+    startup = json.loads(args.startup_plan.read_text())
+    fixed_entries = fixed_symbols(args.symbols_header, args.kernel_source)
+    # Keep every occupied fixed slot. Some historical fixed symbols intentionally share a name.
+    fixed = {name: offset for name, offset in fixed_entries}
+    slots = {offset: name for name, offset in fixed_entries}
+    seed = json.loads(args.kernel_seed.read_text()) if args.kernel_seed else []
+    names = [*seed, *startup["symbol_intern_order"]]
+    assignments = []
+    seen = set()
+    for name in names:
+        if name in seen:
+            continue
+        seen.add(name)
+        offset = fixed.get(name)
+        if offset is None:
+            offset = allocate(name, slots)
+        assignments.append({"name": name, "hash_crc32": goal_crc32(name.encode("utf-8")), "s7_relative_offset": offset})
+
+    report = {
+        "format": "OpenGOAL Jak 1 iOS AOT symbol-slot plan v1",
+        "kernel_seed_count": len(seed),
+        "fixed_symbol_count": len(fixed_entries),
+        "assignment_count": len(assignments),
+        "requires_kernel_seed_validation": not bool(args.kernel_seed),
+        "assignments": assignments,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + "\n")
+    print(f"Wrote {args.output} ({len(assignments)} symbol assignments)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
