+
+(defbehavior super-red-bomb-post super-red-bomb ()
+  ; (if (< (- (current-time) (-> self fuse-time)) SUPER_RED_BOMB_FUSE_TIME)
+  ;   (format *stdcon* "red-bomb fuse time ~,,2es~%" (- SUPER_RED_BOMB_FUSE_TIME (- (current-time) (-> self fuse-time)))))
