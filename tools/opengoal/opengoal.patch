+(define *ios-ocean-in-stock-water* #f)
+
+(defun ios-ocean-target-in-stock-water? ()
+  "Is Jak inside any loaded level's water volume (ocean, pools, rivers)?"
+  (set! *ios-ocean-in-stock-water* #f)
+  (iterate-process-tree *entity-pool*
+                        (lambda ((arg0 process))
+                          (when (and *target*
+                                     (type-type? (-> arg0 type) water-vol)
+                                     (nonzero? (-> (the-as water-vol arg0) vol))
+                                     (point-in-vol? (-> (the-as water-vol arg0) vol) (-> *target* control trans)))
+                            (set! *ios-ocean-in-stock-water* #t))
+                          #t)
+                        *null-kernel-context*)
+  *ios-ocean-in-stock-water*)
+
+(defun ios-ocean-open-sea? ((pos vector))
+  "Far enough from every island's land to be open water."
+  (and (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_VILLAGE_X IOS_SEA_VILLAGE_Z))
+       (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_BEACH_X IOS_SEA_BEACH_Z))
+       (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_MISTY_X IOS_SEA_MISTY_Z))
+       (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_TRAINING_X IOS_SEA_TRAINING_Z))
+       (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_JUNGLE_X IOS_SEA_JUNGLE_Z))
+       (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_VILLAGE2_X IOS_SEA_VILLAGE2_Z))
+       (< IOS_SEA_LAND_R (ios-sea-distance pos IOS_SEA_SWAMP_X IOS_SEA_SWAMP_Z))))
+
+(defun ios-ocean-set-respawn ((zone symbol))
+  "Keep an open-sea death tied to the island whose full-detail level is currently linked. Village and
+   Misty use their docks; levels without a dedicated dock retain their normal initial continue."
+  (case zone
+    (('misty)
+     (set-continue! *game-info* "misty-start")
+     (set-vector! (-> *game-info* current-continue trans) 49971.2 28672.0 2924544.0 1.0)
+     (set-vector! (-> *game-info* current-continue camera-trans) 49971.2 49152.0 2859008.0 1.0))
+    (('training) (set-continue! *game-info* "training-start"))
+    (('beach) (set-continue! *game-info* "beach-start"))
+    (('jungle) (set-continue! *game-info* "jungle-start"))
+    (('village2) (set-continue! *game-info* "village2-dock"))
+    (('swamp) (set-continue! *game-info* "swamp-dock1"))
+    (('glacier) (set-continue! *game-info* "glacier-start"))
+    (else
+     (set-continue! *game-info* "village1-hut")
+     (set-vector! (-> *game-info* current-continue trans) -88473.6 28672.0 425984.0 1.0)
+     (set-vector! (-> *game-info* current-continue camera-trans) -88473.6 49152.0 360448.0 1.0)))
+  0
+  (none))
+
+(defun ios-ocean-mark-low-res-models ()
+  "Keep village1's low-res island models (and the boat) alive while village1 is in 'special display mode,
+   like the misty / training continue points do."
+  (dolist (name '("med-res-level-1"
+                  "med-res-level-2"
+                  "med-res-level-3"
+                  "med-res-level-4"
+                  "med-res-level-6"
+                  "med-res-level-7"
+                  "med-res-level-8"
+                  "med-res-level-9"
+                  "med-res-level-11"
+                  "med-res-level-14"
+                  "med-res-level-22"
+                  "med-res-level-23"
+                  "fishermans-boat-2"))
+    (let ((ent (entity-by-name (the-as string (car name)))))
+      (if ent (set-or-clear-status! (the-as entity-actor ent) (entity-perm-status bit-7) #t))))
+  0
+  (none))
+
+(defbehavior ios-ocean-claim-water ios-ocean-manager ()
+  "Act as an ocean water-vol for Jak (same settings as the levels' ocean volumes)."
+  (let ((w (-> *target* water)))
+    (set! (-> w volume) (process->handle self))
+    (logior! (-> w flag) (water-flag active can-wade can-swim use-ocean part-water))
+    (set! (-> w base-height) 0.0)
+    (set! (-> w ocean-offset) 0.0)
+    (set! (-> w wade-height) 2048.0)
+    (set! (-> w swim-height) 8192.0)
+    (set! (-> w bottom-height) 32768.0)
+    (set-zero! (-> w bob)))
+  (set! (-> self water-claim) #t)
+  0
+  (none))
+
+(defbehavior ios-ocean-release-water ios-ocean-manager ()
+  "Same as water-vol on-exit-water: drop the water flags and let the level water volumes re-check Jak."
+  (when (-> self water-claim)
+    (set! (-> self water-claim) #f)
+    (when (and *target* (= (handle->process (-> *target* water volume)) self))
+      (logclear! (-> *target* water flag)
+                 (water-flag active
+                             can-wade
+                             can-swim
+                             use-ocean
+                             tar
+                             mud
+                             deadly
+                             use-ripple-offset
+                             no-grab-sound
+                             part-water
+                             dark-eco
+                             lava
+                             wt26))
+      (set! (-> *target* water volume) (the-as handle #f))
+      (iterate-process-tree *entity-pool*
+                            (lambda ((arg0 water-vol))
+                              (if (type-type? (-> arg0 type) water-vol) (send-event arg0 'update)))
+                            *null-kernel-context*)))
+  0
+  (none))
+
+(defun ios-ocean-birth-water-vols ()
+  "Spawn the active levels' water volumes near Jak. A level streamed in with force-vis gets no actor births at
+   all while Jak is outside its bsp (actors-update skips it while all-visible?), and the sea around an island lies
+   outside it, so its water would never spawn and Jak would sink through. bit-3 keeps actors-update from killing them."
+  (let ((pos (-> *target* control trans)))
+    (dotimes (i (-> *level* length))
+      (let ((lev (-> *level* level i)))
+        ;; inside a level's bsp its stock vis decides
+        (when (and (= (-> lev status) 'active) (not (-> lev inside-boxes?)) (nonzero? (-> lev entity)))
+          (dotimes (j (-> lev entity length))
+            (let* ((link (-> lev entity data j))
+                   (ent (-> link entity)))
+              (when (and (type-type? (-> ent type) entity-actor)
+                         ;; subtypes too (water-anim)
+                         (type-type? (-> (the-as entity-actor ent) etype) water-vol)
+                         (not (-> link process))
+                         (not (logtest? (-> link perm status) (entity-perm-status bit-0 dead)))
+                         (< (vector-vector-xz-distance (-> link trans) pos) (meters 300)))
+                (entity-birth-no-kill ent))))))))
+  0
+  (none))
+
+(defbehavior ios-ocean-update-water ios-ocean-manager ()
+  "Ocean water anywhere outside the levels' own water volumes."
+  (cond
+    ((not *target*) (set! (-> self water-claim) #f))
+    ((-> self water-claim)
+     ;; release once a level volume covers Jak again (checked every 8 frames) or he is back near land
+     (when (or (not (= (handle->process (-> *target* water volume)) self))
+               (not (ios-ocean-open-sea? (-> *target* control trans)))
+               (and (zero? (logand (-> self tick) 7)) (ios-ocean-target-in-stock-water?)))
+       (ios-ocean-release-water)))
+    ((and (not (handle->process (-> *target* water volume)))
+          (zero? (logand (-> self tick) 7))
+          (ios-ocean-open-sea? (-> *target* control trans))
+          (not (ios-ocean-target-in-stock-water?)))
+     (ios-ocean-claim-water)))
+  0
+  (none))
+
+(define-extern ios-glacier-partner (function symbol symbol))
+
+(defbehavior ios-ocean-arrive ios-ocean-manager ((zone symbol))
+  "Back in an island's home zone: the same level setup as its continue point, and its continue (music, respawn)."
+  (case zone
+    (('misty)
+     (load-state-want-levels 'village1 'misty)
+     (load-state-want-display-level 'misty 'display)
+     (load-state-want-display-level 'village1 'special)
+     (load-state-want-vis 'mis)
+     (load-state-want-force-vis 'misty #f)
+     (ios-ocean-set-respawn 'misty))
+    (('training)
+     (load-state-want-levels 'village1 'training)
+     (load-state-want-display-level 'training 'display)
+     (load-state-want-display-level 'village1 'special)
+     (load-state-want-vis 'tra)
+     (load-state-want-force-vis 'training #f)
+     (ios-ocean-set-respawn 'training))
+    (('beach)
+     (load-state-want-levels 'village1 'beach)
+     (load-state-want-display-level 'village1 'display)
+     (load-state-want-display-level 'beach 'display)
+     (load-state-want-vis 'bea)
+     (load-state-want-force-vis 'village1 #f)
+     ;; sea mode streamed it in with force-vis, which suppresses its actors outside its bsp
+     (load-state-want-force-vis 'beach #f)
+     (ios-ocean-set-respawn 'beach))
+    (('jungle)
+     ;; same as the stock jungle-start continue: both levels in full (Sandover borders the jungle)
+     (load-state-want-levels 'village1 'jungle)
+     (load-state-want-display-level 'jungle 'display)
+     (load-state-want-display-level 'village1 'display)
+     (load-state-want-vis 'jun)
+     (load-state-want-force-vis 'village1 #f)
+     (load-state-want-force-vis 'jungle #f)
+     (ios-ocean-set-respawn 'jungle))
+    (('glacier)
+     ;; the partner it had at sea stays in the other slot (never Sandover, see IOS_SEA_GLACIER_X)
+     (let ((partner (ios-glacier-partner #f)))
+       (load-state-want-levels 'glacier partner)
+       (load-state-want-display-level 'glacier 'display)
+       (load-state-want-display-level partner 'display)
+       (load-state-want-vis 'gla)
+       (load-state-want-force-vis 'glacier #f)
+       (load-state-want-force-vis partner #t))
+     (ios-ocean-set-respawn 'glacier))
+    (('village2 'swamp)
+     (cond
+       (*ios-boat-art-resident*
+        ;; the free boat needs no level: the stock pair here, Rock Village and Boggy Swamp both in full
+        (load-state-want-levels 'village2 'swamp)
+        (load-state-want-display-level 'village2 'display)
+        (load-state-want-display-level 'swamp 'display)
+        (load-state-want-vis (if (= zone 'swamp) 'swa 'vi2))
+        (load-state-want-force-vis 'village2 #f)
+        (load-state-want-force-vis 'swamp #f))
+       (else
+        ;; the boat is a village1 actor: keep village1 in the other slot so it survives docking
+        (load-state-want-levels 'village1 zone)
+        (load-state-want-display-level zone 'display)
+        (load-state-want-display-level 'village1 'special)
+        (load-state-want-vis (if (= zone 'swamp) 'swa 'vi2))
+        (load-state-want-force-vis zone #f)))
+     (ios-ocean-set-respawn zone))
+    (else
+     ;; like fishermans-boat-entering-village
+     (load-commands-set! *level* '())
+     (load-state-want-levels 'village1 'beach)
+     (load-state-want-display-level 'village1 'display)
+     (load-state-want-vis 'vi1)
+     (load-state-want-force-vis 'village1 #f)
+     (ios-ocean-set-respawn 'village1)))
+  0
+  (none))
+
+(defun ios-ocean-level-ready? ((name symbol))
+  "NAME is loaded and logged in (can be displayed)."
+  (let ((status (level-status *level* name)))
+    (or (= status 'loaded) (= status 'alive) (= status 'active))))
+
+(defun ios-ocean-want-pair ((first symbol) (second symbol))
+  "load-state-want-levels FIRST SECOND, one slot at a time: until FIRST is ready, a displayed level from the
+   pair being left (not SECOND) keeps the other slot. Swapping both slots at once (north <-> south pair) left
+   nothing loaded until FIRST was in, so the world went black for a moment (user 2026-10-18). Returns the level
+   kept instead of SECOND, or #f."
+  (let ((keep (the-as symbol #f)))
+    (when (and (not (ios-ocean-level-ready? first)) (not (level-get *level* second)))
+      (dotimes (i 2)
+        (let ((lev (-> *level* level i)))
+          (when (and (not keep)
+                     (= (-> lev status) 'active)
+                     (-> lev display?)
+                     (!= (-> lev name) first))
+            (set! keep (-> lev name))))))
+    (load-state-want-levels first (if keep keep second))
+    keep))
+
+(defbehavior ios-ocean-update-south-levels ios-ocean-manager ((d-village2 float) (d-swamp float))
+  "At sea near Rock Village / Boggy Swamp with the free boat: both level slots for them, each shown in full once
+   loaded. Out at sea neither bsp can work out visibility, so both are drawn whole (force-vis); vis data and the
+   respawn follow the nearer one. Coming from the north the nearer one loads first, while a north level stays."
+  (let ((near (if (< d-swamp d-village2) 'swamp 'village2)))
+    (when (!= near (-> self primary))
+      (set! (-> self primary) near)
+      (ios-ocean-set-respawn near))
+    (let ((kept (ios-ocean-want-pair near (if (= near 'swamp) 'village2 'swamp))))
+      (dolist (lev '(village2 swamp))
+        (let ((name (the-as symbol (car lev))))
+          (when (or (not kept) (= name near))
+            (load-state-want-display-level name (if (ios-ocean-level-ready? name) 'display #f))
+            (load-state-want-force-vis name #t)))))
+    (load-state-want-vis (if (= near 'swamp) 'swa 'vi2)))
+  0
+  (none))
+
+;; Middle stage of the trip down the east coast (coastline-plan.md phase 4): with the jungle the nearest island of
+;; the north and Rock Village within this distance, the pair is jungle + Rock Village (enter / leave, hysteresis).
+;; At the jungle's south end (z -380) Rock Village's centre is ~1250 m away: it streams in just past it.
+(defconstant IOS_SEA_MID_ENTER_R (meters 1150))
+(defconstant IOS_SEA_MID_LEAVE_R (meters 1250))
+
+(defbehavior ios-ocean-update-mid-levels ios-ocean-manager ((d-jungle float) (d-village2 float))
+  "At sea down the east coast: the jungle and Rock Village in the two slots, both drawn whole (force-vis) once
+   loaded, vis data and the respawn following the nearer one. The one already loaded is kept while the other
+   streams in (coming south that is the jungle, Sandover's slot goes to Rock Village; coming north the other way)."
+  (let ((near (if (< d-village2 d-jungle) 'village2 'jungle)))
+    (when (!= near (-> self primary))
+      (set! (-> self primary) near)
+      (ios-ocean-set-respawn near))
+    (let* ((first (if (ios-ocean-level-ready? 'village2) 'village2 'jungle))
+           (kept (ios-ocean-want-pair first (if (= first 'village2) 'jungle 'village2))))
+      (dolist (lev '(jungle village2))
+        (let ((name (the-as symbol (car lev))))
+          (when (or (not kept) (= name first))
+            (load-state-want-display-level name (if (ios-ocean-level-ready? name) 'display #f))
+            (load-state-want-force-vis name #t)))))
+    (load-state-want-vis (if (= near 'village2) 'vi2 'jun)))
+  0
+  (none))
+
+(define-extern *ios-sea-fog* float)
+;; The fog bank sits on the Sandover <-> Rock Village switch (IOS_SEA_MID_ENTER_R / _LEAVE_R): full within
+;; IOS_SEA_FOG_FULL of this distance from Rock Village, gone beyond IOS_SEA_FOG_CLEAR (see ios-ocean-transition-fog).
+(defconstant IOS_SEA_FOG_CENTER (meters 1200))
+(defconstant IOS_SEA_FOG_FULL (meters 70))      ;; full from the line out to this, on the Sandover side
+(defconstant IOS_SEA_FOG_CLEAR (meters 170))    ;; clear beyond this, on the Sandover side
+;; on the Rock Village side it reaches further in (user 2026-10-22: Rock Village's sky, light and rock still settled
+;; in after the fog had cleared), so the whole arrival happens inside it
+(defconstant IOS_SEA_FOG_FULL_IN (meters 260))
+(defconstant IOS_SEA_FOG_CLEAR_IN (meters 360))
+;; at sea in the jungle + Rock Village pair ('mid) or the Rock Village + Boggy Swamp pair ('south), else #f: the sky
+;; and light then follow Rock Village (ios-sea-look-weights), not the distance blend with the other level
+(define-perm *ios-sea-look* symbol #f)
+;; after a switch, and while the arriving level is not active yet, the fog stays full this long
+(defconstant IOS_SEA_FOG_HOLD (seconds 2.5))
+(define-perm *ios-sea-fog-hold-until* time-frame 0)
+
+(defun ios-glacier-partner ((current symbol))
+  "The level beside the Glacier: the nearer of the jungle and Rock Village to Jak (CURRENT is kept until the other is
+   clearly nearer)."
+  (let* ((pos (target-pos 0))
+         (d-jungle (ios-sea-distance pos IOS_SEA_JUNGLE_X IOS_SEA_JUNGLE_Z))
+         (d-village2 (ios-sea-distance pos IOS_SEA_VILLAGE2_X IOS_SEA_VILLAGE2_Z)))
+    (case current
+      (('jungle) (if (< d-village2 (* IOS_SEA_REGION_HYSTERESIS d-jungle)) 'village2 'jungle))
+      (('village2) (if (< d-jungle (* IOS_SEA_REGION_HYSTERESIS d-village2)) 'jungle 'village2))
+      (else (if (< d-village2 d-jungle) 'village2 'jungle)))))
+
+(defbehavior ios-ocean-update-glacier-levels ios-ocean-manager ((d-glacier float))
+  "At sea inside the Glacier's fog ring: the Glacier and its partner in the two slots, both drawn whole (force-vis)
+   once loaded, the respawn the Glacier's. Coming from Sandover the Glacier takes Sandover's slot (it waits for
+   Sandover to go, ios-glacier-guard-levels); from the south the farther of the jungle / Rock Village gives way. The
+   fog is held full until the Glacier is in (ios-ocean-transition-fog)."
+  (let ((partner (ios-glacier-partner (-> self glacier))))
+    (set! (-> self glacier) partner)
+    (when (!= (-> self primary) 'glacier)
+      (set! (-> self primary) 'glacier)
+      (ios-ocean-set-respawn 'glacier))
+    (let* ((first (if (ios-ocean-level-ready? 'glacier) 'glacier partner))
+           (kept (ios-ocean-want-pair first (if (= first 'glacier) partner 'glacier))))
+      (dolist (lev (list 'glacier partner))
+        (let ((name (the-as symbol (car lev))))
+          (when (or (not kept) (= name first))
+            (load-state-want-display-level name (if (ios-ocean-level-ready? name) 'display #f))
+            (load-state-want-force-vis name #t)))))
+    (load-state-want-vis 'gla))
+  0
+  (none))
+
+(define-extern ios-ocean-jak-aboard? (function fishermans-boat object))
+(defconstant IOS_SEA_ABOARD_NEAR (meters 9))  ;; Jak this close to the boat (xz) is still aboard for the level choice
+
+(defbehavior ios-ocean-update-levels ios-ocean-manager ()
+  "Pick the levels for Jak's position at sea (every 10 frames)."
+  (set! *ios-sea-look* #f)
+  (let* ((pos (-> *target* control trans))
+         (d-village (ios-sea-distance pos IOS_SEA_VILLAGE_X IOS_SEA_VILLAGE_Z))
+         (d-beach (ios-sea-distance pos IOS_SEA_BEACH_X IOS_SEA_BEACH_Z))
+         (d-misty (ios-sea-distance pos IOS_SEA_MISTY_X IOS_SEA_MISTY_Z))
+         (d-training (ios-sea-distance pos IOS_SEA_TRAINING_X IOS_SEA_TRAINING_Z))
+         (d-jungle (ios-sea-distance pos IOS_SEA_JUNGLE_X IOS_SEA_JUNGLE_Z))
+         (d-village2 (ios-sea-distance pos IOS_SEA_VILLAGE2_X IOS_SEA_VILLAGE2_Z))
+         (d-swamp (ios-sea-distance pos IOS_SEA_SWAMP_X IOS_SEA_SWAMP_Z))
+         ;; far away (never chosen) while the Glacier is not available
+         (d-glacier (if (= *ios-glacier-warp* #t)
+                        (ios-sea-distance pos IOS_SEA_GLACIER_X IOS_SEA_GLACIER_Z)
+                        (meters 100000)))
+         (zone (cond
+                 ((< d-glacier (- IOS_SEA_GLACIER_SHORE IOS_SEA_ARRIVE_R)) 'glacier)
+                 ((< d-misty IOS_SEA_ARRIVE_R) 'misty)
+                 ((< d-training IOS_SEA_ARRIVE_R) 'training)
+                 ((< d-jungle IOS_SEA_ARRIVE_R) 'jungle)
+                 ((< d-village2 IOS_SEA_ARRIVE_R) 'village2)
+                 ((< d-swamp IOS_SEA_ARRIVE_R) 'swamp)
+                 ((< d-beach IOS_SEA_ARRIVE_R) 'beach)
+                 ((< d-village IOS_SEA_ARRIVE_R) 'village1)
+                 (else #f)))
+         ;; Only a trip over water is managed. Much of Sandover's land (village1-hut, ~215 m out) lies outside
+         ;; the arrival zones, so walking or loading a save there must not switch to sea mode. Standing on the boat
+         ;; is at sea too (user 2026-10-24: leaving the wheel at the Sandover / Rock Village hand-over took the "back on
+         ;; land" branch below, which handed the levels to the nearest island and swapped them under Jak's feet).
+         ;; Close to the boat counts as well: jumping on the deck leaves its rider slot for a moment. Both only keep a
+         ;; trip that driving or swimming started (sea-mode): walking past a boat parked by the shore stays stock.
+         (boat (ios-ocean-boat))
+         (at-sea? (or *ios-boat-driving*
+                      (and (-> self sea-mode)
+                           boat
+                           (or (ios-ocean-jak-aboard? boat)
+                               (< (vector-vector-xz-distance pos (-> boat root-overlay trans)) IOS_SEA_ABOARD_NEAR)))
+                      (logtest? (-> *target* water flag) (water-flag swimming under-water)))))
+    (cond
+      (zone
+       ;; only take over again if we were managing the trip
+       (when (-> self sea-mode)
+         (set! (-> self sea-mode) #f)
+         (ios-ocean-arrive zone)))
+      ((not at-sea?)
+       ;; back on land outside the arrival zones: hand the nearest island back to the stock level logic
+       (when (-> self sea-mode)
+         (set! (-> self sea-mode) #f)
+         (let ((nearest 'village1)
+               (d-nearest d-village))
+           (when (< d-beach d-nearest) (set! nearest 'beach) (set! d-nearest d-beach))
+           (when (< d-misty d-nearest) (set! nearest 'misty) (set! d-nearest d-misty))
+           (when (< d-training d-nearest) (set! nearest 'training) (set! d-nearest d-training))
+           (when (< d-jungle d-nearest) (set! nearest 'jungle) (set! d-nearest d-jungle))
+           (when (< d-village2 d-nearest) (set! nearest 'village2) (set! d-nearest d-village2))
+           (when (< d-swamp d-nearest) (set! nearest 'swamp) (set! d-nearest d-swamp))
+           (when (< (- d-glacier IOS_SEA_GLACIER_SHORE) d-nearest) (set! nearest 'glacier) (set! d-nearest (- d-glacier IOS_SEA_GLACIER_SHORE)))
+           (ios-ocean-arrive nearest))))
+      ;; Inside the Glacier's fog ring (IOS_SEA_GLACIER_ENTER_R): the Glacier + the jungle or Rock Village
+      ((< d-glacier (if (-> self glacier) IOS_SEA_GLACIER_LEAVE_R IOS_SEA_GLACIER_ENTER_R))
+       (set! (-> self sea-mode) #t)
+       (set! (-> self mid) #f)
+       (set! (-> self south) #f)
+       (ios-ocean-update-glacier-levels d-glacier))
+      ((begin (set! (-> self glacier) #f) #f) #f)
+      ;; Rock Village / Boggy Swamp at sea with the free boat: both slots, no Sandover (see IOS_SEA_REGION_HYSTERESIS)
+      ((and *ios-boat-art-resident*
+            (let ((d-south (fmin d-village2 d-swamp))
+                  (d-north (fmin (fmin (fmin d-village d-beach) (fmin d-misty d-training)) d-jungle)))
+              (set! (-> self south)
+                    (if (-> self south)
+                      (not (< d-north (* IOS_SEA_REGION_HYSTERESIS d-south)))
+                      (< d-south (* IOS_SEA_REGION_HYSTERESIS d-north))))
+              (-> self south)))
+       (set! (-> self sea-mode) #t)
+       (set! (-> self mid) #f)
+       (set! *ios-sea-look* 'south)
+       (ios-ocean-update-south-levels d-village2 d-swamp))
+      ;; Down the east coast: the jungle + Rock Village, so Rock Village is in long before you reach it (it used
+      ;; to appear only at the halfway hand-over; user 2026-10-21). Sandover is far behind by then.
+      ((and *ios-boat-art-resident*
+            (let ((want-mid (and (< d-jungle (fmin (fmin d-village d-beach) (fmin d-misty d-training)))
+                                 (< d-village2 (if (-> self mid) IOS_SEA_MID_LEAVE_R IOS_SEA_MID_ENTER_R)))))
+              ;; Sandover <-> Rock Village is where the sky and the water colour change (the active ocean map is
+              ;; the last active level's), so near that line the pair only switches inside full fog
+              ;; (coastline-plan.md phase 5, user 2026-10-22); away from it (a save loaded at sea, a warp) at once
+              (when (and (!= want-mid (-> self mid))
+                         (or (< 0.9 *ios-sea-fog*)
+                             (< IOS_SEA_FOG_CLEAR (- d-village2 IOS_SEA_FOG_CENTER))
+                             (< IOS_SEA_FOG_CLEAR_IN (- IOS_SEA_FOG_CENTER d-village2))))
+                (set! (-> self mid) want-mid)
+                (set! *ios-sea-fog-hold-until* (+ (current-time) IOS_SEA_FOG_HOLD)))
+              (-> self mid)))
+       (set! (-> self sea-mode) #t)
+       (if (not (= (level-status *level* 'village2) 'active))
+           (set! *ios-sea-fog-hold-until* (+ (current-time) IOS_SEA_FOG_HOLD)))
+       (set! *ios-sea-look* 'mid)
+       (ios-ocean-update-mid-levels d-jungle d-village2))
+      (else
+       (when (not (-> self sea-mode))
+         (set! (-> self sea-mode) #t)
+         (set! (-> self primary) 'village1)
+         (ios-ocean-mark-low-res-models))
+       ;; back up north: the fog stays until Sandover is in again
+       (if (and *ios-boat-art-resident* (not (= (level-status *level* 'village1) 'active)))
+           (set! *ios-sea-fog-hold-until* (+ (current-time) IOS_SEA_FOG_HOLD)))
+       (when (and *ios-boat-art-resident* (or (= (-> self primary) 'village2) (= (-> self primary) 'swamp)))
+         ;; back from the south / mid pair: #f so the primary check below sets the respawn again
+         (set! (-> self primary) #f)
+         (ios-ocean-mark-low-res-models))
+       ;; The second slot always streams the nearest destination. Beach and Jungle must participate here too;
+       ;; otherwise their low-res stand-ins remain visible all the way to shore and their real actors never link.
+       (let ((other 'misty)
+             (d-other d-misty)
+             (other-radius IOS_SEA_MISTY_R))
+         (when (< d-training d-other)
+           (set! other 'training)
+           (set! d-other d-training)
+           (set! other-radius IOS_SEA_TRAINING_R))
+         (when (< d-beach d-other)
+           (set! other 'beach)
+           (set! d-other d-beach)
+           (set! other-radius IOS_SEA_BEACH_R))
+         (when (< d-jungle d-other)
+           (set! other 'jungle)
+           (set! d-other d-jungle)
+           (set! other-radius IOS_SEA_JUNGLE_R))
+         ;; Rock Village and Boggy Swamp (no low-res stand-ins in village1, so they only appear once streamed). With
+         ;; the free boat they are never reached here (the south pair takes over first); this is the fallback for a
+         ;; boat that is still a village1 actor.
+         (when (not *ios-boat-art-resident*)
+           (when (< d-village2 d-other)
+             (set! other 'village2)
+             (set! d-other d-village2)
+             (set! other-radius IOS_SEA_VILLAGE2_R))
+           (when (< d-swamp d-other)
+             (set! other 'swamp)
+             (set! d-other d-swamp)
+             (set! other-radius IOS_SEA_SWAMP_R)))
+         ;; back from the south pair, a Rock Village / Boggy Swamp level stays until Sandover is in
+         (ios-ocean-want-pair 'village1 other)
+         ;; Begin displaying full detail at twice the destination's former home-zone distance.
+         (let ((new-primary (if (< d-other (* 2.0 other-radius)) other 'village1)))
+           (when (!= new-primary (-> self primary))
+             (set! (-> self primary) new-primary)
+             (ios-ocean-set-respawn new-primary)))
+         (let ((status (level-status *level* other))
+               ;; Experiment (user, 2026-10-07): long view from the boat. While Jak is on the boat in open water,
+               ;; show the streamed island in full as soon as it is loaded, at any distance, and keep Sandover
+               ;; in full too, instead of the low-res stand-ins. Only two level slots exist, so islands other
+               ;; than the streamed one still show their low-res models.
+               (long-view? (and (ios-ocean-open-sea? pos)
+                                (or *ios-boat-driving*
+                                    (let* ((boat (ios-ocean-boat))
+                                           (riders (if boat (-> boat root-overlay riders))))
+                                      (and riders
+                                           (nonzero? riders)
+                                           (> (-> riders num-riders) 0)
+                                           (= (handle->process (-> riders rider 0 rider-handle)) *target*)))))))
+           (cond
+             ((and long-view? (or (= status 'loaded) (= status 'alive) (= status 'active)))
+              (load-state-want-display-level other 'display)
+              (load-state-want-display-level 'village1 'display)
+              ;; out at sea neither bsp can work out visibility, so draw both whole
+              (load-state-want-vis (if (= (-> self primary) other)
+                                       (case other (('misty) 'mis) (('training) 'tra) (('beach) 'bea) (('village2) 'vi2) (('swamp) 'swa) (else 'jun))
+                                       'vi1))
+              (load-state-want-force-vis other #t)
+              (load-state-want-force-vis 'village1 #t))
+             ((and (= (-> self primary) other) (or (= status 'loaded) (= status 'alive) (= status 'active)))
+              (load-state-want-display-level other 'display)
+              ;; Beach and Jungle border Sandover and show alongside it in full, like the stock load boundaries.
+              (load-state-want-display-level 'village1 (if (or (= other 'beach) (= other 'jungle)) 'display 'special))
+              (load-state-want-vis (case other (('misty) 'mis) (('training) 'tra) (('beach) 'bea) (('village2) 'vi2) (('swamp) 'swa) (else 'jun)))
+              (load-state-want-force-vis other #t))
+             (else
+              ;; still loading, or Sandover is closer: village1 in full, the far island as its low-res model
+              (load-state-want-display-level 'village1 'display)
+              (load-state-want-display-level other #f)
+              (load-state-want-vis 'vi1)
+              (load-state-want-force-vis 'village1 #t))))))))
+  0
+  (none))
+
+(defbehavior ios-ocean-shark-depth-tint ios-ocean-shark ()
+  "Darken with depth, like sharkey common-post."
+  (let ((f0-2 (fmax 0.0 (fmin 1.0 (- 1.0 (/ (- -36864.0 (-> self root trans y)) (meters 3)))))))
+    (set-vector! (-> self draw color-mult) f0-2 f0-2 f0-2 1.0))
+  0
+  (none))
+
+(defun ios-ocean-jak-aboard? ((boat fishermans-boat))
+  "Jak at the wheel or standing on the boat (its only sticky rider slot)."
+  (and boat
+       *target*
+       (or *ios-boat-driving*
+           (let ((riders (-> boat root-overlay riders)))
+             (and (nonzero? riders)
+                  (> (-> riders num-riders) 0)
+                  (= (handle->process (-> riders rider 0 rider-handle)) *target*))))))
+
+;; Fog bank over the hand-over between Sandover and Rock Village (coastline-plan.md phase 5; moved here from the
+;; Boggy Swamp hand-over 2026-10-22: this is where the sky and the water colour change): where the jungle + Rock
+;; Village pair takes over from Sandover (or back), Jak is inside thick fog, and the pair only switches while it is
+;; at full strength and it stays until the arriving level is in (ios-ocean-update-levels, *ios-sea-fog-hold-until*),
+;; so the change is never seen. Band: Jak's distance to Rock Village near IOS_SEA_FOG_CENTER, with the jungle the
+;; nearest island of the north (the stretch down the east coast).
+(defconstant IOS_SEA_FOG_START (meters 10))
+(defconstant IOS_SEA_FOG_END (meters 110))  ;; was 45 m: that turned the fog bank's clouds into flat fog colour
+;; fog colour (PS2 0-255 scale): a cool grey by day, dark blue-grey at night - the same on both sides of the swap
+(define *ios-sea-fog-day* (new 'static 'vector :x 150.0 :y 158.0 :z 166.0 :w 128.0))
+(define *ios-sea-fog-night* (new 'static 'vector :x 36.0 :y 42.0 :z 54.0 :w 128.0))
+;; the Glacier's fog ring (IOS_GLACIER_FOG_RING): white by day, pale blue-grey at night; *ios-sea-fog-white* (0..1,
+;; eased) is how much of the fog is the glacier's
+(define *ios-glacier-fog-day* (new 'static 'vector :x 232.0 :y 236.0 :z 242.0 :w 128.0))
+(define *ios-glacier-fog-night* (new 'static 'vector :x 104.0 :y 110.0 :z 124.0 :w 128.0))
+(define-perm *ios-sea-fog-white* float 0.0)
+;; current strength 0..1, eased so it never pops (define-perm: survives VI1 relinks)
+(define-perm *ios-sea-fog* float 0.0)
+;; the levels' own mood functions while ios-sea-fog-mood-func stands in for them (one per level slot)
+(define-perm *ios-sea-fog-orig-mood-0* (function mood-context float int none) #f)
+(define-perm *ios-sea-fog-orig-mood-1* (function mood-context float int none) #f)
+;; the Open Ocean storm (pc/ios/ios-open-ocean.gc) wraps the mood functions the same way; the fog goes under it
+(define-extern ios-storm-mood-func (function mood-context float int none))
+(define-extern *ios-storm-orig-mood-0* (function mood-context float int none))
+(define-extern *ios-storm-orig-mood-1* (function mood-context float int none))
+
+(defun ios-sea-fog-apply ((m mood-context) (time float))
+  "Pull the mood's fog in close and turn its fog + horizon colour to the sea fog's, by *ios-sea-fog*."
+  (let* ((f *ios-sea-fog*)
+         (day (fmax 0.0 (fmin 1.0 (* 1.5 (sin (* 16384.0 (/ (- time 6.0) 6.0)))))))  ;; 0 night .. 1 midday
+         (col (vector4-lerp! (new 'stack-no-clear 'vector) *ios-sea-fog-night* *ios-sea-fog-day* day))
+         (fog (-> m current-fog)))
+    (when (< 0.0 *ios-sea-fog-white*)
+      (let ((white (vector4-lerp! (new 'stack-no-clear 'vector) *ios-glacier-fog-night* *ios-glacier-fog-day* day)))
+        (vector4-lerp! col col white *ios-sea-fog-white*)))
+    (vector4-lerp! (-> fog fog-color) (-> fog fog-color) col f)
+    (vector4-lerp! (-> fog erase-color) (-> fog erase-color) col f)
+    (set! (-> fog fog-dists x) (lerp (-> fog fog-dists x) IOS_SEA_FOG_START f))
+    (set! (-> fog fog-dists y) (lerp (-> fog fog-dists y) IOS_SEA_FOG_END f))
+    (set! (-> fog fog-dists w) (lerp (-> fog fog-dists w) 0.0 f)))
+  0)
+
+(defun ios-sea-look-weights ()
+  "Called from slot 0's mood function, after update-time-of-day has read slot 0's level-distance and before it reads
+   slot 1's: the two moods are blended by level-distance (weight of slot 1 = d0 / (d0 + d1)), so setting slot 1's
+   picks the blend. Down the east coast with Rock Village in ('mid) its sky and light are used in full, not blended
+   with the jungle's; with Boggy Swamp in ('south) Rock Village's too until the swamp is within ~650 m, easing to the
+   stock blend by 300 m. So Rock Village's whole look is there as you leave the fog, not drifting in afterwards."
+  (let* ((l0 (-> *level* level 0))
+         (l1 (-> *level* level 1))
+         (v2-slot (cond ((= (-> l0 name) 'village2) 0) ((= (-> l1 name) 'village2) 1) (else -1))))
+    (when (and (>= v2-slot 0) (= (-> l0 status) 'active) (= (-> l1 status) 'active))
+      (let* ((d0 (fmax (meters 1) (-> l0 level-distance)))
+             (d1 (fmax (meters 1) (-> l1 level-distance)))
+             (stock-w1 (/ d0 (+ d0 d1)))
+             (stock-v2 (if (= v2-slot 1) stock-w1 (- 1.0 stock-w1)))
+             (t (if (= *ios-sea-look* 'south)
+                    (fmax 0.0 (fmin 1.0 (/ (- (ios-sea-distance (math-camera-pos) IOS_SEA_SWAMP_X IOS_SEA_SWAMP_Z)
+                                               (meters 300))
+                                            (meters 350))))
+                    1.0))
+             (v2 (lerp stock-v2 1.0 t))
+             (w1 (fmax 0.001 (fmin 0.999 (if (= v2-slot 1) v2 (- 1.0 v2))))))
+        (set! (-> l1 level-distance) (/ (* d0 (- 1.0 w1)) w1)))))
+  0)
+
+(defun ios-sea-fog-mood-func ((m mood-context) (time float) (slot int))
+  (let ((orig (if (zero? slot) *ios-sea-fog-orig-mood-0* *ios-sea-fog-orig-mood-1*)))
+    (if orig (orig m time slot)))
+  (if (< 0.0 *ios-sea-fog*) (ios-sea-fog-apply m time))
+  (if (and *ios-sea-look* (zero? slot)) (ios-sea-look-weights))
+  (none))
+
+(defun ios-sea-fog-hook-moods ()
+  "While there is sea fog, ios-sea-fog-mood-func stands in for both loaded levels' mood functions (under the
+   storm's, when a storm has them); with none, the levels' own are put back."
+  (dotimes (slot 2)
+    (let* ((lev (-> *level* level slot))
+           (stormed (and (nonzero? ios-storm-mood-func) (= (-> lev mood-func) ios-storm-mood-func)))
+           ;; the function the fog wraps or replaces: the level's, or the storm's saved original
+           (cur (cond
+                  ((not stormed) (-> lev mood-func))
+                  ((zero? slot) *ios-storm-orig-mood-0*)
+                  (else *ios-storm-orig-mood-1*))))
+      (cond
+        ((or (< 0.0 *ios-sea-fog*) *ios-sea-look*)
+         (when (and cur (nonzero? cur) (!= cur ios-sea-fog-mood-func))
+           (if (zero? slot)
+             (set! *ios-sea-fog-orig-mood-0* cur)
+             (set! *ios-sea-fog-orig-mood-1* cur))
+           (cond
+             ((not stormed) (set! (-> lev mood-func) ios-sea-fog-mood-func))
+             ((zero? slot) (set! *ios-storm-orig-mood-0* ios-sea-fog-mood-func))
+             (else (set! *ios-storm-orig-mood-1* ios-sea-fog-mood-func)))))
+        ((= cur ios-sea-fog-mood-func)
+         (let ((orig (if (zero? slot) *ios-sea-fog-orig-mood-0* *ios-sea-fog-orig-mood-1*)))
+           (cond
+             ((not stormed) (set! (-> lev mood-func) orig))
+             ((zero? slot) (set! *ios-storm-orig-mood-0* orig))
+             (else (set! *ios-storm-orig-mood-1* orig))))))))
+  0)
+
+;; The fog bank seen from afar (user 2026-10-22: it only appeared once Jak was in it). Big soft clouds stand on the
+;; band itself - the arc IOS_SEA_FOG_CENTER from Rock Village across the sea east of the coast - from the water up
+;; to ~45 m, so it is visible as a wall of fog from up to ~1.1 km away and you sail into it. Few and large (cheap:
+;; ~75 sprites), fairly see-through. The same clouds thicken around Jak as he sails in (IOS_FOG_BANK_CLOSE_RATE), with
+;; the distance fog (ios-sea-fog-apply) kept loose enough that they stay visible.
+;; Parts 2977-2979. (The Open Ocean mist that used to stand in near the camera is gone.)
+(defconstant IOS_FOG_BANK_RATE 5.0)           ;; clouds per second (each ~15 s; halved 2026-10-22: too thick)
+(defconstant IOS_FOG_BANK_SEE (meters 1100))   ;; launched within this distance of the camera
+(defconstant IOS_FOG_BANK_NEAR (meters 8))     ;; not right on the camera
+;; One kind of fog (user 2026-10-22: the far clouds vanished as Jak reached them, a second kind took over): as the
+;; fog thickens around Jak (*ios-sea-fog*) more of the same clouds are launched on the band close around the camera
+(defconstant IOS_FOG_BANK_CLOSE_RATE 8.0)      ;; extra clouds per second at full fog
+(defconstant IOS_FOG_BANK_CLOSE (meters 220))
+(defconstant IOS_FOG_BANK_DEPTH (meters 70))   ;; +- across the band
+
+;; No cloud may reach into the water (user 2026-10-24: blocky straight edges where the fog met the sea): a sprite is a
+;; camera-facing quad of +-0.5 x its scale, so a cloud centred low hung metres below the waves and the depth test cut
+;; it off along the waterline. The puff texture is round, so only the circle of radius scale / 2 is visible: every
+;; cloud's size is chosen at launch (ios-sea-fog-bank-launch) and it is placed with that circle, fully grown, above the
+;; wave crests. Two kinds: tall round clouds (2977) above, and wide flat streaks lying on the water (2980) below them.
+(defconstant IOS_FOG_BANK_CLEAR_WATER (meters 1.8))  ;; lowest visible edge over mean sea (waves reach 1.3 m)
+(defconstant IOS_FOG_BANK_GROWTH (meters 18))        ;; most a cloud grows over its life (scalevel x 15 s)
+(defconstant IOS_FOG_BANK_FLAT_SHARE 0.55)           ;; share of the clouds that are low flat streaks
+(defconstant IOS_FOG_BANK_FLAT_RISE (meters 14))     ;; flat streaks: how far above the lowest spot they may sit
+(defconstant IOS_FOG_BANK_TALL_RISE (meters 20))     ;; tall clouds: the same
+
