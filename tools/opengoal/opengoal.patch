+;; The ocean is only drawn properly over the active ocean map: 48 x 48 tiles of 96 m from its start-corner (see
+;; render-ocean-far; past it only the flat far ring). Sandover's map spans x/z -2304..2304 m, Rock Village's (also
+;; Boggy Swamp) x -1927..2681 m, z -3896..712 m. The boat stops this far inside the outer edges, which still leaves
+;; ~550 m of open sea past Geyser Rock, ~800 m past Misty and ~1400 m past the swamp.
+(defconstant IOS_OCEAN_MAP_SIZE (meters 4608))
+(defconstant IOS_SEA_EDGE_MARGIN (meters 500))
+(define-extern *ios-glacier-warp* symbol)
+(define-extern ios-brume-here? (function symbol))
+;; The TURN AROUND warning stays up until the boat is this far back inside the boundary.
+(defconstant IOS_SEA_EDGE_WARN_CLEAR (meters 40))
+
+(defbehavior fishermans-boat-ios-sea-edge fishermans-boat ()
+  "og:ios driveable boat: invisible boundary near the outer edges of the ocean (user 2026-10-18). Moving out across
+   it stops the boat dead (the engine keeps running, so the boat can still turn) and it can go no further until it
+   heads back in. Only the outer edges: the Sandover map's south edge and Rock Village's north edge are crossed on
+   the way between them, after the ocean manager has switched levels (and so maps)."
+  (let ((map *ocean-map*))
+    (when map
+      (let* ((rb (-> self rbody))
+             (pos (-> self root-overlay trans))
+             (south? (or (= map *ocean-map-village2*) (= map *ocean-map-sunken*)))
+             (x0 (+ (-> map start-corner x) IOS_SEA_EDGE_MARGIN))
+             (x1 (- (+ (-> map start-corner x) IOS_OCEAN_MAP_SIZE) IOS_SEA_EDGE_MARGIN))
+             (z0 (+ (-> map start-corner z) IOS_SEA_EDGE_MARGIN))
+             (z1 (- (+ (-> map start-corner z) IOS_OCEAN_MAP_SIZE) IOS_SEA_EDGE_MARGIN))
+             (back (new 'stack-no-clear 'vector)))
+        ;; back: from the boat to the nearest point inside the boundary
+        (set-vector! back 0.0 0.0 0.0 0.0)
+        (cond
+          ((< (-> pos x) x0) (set! (-> back x) (- x0 (-> pos x))))
+          ((< x1 (-> pos x)) (set! (-> back x) (- x1 (-> pos x)))))
+        (cond
+          ((and south? (< (-> pos z) z0)) (set! (-> back z) (- z0 (-> pos z))))
+          ((and (not south?) (< z1 (-> pos z))) (set! (-> back z) (- z1 (-> pos z)))))
+        ;; any outward motion past the line: stop, then ease back to the line (at most 2 m/s), so the thrust can't
+        ;; creep the boat further out step by step. Spin is left alone, so steering still turns the boat around.
+        (when (and (< 0.0 (vector-length back)) (< (vector-dot (-> rb lin-velocity) back) 0.0))
+          (set! *ios-sea-edge-warning* #t)
+          (let ((ease (vector-normalize-copy! (new 'stack-no-clear 'vector) back (fmin (meters 2) (vector-length back)))))
+            (set! (-> rb lin-velocity x) (-> ease x))
+            (set! (-> rb lin-velocity z) (-> ease z))
+            (set! (-> rb lin-momentum x) (* (-> rb mass) (-> ease x)))
+            (set! (-> rb lin-momentum z) (* (-> rb mass) (-> ease z)))))
+        ;; distance inside the nearest applicable edge (negative past it): the warning clears once well inside
+        (when *ios-sea-edge-warning*
+          (let ((inside (fmin (- (-> pos x) x0) (- x1 (-> pos x)))))
+            (set! inside (fmin inside (if south? (- (-> pos z) z0) (- z1 (-> pos z)))))
+            (if (< IOS_SEA_EDGE_WARN_CLEAR inside) (set! *ios-sea-edge-warning* #f)))))))
+  0
+  (none))
+
