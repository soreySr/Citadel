+;;
+;; Linked as a startup object (aot_level_code_link.py --startup-object ios-action-menu, after ios-green-eco): its
+;; top-level runs once at boot and chains the per-frame update into *menu-hook*.
+
+;; written by the host every frame: the Action menu is on screen
+(define-perm *ios-action-menu-open* symbol #f)
+;; read by the host every frame: the menu may open now (plain gameplay, Jak free, nothing else up)
+(define-perm *ios-action-menu-allowed* symbol #f)
+
+;; ios-fishing.gc (linked after this file): fishing mode is on
+(define-extern *ios-fishing-active* symbol)
+
+
+;; ---- what to draw (written by the host, OpenGOALRuntimeHost.mm SyncActionMenu) --------------------------------
+
+(defconstant IOS_ACTION_MENU_MAX 8)
+
+(deftype ios-action-menu-view (structure)
+  ((count      int32  :offset 0)
+   (selection  int32  :offset 4)
+   (controller int32  :offset 8)   ;; 1: a controller is connected (pad hints), 0: touch
+   (available  uint32 :offset 12)  ;; bit per entry
+   (titles     string 8 :offset 16) ;; game-encoded text, filled in place by the host
+   (hints      string 8 :offset 48))
+  :size-assert #x50)
+
+(define *ios-action-menu-view* (new 'global 'ios-action-menu-view))
+(set! (-> *ios-action-menu-view* count) 0)
+(dotimes (i IOS_ACTION_MENU_MAX)
+  (set! (-> *ios-action-menu-view* titles i) (new 'global 'string 48 (the-as string #f)))
+  (set! (-> *ios-action-menu-view* hints i) (new 'global 'string 64 (the-as string #f))))
+
+;; ---- drawing (debug bucket, 512 x 224 screen units stretched over the view, like the menus) --------------------
+
+(defconstant IOS_ACTION_MENU_SEGMENTS 40)
+
+(defun ios-am-vertex ((buf dma-buffer) (x float) (y float) (color rgba))
+  "One rgbaq + xyzf2 pair, x y in 512 x 224 screen units."
+  (let ((c (new 'stack-no-clear 'vector4w))
+        (v (new 'stack-no-clear 'vector4w)))
+    (set-vector! c (the int (-> color r)) (the int (-> color g)) (the int (-> color b)) (the int (-> color a)))
+    (set-vector! v
+                 (the int (* 16.0 (+ 1792.0 x)))
+                 (the int (* 16.0 (+ (the float (-> *video-parms* screen-miny)) y)))
+                 #xffffff
+                 0)
+    (dma-buffer-add-uint128 buf (-> c quad) (-> v quad)))
+  0)
+
+(defun ios-am-rgba ((r float) (g float) (b float) (a int))
+  "An rgba value from (unclamped) float channels."
+  (the-as rgba (logior (max 0 (min 255 (the int r)))
+                       (ash (max 0 (min 255 (the int g))) 8)
+                       (ash (max 0 (min 255 (the int b))) 16)
+                       (ash (max 0 (min 255 a)) 24))))
+
+(defun ios-am-lerp-color ((a rgba) (b rgba) (t float))
+  (ios-am-rgba (lerp (the float (-> a r)) (the float (-> b r)) t)
+               (lerp (the float (-> a g)) (the float (-> b g)) t)
+               (lerp (the float (-> a b)) (the float (-> b b)) t)
+               (the int (lerp (the float (-> a a)) (the float (-> b a)) t))))
+
+(defun ios-am-disc ((buf dma-buffer) (cx float) (cy float) (rx float) (ry float) (inner rgba) (outer rgba))
+  "Filled ellipse (a circle on screen), INNER colour at the centre shading to OUTER at the rim."
+  (with-cnt-vif-block (buf)
+    (dma-buffer-add-gif-tag buf
+                            (new 'static 'gif-tag64
+                                 :nloop (+ IOS_ACTION_MENU_SEGMENTS 2)
+                                 :eop 1
+                                 :pre 1
+                                 :prim (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :iip 1 :abe 1)
+                                 :nreg 2)
+                            (gs-reg-list rgbaq xyzf2))
+    (ios-am-vertex buf cx cy inner)
+    (dotimes (k (+ IOS_ACTION_MENU_SEGMENTS 1))
+      (let ((angle (* 65536.0 (/ (the float k) (the float IOS_ACTION_MENU_SEGMENTS)))))
+        (ios-am-vertex buf (+ cx (* rx (cos angle))) (+ cy (* ry (sin angle))) outer))))
+  0)
+
+(defun ios-am-ring ((buf dma-buffer) (cx float) (cy float) (rx float) (ry float) (width float) (bright rgba))
+  "A ring WIDTH units thick inside the rim, lit like a bronze edge: BRIGHT, mid, dark, mid twice around (mid and
+   dark are BRIGHT at 76% and 32%)."
+  (let ((mid (ios-am-rgba (* 0.76 (the float (-> bright r))) (* 0.6 (the float (-> bright g)))
+                          (* 0.45 (the float (-> bright b))) (the int (-> bright a))))
+        (dark (ios-am-rgba (* 0.32 (the float (-> bright r))) (* 0.22 (the float (-> bright g)))
+                           (* 0.14 (the float (-> bright b))) (the int (-> bright a))))
+        (thin (/ (* width rx) ry)))
+    (with-cnt-vif-block (buf)
+      (dma-buffer-add-gif-tag buf
+                              (new 'static 'gif-tag64
+                                   :nloop (* 2 (+ IOS_ACTION_MENU_SEGMENTS 1))
+                                   :eop 1
+                                   :pre 1
+                                   :prim (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip 1 :abe 1)
+                                   :nreg 2)
+                              (gs-reg-list rgbaq xyzf2))
+      (dotimes (k (+ IOS_ACTION_MENU_SEGMENTS 1))
+        (let* ((angle (* 65536.0 (/ (the float k) (the float IOS_ACTION_MENU_SEGMENTS))))
+               (light (cos (* 2.0 (+ angle 8192.0))))
+               (color (if (< 0.0 light) (ios-am-lerp-color mid bright light) (ios-am-lerp-color mid dark (- light)))))
+          (ios-am-vertex buf (+ cx (* rx (cos angle))) (+ cy (* ry (sin angle))) color)
+          (ios-am-vertex buf (+ cx (* (- rx thin) (cos angle))) (+ cy (* (- ry width) (sin angle))) color)))))
+  0)
+
+(defun ios-am-triangle ((buf dma-buffer) (x0 float) (y0 float) (x1 float) (y1 float) (x2 float) (y2 float) (color rgba))
+  (with-cnt-vif-block (buf)
+    (dma-buffer-add-gif-tag buf
+                            (new 'static 'gif-tag64
+                                 :nloop 3
+                                 :eop 1
+                                 :pre 1
+                                 :prim (new 'static 'gs-prim :prim (gs-prim-type tri) :abe 1)
+                                 :nreg 2)
+                            (gs-reg-list rgbaq xyzf2))
+    (ios-am-vertex buf x0 y0 color)
+    (ios-am-vertex buf x1 y1 color)
+    (ios-am-vertex buf x2 y2 color))
+  0)
+
+(defun ios-am-text ((str string) (x float) (y float) (scale float) (color font-color) (alpha int))
+  "STR centred on x y, in the game font."
+  (let ((font (new 'stack 'font-context *font-default-matrix* (the int (- x 160.0)) (the int (- y 20.0)) 0.0 color
+                   (font-flags shadow kerning))))
+    (set-width! font 320)
+    (set-height! font 40)
+    (set-scale! font scale)
+    (set! (-> font flags) (font-flags shadow kerning middle middle-vert large))
+    (print-game-text str font #f alpha 22))
+  0)
+
+(defun ios-action-menu-draw ()
+  (let* ((view *ios-action-menu-view*)
+         (count (-> view count))
+         (cx 256.0)
+         (cy 112.0)
+         (ry 96.0)
+         ;; screen units are 512 wide and 224 high however wide the view is: keep the disc round
+         (rx (/ (* ry 512.0) (* 224.0 (fmax 0.5 (-> *pc-settings* aspect-ratio))))))
+    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug))
+      (dma-buffer-add-gs-set buf
+                             (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest always)))
+                             (zbuf-1 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24) :zmsk #x1))
+                             (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)))
+      ;; the whole view dimmed
+      (ios-am-disc buf cx cy 1000.0 1000.0 (new 'static 'rgba :a #x34) (new 'static 'rgba :a #x34))
+      ;; dark socket, orange glass, bronze rim and its inner glow line
+      (ios-am-disc buf cx cy rx ry (new 'static 'rgba :r #x52 :g #x30 :b #x1a :a #x78) (new 'static 'rgba :r #x1a :g #xd :b #x5 :a #x78))
+      (ios-am-disc buf cx cy (* 0.94 rx) (* 0.94 ry)
+                   (new 'static 'rgba :r #xff :g #xa8 :b #x4d :a #x3a) (new 'static 'rgba :r #xcc :g #x57 :b #x14 :a #x29))
+      (ios-am-ring buf cx cy rx ry 3.0 (new 'static 'rgba :r #xf2 :g #xb8 :b #x6b :a #x80))
+      (ios-am-ring buf cx cy (- rx (/ (* 4.5 rx) ry)) (- ry 4.5) 0.7 (new 'static 'rgba :r #xff :g #x9e :b #x38 :a #x30))
+      ;; carousel arrows and dots with 2+ entries
+      (when (< 1 count)
+        (let ((arrow (new 'static 'rgba :r #xfa :g #xc0 :b #x40 :a #x80))
+              (ax (* 0.72 rx))
+              (ay (+ cy -6.0)))
+          (ios-am-triangle buf (- cx ax) ay (+ (- cx ax) 6.0) (+ ay -6.0) (+ (- cx ax) 6.0) (+ ay 6.0) arrow)
+          (ios-am-triangle buf (+ cx ax) ay (- (+ cx ax) 6.0) (+ ay -6.0) (- (+ cx ax) 6.0) (+ ay 6.0) arrow)
+          (dotimes (i count)
+            (let ((dx (+ cx (* 6.0 (- (the float i) (* 0.5 (the float (+ count -1))))))))
+              (ios-am-disc buf dx (+ cy 34.0) 1.6 1.6
+                           (if (= i (-> view selection))
+                             (new 'static 'rgba :r #xff :g #x9e :b #x38 :a #x80)
+                             (new 'static 'rgba :r #x4d :g #x29 :b #xf :a #x80))
+                           (if (= i (-> view selection))
+                             (new 'static 'rgba :r #xff :g #x9e :b #x38 :a #x80)
+                             (new 'static 'rgba :r #x4d :g #x29 :b #xf :a #x80)))))))
+      ;; back to what the debug bucket's text and HUD expect
+      (dma-buffer-add-gs-set buf (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest always)))))
+    ;; text, after the shapes so it is drawn over them
+    (ios-am-text "ACTIONS" cx (+ cy (* -0.68 ry)) 0.8 (font-color progress-yellow) 128)
+    (when (< 0 count)
+      (let* ((sel (max 0 (min (+ count -1) (-> view selection))))
+             (available (logtest? (-> view available) (ash 1 sel))))
+        (ios-am-text (-> view titles sel) cx (+ cy -6.0) 1.0 (font-color default) (if available 128 64))
+        (when (< 1 count)
+          (ios-am-text (-> view titles (mod (+ sel 1) count)) (+ cx (* 0.48 rx)) (+ cy -6.0) 0.5 (font-color default) 56)
+          (if (< 2 count)
+            (ios-am-text (-> view titles (mod (+ sel count -1) count)) (- cx (* 0.48 rx)) (+ cy -6.0) 0.5
+                         (font-color default) 56)))
+        (if (not available)
+          (ios-am-text (-> view hints sel) cx (+ cy 18.0) 0.5 (font-color progress-blue) 128))))
+    ;; <PAD_X> / <PAD_CIRCLE> in the game font (common/util/font/dbs/font_db_jak1.cpp)
+    (ios-am-text (if (= (-> view controller) 1)
+                   "~Y~22L<~Z~Y~27L*~Z~Y~1L>~Z~Y~23L[~Z~+26H SELECT   ~Y~22L<~Z~Y~25L@~Z~Y~1L>~Z~Y~23L[~Z~+26H CLOSE"
+                   "TAP TO SELECT")
+                 cx
+                 (+ cy (* 0.6 ry))
+                 0.5
+                 (font-color default)
+                 128))
+  0)
+
+(define *ios-action-menu-health* 0.0)
+
+(defun ios-action-menu-hurt? ()
+  "Jak is being hit or dying, or lost health since the last frame."
+  (let* ((state (-> *target* next-state))
+         (health (-> *target* fact health))
+         (hurt (or (< health *ios-action-menu-health*)
+                   (and state (member (-> state name) '(target-hit target-death))))))
+    (set! *ios-action-menu-health* health)
+    hurt))
+
+;; fishermans-boat.gc: Jak is at the free boat's wheel
+(define-extern *ios-boat-driving* symbol)
+
+(defun ios-action-menu-on-foot? ()
+  "Jak is in the standard walking-around mode (user 2026-10-22: no ACTION button / L1 menu while driving the boat or in
+   any other mode): one of the plain on-foot states, nothing has grabbed him, not first person, not at the boat's
+   wheel. Flut Flut, zoomer, tube, swimming, ledge / pole, periscope, warp, cutscene states etc. are all left out."
+  (let ((state (-> *target* next-state)))
+    (and state
+         (!= *ios-boat-driving* #t)
+         (not (logtest? (-> *target* state-flags) (state-flags grabbed first-person-mode dying)))
+         (member (-> state name)
+                 '(target-stance target-stance-ambient target-stance-look-around target-walk target-turn-around
+                   target-duck-stance target-duck-walk target-jump target-jump-forward target-double-jump
+                   target-high-jump target-duck-high-jump target-duck-high-jump-jump target-falling target-hit-ground
+                   target-hit-ground-hard target-attack target-attack-air target-attack-uppercut
+                   target-attack-uppercut-jump target-running-attack target-flop target-flop-hit-ground target-wheel
+                   target-wheel-flip target-slide-down target-ice-stance target-ice-walk target-wade-stance
+                   target-wade-walk target-yellow-blast)))))
+
+(defun ios-action-menu-allowed? ()
+  "Plain gameplay: master mode 'game, no menu, no cutscene or fade (the pause menu would be allowed too), not fishing,
+   Jak isn't being hurt and he is on foot."
+  (and *target*
+       (ios-action-menu-on-foot?)
+       (= *master-mode* 'game)
+       (!= *ios-fishing-active* #t)
+       (not *progress-process*)
+       (not (level-get *level* 'title))
+       (progress-allowed?)
+       (pause-allowed?)
+       (not (ios-action-menu-hurt?))))
+
+(defun ios-action-menu-update ()
+  ;; The game keeps running while the menu is up (user 2026-10-17: no pause); the app gives it a neutral pad meanwhile.
+  ;; Allowed turns false as soon as Jak is hurt (or anything else takes over), which makes the app close the menu and
+  ;; hand the controls back at once.
+  (set! *ios-action-menu-allowed* (if (ios-action-menu-allowed?) #t #f))
+  (if (and (= *ios-action-menu-open* #t) (= *ios-action-menu-allowed* #t))
+    (ios-action-menu-draw))
+  0)
+
+;; ---- Boat menu (boat-upgrades-plan.md phase 4) ------------------------------------------------------------------
+;; R2 / BOAT at the boat's wheel opens it (Jak1MetalView updateBoatMenu). Left: BOAT LVL and the level (MAX LVL at
+;; the top level). Right: the power cells the next level needs, how many Jak has, and the UPGRADE button, grayed out
+;; while he has too few; hidden at the top level. All values are written by the host (SyncBoatMenu) every frame.
+
+(deftype ios-boat-menu-view (structure)
+  ((open        int32 :offset 0)   ;; 1: the menu is on screen
+   (level       int32 :offset 4)   ;; 1..max-level
+   (max-level   int32 :offset 8)
+   (cost        int32 :offset 12)  ;; power cells needed for the next level (0 at max)
+   (cells       int32 :offset 16)  ;; power cells collected
+   (controller  int32 :offset 20)  ;; 1: a controller is connected (pad hints), 0: touch
+   (flash       float :offset 24)  ;; 1 -> 0 over ~0.9 s after an upgrade: glow behind the level
+   (event       int32 :offset 28)) ;; set for one frame: 1 upgraded, 2 not enough power cells
+  :size-assert #x20)
+
+(define *ios-boat-menu-view* (new 'global 'ios-boat-menu-view))
+(set! (-> *ios-boat-menu-view* open) 0)
+(set! (-> *ios-boat-menu-view* level) 1)
+(set! (-> *ios-boat-menu-view* max-level) 6)
+(set! (-> *ios-boat-menu-view* flash) 0.0)
+(define *ios-boat-menu-text* (new 'global 'string 64 (the-as string #f)))
+
+(defun ios-am-rect ((buf dma-buffer) (x0 float) (y0 float) (x1 float) (y1 float) (top rgba) (bottom rgba))
+  "Filled rectangle, TOP colour shading to BOTTOM."
+  (with-cnt-vif-block (buf)
+    (dma-buffer-add-gif-tag buf
+                            (new 'static 'gif-tag64
+                                 :nloop 4
+                                 :eop 1
+                                 :pre 1
+                                 :prim (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip 1 :abe 1)
+                                 :nreg 2)
+                            (gs-reg-list rgbaq xyzf2))
+    (ios-am-vertex buf x0 y0 top)
+    (ios-am-vertex buf x1 y0 top)
+    (ios-am-vertex buf x0 y1 bottom)
+    (ios-am-vertex buf x1 y1 bottom))
+  0)
+
+(defun ios-am-frame ((buf dma-buffer) (x0 float) (y0 float) (x1 float) (y1 float) (width float) (bright rgba))
+  "A bronze edge WIDTH units thick inside the rectangle: BRIGHT along the top, darker down the sides and bottom
+   (as ios-am-ring lights its rim). WIDTH is in screen-height units; sides are scaled to look as thick."
+  (let ((mid (ios-am-rgba (* 0.76 (the float (-> bright r))) (* 0.6 (the float (-> bright g)))
+                          (* 0.45 (the float (-> bright b))) (the int (-> bright a))))
+        (dark (ios-am-rgba (* 0.32 (the float (-> bright r))) (* 0.22 (the float (-> bright g)))
+                           (* 0.14 (the float (-> bright b))) (the int (-> bright a))))
+        (side (/ (* width 224.0 (fmax 0.5 (-> *pc-settings* aspect-ratio))) 512.0)))
+    (ios-am-rect buf x0 y0 x1 (+ y0 width) bright bright)
+    (ios-am-rect buf x0 (- y1 width) x1 y1 dark dark)
+    (ios-am-rect buf x0 y0 (+ x0 side) y1 bright dark)
+    (ios-am-rect buf (- x1 side) y0 x1 y1 mid dark))
+  0)
+
+(defun ios-boat-menu-number ((n int))
+  "N as text, in the shared scratch string."
+  (format (clear *ios-boat-menu-text*) "~D" n)
+  *ios-boat-menu-text*)
+
+(defun ios-boat-menu-draw ()
+  (let* ((view *ios-boat-menu-view*)
+         (at-max (>= (-> view level) (-> view max-level)))
+         (can-upgrade (and (not at-max) (< 0 (-> view cost)) (>= (-> view cells) (-> view cost))))
+         (flash (fmax 0.0 (fmin 1.0 (-> view flash))))
+         (cx 256.0)
+         (cy 112.0)
+         (hh 62.0)
+         ;; screen units are 512 wide and 224 high however wide the view is: the panel is ~2.1x as wide as tall on
+         ;; screen at max level's narrow layout, ~2.6x with the cells side
+         (aspect (/ 512.0 (* 224.0 (fmax 0.5 (-> *pc-settings* aspect-ratio)))))
+         (hw (fmin 236.0 (* hh aspect (if at-max 1.3 2.6))))
+         (x0 (- cx hw))
+         (x1 (+ cx hw))
+         (y0 (- cy hh))
+         (y1 (+ cy hh))
+         ;; left column centre (the whole panel at max level), right column centre
+         (lx (if at-max cx (- cx (* 0.5 hw))))
+         (rx (+ cx (* 0.5 hw)))
+         ;; UPGRADE button
+         (bw (* 0.34 hw))
+         (by (+ cy 30.0))
+         (bh 11.0))
+    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug))
+      (dma-buffer-add-gs-set buf
+                             (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest always)))
+                             (zbuf-1 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24) :zmsk #x1))
+                             (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)))
+      ;; the whole view dimmed
+      (ios-am-rect buf -10.0 -10.0 522.0 234.0 (new 'static 'rgba :a #x34) (new 'static 'rgba :a #x34))
+      ;; dark socket, orange glass, bronze frame and its inner glow line (as the Action menu's disc)
+      (ios-am-rect buf x0 y0 x1 y1 (new 'static 'rgba :r #x52 :g #x30 :b #x1a :a #x78) (new 'static 'rgba :r #x1a :g #xd :b #x5 :a #x78))
+      (ios-am-rect buf (+ x0 3.0) (+ y0 3.0) (- x1 3.0) (- y1 3.0)
+                   (new 'static 'rgba :r #xff :g #xa8 :b #x4d :a #x3a) (new 'static 'rgba :r #xcc :g #x57 :b #x14 :a #x29))
+      (ios-am-frame buf x0 y0 x1 y1 3.0 (new 'static 'rgba :r #xf2 :g #xb8 :b #x6b :a #x80))
+      (ios-am-frame buf (+ x0 5.0) (+ y0 4.5) (- x1 5.0) (- y1 4.5) 0.7 (new 'static 'rgba :r #xff :g #x9e :b #x38 :a #x30))
+      (when (not at-max)
+        ;; divider between the columns
+        (ios-am-rect buf (- cx 0.6) (+ y0 14.0) (+ cx 0.6) (- y1 14.0)
+                     (new 'static 'rgba :r #xf2 :g #xb8 :b #x6b :a #x10) (new 'static 'rgba :r #xf2 :g #xb8 :b #x6b :a #x50))
+        ;; UPGRADE button: lit orange when there are enough cells, gray otherwise
+        (if can-upgrade
+          (begin
+            (ios-am-rect buf (- rx bw) (- by bh) (+ rx bw) (+ by bh)
+                         (new 'static 'rgba :r #xff :g #xb0 :b #x40 :a #x70) (new 'static 'rgba :r #xc0 :g #x5a :b #x10 :a #x70))
+            (ios-am-frame buf (- rx bw) (- by bh) (+ rx bw) (+ by bh) 1.5 (new 'static 'rgba :r #xff :g #xe0 :b #xa0 :a #x80)))
+          (begin
+            (ios-am-rect buf (- rx bw) (- by bh) (+ rx bw) (+ by bh)
+                         (new 'static 'rgba :r #x60 :g #x60 :b #x60 :a #x50) (new 'static 'rgba :r #x30 :g #x30 :b #x30 :a #x50))
+            (ios-am-frame buf (- rx bw) (- by bh) (+ rx bw) (+ by bh) 1.5 (new 'static 'rgba :r #x90 :g #x90 :b #x90 :a #x60)))))
+      ;; after an upgrade: a glow behind the level that fades out
+      (when (< 0.0 flash)
+        (ios-am-disc buf lx (+ cy 6.0) (* 0.42 hh aspect) (* 0.42 hh)
+                     (ios-am-rgba 255.0 220.0 140.0 (the int (* 112.0 flash))) (ios-am-rgba 255.0 140.0 40.0 0)))
+      ;; back to what the debug bucket's text and HUD expect
+      (dma-buffer-add-gs-set buf (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest always)))))
+    ;; text, after the shapes so it is drawn over them
+    (cond
+      (at-max
+        (ios-am-text "BOAT" lx (+ cy -26.0) 0.8 (font-color progress-yellow) 128)
+        (ios-am-text "MAX LVL" lx (+ cy 6.0) 1.3 (font-color default) 128))
+      (else
+        (ios-am-text "BOAT LVL" lx (+ cy -26.0) 0.8 (font-color progress-yellow) 128)
+        (ios-am-text (ios-boat-menu-number (-> view level)) lx (+ cy 8.0) 2.0 (font-color default) 128)
+        (ios-am-text "POWER CELLS" rx (+ cy -40.0) 0.6 (font-color progress-yellow) 128)
+        (ios-am-text (ios-boat-menu-number (-> view cost)) rx (+ cy -18.0) 1.3 (font-color default) 128)
+        (format (clear *ios-boat-menu-text*) "YOU HAVE ~D" (-> view cells))
+        (ios-am-text *ios-boat-menu-text* rx (+ cy 4.0) 0.5 (if can-upgrade (font-color progress-blue) (font-color red)) 128)
+        ;; <PAD_X> before UPGRADE with a controller (glyph codes as the Action menu's hints)
+        (ios-am-text (if (= (-> view controller) 1) "~Y~22L<~Z~Y~27L*~Z~Y~1L>~Z~Y~23L[~Z~+26H UPGRADE" "UPGRADE")
+                     rx by 0.6 (font-color default) (if can-upgrade 128 56))))
+    ;; <PAD_CIRCLE> CLOSE with a controller; touch has its own BACK button
+    (if (= (-> view controller) 1)
+      (ios-am-text "~Y~22L<~Z~Y~25L@~Z~Y~1L>~Z~Y~23L[~Z~+26H CLOSE" cx (+ y1 10.0) 0.5 (font-color default) 128)))
+  0)
+
+(defun ios-boat-menu-update ()
+  "Draw the Boat menu while the app has it open and Jak is still at the wheel in plain gameplay, and play the sound
+   of an upgrade (the power cell pickup's) or of a refused one."
+  (when (and (= (-> *ios-boat-menu-view* open) 1)
+             (= *ios-boat-driving* #t)
+             (= *master-mode* 'game)
+             (not *progress-process*))
+    (case (-> *ios-boat-menu-view* event)
+      ((1) (sound-play "cell-prize"))
+      ((2) (sound-play "yellow-fizzle")))
+    (ios-boat-menu-draw))
+  ;; the host writes the event for one frame only; clear it so a skipped frame can't replay it
+  (set! (-> *ios-boat-menu-view* event) 0)
+  0)
+
+;; Chain into *menu-hook* (after ios-green-eco's). This file's top-level only runs once, at boot.
+(define *ios-action-menu-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-action-menu-menu-hook ()
+  (ios-action-menu-update)
+  (ios-boat-menu-update)
+  (*ios-action-menu-prev-menu-hook*)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-action-menu-menu-hook))
diff --git a/goal_src/jak1/pc/ios/ios-blue-eco-swim.gc b/goal_src/jak1/pc/ios/ios-blue-eco-swim.gc
new file mode 100644
index 000000000..ab4b9a993
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-blue-eco-swim.gc
@@ -0,0 +1,83 @@
+;;-*-Lisp-*-
+(in-package goal)
+(require "engine/target/logic-target.gc")
+(require "engine/target/target2.gc")
+
+;; og:ios Blue eco makes Jak swim and wade faster, like it makes him run faster (swimming also while riding the
+;; Expanded Flut Flut).
+;;
+;; logic-target and target2 are captured engine objects on iOS, so this file is linked as a startup object
+;; (aot_level_code_link.py --startup-object ios-blue-eco-swim). Its top-level runs once at boot: the defbehavior
+;; below replaces the captured build-conversions (called through its symbol), and target-swim-walk gets a new
+;; :code that plays the paddle animation faster.
+
+;; Swim/wade speed and paddle animation multiplier while charged with blue eco.
+(defconstant IOS_BLUE_ECO_SWIM_SCALE 1.5)
+
+(defbehavior ios-blue-eco-charged? target ()
+  (and (= (-> self fact eco-type) (pickup-type eco-blue)) (>= (-> self fact eco-level) 1.0)))
+
+;; Stock build-conversions (logic-target.gc) plus the swim boost.
+(defbehavior build-conversions target ((arg0 vector))
+  (surface-mult! (-> self control current-surface) (-> self control mod-surface) (-> self control surf))
+  (when (and (ios-blue-eco-charged?)
+             (or (= (-> self control mod-surface name) 'run) (= (-> self control mod-surface name) 'jump)))
+    (+! (-> self control current-surface target-speed) 20480.0)
+    (+! (-> self control current-surface transv-max) 20480.0))
+  ;; og:ios swimming (Jak's *swim-mods* and the flut's *flut-ios-swim-mods* are both named 'swim). Jak's swim
+  ;; target-speed follows his paddle animation, which target-swim-walk already plays faster, so only his speed
+  ;; cap is raised. The flut's target-speed is fixed (its paddle animation follows its speed instead).
+  (when (and (= (-> self control mod-surface name) 'swim) (ios-blue-eco-charged?))
+    (set! (-> self control current-surface transv-max) (* IOS_BLUE_ECO_SWIM_SCALE (-> self control current-surface transv-max)))
+    (if (logtest? (-> self control root-prim prim-core action) (collide-action flut))
+      (set! (-> self control current-surface target-speed)
+            (* IOS_BLUE_ECO_SWIM_SCALE (-> self control current-surface target-speed)))))
+  ;; og:ios wading (*wade-mods*): target-wade-walk times its animation from ctrl-xz-vel like running does, so
+  ;; raising the speed speeds up the wade animation too.
+  (when (and (= (-> self control mod-surface name) 'wade) (ios-blue-eco-charged?))
+    (set! (-> self control current-surface target-speed) (* IOS_BLUE_ECO_SWIM_SCALE (-> self control current-surface target-speed)))
+    (set! (-> self control current-surface transv-max) (* IOS_BLUE_ECO_SWIM_SCALE (-> self control current-surface transv-max))))
+  (let ((s5-0 (new-stack-vector0)))
+    (vector-z-quaternion! s5-0 (-> self control quat-for-control))
+    (when (logtest? (-> self control mod-surface flags) (surface-flags dive))
+      (vector-flatten! s5-0 s5-0 (-> self control dynam gravity-normal))
+      (vector-normalize! s5-0 1.0))
+    (forward-up-nopitch->inv-matrix (-> self control c-R-w) s5-0 (-> self control local-normal)))
+  (matrix-transpose! (-> self control w-R-c) (-> self control c-R-w))
+  (vector-matrix*! (-> self control transv-ctrl) arg0 (-> self control w-R-c))
+  (set! (-> self control last-gravity-normal quad) (-> self control gravity-normal quad))
+  (let ((v0-7 (-> self control gravity-normal))) (set! (-> v0-7 quad) (-> self control dynam gravity-normal quad)) v0-7))
+
+(defbehavior ios-swim-anim-rate target ()
+  (if (ios-blue-eco-charged?) IOS_BLUE_ECO_SWIM_SCALE 1.0))
+
+;; Stock target-swim-walk :code (target2.gc) with the paddle animation rate from ios-swim-anim-rate. The swim
+;; target-speed is the animation's alignment delta per frame, so the faster animation also moves Jak faster.
+(set! (-> target-swim-walk code)
+      (lambda :behavior target
+        ()
+        (let ((v1-2 (ja-group)))
+          (cond
+            ((or (= v1-2 eichar-swim-up-ja) (= v1-2 eichar-swim-down-to-up-ja) (= v1-2 eichar-swim-up-to-stance-ja))
+             (ja-channel-push! 1 (seconds 0.3)))
+            ((ja-group? eichar-swim-up-to-stance-ja)
+             (ja-channel-push! 1 (seconds 0.15))
+             (ja-no-eval :group! eichar-swim-walk-ja :num! (seek! max (ios-swim-anim-rate)) :frame-num (ja-aframe (the-as float 19.0) 0))
+             (until (ja-done? 0)
+               (compute-alignment! (-> self align))
+               (if (not (logtest? (-> self align flags) (align-flags disabled)))
+                 (set! (-> self control mod-surface target-speed)
+                       (* (-> self align delta trans z) (-> self control current-surface alignv) (-> *display* frames-per-second))))
+               (suspend)
+               (ja :num! (seek! max (ios-swim-anim-rate)))))
+            (else (ja-channel-push! 1 (seconds 0.15)))))
+        (loop
+          (ja-no-eval :group! eichar-swim-walk-ja :num! (seek! max (ios-swim-anim-rate)) :frame-num 0.0)
+          (until (ja-done? 0)
+            (compute-alignment! (-> self align))
+            (if (not (logtest? (-> self align flags) (align-flags disabled)))
+              (set! (-> self control mod-surface target-speed)
+                    (* (-> self align delta trans z) (-> self control current-surface alignv) (-> *display* frames-per-second))))
+            (suspend)
+            (ja :num! (seek! max (ios-swim-anim-rate)))))
+        (none)))
diff --git a/goal_src/jak1/pc/ios/ios-boat-park.gc b/goal_src/jak1/pc/ios/ios-boat-park.gc
new file mode 100644
index 000000000..da17049b3
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-boat-park.gc
@@ -0,0 +1,280 @@
+;;-*-Lisp-*-
+(in-package goal)
+(require "engine/target/logic-target.gc")
+(require "engine/target/target2.gc")
+
+;; og:ios Driveable Boat (experimental): the boat stays where Jak leaves it, anywhere.
+;;
+;; The boat is a village1 actor, so it only exists while village1 is in one of the two level slots. Its parked
+;; spot is kept in the boat entity's perm (user data), which lives in *game-info*'s perm-list and the save file:
+;; it survives deaths, level changes and save/load. Each frame, while Jak is near the parked spot outside
+;; Sandover, village1 is kept in the level slot Jak is not standing in ('special: only the boat spawns); farther
+;; away that slot goes back to what the stock load boundaries asked for.
+;;
+;; With the boat art resident (free-boat-plan.md phase 3: OpenGOALRuntimeHost.mm LoadResidentBoatArt links the boat code
+;; and art at boot, *ios-boat-art-resident*) none of the village1 juggling below is used: the per-frame update hands
+;; over to ios-free-boat-update (fishermans-boat.gc), which keeps a free boat (no level's actor) at the parked spot
+;; and the ocean manager running, whatever levels are loaded.
+;;
+;; Linked as a startup object (aot_level_code_link.py --startup-object ios-boat-park) so this runs even when
+;; village1 (fishermans-boat.o) was never loaded this session, e.g. a save loaded in Rock Village. The per-frame
+;; update is chained into *menu-hook*: the display loop runs it after the draw hook (render-boundaries) and
+;; before level-update, so a boundary's want-levels can be corrected before the level would be discarded.
+
+(define-extern *ios-driveable-boat* symbol)
+(define-extern *ios-boat-driving* symbol)
+(define-extern *ios-boat-boardable* symbol)
+(define-extern *ios-boat-art-resident* symbol)
+(define-extern ios-free-boat-update (function int))
+(define-extern ios-ocean-transition-fog (function int))
+
+;; fishermans-boat-2 (village1)
+(defconstant IOS_BOAT_PARK_AID 10419)
+;; user-int16 3 holds this while a parked spot is stored (0 in saves from before the option: Sandover's dock)
+(defconstant IOS_BOAT_PARK_MAGIC #x2b0a)
+;; position units in user-int16 0/1 (x, z): 0.25 m, +-8 km
+(defconstant IOS_BOAT_PARK_UNIT (meters 0.25))
+
+;; Jak near the parked spot (xz): keep village1 loaded so the boat exists; farther: give the slot back.
+(defconstant IOS_BOAT_PARK_SPAWN_DIST (meters 90))
+(defconstant IOS_BOAT_PARK_DESPAWN_DIST (meters 120))
+
+;; Rock Village spawn point (user, 2026-10-09): alongside the north dock where Jak stood (317.64, 3.7, -1580.82).
+;; The dock's north edge runs east-west at z -1579.5 (x 292.6..326.8) with posts/steps reaching z -1577.5, so the
+;; boat lies parallel to it, bow east, its 5.5 m half-width side ~1 m clear of the posts.
+(defconstant IOS_BOAT_PARK_VILLAGE2_X (meters 317.0))
+(defconstant IOS_BOAT_PARK_VILLAGE2_Z (meters -1571.0))
+(defconstant IOS_BOAT_PARK_VILLAGE2_YAW (degrees 90))
+
+;; The level slot village1 took over, restored once Jak walks away from the boat.
+(define *ios-boat-park-holding* #f)
+(define *ios-boat-park-displaced* (the-as symbol #f))
+(define *ios-boat-park-displaced-display* (the-as symbol #f))
+
+(defun ios-boat-park-perm ()
+  "The boat's perm: the live one while village1 is active, else the copy in game-info (#f if it has none)."
+  (let ((ent (entity-by-aid (the-as uint IOS_BOAT_PARK_AID))))
+    (if ent
+      (-> ent extra perm)
+      (lookup-entity-perm-by-aid *game-info* (the-as actor-id IOS_BOAT_PARK_AID)))))
+
+(defun ios-boat-park-perm-valid? ((perm entity-perm))
+  (and perm (= (-> perm user-int16 3) IOS_BOAT_PARK_MAGIC)))
+
+(defun ios-boat-park-perm-write ((perm entity-perm) (x float) (z float) (yaw float))
+  (when perm
+    (set! (-> perm user-int16 0) (the int (/ x IOS_BOAT_PARK_UNIT)))
+    (set! (-> perm user-int16 1) (the int (/ z IOS_BOAT_PARK_UNIT)))
+    ;; angle units, wraps to int16
+    (set! (-> perm user-int16 2) (the int yaw))
+    (set! (-> perm user-int16 3) IOS_BOAT_PARK_MAGIC)
+    ;; update-perm! (level login, death resets) zeroes the user data without this bit
+    (logior! (-> perm status) (entity-perm-status user-set-from-cstage)))
+  0)
+
+(defun ios-boat-park-store ((pos vector) (yaw float))
+  "Save the boat's spot in its live perm and in game-info's copy (the one the hook reads with village1 away)."
+  (let ((ent (entity-by-aid (the-as uint IOS_BOAT_PARK_AID))))
+    (if ent (ios-boat-park-perm-write (-> ent extra perm) (-> pos x) (-> pos z) yaw)))
+  (ios-boat-park-perm-write (lookup-entity-perm-by-aid *game-info* (the-as actor-id IOS_BOAT_PARK_AID))
+                            (-> pos x) (-> pos z) yaw)
+  0)
+
+(defun ios-boat-park-clear ()
+  "Back at a stock dock: no parked spot."
+  (let ((ent (entity-by-aid (the-as uint IOS_BOAT_PARK_AID))))
+    (if ent (set! (-> ent extra perm user-int16 3) 0)))
+  (let ((perm (lookup-entity-perm-by-aid *game-info* (the-as actor-id IOS_BOAT_PARK_AID))))
+    (if perm (set! (-> perm user-int16 3) 0)))
+  0)
+
+(defun ios-boat-park-get ((pos vector))
+  "Parked spot -> pos (y 0, w = yaw). #f if the boat has none (it docks at Sandover/Misty as in the stock game)."
+  (let ((perm (ios-boat-park-perm)))
+    (when (ios-boat-park-perm-valid? perm)
+      (set-vector! pos
+                   (* IOS_BOAT_PARK_UNIT (the float (-> perm user-int16 0)))
+                   0.0
+                   (* IOS_BOAT_PARK_UNIT (the float (-> perm user-int16 1)))
+                   (the float (-> perm user-int16 2)))
+      ;; first Rock Village spot (323.66, -1574.13, 42 deg) cut into the dock: saves still parked there move to
+      ;; the current one
+      (when (< (vector-vector-xz-distance pos (new 'static 'vector :x (meters 323.66) :z (meters -1574.13)))
+               (meters 2))
+        (set-vector! pos IOS_BOAT_PARK_VILLAGE2_X 0.0 IOS_BOAT_PARK_VILLAGE2_Z 1.0)
+        (ios-boat-park-store pos IOS_BOAT_PARK_VILLAGE2_YAW)
+        (set! (-> pos w) IOS_BOAT_PARK_VILLAGE2_YAW))
+      #t)))
+
+(defun ios-boat-park-want-slot ((name symbol))
+  (dotimes (i 2)
+    (if (= (-> *load-state* want i name) name) (return i)))
+  -1)
+
+(defun ios-boat-park-release ((restore symbol))
+  "Stop keeping village1 loaded. With restore, its slot gets back the level the stock logic wanted there."
+  (when *ios-boat-park-holding*
+    (set! *ios-boat-park-holding* #f)
+    (let ((slot (ios-boat-park-want-slot 'village1)))
+      (when (and restore (>= slot 0))
+        (format 0 "ios-boat-park: village1 slot back to ~A~%" *ios-boat-park-displaced*)
+        (set! (-> *load-state* want slot name) *ios-boat-park-displaced*)
+        (set! (-> *load-state* want slot display?) *ios-boat-park-displaced-display*)
+        (set! (-> *load-state* want slot force-vis?) #f)
+        (set! (-> *load-state* want slot force-inside?) #f))))
+  0)
+
+(defun ios-boat-park-hold ((inside symbol))
+  "Make sure village1 is wanted, taking the slot of the level Jak is not in. Re-taken whenever a load boundary
+   swaps it out again (the boundary's level is remembered instead)."
+  (when (< (ios-boat-park-want-slot 'village1) 0)
+    (let ((slot (if (= (-> *load-state* want 0 name) inside) 1 0)))
+      (format 0 "ios-boat-park: village1 replaces ~A for the parked boat~%" (-> *load-state* want slot name))
+      (set! *ios-boat-park-displaced* (-> *load-state* want slot name))
+      (set! *ios-boat-park-displaced-display* (-> *load-state* want slot display?))
+      (set! (-> *load-state* want slot name) 'village1)
+      ;; only bit-7 actors spawn (the boat; see ios-boat-park-ensure-spawn)
+      (set! (-> *load-state* want slot display?) 'special)
+      (set! (-> *load-state* want slot force-vis?) #f)
+      (set! (-> *load-state* want slot force-inside?) #f)
+      (set! *ios-boat-park-holding* #t)))
+  0)
+
+(defun ios-boat-park-ensure-spawn ()
+  "'special display only births bit-7 actors. The boat sets bit-7 on itself, but a save may not have it yet."
+  (let ((ent (entity-by-aid (the-as uint IOS_BOAT_PARK_AID))))
+    (if (and ent (not (logtest? (-> ent extra perm status) (entity-perm-status bit-7))))
+      (set-or-clear-status! (the-as entity-actor ent) (entity-perm-status bit-7) #t)))
+  0)
+
+(defun ios-boat-park-village2-spot ((inside symbol) (pos vector))
+  "New spawn point: a boat with no parked spot shows up at Rock Village's dock while Jak is there."
+  (when (and (= inside 'village2)
+             (not (ios-boat-park-get pos))
+             (task-complete? *game-info* (game-task jungle-fishgame)))
+    (format 0 "ios-boat-park: boat moved to the Rock Village dock~%")
+    (set-vector! pos IOS_BOAT_PARK_VILLAGE2_X 0.0 IOS_BOAT_PARK_VILLAGE2_Z 1.0)
+    (ios-boat-park-store pos IOS_BOAT_PARK_VILLAGE2_YAW))
+  0)
+
+(defun ios-boat-park-return-home ((pos vector))
+  "Jak died at sea with the boat adrift (fishermans-boat.gc ios-ocean-return-boat-on-death, user 2026-10-10): send
+   the boat to the nearer home spot from POS, Sandover's stock dock (no parked spot) or the Rock Village dock.
+   The free boat sees its parked spot change and respawns there (fishermans-boat-ios-record-park)."
+  (let ((rock (new 'stack-no-clear 'vector)))
+    (set-vector! rock IOS_BOAT_PARK_VILLAGE2_X 0.0 IOS_BOAT_PARK_VILLAGE2_Z 1.0)
+    (cond
+      ;; Sandover's dock is ~100 m from its centre (0, 40)
+      ((< (vector-vector-xz-distance pos rock)
+          (vector-vector-xz-distance pos (new 'static 'vector :x (meters 0.0) :z (meters 40.0))))
+       (format 0 "ios-boat-park: Jak died at sea, boat back to the Rock Village dock~%")
+       (ios-boat-park-store rock IOS_BOAT_PARK_VILLAGE2_YAW))
+      (else
+       (format 0 "ios-boat-park: Jak died at sea, boat back to Sandover's dock~%")
+       (ios-boat-park-clear))))
+  0)
+
+(defun ios-boat-park-update ()
+  (when (and *target*
+             (not (level-get *level* 'title))
+             (not (paused?))
+             (not (movie?))
+             ;; these wait for their own levels to load: target-continue for the continue point's, a warp gate
+             ;; (basebutton warp, Jak in target-warp-out) for its destination. Rock Village's gate is ~75 m
+             ;; from the boat's spot there.
+             (not (and (-> *target* next-state)
+                       (member (-> *target* next-state name) '(target-continue target-warp-out target-warp-in)))))
+    (let* ((inside-lev (level-get-target-inside *level*))
+           (inside (if inside-lev (-> inside-lev name) #f))
+           (pos (new 'stack-no-clear 'vector)))
+      (cond
+        ((!= *ios-driveable-boat* #t) (ios-boat-park-release #t))
+        ;; free boat: no level needs to be kept for the boat
+        ((= *ios-boat-art-resident* #t)
+         (ios-boat-park-release #t)
+         (ios-boat-park-village2-spot inside pos)
+         (ios-free-boat-update))
+        ;; Jak on the boat: its ocean manager picks the levels
+        ((or (= *ios-boat-driving* #t) (= *ios-boat-boardable* #t)) (ios-boat-park-release #f))
+        (else
+         (ios-boat-park-village2-spot inside pos)
+         (cond
+           ;; docked in Sandover/Misty, or Jak is in Sandover: the stock level logic keeps the boat
+           ((or (not (ios-boat-park-get pos)) (= inside 'village1)) (ios-boat-park-release #f))
+           (else
+            (let ((dist (vector-vector-xz-distance pos (target-pos 0))))
+              (cond
+                ((< dist IOS_BOAT_PARK_SPAWN_DIST)
+                 (ios-boat-park-hold inside)
+                 (if (and *ios-boat-park-holding* (zero? (logand (-> *display* base-frame-counter) 7)))
+                   (ios-boat-park-ensure-spawn)))
+                ((< IOS_BOAT_PARK_DESPAWN_DIST dist) (ios-boat-park-release #t))))))))))
+  0)
+
+;; ---- one level load at a time ----------------------------------------------------------------------------------
+;; load-state update! only adds a wanted level while (check-busy *load-dgo-rpc*) is false, which on the PS2 keeps a
+;; second DGO from starting while one streams in. The host completes RPCs in-process (rpc-busy? is always 0), so
+;; when two levels that aren't loaded are wanted at once (the ocean manager switching to Rock Village + Boggy Swamp
+;; at sea) the second load began while the first was still loading: both levels polled the one DGO stream, the
+;; swamp's objects were split between the two heaps, and it reloaded forever with Jak stuck waiting in a black
+;; world (user 2026-10-18). So while a level is loading, a wanted level that hasn't started yet is taken out of
+;; *load-state* just for level-update and put back the next frame.
+(define *ios-load-held-name* (the-as symbol #f))
+(define *ios-load-held-display* (the-as symbol #f))
+(define *ios-load-held-force-vis* (the-as symbol #f))
+(define *ios-load-held-force-inside* (the-as symbol #f))
+;; the other want slot's level when it was held: only put back while that is still the only other wanted level
+(define *ios-load-held-other* (the-as symbol #f))
+
+(defun ios-level-dgo-loading? ()
+  "A level slot is streaming its DGO in or logging it in. Login counts too: when it finishes it resets
+   (-> *level* loading-level) to level-default, so a level loading meanwhile has its bsp attached to no level and
+   login-begin silently kills it (it was then loaded a second time)."
+  (dotimes (i 2)
+    (case (-> *level* level i status)
+      (('loading 'loading-bt 'loading-done 'login) (return #t))))
+  #f)
+
+(defun ios-load-one-at-a-time ()
+  "Run last before level-update (end of the *menu-hook* chain)."
+  (let ((prev *ios-load-held-name*))
+    ;; put back last frame's held level, unless the want list has changed since
+    (when prev
+      (set! *ios-load-held-name* #f)
+      (when (< (ios-boat-park-want-slot prev) 0)
+        (let ((slot (cond
+                      ((and (not (-> *load-state* want 0 name)) (= (-> *load-state* want 1 name) *ios-load-held-other*)) 0)
+                      ((and (not (-> *load-state* want 1 name)) (= (-> *load-state* want 0 name) *ios-load-held-other*)) 1)
+                      (else -1))))
+          (when (>= slot 0)
+            (set! (-> *load-state* want slot name) prev)
+            (set! (-> *load-state* want slot display?) *ios-load-held-display*)
+            (set! (-> *load-state* want slot force-vis?) *ios-load-held-force-vis*)
+            (set! (-> *load-state* want slot force-inside?) *ios-load-held-force-inside*)))))
+    (when (ios-level-dgo-loading?)
+      (dotimes (i 2)
+        (let ((name (-> *load-state* want i name)))
+          (when (and name (not *ios-load-held-name*) (not (level-get *level* name)))
+            (if (!= name prev) (format 0 "ios: level ~A waits for the level being loaded~%" name))
+            (set! *ios-load-held-name* name)
+            (set! *ios-load-held-display* (-> *load-state* want i display?))
+            (set! *ios-load-held-force-vis* (-> *load-state* want i force-vis?))
+            (set! *ios-load-held-force-inside* (-> *load-state* want i force-inside?))
+            (set! *ios-load-held-other* (-> *load-state* want (- 1 i) name))
+            (set! (-> *load-state* want i name) #f))))))
+  0)
+
+;; Chain into *menu-hook* (retail: nothing). This file's top-level only runs once, at boot.
+(define *ios-boat-park-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-boat-park-menu-hook ()
+  (ios-boat-park-update)
+  ;; every frame, paused or not: after update-time-of-day, before the next update-camera (fishermans-boat.gc)
+  (if (= *ios-boat-art-resident* #t) (ios-ocean-transition-fog))
+  (*ios-boat-park-prev-menu-hook*)
+  ;; later startup objects' hooks run their own update before calling this one, so this is the last word on the
+  ;; want list before level-update
+  (ios-load-one-at-a-time)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-boat-park-menu-hook))
diff --git a/goal_src/jak1/pc/ios/ios-boat-summon.gc b/goal_src/jak1/pc/ios/ios-boat-summon.gc
new file mode 100644
index 000000000..f44ebc16c
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-boat-summon.gc
@@ -0,0 +1,381 @@
+;;-*-Lisp-*-
+(in-package goal)
+(require "engine/target/logic-target.gc")
+(require "engine/target/target2.gc")
+
+;; og:ios Driveable Boat: boat summon pads (user 2026-10-10).
+;;
+;; A faintly glowing spot on Sandover's dock and on Rock Village's dock. Standing on it shows "PRESS O TO SUMMON BOAT"
+;; (only when the boat isn't already moored at that dock); pressing O moves the boat's parked spot there, so the
+;; free boat (fishermans-boat.gc, *ios-boat-art-resident*) is removed wherever it was and appears at this dock. As it
+;; appears its model fades in from a cyan glow (*ios-boat-summon-fade*, mirrored by the host to the Merc renderer,
+;; Jak1RendererSetBoatFade) with a burst of sparkles, blue eco lightning and a splash.
+;;
+;; Linked as a startup object (aot_level_code_link.py --startup-object ios-boat-summon, after ios-ocean-fish).
+;; Uses only the always-linked startup objects ios-boat-park (parked spot) and ios-dynamic-save (free boat lookup).
+
+(define-extern *ios-driveable-boat* symbol)
+(define-extern *ios-boat-art-resident* symbol)
+(define-extern *ios-boat-driving* symbol)
+(define-extern ios-boat-park-store (function vector float int))
+(define-extern ios-boat-park-get (function vector symbol))
+(define-extern ios-dsp-free-boat (function process-drawable))
+
+;; read by the host every frame: x model alpha (0..1), y glow (0..1), w 1 while the fade runs
+(define-perm *ios-boat-summon-fade* vector (new 'global 'vector))
+
+;; ---- pads ----------------------------------------------------------------------------------------------------
+;; Pad = where Jak stands (xz; y found from the dock's collision), boat = where the summoned boat is moored.
+
+;; Sandover: on the wooden pier (village1 collision: flat at y 2.46 m, x -35.4..-28.6, z 84..109; posts along the
+;; east edge at z ~89, ~98, ~107), beside the hull; boat at the stock dock (boat-path point 0, method-31), facing +z.
+;; (The first pad, (-21.6, 104), was that dock point itself: open water with no collision, so it never showed.)
+;; Pad = where the user stood on the pier (lldb, 2026-10-18: (-32.51, 2.46, 103.00) m).
+(defconstant IOS_SUMMON_VILLAGE1_PAD_X (meters -32.51))
+(defconstant IOS_SUMMON_VILLAGE1_PAD_Z (meters 103.0))
+(defconstant IOS_SUMMON_VILLAGE1_BOAT_X (meters -21.6))
+(defconstant IOS_SUMMON_VILLAGE1_BOAT_Z (meters 104.0))
+(defconstant IOS_SUMMON_VILLAGE1_BOAT_YAW (degrees 0))
+;; Rock Village: by the north dock edge; boat at ios-boat-park's Rock Village spot.
+(defconstant IOS_SUMMON_VILLAGE2_PAD_X (meters 317.64))
+(defconstant IOS_SUMMON_VILLAGE2_PAD_Z (meters -1580.82))
+(defconstant IOS_SUMMON_VILLAGE2_BOAT_X (meters 317.0))
+(defconstant IOS_SUMMON_VILLAGE2_BOAT_Z (meters -1571.0))
+(defconstant IOS_SUMMON_VILLAGE2_BOAT_YAW (degrees 90))
+
+(defconstant IOS_SUMMON_PAD_RADIUS (meters 1.5))   ;; stand within this (xz) for the prompt
+(defconstant IOS_SUMMON_SPARKLE_DIST (meters 60))  ;; pad sparkles while Jak is this close
+(defconstant IOS_SUMMON_MOORED_DIST (meters 15))   ;; boat this close to the dock's spot: already there
+(defconstant IOS_SUMMON_BOAT_AID 10419)            ;; fishermans-boat-2, the village1 actor
+
+;; ---- helpers -------------------------------------------------------------------------------------------------
+
+(defun ios-boat-summon-hint-line ((str string) (font font-context) (alpha int))
+  "Print one prompt line, fading the pad glyph colours with it (same as fishermans-boat-ios-hint-line)."
+  (dotimes (i 7)
+    (set-font-color-alpha (the-as font-color (-> (new 'static 'array uint8 7 1 22 23 24 25 26 27) i)) alpha))
+  (print-game-text str font #f alpha 22)
+  (dotimes (i 7)
+    (set-font-color-alpha (the-as font-color (-> (new 'static 'array uint8 7 1 22 23 24 25 26 27) i)) 128))
+  0)
+
+(defun ios-boat-summon-eat-circle ()
+  "Consume this O press entirely, history included, so Jak doesn't also attack (fishermans-boat-ios-eat-circle)."
+  (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons circle))
+  (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons circle))
+  (let ((history (-> *cpad-history-list* cpads 0)))
+    (dotimes (i 15)
+      (logclear! (-> history button0-rel i) (pad-buttons circle))))
+  0)
+
+(defun ios-boat-summon-boat ()
+  "The boat as it is now: the free boat, else the village1 actor if it is alive. #f if neither."
+  (let ((free (ios-dsp-free-boat)))
+    (if free
+      free
+      (let ((ent (entity-by-aid (the-as uint IOS_SUMMON_BOAT_AID))))
+        (the-as process-drawable (if ent (-> (the-as entity-actor ent) extra process)))))))
+
+(defun ios-boat-summon-moored? ((boat-spot vector))
+  "Is the boat already at (or about to appear at) this dock?"
+  (let ((boat (ios-boat-summon-boat))
+        (park (new 'stack-no-clear 'vector)))
+    (cond
+      (boat (< (vector-vector-xz-distance (-> boat root trans) boat-spot) IOS_SUMMON_MOORED_DIST))
+      ;; no boat process yet: it is about to spawn at its parked spot
+      ((ios-boat-park-get park) (< (vector-vector-xz-distance park boat-spot) IOS_SUMMON_MOORED_DIST))
+      (else #f))))
+
+(defun ios-boat-summon-jak-ready? ()
+  "Jak standing or walking on the ground, free to act."
+  (and *target*
+       (-> *target* next-state)
+       (member (-> *target* next-state name) '(target-stance target-walk target-turn-around target-stance-look-around))
+       (not (logtest? (-> *target* water flag) (water-flag touch-water)))))
+
+;; ---- the pad process -----------------------------------------------------------------------------------------
+
+(deftype ios-boat-summon (process-drawable)
+  ((pad        vector :inline)  ;; active pad (y from collision, w 1 once found)
+   (boat-spot  vector :inline)  ;; xz, w = yaw
+   (pad-level  symbol)
+   (old-boat   handle)          ;; the boat as it was when summoned (it must go away first)
+   (press-time time-frame)
+   (arrive-time time-frame)
+   (burst-time time-frame)
+   (bursts     int32))
+  (:states
+   ios-boat-summon-idle
+   ios-boat-summon-wait
+   ios-boat-summon-appear))
+
+(define *ios-boat-summon-ppointer* (the-as (pointer process) #f))
+(define *ios-boat-summon-pid* 0)
+
+(defun ios-boat-summon-get ()
+  (let ((pp *ios-boat-summon-ppointer*))
+    (the-as ios-boat-summon
+            (when pp
+              (let ((proc (-> pp 0)))
+                (if (and proc (= (-> proc pid) *ios-boat-summon-pid*)) proc))))))
+
+(defbehavior ios-boat-summon-pick-pad ios-boat-summon ()
+  "The pad of the dock level Jak is at (that level active, Jak within sparkle range), or #f."
+  (let ((jak (target-pos 0))
+        (found #f))
+    (dotimes (i 2)
+      (let ((lev (if (zero? i) 'village1 'village2))
+            (pad (new 'stack-no-clear 'vector)))
+        (if (zero? i)
+          (set-vector! pad IOS_SUMMON_VILLAGE1_PAD_X 0.0 IOS_SUMMON_VILLAGE1_PAD_Z 1.0)
+          (set-vector! pad IOS_SUMMON_VILLAGE2_PAD_X 0.0 IOS_SUMMON_VILLAGE2_PAD_Z 1.0))
+        (when (and (not found)
+                   (= (level-status *level* lev) 'active)
+                   (< (vector-vector-xz-distance pad jak) IOS_SUMMON_SPARKLE_DIST))
+          (set! found #t)
+          (when (!= (-> self pad-level) lev)
+            ;; new pad: find the dock's surface under it
+            (set! (-> self pad-level) lev)
+            (set! (-> self pad quad) (-> pad quad))
+            (set! (-> self pad w) 0.0)
+            (if (zero? i)
+              (set-vector! (-> self boat-spot)
+                           IOS_SUMMON_VILLAGE1_BOAT_X 0.0 IOS_SUMMON_VILLAGE1_BOAT_Z IOS_SUMMON_VILLAGE1_BOAT_YAW)
+              (set-vector! (-> self boat-spot)
+                           IOS_SUMMON_VILLAGE2_BOAT_X 0.0 IOS_SUMMON_VILLAGE2_BOAT_Z IOS_SUMMON_VILLAGE2_BOAT_YAW))))))
+    (if (not found) (set! (-> self pad-level) #f))
+    ;; the dock's height under the pad (collision only exists once the level is active)
+    (when (and found (< (-> self pad w) 0.5))
+      (let ((start (new 'stack-no-clear 'vector))
+            (probe (new 'stack-no-clear 'vector))
+            (result (new 'stack-no-clear 'collide-tri-result)))
+        (set-vector! start (-> self pad x) (meters 30) (-> self pad z) 1.0)
+        (set-vector! probe 0.0 (meters -40) 0.0 1.0)
+        (let ((u (fill-and-probe-using-line-sphere *collide-cache* start probe (meters 0.3)
+                                                   (collide-kind background) self result
+                                                   (new 'static 'pat-surface :noentity #x1))))
+          (when (>= u 0.0)
+            (set! (-> self pad y) (+ (- (meters 30) (* u (meters 40))) (meters 0.1)))
+            (set! (-> self pad w) 1.0)
+            (set! (-> self root trans quad) (-> self pad quad))
+            (set! (-> self root trans w) 1.0)))))
+    (and found (< 0.5 (-> self pad w)))))
+
+(defun ios-boat-summon-allowed? ()
+  "Driveable Boat on with the free boat (resident art), the fishing game done, normal gameplay."
+  (and (= *ios-driveable-boat* #t)
+       (= *ios-boat-art-resident* #t)
+       *target*
+       (task-complete? *game-info* (game-task jungle-fishgame))
+       (not (movie?))
+       (not (paused?))
+       (not (level-get *level* 'title))))
+
+(defbehavior ios-boat-summon-show-prompt ios-boat-summon ()
+  "The stock press-to-use layout (fishermans-boat-ios-board?), with our own text. #t if it is on screen."
+  (when (not (level-hint-displayed?))
+    (hide-hud)
+    (level-hint-surpress!)
+    (kill-current-level-hint '() '(sidekick voicebox) 'exit)
+    (when (and (hud-hidden?) (can-grab-display? self) (= *kernel-boot-message* 'play))
+      (let ((font (new 'stack 'font-context *font-default-matrix* 32 160 0.0 (font-color default) (font-flags shadow kerning))))
+        (set-width! font 440)
+        (set-height! font 80)
+        (set! (-> font flags) (font-flags shadow kerning large middle))
+        ;; <PAD_CIRCLE> in the game font (font_db_jak1.cpp), as in the boat's own hints
+        (ios-boat-summon-hint-line "PRESS ~Y~22L<~Z~Y~25L@~Z~Y~1L>~Z~Y~23L[~Z~+26H TO SUMMON BOAT" font 128))
+      #t)))
+
+(defbehavior ios-boat-summon-burst ios-boat-summon ((group-id int) (pos vector) (duration time-frame))
+  "One particle group at POS, run by its own part-tracker."
+  (let ((core (new 'stack-no-clear 'vector)))
+    (set! (-> core quad) (-> pos quad))
+    (set! (-> core w) (meters 4))
+    (process-spawn part-tracker
+                   :init part-tracker-init
+                   (-> *part-group-id-table* group-id)
+                   duration
+                   #f
+                   #f
+                   #f
+                   (the-as collide-prim-core core)
+                   :to *entity-pool*))
+  0)
+
+;; ---- pad indicator ---------------------------------------------------------------------------------------------
+;; A few faint pale motes drifting up off the pad (instead of the blue eco vent's flashes). Ids past the last stock
+;; ones (group 708, part 2968); effects tpage is in GAME.CGO, always resident.
+
+(defpartgroup group-ios-boat-summon-pad
+  :id 709
+  :bounds (static-bspherem 0 1 0 2)
+  :parts ((sp-item 2969 :fade-after (meters 40) :falloff-to (meters 40))))
+
+(defpart 2969
+  :init-specs
+  ((:texture (middot effects))
+   (:num 0.06 0.06)
+   (:x (meters -0.6) (meters 1.2))
+   (:y (meters 0.1))
+   (:z (meters -0.6) (meters 1.2))
+   (:scale-x (meters 0.3) (meters 0.2))
+   (:scale-y :copy scale-x)
+   (:r 160.0)
+   (:g 200.0)
+   (:b 255.0)
+   (:a 0.0)
+   (:vel-y (meters 0.006) (meters 0.004))
+   ;; fade in over 0.4 s, then out
+   (:fade-a 1.0)
+   (:timer (seconds 1.5))
+   (:flags (bit2 bit3 bit14))
+   (:next-time (seconds 0.4))
+   (:next-launcher 2970)))
+
+(defpart 2970
+  :init-specs ((:fade-a -0.36)))
+
+(defbehavior ios-boat-summon-pad-sparkle ios-boat-summon ()
+  ;; group-ios-boat-summon-pad: faint motes rising off a 1.2 m square
+  (if (nonzero? (-> self part)) (spawn (-> self part) (-> self pad)))
+  0)
+
+(defbehavior ios-boat-summon-init-by-other ios-boat-summon ()
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! *ios-boat-summon-ppointer* (-> self ppointer))
+  (set! *ios-boat-summon-pid* (-> self pid))
+  (set! (-> self root) (new 'process 'trsqv))
+  (vector-reset! (-> self pad))
+  (set! (-> self pad-level) #f)
+  (set! (-> self old-boat) (the-as handle #f))
+  (set! (-> self part) (create-launch-control (-> *part-group-id-table* 709) self))
+  (set! (-> *ios-boat-summon-fade* w) 0.0)
+  (go ios-boat-summon-idle)
+  (none))
+
+(defmethod deactivate ((this ios-boat-summon))
+  ;; never leave the boat faded out
+  (set! (-> *ios-boat-summon-fade* w) 0.0)
+  ((method-of-type process-drawable deactivate) this)
+  (none))
+
+;; Sparkling pad; prompt + O press while Jak stands on it and the boat is elsewhere.
+(defstate ios-boat-summon-idle (ios-boat-summon)
+  :trans
+    (behavior ()
+      (when (and (ios-boat-summon-allowed?)
+                 (ios-boat-summon-pick-pad)
+                 (not (ios-boat-summon-moored? (-> self boat-spot))))
+        (ios-boat-summon-pad-sparkle)
+        (let ((jak (target-pos 0)))
+          (when (and (< (vector-vector-xz-distance jak (-> self pad)) IOS_SUMMON_PAD_RADIUS)
+                     (< (fabs (- (-> jak y) (-> self pad y))) (meters 2.5))
+                     (ios-boat-summon-jak-ready?)
+                     (ios-boat-summon-show-prompt)
+                     (cpad-pressed? 0 circle))
+            (ios-boat-summon-eat-circle)
+            (go ios-boat-summon-wait)))))
+  :code
+    (behavior ()
+      (loop
+        (suspend))))
+
+;; Pressed: move the parked spot here. The free boat wherever it was sees its spot change and goes; the free boat
+;; update (ios-boat-park.gc *menu-hook*) spawns the new one at this dock. Hidden (alpha 0) until it is here.
+(defstate ios-boat-summon-wait (ios-boat-summon)
+  :enter
+    (behavior ()
+      (set-time! (-> self press-time))
+      (let ((boat (ios-boat-summon-boat)))
+        (set! (-> self old-boat) (if boat (process->handle boat) (the-as handle #f))))
+      (sound-play "buzzer-pickup")
+      (ios-boat-summon-burst 63 (-> self pad) (seconds 1))
+      (set-vector! *ios-boat-summon-fade* 0.0 1.0 0.0 1.0)
+      (let ((spot (new 'stack-no-clear 'vector)))
+        (set-vector! spot (-> self boat-spot x) 0.0 (-> self boat-spot z) 1.0)
+        (ios-boat-park-store spot (-> self boat-spot w)))
+      (format 0 "ios-boat-summon: boat summoned to the ~A dock~%" (-> self pad-level)))
+  :trans
+    (behavior ()
+      (ios-boat-summon-pad-sparkle)
+      (let ((boat (ios-dsp-free-boat)))
+        (cond
+          ((and boat
+                (!= (process->handle boat) (-> self old-boat))
+                (< (vector-vector-xz-distance (-> boat root trans) (-> self boat-spot)) (meters 3)))
+           (go ios-boat-summon-appear))
+          ;; never stay invisible: give up after a while
+          ((time-elapsed? (-> self press-time) (seconds 5))
+           (format 0 "ios-boat-summon: no boat appeared~%")
+           (set! (-> *ios-boat-summon-fade* w) 0.0)
+           (go ios-boat-summon-idle)))))
+  :code
+    (behavior ()
+      (loop
+        (suspend))))
+
+;; The new boat is here: fade in from a glow over 2 s (glow gone after 3 s), with sparkles, lightning and a splash.
+(defstate ios-boat-summon-appear (ios-boat-summon)
+  :enter
+    (behavior ()
+      (set-time! (-> self arrive-time))
+      (set-time! (-> self burst-time))
+      (set! (-> self bursts) 0)
+      (let ((boat (ios-dsp-free-boat))
+            (pos (new 'stack-no-clear 'vector)))
+        (when boat
+          (set! (-> pos quad) (-> boat root trans quad))
+          (set! (-> pos y) (+ (ocean-get-height pos) (meters 0.3)))
+          (ios-boat-summon-burst 40 pos (seconds 3))   ;; group-part-water-splash
+          (ios-boat-summon-burst 44 pos (seconds 2.5)) ;; group-part-vent-blue-active: blue eco lightning
+          (+! (-> pos y) (meters 2.5))
+          (ios-boat-summon-burst 63 pos (seconds 1)))) ;; group-fuel-cell-starburst
+      (sound-play "y-eco-pickup"))
+  :trans
+    (behavior ()
+      (let* ((t (/ (the float (- (current-time) (-> self arrive-time))) (the float (seconds 2))))
+             (alpha (fmin 1.0 (fmax 0.0 t)))
+             (glow (fmax 0.0 (- 1.0 (* 0.6666667 t)))))
+        ;; ease in: slow start, quick finish
+        (set-vector! *ios-boat-summon-fade* (* alpha alpha (- 3.0 (* 2.0 alpha))) glow 0.0 1.0)
+        ;; sparkle bursts around the hull while it materializes
+        (let ((boat (ios-dsp-free-boat)))
+          (when (and boat (< (-> self bursts) 6) (time-elapsed? (-> self burst-time) (seconds 0.3)))
+            (set-time! (-> self burst-time))
+            (+! (-> self bursts) 1)
+            (let ((pos (new 'stack-no-clear 'vector)))
+              (set-vector! pos
+                           (+ (-> boat root trans x) (rand-vu-float-range (meters -5) (meters 5)))
+                           (+ (-> boat root trans y) (rand-vu-float-range (meters 1) (meters 4)))
+                           (+ (-> boat root trans z) (rand-vu-float-range (meters -5) (meters 5)))
+                           1.0)
+              (ios-boat-summon-burst 63 pos (seconds 1)))))
+        (when (or (< 1.5 t) (not (ios-dsp-free-boat)))
+          (set! (-> *ios-boat-summon-fade* w) 0.0)
+          (go ios-boat-summon-idle))))
+  :code
+    (behavior ()
+      (loop
+        (suspend))))
+
+;; ---- per frame -----------------------------------------------------------------------------------------------
+
+(defun ios-boat-summon-update ()
+  (cond
+    ((and (= *ios-driveable-boat* #t) (= *ios-boat-art-resident* #t) *target* (not (level-get *level* 'title)))
+     (if (not (ios-boat-summon-get)) (process-spawn ios-boat-summon :to *entity-pool*)))
+    (else
+     (let ((proc (ios-boat-summon-get)))
+       (if proc (deactivate proc)))
+     (set! (-> *ios-boat-summon-fade* w) 0.0)))
+  0)
+
+;; Chain into *menu-hook* (after ios-ocean-fish's). This file's top-level only runs once, at boot.
+(define *ios-boat-summon-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-boat-summon-menu-hook ()
+  (ios-boat-summon-update)
+  (*ios-boat-summon-prev-menu-hook*)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-boat-summon-menu-hook))
diff --git a/goal_src/jak1/pc/ios/ios-brume.gc b/goal_src/jak1/pc/ios/ios-brume.gc
new file mode 100644
index 000000000..6075e4d2e
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-brume.gc
@@ -0,0 +1,308 @@
+;;-*-Lisp-*-
+(in-package goal)
+
+;; name: ios-brume.gc
+;; name in dgo: ios-brume
+;; dgos: none (iOS startup object)
+
+;; Brume Village: the community mod "Brume Village" by Cuttlefishthesage (jakIOS/ModLevels/Brume, brume-plan.md), four
+;; connected levels (brume, the village; abandon, the caverns; mount, the mountain range; preundg, the precursor
+;; underground) built on the device at import and reached through warp gate slot 6. Their own code (levels/brume,
+;; abandoned, mount, preundg) is level code in BRU/ABA/MOU/PRE.DGO; this file is the engine side the mod changed in its
+;; engine sources, done at boot because those are captured engine objects:
+;;   * the 28 Brume tasks (game-task 123-150) need task-perm-list / fuel-cell-time entries: ios-glacier.gc grows both
+;;     to (game-task max), which is 151 now, and repairs older saves.
+;;   * *game-counts* gets the four pages (18-21): 115 / 200 / 215 / 215 orbs, 7 flies each (the mod's progress.gc).
+;;   * the pages open while warp gate slot 6 is (a bonus outside the stock 100%, like the Glacier's).
+;;   * vol lumps written by the custom level builder carry no time stamp (DEFAULT_RES_TIME), so the stock 'exact 0.0
+;;     lookup found none and their water / dark eco volumes did nothing; vol-control falls back to 'base for them (the
+;;     mod base looks them up with 'base).
+;;   * the yellow vents of Abandon open with Brume's restore-power task (stock: snow-eggtop).
+;;   * the sunken water planes the levels reuse are drawn from 10x farther (the mod's water-anim.gc bounds).
+;;   * the big collide cache while a Brume level is in (the mod turns it on for good).
+;;   * the levels copy village1's texture pages (preundg snow's): Sandover / Snowy Mountain must not start loading
+;;     while they are in (the Glacier's crash, ios-glacier.gc), so those are held back until the Brume levels are gone.
+;;   * none of the sea's code runs while they are in (fishermans-boat.gc, ios-open-ocean.gc call ios-brume-here?).
+;;   * the mod's own audio (mod-base play-main-music / play-sound-file) is played by the host (Jak1AudioManager
+;;     playModMusic / playModClip, OpenGOALRuntimeHost.mm SyncBrumeAudio) from what this file publishes: the music
+;;     track of the Brume level Jak is in, and numbered one-shot clips. The fisherman's and the yellow sage's clips are
+;;     cut from the disc's voice lines (FIACCEPT, YERESOLU); the mod's music tracks and the muse steps are not on the
+;;     disc and only play once their files are bundled (with the author's permission); until then brume / abandon /
+;;     mount play the jungle music bank and preundg the jungleb one (the mod's track for it is a recording of that).
+;; Not taken from the mod: its new game at brume-warp, slower platform buttons in brume / preundg, the jungle water
+;; and jungle particle tweaks (they change the stock jungle too).
+;; Linked as a startup object (aot_level_code_link.py --startup-object ios-brume, after ios-glacier).
+
+;; set by the host every frame (OpenGOALRuntimeHost.mm SyncBrumeLevelOption): the levels are built and the option
+;; is on. Opens warp gate slot 6 (villagep-obs.gc) and the four progress pages.
+(define-perm *ios-brume-warp* symbol #f)
+
+;; read by the host every frame (SyncBrumeAudio): the Brume level whose music plays (0 none, 1 brume, 2 abandon,
+;; 3 mount, 4 preundg), its gain in thousandths (the mod's 30% of the music volume, 0 while paused), and the last
+;; clip asked for (1 muse steps, 2 fisherman, 3 yellow sage) with a counter that goes up on every request.
+(define-perm *ios-brume-music* int 0)
+(define-perm *ios-brume-music-gain* int 0)
+(define-perm *ios-brume-clip* int 0)
+(define-perm *ios-brume-clip-seq* int 0)
+
+(defun ios-brume-play-clip ((id int))
+  "brume-obs.gc's mod clips (the mod's play-sound-file)."
+  (set! *ios-brume-clip* id)
+  (+! *ios-brume-clip-seq* 1)
+  0)
+
+(defconstant IOS_BRUME_FIRST_PAGE 18)  ;; *level-task-data* / *game-counts* index of brume (progress-static.gc)
+(defconstant IOS_BRUME_PAGE_COUNT 4)
+
+(defun ios-brume-here? ()
+  "A Brume Village level is loaded (or loading)."
+  (the-as symbol (or (level-get *level* 'brume) (level-get *level* 'abandon) (level-get *level* 'mount)
+                     (level-get *level* 'preundg))))
+
+;; ---- game counts --------------------------------------------------------------------------------------------
+
+;; *game-counts* with room for the four pages (ios-glacier.gc grew it to 18). A basic laid out as the kernel's
+;; alloc_heap_object does: type tag, then the object 4 bytes in.
+(defun ios-brume-grow-game-counts ()
+  (let ((old *game-counts*)
+        (count (+ IOS_BRUME_FIRST_PAGE IOS_BRUME_PAGE_COUNT)))
+    (when (and old (< (-> old length) count))
+      (let* ((mem (malloc 'global (+ 16 (* count (size-of count-info)))))
+             (new-counts (the-as game-count-info (&+ mem 4))))
+        (set! (-> (the-as (pointer type) mem) 0) game-count-info)
+        (set! (-> new-counts length) count)
+        (dotimes (i count)
+          (cond
+            ((< i (-> old length))
+             (set! (-> new-counts data i money-count) (-> old data i money-count))
+             (set! (-> new-counts data i buzzer-count) (-> old data i buzzer-count)))
+            (else
+             (set! (-> new-counts data i money-count) 0)
+             (set! (-> new-counts data i buzzer-count) 7))))
+        (set! (-> new-counts data (+ IOS_BRUME_FIRST_PAGE 0) money-count) 115)
+        (set! (-> new-counts data (+ IOS_BRUME_FIRST_PAGE 1) money-count) 200)
+        (set! (-> new-counts data (+ IOS_BRUME_FIRST_PAGE 2) money-count) 215)
+        (set! (-> new-counts data (+ IOS_BRUME_FIRST_PAGE 3) money-count) 215)
+        (set! *game-counts* new-counts))))
+  0
+  (none))
+
+(ios-brume-grow-game-counts)
+
+;; ---- progress pages -----------------------------------------------------------------------------------------
+
+;; ios-open-ocean.gc's make-levels-with-tasks-available-to-progress, then the Brume pages: open while slot 6 is.
+(define-perm *ios-brume-prev-make-levels* (function none) make-levels-with-tasks-available-to-progress)
+
+(defun make-levels-with-tasks-available-to-progress ()
+  (*ios-brume-prev-make-levels*)
+  (when (>= (length *level-task-data*) (+ IOS_BRUME_FIRST_PAGE IOS_BRUME_PAGE_COUNT))
+    (dotimes (i IOS_BRUME_PAGE_COUNT)
+      (set! (-> *game-info* level-opened (+ IOS_BRUME_FIRST_PAGE i))
+            (the-as uint (if (and *ios-brume-warp* (= *kernel-boot-message* 'play)) 1 0)))))
+  0
+  (none))
+
+;; ---- vol lumps without a time stamp ---------------------------------------------------------------------------
+
+(defun ios-brume-vol-tag-idx ((lump res-lump) (name symbol))
+  "Stock looks vol lumps up at exactly time 0; custom levels' have no time stamp."
+  (let ((idx (-> ((method-of-type res-lump lookup-tag-idx) (the-as entity-actor lump) name 'exact 0.0) lo)))
+    (if (< (the-as int idx) 0)
+      (-> ((method-of-type res-lump lookup-tag-idx) (the-as entity-actor lump) name 'base 0.0) lo)
+      idx)))
+
+;; vol-h.gc's new, with that lookup
+(defmethod new vol-control ((allocation symbol) (type-to-make type) (arg0 process-drawable))
+  (let ((gp-0 (the-as object (object-new allocation type-to-make (the-as int (-> type-to-make size))))))
+    (when (zero? (the-as vol-control gp-0))
+      (go process-drawable-art-error "memory")
+      (set! gp-0 0)
+      (goto cfg-13))
+    (set! (-> (the-as vol-control gp-0) process) arg0)
+    (let* ((s5-1 (the-as res-lump (-> (the-as vol-control gp-0) process entity)))
+           (s4-0 (ios-brume-vol-tag-idx s5-1 'vol)))
+      (when (>= (the-as int s4-0) 0)
+        (let ((s3-0 (the-as int s4-0))
+              (s2-0 (-> s5-1 tag s4-0)))
+          0
+          (while (= (-> s2-0 name) (-> s5-1 tag s4-0 name))
+            (let ((v1-12 (make-property-data s5-1 0.0 (the-as res-tag-pair s3-0) (the-as pointer #f)))
+                  (a0-8 (-> (the-as vol-control gp-0) pos-vol (-> (the-as vol-control gp-0) pos-vol-count))))
+              (set! (-> a0-8 num-planes) (the-as int (-> s2-0 elt-count)))
+              (set! (-> a0-8 plane) (the-as (inline-array plane) v1-12)))
+            (+! (-> (the-as vol-control gp-0) pos-vol-count) 1)
+            (+! s3-0 1)
+            (set! s2-0 (-> s5-1 tag s3-0))))))
+    (let* ((s5-2 (the-as res-lump (-> (the-as vol-control gp-0) process entity)))
+           (s4-1 (ios-brume-vol-tag-idx s5-2 'cutoutvol)))
+      (when (>= (the-as int s4-1) 0)
+        (let ((s3-1 (the-as int s4-1))
+              (s2-1 (-> s5-2 tag s4-1)))
+          0
+          (while (= (-> s2-1 name) (-> s5-2 tag s4-1 name))
+            (let ((v1-31 (make-property-data s5-2 0.0 (the-as res-tag-pair s3-1) (the-as pointer #f)))
+                  (a0-19 (-> (the-as vol-control gp-0) neg-vol (-> (the-as vol-control gp-0) neg-vol-count))))
+              (set! (-> a0-19 num-planes) (the-as int (-> s2-1 elt-count)))
+              (set! (-> a0-19 plane) (the-as (inline-array plane) v1-31)))
+            (+! (-> (the-as vol-control gp-0) neg-vol-count) 1)
+            (+! s3-1 1)
+            (set! s2-1 (-> s5-2 tag s3-1))))))
+    (label cfg-13)
+    (the-as vol-control gp-0)))
+
+;; ---- vents ----------------------------------------------------------------------------------------------------
+
+;; collectables.gc's vent initialize; the yellow valve vents of Brume / Abandon open with brume-restore-power (the
+;; mod's change), every other vent as stock.
+(defmethod initialize ((this vent) (arg0 entity-actor) (arg1 pickup-type))
+  (stack-size-set! (-> this main-thread) 128)
+  (logior! (-> this mask) (process-mask actor-pause))
+  (let ((s3-0 (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
+    (let ((s2-0 (new 'process 'collide-shape-prim-sphere s3-0 (the-as uint 0))))
+      (set! (-> s2-0 prim-core collide-as) (collide-kind powerup))
+      (set! (-> s2-0 collide-with) (collide-kind target))
+      (set-vector! (-> s2-0 local-sphere) 0.0 4915.2 0.0 6553.6)
+      (set-root-prim! s3-0 s2-0))
+    (set! (-> s3-0 nav-radius) (* 0.75 (-> s3-0 root-prim local-sphere w)))
+    (backup-collide-with-as s3-0)
+    (set! (-> this root) s3-0))
+  (set! (-> this root trans quad) (-> arg0 extra trans quad))
+  (update-transforms! (-> this root))
+  (set! (-> this root pause-adjust-distance) 409600.0)
+  (set! (-> this fact) (new 'process 'fact-info this arg1 (-> *FACT-bank* eco-full-inc)))
+  (set! (-> this block-func) (the-as (function vent symbol) true-func))
+  (case (-> this fact pickup-type)
+    (((pickup-type eco-blue))
+     (set! (-> this part) (create-launch-control group-part-vent-blue-active this))
+     (set! (-> this collect-effect) group-blue-collect)
+     (set! (-> this collect-effect2) group-eco-blue-collect)
+     (set! (-> this sound) (new 'process 'ambient-sound 'eco-bg-blue (-> this root trans))))
+    (((pickup-type eco-red))
+     (set! (-> this part) (create-launch-control group-part-vent-red-active this))
+     (set! (-> this collect-effect) group-red-collect)
+     (set! (-> this collect-effect2) group-eco-red-collect)
+     (set! (-> this sound) (new 'process 'ambient-sound 'eco-bg-red (-> this root trans))))
+    (((pickup-type eco-green))
+     (set! (-> this part) (create-launch-control group-part-vent-green-active this))
+     (set! (-> this collect-effect) group-green-collect)
+     (set! (-> this collect-effect2) group-eco-green-collect)
+     (set! (-> this sound) (new 'process 'ambient-sound 'eco-bg-green (-> this root trans))))
+    (((pickup-type eco-yellow))
+     (set! (-> this part) (create-launch-control group-part-vent-yellow-active this))
+     (set! (-> this collect-effect) group-yellow-collect)
+     (set! (-> this collect-effect2) group-eco-yellow-collect)
+     (set! (-> this sound) (new 'process 'ambient-sound 'eco-bg-yellow (-> this root trans)))))
+  (set! (-> this blocker) (entity-actor-lookup (-> this entity) 'alt-actor 0))
+  (when (-> this blocker)
+    (logior! (-> this fact options) (fact-options vent-blocked))
+    (set! (-> this block-func)
+          (lambda ((arg0 vent))
+            (not (logtest? (-> arg0 blocker extra perm status) (entity-perm-status complete))))))
+  (set! (-> this show-particles) #t)
+  (when (logtest? (-> this fact options) (fact-options vent-blocked))
+    (when (logtest? (-> this fact options) (fact-options vent-valve))
+      (case (-> this fact pickup-type)
+        (((pickup-type eco-blue))
+         (set! (-> this block-func)
+               (the-as (function vent symbol) (lambda () (not (task-complete? *game-info* (game-task jungle-eggtop)))))))
+        (((pickup-type eco-red))
+         (set! (-> this block-func)
+               (the-as (function vent symbol) (lambda () (not (task-complete? *game-info* (game-task red-eggtop)))))))
+        (((pickup-type eco-yellow))
+         (if (or (= (-> arg0 extra level name) 'brume) (= (-> arg0 extra level name) 'abandon))
+           (set! (-> this block-func)
+                 (the-as (function vent symbol)
+                         (lambda () (not (task-complete? *game-info* (game-task brume-restore-power))))))
+           (set! (-> this block-func)
+                 (the-as (function vent symbol) (lambda () (not (task-complete? *game-info* (game-task snow-eggtop)))))))))
+      (process-spawn ecovalve (-> this block-func) :from *pickup-dead-pool* :to this))
+    (if ((-> this block-func) this) (go vent-blocked)))
+  (go vent-wait-for-touch)
+  (none))
+
+;; ---- water planes ---------------------------------------------------------------------------------------------
+
+(dolist (sg (list *water-anim-sunken-dark-eco-qbert-sg*
+                  *water-anim-sunken-dark-eco-platform-room-sg*
+                  *water-anim-sunken-dark-eco-helix-room-sg*
+                  *water-anim-sunken-big-room-sg*
+                  *water-anim-sunken-first-room-from-entrance-sg*
+                  *water-anim-sunken-qbert-room-sg*
+                  *water-anim-sunken-first-right-branch-sg*
+                  *water-anim-sunken-circular-with-bullys-sg*
+                  *water-anim-sunken-hall-with-one-whirlpool-sg*
+                  *water-anim-sunken-hall-with-three-whirlpools-sg*
+                  *water-anim-sunken-start-of-helix-slide-sg*
+                  *water-anim-sunken-room-above-exit-chamber-sg*
+                  *water-anim-sunken-hall-before-big-room-sg*
+                  *water-anim-sunken-short-piece-sg*
+                  *water-anim-sunken-big-room-upper-water-sg*))
+  (let ((group (the-as skeleton-group sg)))
+    (set! (-> group bounds w) (* 10.0 (-> group bounds w)))))
+
+;; ---- levels held back -----------------------------------------------------------------------------------------
+
+;; As ios-glacier-guard-levels: while a Brume level is loaded, a wanted village1 / snow that is not loaded yet is held
+;; back (its slot emptied, so the Brume level unloads first), then put back once the Brume levels are gone. Brume,
+;; Abandon and Mount carry village1's texture pages, Preundg snow's.
+(define *ios-brume-held-slot* -1)
+(define *ios-brume-held* (new 'global 'level-buffer-state))
+
+(defun ios-brume-guard-levels ()
+  (cond
+    ((ios-brume-here?)
+     (dotimes (i 2)
+       (let ((want (-> *load-state* want i)))
+         (when (and (or (= (-> want name) 'village1) (= (-> want name) 'snow)) (not (level-get *level* (-> want name))))
+           (format 0 "ios-brume: ~A held back while a Brume Village level is loaded~%" (-> want name))
+           (mem-copy! (the-as pointer *ios-brume-held*) (the-as pointer want) (size-of level-buffer-state))
+           (set! *ios-brume-held-slot* i)
+           (set! (-> want name) #f)
+           (set! (-> want display?) #f)
+           (set! (-> want force-vis?) #f)
+           (set! (-> want force-inside?) #f)))))
+    ((>= *ios-brume-held-slot* 0)
+     (let ((want (-> *load-state* want *ios-brume-held-slot*))
+           (held (-> *ios-brume-held* name)))
+       (when (and (not (-> want name)) (!= (-> *load-state* want (- 1 *ios-brume-held-slot*) name) held))
+         (format 0 "ios-brume: Brume Village gone, ~A loads~%" held)
+         (mem-copy! (the-as pointer want) (the-as pointer *ios-brume-held*) (size-of level-buffer-state))))
+     (set! *ios-brume-held-slot* -1)))
+  0
+  (none))
+
+(defun ios-brume-music-update ()
+  "The mod's music-manager: the track of the Brume level Jak is in."
+  (let ((lev (if *target* (level-get-target-inside *level*))))
+    (set! *ios-brume-music*
+          (if (and lev (= *master-mode* 'game) (not (movie?)))
+            (case (-> lev name)
+              (('brume) 1)
+              (('abandon) 2)
+              (('mount) 3)
+              (('preundg) 4)
+              (else 0))
+            0)))
+  (set! *ios-brume-music-gain*
+        (if (paused?) 0 (the int (* 3.0 (-> *setting-control* current music-volume)))))
+  0
+  (none))
+
+(defun ios-brume-update ()
+  ;; the big collide cache while the dense custom collision is in
+  (set! *collide-cache-max-tris* (if (ios-brume-here?) BIG_COLLIDE_CACHE_SIZE 460))
+  (ios-brume-music-update)
+  0
+  (none))
+
+;; Chain into *menu-hook* (after ios-glacier's).
+(define *ios-brume-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-brume-menu-hook ()
+  (ios-brume-update)
+  (*ios-brume-prev-menu-hook*)
+  (ios-brume-guard-levels)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-brume-menu-hook))
diff --git a/goal_src/jak1/pc/ios/ios-dynamic-save.gc b/goal_src/jak1/pc/ios/ios-dynamic-save.gc
new file mode 100644
index 000000000..327e36459
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-dynamic-save.gc
@@ -0,0 +1,453 @@
+;;-*-Lisp-*-
+(in-package goal)
+(require "engine/target/logic-target.gc")
+(require "engine/target/target2.gc")
+
+;; og:ios Dynamic Save Points (experimental): a save remembers exactly where Jak was, and loading it puts him back
+;; there instead of at the save's checkpoint (continue point). On the Driveable Boat he comes back on the boat.
+;;
+;; game-info / game-save are captured engine code on iOS, so this file is linked as a startup object
+;; (aot_level_code_link.py --startup-object ios-dynamic-save, after ios-boat-park). Its top-level runs once at boot:
+;; - every frame (chained into *menu-hook*) the last "safe" spot is kept in *ios-dsp-snapshot*: Jak standing,
+;;   walking, wading or swimming (never mid-air, in cutscenes, deaths, warps, on the zoomer or the flut flut), plus
+;;   the levels wanted at that moment. On the free boat the spot is relative to the boat.
+;; - save-game! (wrapped) copies the snapshot into four extra perms in *game-info*'s perm-list (aid
+;;   IOS_DSP_AID_BASE+0..3, no entity has those), so it goes into the save file with the rest of the perms. A
+;;   snapshot is only used while the checkpoint is still the one it was taken at.
+;; - load-game! (wrapped) reads those perms back. If they are valid, the checkpoint the save resumes at is
+;;   replaced by *ios-dsp-continue*: the save's checkpoint, moved to Jak's spot and with the levels he had. Once
+;;   target-continue is done with it, the stock checkpoint is put back (deaths respawn there as usual).
+;; Saves made with the option off (or from before it existed) have no valid record and load as in the stock game.
+
+;; set by the host every frame (OpenGOALRuntimeHost.mm SyncDynamicSavePointsOption)
+(define-perm *ios-dynamic-save-points* symbol #f)
+
+(define-extern *ios-driveable-boat* symbol)
+(define-extern *ios-boat-driving* symbol)
+(define-extern *ios-boat-art-resident* symbol)
+(define-extern *ios-free-boat-ppointer* (pointer process))
+(define-extern *ios-free-boat-pid* int)
+(define-extern *ios-free-boat-last-park* vector)
+(define-extern ios-boat-park-store (function vector float int))
+
+;; perm-list entries: +0 x y, +1 z yaw, +2 levels/flags/magic, +3 checkpoint name hash
+(defconstant IOS_DSP_AID_BASE #x7fd50000)
+(defconstant IOS_DSP_MAGIC #x5d5b)
+(defconstant IOS_DSP_NO_LEVEL 255)
+;; flags
+(defconstant IOS_DSP_FLAG_BOAT 1) ;; x y z yaw relative to the free boat (its spot is the save's parked spot)
+
+;; Above the deck / ground when placed, so Jak drops onto it instead of starting inside it.
+(defconstant IOS_DSP_LIFT (meters 0.3))
+;; After loading aboard: frames Jak is held on the free boat once it exists (it spawns after target-continue).
+(defconstant IOS_DSP_BOAT_HOLD_FRAMES 10)
+(defconstant IOS_DSP_BOAT_WAIT (seconds 3))
+;; Initial camera: behind and above Jak (cam-string takes over right away).
+(defconstant IOS_DSP_CAM_BACK (meters 7))
+(defconstant IOS_DSP_CAM_UP (meters 3))
+
+(deftype ios-dsp-record (structure)
+  ((valid     symbol)
+   (pos       vector :inline) ;; w = yaw (relative to the boat with IOS_DSP_FLAG_BOAT)
+   (flags     uint8)
+   (inside    uint8)
+   (lev0      uint8)
+   (lev1      uint8)
+   (vis       uint8)
+   (disp      uint8) ;; disp0 | disp1 << 4
+   (cont-hash uint32)))
+
+(define-perm *ios-dsp-snapshot* ios-dsp-record (new 'global 'ios-dsp-record))
+(set! (-> *ios-dsp-snapshot* valid) #f)
+(define-perm *ios-dsp-continue* continue-point (new 'global 'continue-point))
+;; the stock checkpoint *ios-dsp-continue* stands in for, and where that stand-in is in its use:
+;; 'armed (load-game! set it), 'running (target-continue started), 'boat (holding Jak on the boat), #f
+(define-perm *ios-dsp-stock-continue* continue-point #f)
+(define-perm *ios-dsp-phase* symbol #f)
+(define-perm *ios-dsp-boat-local* vector (new 'global 'vector))
+(define-perm *ios-dsp-boat-frames* int 0)
+(define-perm *ios-dsp-boat-start* time-frame 0)
+(define-perm *ios-dsp-continue-start* time-frame 0)
+;; target-continue never gives up waiting for vis: past this, a level still 'loading is let through
+(defconstant IOS_DSP_VIS_TIMEOUT (seconds 8))
+
+;; Helpers -----------------------------------------------------------------------------------------------------------
+
+(defun ios-dsp-string-hash ((str string))
+  (let ((hash (the-as uint 5381)))
+    (when str
+      (let ((i 0))
+        (while (nonzero? (-> str data i))
+          (set! hash (the-as uint (logand #xffffffff (+ (* hash 33) (-> str data i)))))
+          (+! i 1))))
+    hash))
+
+(defun ios-dsp-level-index ((name symbol))
+  (if (not name)
+    IOS_DSP_NO_LEVEL
+    (let ((info (lookup-level-info name)))
+      (if (or (= info default-level) (< (-> info index) 0) (>= (-> info index) IOS_DSP_NO_LEVEL))
+        IOS_DSP_NO_LEVEL
+        (-> info index)))))
+
+(defun ios-dsp-level-info ((index uint))
+  "level-load-info with this index, #f if none."
+  (when (!= index IOS_DSP_NO_LEVEL)
+    (let ((rest *level-load-list*))
+      (while (not (null? rest))
+        (let ((info (the-as level-load-info (-> (the-as symbol (car rest)) value))))
+          (if (= (-> info index) (the int index)) (return info)))
+        (set! rest (cdr rest)))))
+  (the-as level-load-info #f))
+
+(defun ios-dsp-level-name ((index uint))
+  (let ((info (ios-dsp-level-info index))) (if info (-> info name) #f)))
+
+(defun ios-dsp-disp-code ((disp symbol))
+  (cond
+    ((not disp) 0)
+    ((= disp 'special) 2)
+    ((= disp 'display-self) 3)
+    (else 1)))
+
+(defun ios-dsp-disp-symbol ((code uint))
+  (case code
+    ((0) #f)
+    ((2) 'special)
+    ((3) 'display-self)
+    (else 'display)))
+
+(defun ios-dsp-yaw ((quat quaternion))
+  (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) quat))) (atan (-> fwd x) (-> fwd z))))
+
+(defun ios-dsp-free-boat ()
+  "The Driveable Boat's free boat (fishermans-boat.gc ios-free-boat), or #f."
+  (the-as process-drawable
+          (when (and (= *ios-driveable-boat* #t) (= *ios-boat-art-resident* #t) *ios-free-boat-ppointer*)
+            (let ((proc (-> *ios-free-boat-ppointer* 0)))
+              (if (and proc (= (-> proc pid) *ios-free-boat-pid*)) proc)))))
+
+(defun ios-dsp-on-boat? ((boat process-drawable))
+  "Jak at the boat's wheel or standing on its deck (its only sticky rider slot)."
+  (and boat
+       (or (= *ios-boat-driving* #t)
+           (let ((riders (-> (the-as collide-shape (-> boat root)) riders)))
+             (and (nonzero? riders)
+                  (> (-> riders num-riders) 0)
+                  (= (handle->process (-> riders rider 0 rider-handle)) *target*))))))
+
+(defun ios-dsp-boat-to-local ((dst vector) (boat process-drawable) (pos vector) (yaw float))
+  "pos/yaw in the boat's frame (yaw only: the boat's parked spot keeps no pitch/roll)."
+  (let* ((boat-yaw (ios-dsp-yaw (-> boat root quat)))
+         (dx (- (-> pos x) (-> boat root trans x)))
+         (dz (- (-> pos z) (-> boat root trans z)))
+         (s (sin boat-yaw))
+         (c (cos boat-yaw)))
+    (set-vector! dst
+                 (- (* dx c) (* dz s))
+                 (- (-> pos y) (-> boat root trans y))
+                 (+ (* dx s) (* dz c))
+                 (- yaw boat-yaw)))
+  dst)
+
+(defun ios-dsp-local-to-world ((dst vector) (local vector) (x float) (y float) (z float) (boat-yaw float))
+  "Inverse of ios-dsp-boat-to-local for a boat at x y z facing boat-yaw (w = Jak's world yaw)."
+  (let ((s (sin boat-yaw))
+        (c (cos boat-yaw)))
+    (set-vector! dst
+                 (+ x (* (-> local x) c) (* (-> local z) s))
+                 (+ y (-> local y))
+                 (+ z (- (* (-> local z) c) (* (-> local x) s)))
+                 (+ (-> local w) boat-yaw)))
+  dst)
+
+;; Snapshot (every frame) --------------------------------------------------------------------------------------------
+
+(defun ios-dsp-safe-state? ()
+  "Jak standing, walking, wading or swimming on his own feet, or at the boat's wheel."
+  (let ((state (-> *target* next-state)))
+    (and state
+         (or (member (-> state name)
+                     '(target-stance target-walk target-turn-around target-stance-look-around target-stance-ambient
+                       target-duck-stance target-duck-walk target-wade-stance target-wade-walk target-swim-stance
+                       target-swim-walk))
+             (and (= *ios-boat-driving* #t) (member (-> state name) '(target-grab target-flut-grab)))))))
+
+(defun ios-dsp-update-snapshot ()
+  (let ((snap *ios-dsp-snapshot*))
+    (cond
+      ;; title screen: a new game or a load follows, the old game's spot must not leak into it
+      ((or (not *target*) (level-get *level* 'title) (!= *ios-dynamic-save-points* #t)) (set! (-> snap valid) #f))
+      ((and (not (paused?))
+            (not (movie?))
+            (not *ios-dsp-phase*)
+            (-> *game-info* current-continue)
+            (ios-dsp-safe-state?))
+       (let* ((inside-lev (level-get-target-inside *level*))
+              (lev0 (-> *load-state* want 0 name))
+              (lev1 (-> *load-state* want 1 name))
+              (inside (cond
+                        ((and inside-lev (or (= (-> inside-lev name) lev0) (= (-> inside-lev name) lev1)))
+                         (-> inside-lev name))
+                        (else lev0)))
+              (boat (ios-dsp-free-boat))
+              (pos (-> *target* control trans))
+              (yaw (ios-dsp-yaw (-> *target* control quat))))
+         (when (and inside (!= (ios-dsp-level-index lev0) IOS_DSP_NO_LEVEL))
+           (cond
+             ((ios-dsp-on-boat? boat)
+              (ios-dsp-boat-to-local (-> snap pos) boat pos yaw)
+              (set! (-> snap flags) IOS_DSP_FLAG_BOAT))
+             (else
+              (set! (-> snap pos quad) (-> pos quad))
+              (set! (-> snap pos w) yaw)
+              (set! (-> snap flags) 0)))
+           (set! (-> snap inside) (ios-dsp-level-index inside))
+           (set! (-> snap lev0) (ios-dsp-level-index lev0))
+           (set! (-> snap lev1) (ios-dsp-level-index lev1))
+           (set! (-> snap vis) (ios-dsp-level-index (-> *load-state* vis-nick)))
+           (set! (-> snap disp)
+                 (logior (ios-dsp-disp-code (-> *load-state* want 0 display?))
+                         (shl (ios-dsp-disp-code (-> *load-state* want 1 display?)) 4)))
+           (set! (-> snap cont-hash) (ios-dsp-string-hash (-> *game-info* current-continue name)))
+           (set! (-> snap valid) #t))))))
+  0)
+
+;; Save file perms ---------------------------------------------------------------------------------------------------
+
+(defun ios-dsp-perm ((this game-info) (index int) (create symbol))
+  "One of the four record perms in the perm-list (added at its end when create and there is room)."
+  (let ((perm (lookup-entity-perm-by-aid this (the-as actor-id (+ IOS_DSP_AID_BASE index)))))
+    (when (and (not perm) create)
+      (let ((perms (-> this perm-list)))
+        (when (< (-> perms length) (-> perms allocated-length))
+          (set! perm (-> perms data (-> perms length)))
+          (set! (-> perm quad) (the-as uint128 0))
+          (set! (-> perm aid) (the-as actor-id (+ IOS_DSP_AID_BASE index)))
+          (+! (-> perms length) 1))))
+    perm))
+
+(defun ios-dsp-clear-perms ((this game-info))
+  (let ((perm (ios-dsp-perm this 2 #f))) (if perm (set! (-> perm user-uint16 3) 0)))
+  0)
+
+(defun ios-dsp-write-perms ((this game-info))
+  "Before a save: the snapshot into the perms, or no record when there is nothing usable."
+  (let ((snap *ios-dsp-snapshot*))
+    (cond
+      ((and (= *ios-dynamic-save-points* #t)
+            (-> snap valid)
+            (-> this current-continue)
+            (= (-> snap cont-hash) (ios-dsp-string-hash (-> this current-continue name)))
+            ;; relative to a boat that is still there
+            (or (zero? (logand (-> snap flags) IOS_DSP_FLAG_BOAT)) (ios-dsp-free-boat)))
+       (when (nonzero? (logand (-> snap flags) IOS_DSP_FLAG_BOAT))
+         ;; the save's parked spot = where the boat is now (it only records it every 15 frames)
+         (let* ((boat (ios-dsp-free-boat))
+                (boat-yaw (ios-dsp-yaw (-> boat root quat))))
+           (ios-boat-park-store (-> boat root trans) boat-yaw)
+           ;; the boat checks its spot against this one and would otherwise remove itself (park-replaced?)
+           (when *ios-free-boat-last-park*
+             (set-vector! *ios-free-boat-last-park* (-> boat root trans x) 0.0 (-> boat root trans z) 1.0))))
+       (let ((p0 (ios-dsp-perm this 0 #t))
+             (p1 (ios-dsp-perm this 1 #t))
+             (p2 (ios-dsp-perm this 2 #t))
+             (p3 (ios-dsp-perm this 3 #t)))
+         (cond
+           ((and p0 p1 p2 p3)
+            (set! (-> p0 user-float 0) (-> snap pos x))
+            (set! (-> p0 user-float 1) (-> snap pos y))
+            (set! (-> p1 user-float 0) (-> snap pos z))
+            (set! (-> p1 user-float 1) (-> snap pos w))
+            (set! (-> p2 user-uint8 0) (-> snap inside))
+            (set! (-> p2 user-uint8 1) (-> snap lev0))
+            (set! (-> p2 user-uint8 2) (-> snap lev1))
+            (set! (-> p2 user-uint8 3) (-> snap vis))
+            (set! (-> p2 user-uint8 4) (-> snap disp))
+            (set! (-> p2 user-uint8 5) (-> snap flags))
+            (set! (-> p2 user-uint16 3) IOS_DSP_MAGIC)
+            (set! (-> p3 user-uint32 0) (-> snap cont-hash))
+            (set! (-> p3 user-uint32 1) 0)
+            (format 0 "ios-dynamic-save: saved Jak at ~M ~M ~M (flags ~D)~%"
+                    (-> snap pos x) (-> snap pos y) (-> snap pos z) (-> snap flags)))
+           (else (ios-dsp-clear-perms this)))))
+      (else (ios-dsp-clear-perms this))))
+  0)
+
+(defun ios-dsp-camera ((cont continue-point))
+  "A camera behind and above Jak's spot, looking at him."
+  (let ((fwd (new 'stack-no-clear 'vector))
+        (look (new 'stack-no-clear 'vector))
+        (mat (new 'stack-no-clear 'matrix)))
+    (set-vector! fwd (sin (-> cont trans w)) 0.0 (cos (-> cont trans w)) 1.0)
+    (vector+*! (-> cont camera-trans) (-> cont trans) fwd (- IOS_DSP_CAM_BACK))
+    (+! (-> cont camera-trans y) IOS_DSP_CAM_UP)
+    (set! (-> cont camera-trans w) 1.0)
+    (vector-! look (-> cont trans) (-> cont camera-trans))
+    (+! (-> look y) (meters 1))
+    (forward-down->inv-matrix mat look (new 'static 'vector :y -1.0))
+    (dotimes (row 3)
+      (set! (-> cont camera-rot (* row 3)) (-> mat vector row x))
+      (set! (-> cont camera-rot (+ (* row 3) 1)) (-> mat vector row y))
+      (set! (-> cont camera-rot (+ (* row 3) 2)) (-> mat vector row z))))
+  0)
+
+(defun ios-dsp-apply-perms ((this game-info))
+  "After a load: with a valid record for the save's checkpoint, resume at Jak's saved spot."
+  (let ((stock (-> this current-continue))
+        (p0 (ios-dsp-perm this 0 #f))
+        (p1 (ios-dsp-perm this 1 #f))
+        (p2 (ios-dsp-perm this 2 #f))
+        (p3 (ios-dsp-perm this 3 #f)))
+    (when (and (= *ios-dynamic-save-points* #t)
+               stock
+               (!= stock *ios-dsp-continue*)
+               p0 p1 p2 p3
+               (= (-> p2 user-uint16 3) IOS_DSP_MAGIC)
+               (= (-> p3 user-uint32 0) (ios-dsp-string-hash (-> stock name))))
+      (let ((inside (ios-dsp-level-name (-> p2 user-uint8 0)))
+            (lev0 (ios-dsp-level-name (-> p2 user-uint8 1)))
+            (lev1 (ios-dsp-level-name (-> p2 user-uint8 2)))
+            (local (new 'stack-no-clear 'vector))
+            (cont *ios-dsp-continue*))
+        (set-vector! local (-> p0 user-float 0) (-> p0 user-float 1) (-> p1 user-float 0) (-> p1 user-float 1))
+        (when (and lev0 inside (or (= inside lev0) (= inside lev1)))
+          (cond
+            ((nonzero? (logand (-> p2 user-uint8 5) IOS_DSP_FLAG_BOAT))
+             ;; the boat comes back anchored at the parked spot saved with it (water line y 0)
+             (let ((park (new 'stack-no-clear 'vector))
+                   (perm (lookup-entity-perm-by-aid this (the-as actor-id 10419))))
+               (cond
+                 ((and perm (= (-> perm user-int16 3) #x2b0a))
+                  (set-vector! park
+                               (* (meters 0.25) (the float (-> perm user-int16 0)))
+                               0.0
+                               (* (meters 0.25) (the float (-> perm user-int16 1)))
+                               (the float (-> perm user-int16 2)))
+                  (ios-dsp-local-to-world (-> cont trans) local (-> park x) 0.0 (-> park z) (-> park w))
+                  (set! (-> *ios-dsp-boat-local* quad) (-> local quad)))
+                 (else (return 0)))))
+            (else (set! (-> cont trans quad) (-> local quad))))
+          (+! (-> cont trans y) IOS_DSP_LIFT)
+          (quaternion-axis-angle! (-> cont quat) 0.0 1.0 0.0 (-> cont trans w))
+          (ios-dsp-camera cont)
+          (set! (-> cont trans w) 1.0)
+          (set! (-> cont name) (-> stock name))
+          (set! (-> cont level) inside)
+          (set! (-> cont flags) (continue-flags))
+          (set! (-> cont load-commands) (if (= inside (-> stock level)) (-> stock load-commands) '()))
+          ;; the vis of the level Jak is in, like every stock checkpoint: target-continue waits for that
+          ;; level's vis, which only loads for the vis-nick level (the recorded *load-state* vis-nick is often
+          ;; the neighbouring level's, which left the screen black forever)
+          (let ((vis (lookup-level-info inside)))
+            (set! (-> cont vis-nick) (if (!= vis default-level) (-> vis nickname) (-> stock vis-nick))))
+          (set! (-> cont lev0) lev0)
+          (set! (-> cont disp0) (ios-dsp-disp-symbol (logand (-> p2 user-uint8 4) 15)))
+          (set! (-> cont lev1) lev1)
+          (set! (-> cont disp1) (if lev1 (ios-dsp-disp-symbol (shr (-> p2 user-uint8 4) 4)) #f))
+          (set! *ios-dsp-stock-continue* stock)
+          (set! (-> this current-continue) cont)
+          (set! *ios-dsp-phase*
+                (if (nonzero? (logand (-> p2 user-uint8 5) IOS_DSP_FLAG_BOAT)) 'armed-boat 'armed))
+          (format 0 "ios-dynamic-save: resuming at ~M ~M ~M in ~A (~A ~A)~%"
+                  (-> cont trans x) (-> cont trans y) (-> cont trans z) inside lev0 lev1)))))
+  0)
+
+;; Stand-in checkpoint lifecycle (every frame, paused or not) ---------------------------------------------------------
+
+(defun ios-dsp-restore-stock-continue ()
+  (when (= (-> *game-info* current-continue) *ios-dsp-continue*)
+    ;; straight into the field: set-continue! would reset the checkpoint's death count and time
+    (set! (-> *game-info* current-continue) *ios-dsp-stock-continue*))
+  0)
+
+(defun ios-dsp-hold-on-boat ()
+  "After loading aboard: the free boat spawns once target-continue is done, so keep Jak on its deck for a few
+   frames after it appears (he would drop into the sea before it is there)."
+  (let ((boat (ios-dsp-free-boat)))
+    (cond
+      ((and boat *target*)
+       (let ((pos (new 'stack-no-clear 'vector)))
+         (ios-dsp-local-to-world pos *ios-dsp-boat-local*
+                                 (-> boat root trans x) (-> boat root trans y) (-> boat root trans z)
+                                 (ios-dsp-yaw (-> boat root quat)))
+         (+! (-> pos y) IOS_DSP_LIFT)
+         (set! (-> pos w) 1.0)
+         (move-to-point! (-> *target* control) pos)
+         (vector-reset! (-> *target* control transv)))
+       (+! *ios-dsp-boat-frames* 1)
+       (if (>= *ios-dsp-boat-frames* IOS_DSP_BOAT_HOLD_FRAMES) (set! *ios-dsp-phase* #f)))
+      ((time-elapsed? *ios-dsp-boat-start* IOS_DSP_BOAT_WAIT)
+       (format 0 "ios-dynamic-save: no free boat after loading aboard~%")
+       (set! *ios-dsp-phase* #f))))
+  0)
+
+(defun ios-dsp-update-phase ()
+  (let ((in-continue (and *target*
+                          (-> *target* next-state)
+                          (= (-> *target* next-state name) 'target-continue))))
+    (case *ios-dsp-phase*
+      (('armed 'armed-boat)
+       (cond
+         (in-continue
+          (set-time! *ios-dsp-continue-start*)
+          (set! *ios-dsp-phase* (if (= *ios-dsp-phase* 'armed-boat) 'running-boat 'running)))
+         ;; a new game or another load replaced it before it was used
+         ((!= (-> *game-info* current-continue) *ios-dsp-continue*) (set! *ios-dsp-phase* #f))))
+      (('running 'running-boat)
+       (when (and in-continue (time-elapsed? *ios-dsp-continue-start* IOS_DSP_VIS_TIMEOUT))
+         (dotimes (i (-> *level* length))
+           (let ((lev (-> *level* level i)))
+             (when (and (= (-> lev status) 'active) (= (-> lev all-visible?) 'loading))
+               (format 0 "ios-dynamic-save: no vis for ~A, continuing without it~%" (-> lev name))
+               (set! (-> lev all-visible?) #t))))
+         ;; same for the other level it waits on: don't wait for it to be displayed (Jak's own level still is)
+         (let ((cont *ios-dsp-continue*))
+           (when (and (-> cont lev1) (-> cont disp1) (!= (-> cont lev1) (-> cont level))
+                      (!= (level-status *level* (-> cont lev1)) 'active))
+             (format 0 "ios-dynamic-save: ~A not active, continuing without it~%" (-> cont lev1))
+             (set! (-> cont disp1) #f))
+           (when (and (-> cont lev0) (-> cont disp0) (!= (-> cont lev0) (-> cont level))
+                      (!= (level-status *level* (-> cont lev0)) 'active))
+             (format 0 "ios-dynamic-save: ~A not active, continuing without it~%" (-> cont lev0))
+             (set! (-> cont disp0) #f))))
+       (when (not in-continue)
+         (ios-dsp-restore-stock-continue)
+         (cond
+           ((= *ios-dsp-phase* 'running-boat)
+            (set! *ios-dsp-boat-frames* 0)
+            (set-time! *ios-dsp-boat-start*)
+            (set! *ios-dsp-phase* 'boat))
+           (else (set! *ios-dsp-phase* #f)))))
+      (('boat) (if (not (paused?)) (ios-dsp-hold-on-boat)))))
+  0)
+
+;; Engine hooks ------------------------------------------------------------------------------------------------------
+
+;; define-perm: the originals are taken once, so wrapping can never wrap itself
+(define-perm *ios-dsp-orig-save-game* function (method-of-type game-info save-game!))
+(define-perm *ios-dsp-orig-load-game* function (method-of-type game-info load-game!))
+
+(defmethod save-game! ((this game-info) (arg0 game-save) (arg1 string))
+  (ios-dsp-write-perms this)
+  ((the-as (function game-info game-save string none) *ios-dsp-orig-save-game*) this arg0 arg1)
+  (none))
+
+(defmethod load-game! ((this game-info) (save game-save))
+  ;; whatever happens below, the snapshot was of the game being left
+  (set! (-> *ios-dsp-snapshot* valid) #f)
+  (set! *ios-dsp-phase* #f)
+  ((the-as (function game-info game-save game-save) *ios-dsp-orig-load-game*) this save)
+  (if (zero? (-> save new-game)) (ios-dsp-apply-perms this))
+  save)
+
+;; Chain into *menu-hook* (after ios-boat-park's). This file's top-level only runs once, at boot.
+(define *ios-dsp-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-dsp-menu-hook ()
+  (ios-dsp-update-phase)
+  (ios-dsp-update-snapshot)
+  (*ios-dsp-prev-menu-hook*)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-dsp-menu-hook))
diff --git a/goal_src/jak1/pc/ios/ios-fishing.gc b/goal_src/jak1/pc/ios/ios-fishing.gc
new file mode 100644
index 000000000..62b39db20
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-fishing.gc
@@ -0,0 +1,1104 @@
+;;-*-Lisp-*-
+(in-package goal)
+
+;; og:ios Fishing mode (fishing phase 3, user 2026-10-17). Action menu > Fish (host: *ios-fishing-request*) while
+;; *ios-can-fish* (ios-ocean-fish.gc) starts it:
+;; - Jak is grabbed and hidden; the camera is a first-person view from his eyes (cam-fixed, steered here every
+;;   frame) that only turns left/right (stick, d-pad or swipes), up to IOS_FISHING_YAW_LIMIT either way.
+;; - The rod is one of the fisherman's hut poles (Jak1Level-ios-rod.fr3z, drawn by the host's background renderer
+;;   from *ios-fishing-rod*), held at the lower right of the view pointing out at 45 degrees.
+;; - Square casts: the rod swings back and forward and throws the bobber (the precursor orb model, tinted red)
+;;   on an arc onto the water ahead, where it bobs and drifts. The line runs from the rod tip to the bobber
+;;   (GS triangle strip in the debug bucket, with the depth test).
+;; - X reels the line in a step at a time; once the bobber is back the rod is ready to cast again.
+;; - O leaves fishing mode. Hints are shown top right, where the driveable boat shows its controls.
+;; Bites, the reel-in fight and catches come with phases 4 and 5 (they will read *ios-fishing-bobber-pos* and
+;; *ios-fishing-phase*).
+;;
+;; Linked as a startup object (aot_level_code_link.py --startup-object ios-fishing, after ios-action-menu): its
+;; top-level runs once at boot and chains the per-frame update into *menu-hook*.
+
+;; ios-ocean-fish.gc
+(define-extern *ios-ocean-fish* symbol)
+(define-extern *ios-can-fish* symbol)
+(define-extern ios-fish-entity (function entity-actor))
+(define-extern ios-fish-water-column (function vector process vector symbol))
+(define-extern ios-fish-surface (function vector float))
+(define-extern *ios-fish-water-yaw* float)
+(define-extern ios-fish-manager-get (function ios-fish-manager))
+(define-extern *ios-fish-roster* ios-fish-roster)
+(define-extern ios-fish-skel (function int skeleton-group))
+(define-extern ios-fish-anim-index (function int int))
+(define-extern ios-fish-scale (function int float))
+
+;; written by the host: Action menu > Fish was chosen (cleared here)
+(define-perm *ios-fishing-request* symbol #f)
+;; read by the host and ios-action-menu.gc: fishing mode is on
+(define-perm *ios-fishing-active* symbol #f)
+
+;; ---- tuning --------------------------------------------------------------------------------------------------
+
+(defconstant IOS_FISHING_EYE_HEIGHT (meters 1.9))     ;; was 1.6 (user 2026-10-17: a little higher)
+(defconstant IOS_FISHING_FOV (degrees 74))            ;; a little wider than the usual ~64 degrees
+(defconstant IOS_FISHING_PITCH (degrees 9))           ;; the view looks this far down
+(defconstant IOS_FISHING_YAW_LIMIT (degrees 80))      ;; either side of the facing fishing started with
+(defconstant IOS_FISHING_TURN_RATE (degrees 90))      ;; per second at full stick
+;; rod (the hut pole is 7.09 m long upright; drawn at IOS_FISHING_ROD_SCALE)
+(defconstant IOS_FISHING_ROD_MODEL_LENGTH (meters 7.09))
+(defconstant IOS_FISHING_ROD_SCALE 0.36)
+(defconstant IOS_FISHING_ROD_RIGHT (meters 0.45))     ;; base, in the view: right of centre ...
+(defconstant IOS_FISHING_ROD_DOWN (meters 0.55))      ;; ... below the eye ...
+(defconstant IOS_FISHING_ROD_AHEAD (meters 0.6))      ;; ... and ahead of it
+(defconstant IOS_FISHING_ROD_REST (degrees 45))       ;; rod angle above the view direction at rest
+(defconstant IOS_FISHING_ROD_INWARD (degrees 14))     ;; tip leaning towards the middle of the view
+;; cast
+(defconstant IOS_FISHING_CAST_MIN (meters 13))       ;; was 11-17 m (user 2026-10-18: a little further)
+(defconstant IOS_FISHING_CAST_MAX (meters 20))
+(defconstant IOS_FISHING_CAST_ARC (meters 3.5))       ;; how high the bobber flies above the straight line
+(defconstant IOS_FISHING_FLIGHT_TIME (seconds 1.1))
+;; line
+(defconstant IOS_FISHING_LINE_POINTS 12)
+(defconstant IOS_FISHING_LINE_HALF_WIDTH 8)           ;; GS units (1/16 of a 512-wide screen pixel)
+(defconstant IOS_FISHING_BOBBER_TOP (meters 0.4))      ;; the line meets the bobber this far above its origin
+;; reel
+(defconstant IOS_FISHING_REEL_STEP (meters 0.7))
+(defconstant IOS_FISHING_REEL_SPEED (meters 4))       ;; per second, while a step is being pulled in
+(defconstant IOS_FISHING_REEL_DONE (meters 2.2))      ;; bobber this close (xz): line is in
+
+;; bites (fishing phase 4); "eager" = 1 - 0.15 * rarity (Common 1.0 .. Legendary 0.4)
+(defconstant IOS_FISHING_NOTICE_RANGE (meters 12))   ;; fish this close to the bobber may go for it
+(defconstant IOS_FISHING_NOTICE_CHANCE 0.25)         ;; per fish, per check (every 0.5 s), times eager
+(defconstant IOS_FISHING_BITE_RANGE (meters 1.0))
+(defconstant IOS_FISHING_BITE_CHANCE 0.4)            ;; per check while under the bobber, times eager
+(defconstant IOS_FISHING_LOSE_INTEREST (seconds 10)) ;; no bite this long after turning towards it: swims off
+(defconstant IOS_FISHING_PULL_SPEED (meters 0.5))    ;; a hooked fish pulls the bobber away, plus 0.15 m/s per rarity
+(defconstant IOS_FISHING_MAX_LINE (meters 20))
+;; break odds lowered three times (user 2026-10-17: from 0.02 / 0.015 / 0.12, then 25% less, then halved)
+(defconstant IOS_FISHING_BREAK_BASE 0.00525)         ;; per reel press while hooked, plus IOS_FISHING_BREAK_RARITY per rarity ...
+(defconstant IOS_FISHING_BREAK_RARITY 0.00375)
+(defconstant IOS_FISHING_BREAK_TENSION 0.03)         ;; ... plus this per unit of tension over 1
+(defconstant IOS_FISHING_TENSION_PER_PRESS 0.35)
+(defconstant IOS_FISHING_TENSION_DECAY 0.7)          ;; per second
+(defconstant IOS_FISHING_MESSAGE_TIME (seconds 1.6))
+;; catch reveal: X does nothing (and isn't offered) for this long, so a reeling tap doesn't skip it
+(defconstant IOS_FISHING_REVEAL_LOCK (seconds 3))
+;; Shown fish (catch reveal, Fish menu preview) are normal world models held IOS_FISHING_SHOW_DIST in front of the
+;; camera at IOS_FISHING_SHOW_SCALE of their ocean size (= their size 2.4 m out), so nothing in the world is in front
+;; of them. (Screen-space HUD drawing, as the pause menu's icons, never showed these models on iOS.) They are marked
+;; so the renderer draws them after the sprite bucket, over the pause menu's panels: color-mult w = 0 and
+;; color-emissive w = IOS_FISHING_SHOW_MARK make the Merc packet's light colour w 0 and ambient w exactly that value
+;; (dma-add-process-drawable: ambient = ambient x mult + emissive), which nothing else produces
+;; (Jak1MetalRenderer.mm MercSubmission::onTop). The ambient alpha is ~1, as usual.
+(defconstant IOS_FISHING_SHOW_DIST (meters 1.0))
+(defconstant IOS_FISHING_SHOW_SCALE 0.4167) ;; 1.0 / 2.4
+(defconstant IOS_FISHING_SHOW_MARK #x3f800001) ;; 1.0000001
+
+;; phases
+(defconstant IOS_FISHING_READY 0)    ;; bobber hangs from the rod tip
+(defconstant IOS_FISHING_FLYING 1)   ;; cast: bobber in the air
+(defconstant IOS_FISHING_FLOATING 2) ;; bobber on the water
+(defconstant IOS_FISHING_HOOKED 3)   ;; a fish is on the line
+(defconstant IOS_FISHING_REVEAL 4)   ;; a fish was landed: shown in front of the camera until X
+
+;; messages
+(defconstant IOS_FISHING_MESSAGE_NONE 0)
+(defconstant IOS_FISHING_MESSAGE_CAUGHT 1)
+(defconstant IOS_FISHING_MESSAGE_GOT_AWAY 2)
+
+;; ---- shared with the host and the later phases ---------------------------------------------------------------
+
+;; The rod's pose for the host renderer (OpenGOALRuntimeHost.mm SyncFishingRod -> Jak1Background SetFishingRod):
+;; base (w = 1 while drawn) and the world images of the rod model's x / y (along the rod) / z axes, scaled.
+(deftype ios-fishing-rod-pose (structure)
+  ((origin vector :inline)
+   (axis-x vector :inline)
+   (axis-y vector :inline)
+   (axis-z vector :inline))
+  :size-assert #x40)
+
+(define *ios-fishing-rod* (new 'global 'ios-fishing-rod-pose))
+(set! (-> *ios-fishing-rod* origin w) 0.0)
+(define *ios-fishing-bobber-pos* (new 'global 'vector))
+(define *ios-fishing-bobber-hidden* #f)
+(define *ios-fishing-phase* -1) ;; -1 = not fishing
+;; a fish was reeled all the way in: its species; count goes up by one per catch. The host then adds it to the
+;; save's fishing log and fills *ios-fishing-reveal* for that catch (serial = the count).
+(define *ios-fishing-landed-species* -1)
+(define *ios-fishing-landed-count* 0)
+
+;; Catch reveal text, written by the host (OpenGOALRuntimeHost.mm SyncActionMenu): the name (game-encoded, in place)
+;; and whether it is the save's first of that species. Shown once serial matches *ios-fishing-landed-count*.
+(deftype ios-fishing-reveal (structure)
+  ((serial int32  :offset 0)
+   (new    int32  :offset 4)
+   (name   string :offset 8))
+  :size-assert #xc)
+
+(define *ios-fishing-reveal* (new 'global 'ios-fishing-reveal))
+(set! (-> *ios-fishing-reveal* serial) -1)
+(set! (-> *ios-fishing-reveal* name) (new 'global 'string 64 (the-as string #f)))
+
+;; ---- types ---------------------------------------------------------------------------------------------------
+
+(deftype ios-fisher (process)
+  ((yaw          float)
+   (yaw-center   float)
+   (phase        int32)
+   (phase-time   time-frame)
+   (swing-time   time-frame)  ;; the rod's cast swing started (0: not swinging)
+   (released     symbol)      ;; this swing has thrown the bobber
+   (whooshed     symbol)      ;; this swing has played its forward woosh
+   (eye         vector :inline)
+   (fwd          vector :inline)
+   (right        vector :inline)
+   (up           vector :inline)
+   (rod-tip      vector :inline)
+   (cast-from    vector :inline)
+   (cast-to      vector :inline)
+   (bobber       vector :inline)
+   (drift        vector :inline)
+   (reel-pending float)
+   (bob-phase    float)
+   (water-time   time-frame)
+   (start-time   time-frame)
+   (lure         handle)      ;; the fish school going for / hooked on the bobber
+   (lure-check   time-frame)
+   (tension      float)
+   (shake        float)       ;; bite shake, 1 -> 0
+   (message      int32)
+   (message-time time-frame)
+   (trophy       handle))     ;; the landed fish on show
+  (:states
+   ios-fisher-fishing
+   ios-fisher-refused))
+
+(deftype ios-fishing-bobber (process-drawable)
+  ()
+  (:states
+   ios-fishing-bobber-idle))
+
+;; The landed fish, shown in front of the camera during the catch reveal (fishing phase 5).
+(deftype ios-fishing-trophy (process-drawable)
+  ((kind  int32)
+   (spin  float)
+   (size  float))
+  (:states
+   ios-fishing-trophy-show))
+
+(define-extern ios-fishing-trophy-init-by-other (function int none :behavior ios-fishing-trophy))
+
+(define *ios-fisher-ppointer* (the-as (pointer process) #f))
+(define *ios-fisher-pid* 0)
+
+(defun ios-fisher-get ()
+  (let ((pp *ios-fisher-ppointer*))
+    (the-as ios-fisher
+            (when pp
+              (let ((proc (-> pp 0)))
+                (if (and proc (= (-> proc pid) *ios-fisher-pid*)) proc))))))
+
+;; ---- bobber --------------------------------------------------------------------------------------------------
+
+(defbehavior ios-fishing-bobber-init-by-other ios-fishing-bobber ()
+  (set! (-> self entity) (ios-fish-entity))
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! (-> self root) (new 'process 'trsqv))
+  (set! (-> self root trans quad) (-> *ios-fishing-bobber-pos* quad))
+  (initialize-skeleton self *money-sg* '())
+  (set! (-> self skel effect) #f)
+  (set-vector! (-> self root scale) 0.35 0.35 0.35 1.0)
+  ;; red, slightly self-lit, so it reads as a float rather than a precursor orb
+  (set-vector! (-> self draw color-mult) 1.4 0.32 0.28 1.0)
+  (set-vector! (-> self draw color-emissive) 0.25 0.05 0.04 0.0)
+  (go ios-fishing-bobber-idle)
+  (none))
+
+(defstate ios-fishing-bobber-idle (ios-fishing-bobber)
+  :trans
+    (behavior ()
+      (cond
+        ((ppointer->process (-> self parent))
+         (set! (-> self root trans quad) (-> *ios-fishing-bobber-pos* quad))
+         (if *ios-fishing-bobber-hidden*
+           (logior! (-> self draw status) (draw-status hidden))
+           (logclear! (-> self draw status) (draw-status hidden))))
+        (else (deactivate self))))
+  :code
+    (behavior ()
+      (ja-channel-set! 0)
+      (loop
+        (suspend)))
+  :post ja-post)
+
+;; ---- view, rod and camera ------------------------------------------------------------------------------------
+
+(defun ios-fishing-eat-buttons ((buttons pad-buttons))
+  "Consume these presses entirely, including the high-fps *cpad-history-list* (Jak's states read it)."
+  (logclear! (-> *cpad-list* cpads 0 button0-abs 0) buttons)
+  (logclear! (-> *cpad-list* cpads 0 button0-rel 0) buttons)
+  (let ((history (-> *cpad-history-list* cpads 0)))
+    (dotimes (i 15)
+      (logclear! (-> history button0-rel i) buttons)))
+  0)
+
+(defbehavior ios-fisher-update-view ios-fisher ()
+  "Turn with the sticks / d-pad (swipes arrive as the right stick), then the eye and its basis. No turning while a
+   catch is shown (until X clears it)."
+  (let* ((pad (-> *cpad-list* cpads 0))
+         (turn (+ (analog-input (the-as int (-> pad leftx)) 128.0 48.0 110.0 1.0)
+                  (analog-input (the-as int (-> pad rightx)) 128.0 48.0 110.0 1.0))))
+    (cond
+      ((cpad-hold? 0 right) (set! turn 1.0))
+      ((cpad-hold? 0 left) (set! turn -1.0)))
+    (set! turn (fmax -1.0 (fmin 1.0 turn)))
+    (if (= (-> self phase) IOS_FISHING_REVEAL) (set! turn 0.0))
+    ;; stick right turns the view right (yaw = atan(x, z) grows to the left)
+    (set! (-> self yaw) (- (-> self yaw) (* turn IOS_FISHING_TURN_RATE (seconds-per-frame))))
+    (let ((off (deg- (-> self yaw) (-> self yaw-center))))
+      (set! (-> self yaw) (+ (-> self yaw-center) (fmax (- IOS_FISHING_YAW_LIMIT) (fmin IOS_FISHING_YAW_LIMIT off))))))
+  (let ((pos (target-pos 0))
+        (c (cos IOS_FISHING_PITCH))
+        (s (sin IOS_FISHING_PITCH)))
+    (set-vector! (-> self eye) (-> pos x) (+ (-> pos y) IOS_FISHING_EYE_HEIGHT) (-> pos z) 1.0)
+    (set-vector! (-> self fwd) (* c (sin (-> self yaw))) (- s) (* c (cos (-> self yaw))) 0.0)
+    ;; right = up x forward, made to agree with the camera's own right (the sign depends on handedness)
+    (vector-cross! (-> self right) *up-vector* (-> self fwd))
+    (vector-normalize! (-> self right) 1.0)
+    (if (< (vector-dot (-> self right) (-> *math-camera* inv-camera-rot vector 0)) 0.0)
+      (vector-negate! (-> self right) (-> self right)))
+    (vector-cross! (-> self up) (-> self fwd) (-> self right))
+    (vector-normalize! (-> self up) 1.0)
+    (if (< (-> self up y) 0.0) (vector-negate! (-> self up) (-> self up))))
+  0)
+
+(defbehavior ios-fisher-update-camera ios-fisher ()
+  "The newest camera slave, once it is cam-fixed: our eye, looking along fwd."
+  (when (> (-> *camera* num-slaves) 0)
+    (let ((slave (the-as camera-slave (ppointer->process (-> *camera* slave (+ -1 (-> *camera* num-slaves)))))))
+      (when (and slave (= (-> slave state) cam-fixed))
+        (set! (-> slave saved-pt quad) (-> self eye quad))
+        (set! (-> slave trans quad) (-> self eye quad))
+        (forward-down->inv-matrix (-> slave tracking inv-mat) (-> self fwd) (-> *camera* local-down))
+        (set! (-> slave fov) IOS_FISHING_FOV))))
+  0)
+
+(defbehavior ios-fisher-rod-angle ios-fisher ()
+  "Rod angle above the view direction: at rest, or along the cast swing (back, snap forward, settle).
+   The snap forward plays Jak's punch woosh."
+  (if (zero? (-> self swing-time))
+    IOS_FISHING_ROD_REST
+    (let ((t (/ (the float (- (current-time) (-> self swing-time))) (the float (seconds 1)))))
+      (when (and (>= t 0.25) (not (-> self whooshed)))
+        (set! (-> self whooshed) #t)
+        (sound-play "punch"))
+      (cond
+        ((< t 0.25) (lerp IOS_FISHING_ROD_REST (degrees 95) (/ t 0.25)))
+        ((< t 0.4) (lerp (degrees 95) (degrees 0) (/ (- t 0.25) 0.15)))
+        ((< t 0.8) (lerp (degrees 0) IOS_FISHING_ROD_REST (/ (- t 0.4) 0.4)))
+        (else
+         (set! (-> self swing-time) 0)
+         IOS_FISHING_ROD_REST)))))
+
+(defbehavior ios-fisher-update-rod ios-fisher ()
+  "Rod pose for the renderer, and its tip. The rod is fixed in the view, so it is given in camera space (*math-camera*
+   inv-camera-rot axes; origin w = 2) and the renderer places it with the camera of the frame it is drawn in: worked
+   out here in world space it lagged the turning camera by a frame and jittered (user 2026-10-17)."
+  (let* ((rod *ios-fishing-rod*)
+         (cam *math-camera*)
+         (angle (ios-fisher-rod-angle))
+         ;; the view's right / up / forward in camera coordinates (camera y may point down)
+         (up-sign (if (< (vector-dot (-> cam inv-camera-rot vector 1) *up-vector*) 0.0) -1.0 1.0))
+         (right (new 'static 'vector :x 1.0))
+         (up (new 'stack-no-clear 'vector))
+         (fwd (new 'static 'vector :z 1.0))
+         (dir (new 'stack-no-clear 'vector))
+         (across (new 'stack-no-clear 'vector))
+         (third (new 'stack-no-clear 'vector))
+         (tip (new 'stack-no-clear 'vector))
+         (scale IOS_FISHING_ROD_SCALE))
+    (set-vector! up 0.0 up-sign 0.0 0.0)
+    ;; base at the lower right of the view
+    (set-vector! (-> rod origin) IOS_FISHING_ROD_RIGHT (* up-sign (- IOS_FISHING_ROD_DOWN)) IOS_FISHING_ROD_AHEAD 1.0)
+    ;; put away while a catch is shown; 2 = camera space
+    (set! (-> rod origin w) (if (= (-> self phase) IOS_FISHING_REVEAL) 0.0 2.0))
+    ;; along the rod: forward tilted up by the angle, leaning in towards the middle
+    (vector-float*! dir fwd (cos angle))
+    (vector+*! dir dir up (sin angle))
+    (vector+*! dir dir right (- (sin IOS_FISHING_ROD_INWARD)))
+    (vector-normalize! dir 1.0)
+    (vector-cross! across dir up)
+    (vector-normalize! across 1.0)
+    (vector-cross! third across dir)
+    ;; roll the rod 90 degrees about its length, counter-clockwise as seen in the view (user 2026-10-17): the reel,
+    ;; which pointed to the left of the view, points down. For axes across the rod, a quarter turn is
+    ;; k x v with k = +-dir, the sign chosen so the turn carries the view's right onto its up.
+    (let ((right-up (vector-cross! (new 'stack-no-clear 'vector) right up))
+          (rolled (new 'stack-no-clear 'vector)))
+      (let ((k (if (< (vector-dot right-up dir) 0.0) -1.0 1.0)))
+        (vector-cross! rolled dir across)
+        (vector-float*! across rolled k)
+        (vector-cross! rolled dir third)
+        (vector-float*! third rolled k)))
+    (vector-float*! (-> rod axis-x) across scale)
+    (vector-float*! (-> rod axis-y) dir scale)
+    (vector-float*! (-> rod axis-z) third scale)
+    ;; the tip in world space, through the same camera the line is projected with (so the line meets the rod)
+    (vector+*! tip (-> rod origin) dir (* scale IOS_FISHING_ROD_MODEL_LENGTH))
+    (vector+*! (-> self rod-tip) (-> cam trans) (-> cam inv-camera-rot vector 0) (-> tip x))
+    (vector+*! (-> self rod-tip) (-> self rod-tip) (-> cam inv-camera-rot vector 1) (-> tip y))
+    (vector+*! (-> self rod-tip) (-> self rod-tip) (-> cam inv-camera-rot vector 2) (-> tip z))
+    (set! (-> self rod-tip w) 1.0))
+  0)
+
+;; ---- line ----------------------------------------------------------------------------------------------------
+
+(defun ios-fishing-draw-line ((from vector) (to vector) (sag float))
+  "The line from FROM to TO, hanging SAG at its middle: a thin screen-space triangle strip in the debug bucket,
+   depth tested against the scene. Points behind the camera end the line there."
+  (let ((screen (new 'stack-no-clear 'inline-array 'vector4w 13)) ;; IOS_FISHING_LINE_POINTS + 1
+        (p (new 'stack-no-clear 'vector))
+        (count 0))
+    (dotimes (i (+ IOS_FISHING_LINE_POINTS 1))
+      (when (= count i)
+        (let ((t (/ (the float i) (the float IOS_FISHING_LINE_POINTS))))
+          (vector-lerp! p from to t)
+          (set! (-> p y) (- (-> p y) (* sag 4.0 t (- 1.0 t))))
+          (set! (-> p w) 1.0)
+          (if (transform-point-qword! (-> screen i) p) (+! count 1)))))
+    (when (>= count 2)
+      (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug))
+        (dma-buffer-add-gs-set buf
+                               (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest greater-equal)))
+                               (zbuf-1 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24) :zmsk #x1)))
+        (with-cnt-vif-block (buf)
+          (dma-buffer-add-gif-tag buf
+                                  (new 'static 'gif-tag64 :nloop (* 2 count) :eop 1 :pre 1 :nreg 2 :prim (gif-prim tri-strip))
+                                  (gs-reg-list rgbaq xyzf2))
+          (let ((color (new 'stack-no-clear 'vector4w))
+                (v (new 'stack-no-clear 'vector4w)))
+            (set! (-> color x) 150)
+            (set! (-> color y) 150)
+            (set! (-> color z) 140)
+            (set! (-> color w) 128)
+            (dotimes (i count)
+              ;; across the line in screen space, from its direction at this point
+              (let* ((a (-> screen (max 0 (+ i -1))))
+                     (b (-> screen (min (+ count -1) (+ i 1))))
+                     (dx (the float (- (-> b x) (-> a x))))
+                     (dy (the float (- (-> b y) (-> a y))))
+                     (len (fmax 1.0 (sqrtf (+ (* dx dx) (* dy dy)))))
+                     (nx (the int (* (- dy) (/ (the float IOS_FISHING_LINE_HALF_WIDTH) len))))
+                     (ny (the int (* dx (/ (the float IOS_FISHING_LINE_HALF_WIDTH) len)))))
+                (set! (-> v quad) (-> screen i quad))
+                (+! (-> v x) nx)
+                (+! (-> v y) ny)
+                (dma-buffer-add-uint128 buf (-> color quad) (-> v quad))
+                (set! (-> v quad) (-> screen i quad))
+                (+! (-> v x) (- nx))
+                (+! (-> v y) (- ny))
+                (dma-buffer-add-uint128 buf (-> color quad) (-> v quad))))))
+        ;; back to what the debug bucket's text and HUD expect
+        (dma-buffer-add-gs-set buf (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest always)))))))
+  0)
+
+;; ---- hints ---------------------------------------------------------------------------------------------------
+
+(defun ios-fishing-hint-line ((str string) (font font-context) (alpha int))
+  "One hint line. print-game-text only fades the main colour, so fade the pad glyph colours too."
+  (dotimes (i 7)
+    (set-font-color-alpha (the-as font-color (-> (new 'static 'array uint8 7 1 22 23 24 25 26 27) i)) alpha))
+  (print-game-text str font #f alpha 22)
+  (dotimes (i 7)
+    (set-font-color-alpha (the-as font-color (-> (new 'static 'array uint8 7 1 22 23 24 25 26 27) i)) 128))
+  (+! (-> font origin y) 15.0)
+  0)
+
+(defun ios-fishing-draw-hints ((since time-frame))
+  "Fishing controls, right-aligned under the touch HUD button (where the driveable boat shows its controls).
+   Shown for 5 seconds after fishing starts, then faded out over 1 second (user 2026-10-17)."
+  (let* ((elapsed (the int (- (current-time) since)))
+         (alpha (if (< elapsed (the int (seconds 5)))
+                  128
+                  (- 128 (/ (* 128 (- elapsed (the int (seconds 5)))) (the int (seconds 1)))))))
+    (when (> alpha 0)
+      (let ((font (new 'stack 'font-context *font-default-matrix* 464 26 0.0 (font-color default) (font-flags shadow kerning))))
+        (set-scale! font 0.7)
+        (set-width! font 300)
+        (set-height! font 20)
+        (set! (-> font flags) (font-flags shadow kerning right large))
+        ;; <PAD_SQUARE>, <PAD_X>, <PAD_CIRCLE> in the game font (common/util/font/dbs/font_db_jak1.cpp)
+        (ios-fishing-hint-line "PRESS ~Y~22L<~Z~Y~24L#~Z~Y~1L>~Z~Y~23L[~Z~+26H TO CAST" font alpha)
+        (ios-fishing-hint-line "PRESS ~Y~22L<~Z~Y~27L*~Z~Y~1L>~Z~Y~23L[~Z~+26H TO REEL IN" font alpha)
+        (ios-fishing-hint-line "PRESS ~Y~22L<~Z~Y~25L@~Z~Y~1L>~Z~Y~23L[~Z~+26H TO EXIT" font alpha))))
+  0)
+
+;; ---- casting and the bobber ----------------------------------------------------------------------------------
+
+(defbehavior ios-fisher-go-phase ios-fisher ((phase int))
+  (set! (-> self phase) phase)
+  (set-time! (-> self phase-time))
+  (set! *ios-fishing-phase* phase)
+  0)
+
+(defbehavior ios-fisher-pick-cast-target ios-fisher ()
+  "A spot on the water ahead, IOS_FISHING_CAST_MIN-MAX away; nearer if that is land, #f if there is no water
+   ahead at all."
+  (let ((flat (new 'stack-no-clear 'vector))
+        (col (new 'stack-no-clear 'vector))
+        (dist (rand-vu-float-range IOS_FISHING_CAST_MIN IOS_FISHING_CAST_MAX))
+        (found #f))
+    (set-vector! flat (-> self fwd x) 0.0 (-> self fwd z) 0.0)
+    (vector-normalize! flat 1.0)
+    (while (and (not found) (< (meters 3) dist))
+      (vector+*! (-> self cast-to) (-> self eye) flat dist)
+      (if (ios-fish-water-column (-> self cast-to) self col)
+        (set! found #t)
+        (set! dist (- dist (meters 1.5)))))
+    (when found
+      (set! (-> self cast-to y) (-> col y))
+      (set! (-> self cast-to w) 1.0))
+    found))
+
+(defbehavior ios-fisher-lure-school ios-fisher ()
+  (the-as ios-fish-school (handle->process (-> self lure))))
+
+(defbehavior ios-fisher-lure-rarity ios-fisher ()
+  "Rarity of the fish going for / on the line (0 Common .. 4 Legendary)."
+  (let ((school (ios-fisher-lure-school)))
+    (if school (-> *ios-fish-roster* species (-> school species) rarity) 0)))
+
+(defbehavior ios-fisher-release-lure ios-fisher ((mode int))
+  "Let the fish go: back to swimming (IOS_FISH_LURE_NONE) or fleeing (IOS_FISH_LURE_FLEE)."
+  (let ((school (ios-fisher-lure-school)))
+    (when school
+      (set! (-> school lure-mode) mode)
+      (set-time! (-> school lure-time))
+      (set! (-> school wander-time) (current-time))))
+  (set! (-> self lure) (the-as handle #f))
+  0)
+
+(defbehavior ios-fisher-message ios-fisher ((message int))
+  (set! (-> self message) message)
+  (set-time! (-> self message-time))
+  0)
+
+(defun ios-fishing-screen-pos ((p vector) (out vector))
+  "OUT x y = where P is on screen, in 512 x 224 units; #f when it is behind the camera."
+  (let ((q (new 'stack-no-clear 'vector4w)))
+    (set! (-> p w) 1.0)
+    (when (transform-point-qword! q p)
+      (set! (-> out x) (- (/ (the float (-> q x)) 16.0) 1792.0))
+      (set! (-> out y) (- (/ (the float (-> q y)) 16.0) (the float (-> *video-parms* screen-miny))))
+      #t)))
+
+(defun ios-fishing-view-place ((proc process-drawable) (x float) (y float) (yaw float))
+  "PROC IOS_FISHING_SHOW_DIST in front of the camera, moved sideways / up so it is at screen x y (512 x 224 units:
+   found by projecting test points, so it works for any field of view and aspect), turned YAW from facing the view."
+  (let* ((cam *math-camera*)
+         (right (-> cam inv-camera-rot vector 0))
+         (fwd (-> cam inv-camera-rot vector 2))
+         (centre (vector+*! (new 'stack-no-clear 'vector) (-> cam trans) fwd IOS_FISHING_SHOW_DIST))
+         (side (vector+*! (new 'stack-no-clear 'vector) centre right (meters 0.1)))
+         (lift (vector+*! (new 'stack-no-clear 'vector) centre *up-vector* (meters 0.1)))
+         (s0 (new 'stack-no-clear 'vector))
+         (s1 (new 'stack-no-clear 'vector))
+         (s2 (new 'stack-no-clear 'vector))
+         (facing (new 'stack-no-clear 'vector)))
+    (set! (-> proc root trans quad) (-> centre quad))
+    (when (and (ios-fishing-screen-pos centre s0) (ios-fishing-screen-pos side s1) (ios-fishing-screen-pos lift s2))
+      (let ((dx (- (-> s1 x) (-> s0 x)))
+            (dy (- (-> s2 y) (-> s0 y))))
+        (if (< 0.01 (fabs dx)) (vector+*! (-> proc root trans) (-> proc root trans) right (* (meters 0.1) (/ (- x (-> s0 x)) dx))))
+        (if (< 0.01 (fabs dy)) (vector+*! (-> proc root trans) (-> proc root trans) *up-vector* (* (meters 0.1) (/ (- y (-> s0 y)) dy))))))
+    (set! (-> proc root trans w) 1.0)
+    (set-vector! facing 0.0 (+ (atan (-> fwd x) (-> fwd z)) yaw) 0.0 1.0)
+    (quaternion-zxy! (-> proc root quat) facing))
+  0)
+
+(defun ios-fishing-show-tint ((proc process-drawable) (tint vector))
+  "The species' colours, and the mark that makes the renderer draw it on top (see IOS_FISHING_SHOW_MARK)."
+  (set-vector! (-> proc draw color-mult) (-> tint x) (-> tint y) (-> tint z) 0.0)
+  (set-vector! (-> proc draw color-emissive)
+               (* (-> tint x) (-> tint w))
+               (* (-> tint y) (-> tint w))
+               (* (-> tint z) (-> tint w))
+               (the-as float IOS_FISHING_SHOW_MARK))
+  0)
+
+(defun ios-fishing-show-tint-unlit ((proc process-drawable) (tint vector))
+  "Like ios-fishing-show-tint, but without the world's lights (time of day, level moods, shadow masks): color-mult 0
+   zeroes every light the level gives the model, and color-emissive becomes its only (ambient) light, so the model is
+   drawn with its own colours, as authored (ambient 1 = the texture unchanged), tinted and glowing like the species.
+   For the pause menu's Fish list (user 2026-10-26)."
+  (set-vector! (-> proc draw color-mult) 0.0 0.0 0.0 0.0)
+  (set-vector! (-> proc draw color-emissive)
+               (* (-> tint x) (+ 1.0 (-> tint w)))
+               (* (-> tint y) (+ 1.0 (-> tint w)))
+               (* (-> tint z) (+ 1.0 (-> tint w)))
+               (the-as float IOS_FISHING_SHOW_MARK))
+  0)
+
+(defbehavior ios-fisher-land ios-fisher ()
+  "The hooked fish is in: taken out of the water and shown (the reveal); the host logs it in the save."
+  (let ((school (ios-fisher-lure-school)))
+    (when school
+      (let ((species (-> school species)))
+        (set! *ios-fishing-landed-species* species)
+        (+! *ios-fishing-landed-count* 1)
+        (deactivate school)
+        (sound-play "cell-prize")
+        (set! (-> self trophy) (ppointer->handle (process-spawn ios-fishing-trophy species :to self))))))
+  (set! (-> self lure) (the-as handle #f))
+  0)
+
+;; ---- catch reveal --------------------------------------------------------------------------------------------
+
+;; screen y of the shown catch (512 x 224 units): below the name at 44 (118, then 132 still covered it; user 2026-10-23)
+(defconstant IOS_FISHING_TROPHY_Y 148.0)
+
+(defbehavior ios-fishing-trophy-init-by-other ios-fishing-trophy ((sp int))
+  (let* ((info (-> *ios-fish-roster* species sp))
+         (kind (-> info model))
+         (tint (-> info tint))
+         ;; about life size, a little bigger for the big species
+         (scale (* IOS_FISHING_SHOW_SCALE (ios-fish-scale kind) (+ 0.75 (* 0.25 (-> info scale))))))
+    (set! (-> self entity) (ios-fish-entity))
+    (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+    (set! (-> self kind) kind)
+    (set! (-> self spin) 0.0)
+    (set! (-> self root) (new 'process 'trsqv))
+    (set! (-> self root trans quad) (-> *ios-fishing-bobber-pos* quad))
+    (initialize-skeleton self (ios-fish-skel kind) '())
+    (set! (-> self skel effect) #f)
+    (set! (-> self size) scale)
+    (set-vector! (-> self root scale) scale scale scale 1.0)
+    (ios-fishing-show-tint self tint)
+    (ios-fishing-view-place self 256.0 IOS_FISHING_TROPHY_Y (degrees 90)))
+  (go ios-fishing-trophy-show)
+  (none))
+
+(defstate ios-fishing-trophy-show (ios-fishing-trophy)
+  :trans
+    (behavior ()
+      ;; in the middle of the screen, a little low (the name is above it), turning slowly
+      (+! (-> self spin) (* (degrees 50) (seconds-per-frame)))
+      (ios-fishing-view-place self 256.0 IOS_FISHING_TROPHY_Y (+ (degrees 90) (-> self spin))))
+  :code
+    (behavior ()
+      (ja-channel-set! 1)
+      (let ((anim (the-as art-joint-anim (-> self draw art-group data (ios-fish-anim-index (-> self kind))))))
+        (loop
+          (ja-no-eval :group! anim :num! (seek!) :frame-num 0.0)
+          (until (ja-done? 0)
+            (suspend)
+            (ja :num! (seek!))))))
+  :post ja-post)
+
+(defun ios-fishing-text ((str string) (x float) (y float) (scale float) (color font-color) (alpha int))
+  "STR centred on x y (512 x 224 screen units), in the game font."
+  (let ((font (new 'stack 'font-context *font-default-matrix* (the int (- x 160.0)) (the int (- y 20.0)) 0.0 color
+                   (font-flags shadow kerning))))
+    (set-width! font 320)
+    (set-height! font 40)
+    (set-scale! font scale)
+    (set! (-> font flags) (font-flags shadow kerning middle middle-vert large))
+    (print-game-text str font #f alpha 22))
+  0)
+
+(defun ios-fishing-draw-reveal ((species int) (since time-frame))
+  "Name above the fish, rarity (and NEW DISCOVERY! on a first catch) on the right, how to go on at the bottom."
+  (let ((reveal *ios-fishing-reveal*)
+        (rarity (-> *ios-fish-roster* species species rarity)))
+    (when (= (-> reveal serial) *ios-fishing-landed-count*)
+      (ios-fishing-text (-> reveal name) 256.0 44.0 1.0 (font-color default) 128)
+      (ios-fishing-text (case rarity
+                          ((0) "COMMON")
+                          ((1) "UNCOMMON")
+                          ((2) "RARE")
+                          ((3) "EPIC")
+                          (else "LEGENDARY"))
+                        410.0
+                        72.0
+                        0.8
+                        (case rarity
+                          ((0) (font-color white))
+                          ((1) (font-color green))
+                          ((2) (font-color cyan))
+                          ((3) (font-color pink))
+                          (else (font-color orange)))
+                        128)
+      (if (nonzero? (-> reveal new))
+        (ios-fishing-text "NEW DISCOVERY!"
+                          410.0
+                          90.0
+                          0.6
+                          (font-color progress-yellow)
+                          ;; gently pulsing
+                          (the int (+ 96.0 (* 32.0 (sin (* (degrees 180) (/ (the float (current-time)) 300.0)))))))))
+    ;; <PAD_X> in the game font; only once X works (after the lock), fading in
+    (let ((shown (- (the int (- (current-time) since)) (the int IOS_FISHING_REVEAL_LOCK))))
+      (if (> shown 0)
+        (ios-fishing-text "PRESS ~Y~22L<~Z~Y~27L*~Z~Y~1L>~Z~Y~23L[~Z~+26H TO CONTINUE"
+                          256.0
+                          196.0
+                          0.55
+                          (font-color default)
+                          (min 128 (/ (* 128 shown) (the int (seconds 0.3))))))))
+  0)
+
+(defbehavior ios-fisher-bites ios-fisher ()
+  "Every 0.5 s with the bobber floating: a fish near it may come over; one under it may bite."
+  (when (time-elapsed? (-> self lure-check) (seconds 0.5))
+    (set-time! (-> self lure-check))
+    (let ((school (ios-fisher-lure-school))
+          (bob *ios-fishing-bobber-pos*))
+      (cond
+        ;; one coming: bite when under the bobber, or lose interest
+        (school
+         (let ((eager (- 1.0 (* 0.15 (the float (ios-fisher-lure-rarity))))))
+           (cond
+             ((< (vector-vector-xz-distance (-> school center) bob) IOS_FISHING_BITE_RANGE)
+              (when (< (rand-vu) (* IOS_FISHING_BITE_CHANCE eager))
+                (set! (-> school lure-mode) IOS_FISH_LURE_HOOKED)
+                (set-time! (-> school lure-time))
+                (set! (-> self tension) 0.0)
+                (set! (-> self shake) 1.0)
+                (set! (-> self reel-pending) 0.0)
+                ;; Jak's landing-in-water splash (user 2026-10-17: the water slap sounded like Jak being bumped)
+                (sound-play "swim-stroke" :vol 100)
+                (ios-fisher-message IOS_FISHING_MESSAGE_CAUGHT)
+                (ios-fisher-go-phase IOS_FISHING_HOOKED)))
+             ((time-elapsed? (-> school lure-time) IOS_FISHING_LOSE_INTEREST)
+              (ios-fisher-release-lure IOS_FISH_LURE_NONE)))))
+        ;; none yet: the swimming fish nearby each get a chance to notice it
+        (else
+         (let ((manager (ios-fish-manager-get)))
+           (when manager
+             (let ((child (-> manager child)))
+               (while (and child (not (handle->process (-> self lure))))
+                 (let ((s (the-as ios-fish-school (-> child 0))))
+                   (when (and (zero? (-> s lure-mode))
+                              (< (vector-vector-xz-distance (-> s center) bob) IOS_FISHING_NOTICE_RANGE)
+                              (< (rand-vu)
+                                 (* IOS_FISHING_NOTICE_CHANCE
+                                    (- 1.0 (* 0.15 (the float (-> *ios-fish-roster* species (-> s species) rarity))))))))
+                     (set! (-> s lure-mode) IOS_FISH_LURE_APPROACH)
+                     (set-time! (-> s lure-time))
+                     (set! (-> self lure) (process->handle s))
+                   (set! child (-> s brother)))))))))))
+  0)
+
+(defun ios-fishing-draw-message ((message int) (since time-frame))
+  "CAUGHT! / GOT AWAY in the middle of the view, fading out at the end."
+  (when (and (nonzero? message) (not (time-elapsed? since IOS_FISHING_MESSAGE_TIME)))
+    (let* ((left (- (the int IOS_FISHING_MESSAGE_TIME) (the int (- (current-time) since))))
+           (alpha (min 128 (/ (* 128 left) (the int (seconds 0.4)))))
+           (font (new 'stack 'font-context *font-default-matrix* 96 60 0.0
+                      (if (= message IOS_FISHING_MESSAGE_GOT_AWAY) (font-color red) (font-color progress-yellow))
+                      (font-flags shadow kerning))))
+      (set-width! font 320)
+      (set-height! font 40)
+      (set-scale! font 1.2)
+      (set! (-> font flags) (font-flags shadow kerning middle middle-vert large))
+      (print-game-text (if (= message IOS_FISHING_MESSAGE_GOT_AWAY) "GOT AWAY" "CAUGHT!")
+                       font
+                       #f
+                       alpha
+                       22)))
+  0)
+
+(defbehavior ios-fisher-update-bobber ios-fisher ()
+  (let ((bob *ios-fishing-bobber-pos*)
+        (dt (seconds-per-frame)))
+    (case (-> self phase)
+      ((IOS_FISHING_REVEAL)
+       (set! (-> bob quad) (-> self rod-tip quad))
+       (set! (-> bob y) (- (-> bob y) (meters 0.8))))
+      ((IOS_FISHING_READY)
+       ;; hanging under the rod tip
+       (set! (-> bob quad) (-> self rod-tip quad))
+       (set! (-> bob y) (- (-> bob y) (meters 0.8)))
+       ;; a swing throws it at the snap forward
+       (when (and (nonzero? (-> self swing-time))
+                  (not (-> self released))
+                  (time-elapsed? (-> self swing-time) (seconds 0.33)))
+         (set! (-> self released) #t)
+         (when (ios-fisher-pick-cast-target)
+           (set! (-> self cast-from quad) (-> self rod-tip quad))
+           (ios-fisher-go-phase IOS_FISHING_FLYING))))
+      ((IOS_FISHING_FLYING)
+       (let ((t (fmin 1.0 (/ (the float (- (current-time) (-> self phase-time))) (the float IOS_FISHING_FLIGHT_TIME)))))
+         (vector-lerp! bob (-> self cast-from) (-> self cast-to) t)
+         (+! (-> bob y) (* IOS_FISHING_CAST_ARC 4.0 t (- 1.0 t)))
+         (when (>= t 1.0)
+           ;; lands with a splash: Jak's own landing-in-water sound (target.gc) and water splash particles
+           (sound-play "swim-stroke" :vol 100)
+           (splash-spawn (the-as basic 0.4) (the-as basic (-> self cast-to)) 0)
+           (set! (-> self bobber quad) (-> self cast-to quad))
+           (vector-reset! (-> self drift))
+           (set! (-> self reel-pending) 0.0)
+           (ios-fisher-go-phase IOS_FISHING_FLOATING))))
+      ((IOS_FISHING_FLOATING IOS_FISHING_HOOKED)
+       (let ((pos (-> self bobber))
+             (hooked (= (-> self phase) IOS_FISHING_HOOKED)))
+         ;; reeling: pull in towards Jak a step at a time
+         (when (< 0.0 (-> self reel-pending))
+           (let ((to (vector-! (new 'stack-no-clear 'vector) (-> self eye) pos))
+                 (step (fmin (-> self reel-pending) (* IOS_FISHING_REEL_SPEED dt))))
+             (set! (-> to y) 0.0)
+             (vector-normalize! to 1.0)
+             (vector+*! pos pos to step)
+             (set! (-> self reel-pending) (- (-> self reel-pending) step))))
+         (cond
+           (hooked
+            ;; the fish pulls away from Jak, up to the longest line
+            (let ((away (vector-! (new 'stack-no-clear 'vector) pos (-> self eye))))
+              (set! (-> away y) 0.0)
+              (when (and (< (vector-length away) IOS_FISHING_MAX_LINE) (< 0.0 (vector-length away)))
+                (vector-normalize! away 1.0)
+                (vector+*! pos pos away (* dt (+ IOS_FISHING_PULL_SPEED (* (meters 0.15) (the float (ios-fisher-lure-rarity))))))))
+            (set! (-> self tension) (fmax 0.0 (- (-> self tension) (* IOS_FISHING_TENSION_DECAY dt)))))
+           (else
+            ;; slow drift with the water, which stops at shallows / shore
+            (+! (-> self drift x) (* dt (rand-vu-float-range (meters -0.2) (meters 0.2))))
+            (+! (-> self drift z) (* dt (rand-vu-float-range (meters -0.2) (meters 0.2))))
+            (vector-float*! (-> self drift) (-> self drift) (- 1.0 (* 0.5 dt)))
+            (let ((speed (vector-length (-> self drift))))
+              (if (< (meters 0.15) speed) (vector-float*! (-> self drift) (-> self drift) (/ (meters 0.15) speed))))
+            (when (time-elapsed? (-> self water-time) (seconds 0.25))
+              (set-time! (-> self water-time))
+              (let ((ahead (vector+*! (new 'stack-no-clear 'vector) pos (-> self drift) 4.0))
+                    (col (new 'stack-no-clear 'vector)))
+                (if (not (ios-fish-water-column ahead self col)) (vector-reset! (-> self drift)))))
+            (vector+*! pos pos (-> self drift) dt)
+            (ios-fisher-bites)))
+         ;; ride the waves; a bite shakes it, a hooked fish keeps tugging it under
+         (+! (-> self bob-phase) (* 65536.0 (if hooked 3.0 0.8) dt))
+         (set! (-> self shake) (fmax 0.0 (- (-> self shake) (* 0.8 dt))))
+         (set! (-> pos y) (+ (ios-fish-surface pos)
+                             (meters 0.04)
+                             (* (if hooked (meters 0.09) (meters 0.05)) (sin (-> self bob-phase)))
+                             (* (meters -0.2) (-> self shake))))
+         (set! (-> bob quad) (-> pos quad))
+         (when (< 0.0 (-> self shake))
+           (+! (-> bob x) (* (meters 0.12) (-> self shake) (rand-vu-float-range -1.0 1.0)))
+           (+! (-> bob z) (* (meters 0.12) (-> self shake) (rand-vu-float-range -1.0 1.0))))
+         ;; reeled all the way in: with a fish on the line, it's caught
+         (when (< (vector-vector-xz-distance pos (-> self eye)) IOS_FISHING_REEL_DONE)
+           (cond
+             (hooked
+              (ios-fisher-land)
+              (ios-fisher-go-phase IOS_FISHING_REVEAL))
+             (else
+              (ios-fisher-release-lure IOS_FISH_LURE_NONE)
+              (ios-fisher-go-phase IOS_FISHING_READY)))))))
+    (set! (-> bob w) 1.0))
+  0)
+
+(defbehavior ios-fisher-controls ios-fisher ()
+  (when (cpad-pressed? 0 square)
+    (ios-fishing-eat-buttons (pad-buttons square))
+    (when (and (= (-> self phase) IOS_FISHING_READY) (zero? (-> self swing-time)))
+      (set-time! (-> self swing-time))
+      (set! (-> self released) #f)
+      (set! (-> self whooshed) #f)))
+  (when (cpad-pressed? 0 x)
+    (ios-fishing-eat-buttons (pad-buttons x))
+    (case (-> self phase)
+      ((IOS_FISHING_REVEAL)
+       ;; done looking (only once the lock is over): put it away, ready to cast again
+       (when (time-elapsed? (-> self phase-time) IOS_FISHING_REVEAL_LOCK)
+         (let ((trophy (handle->process (-> self trophy))))
+           (if trophy (deactivate trophy)))
+         (set! (-> self trophy) (the-as handle #f))
+         (ios-fisher-go-phase IOS_FISHING_READY)))
+      ((IOS_FISHING_FLOATING)
+       (+! (-> self reel-pending) IOS_FISHING_REEL_STEP))
+      ((IOS_FISHING_HOOKED)
+       (+! (-> self reel-pending) IOS_FISHING_REEL_STEP)
+       ;; the line can snap: more likely for rarer fish, and when reeling hard
+       (+! (-> self tension) IOS_FISHING_TENSION_PER_PRESS)
+       (when (< (rand-vu)
+                (+ IOS_FISHING_BREAK_BASE
+                   (* IOS_FISHING_BREAK_RARITY (the float (ios-fisher-lure-rarity)))
+                   (* IOS_FISHING_BREAK_TENSION (fmax 0.0 (- (-> self tension) 1.0)))))
+         (sound-play "yellow-fizzle")
+         (ios-fisher-message IOS_FISHING_MESSAGE_GOT_AWAY)
+         (ios-fisher-release-lure IOS_FISH_LURE_FLEE)
+         (ios-fisher-go-phase IOS_FISHING_READY)))))
+  0)
+
+;; ---- fishing mode --------------------------------------------------------------------------------------------
+
+(defbehavior ios-fisher-init-by-other ios-fisher ()
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! *ios-fisher-ppointer* (-> self ppointer))
+  (set! *ios-fisher-pid* (-> self pid))
+  ;; start facing the water the can-fish check found (the direction nearest where Jak faces)
+  (set! (-> self yaw) *ios-fish-water-yaw*)
+  (set! (-> self yaw-center) (-> self yaw))
+  (set! (-> self swing-time) 0)
+  (set! (-> self bob-phase) 0.0)
+  (set-time! (-> self start-time))
+  (set! (-> self lure) (the-as handle #f))
+  (set! (-> self trophy) (the-as handle #f))
+  (set! (-> self message) IOS_FISHING_MESSAGE_NONE)
+  (set! (-> self shake) 0.0)
+  (set! (-> self tension) 0.0)
+  (ios-fisher-update-view)
+  (ios-fisher-update-rod)
+  (ios-fisher-go-phase IOS_FISHING_READY)
+  (ios-fisher-update-bobber)
+  ;; Jak is held for the whole of fishing mode, as at the boat's wheel; busy (mid-jump...): no fishing
+  (if (process-grab? *target*)
+    (go ios-fisher-fishing)
+    (go ios-fisher-refused))
+  (none))
+
+(defstate ios-fisher-refused (ios-fisher)
+  :code
+    (behavior ()
+      (deactivate self)))
+
+(defbehavior ios-fisher-leave ios-fisher ()
+  (ios-fishing-eat-buttons (pad-buttons circle square x))
+  (deactivate self)
+  0)
+
+(defstate ios-fisher-fishing (ios-fisher)
+  :enter
+    (behavior ()
+      (set! *ios-fishing-active* #t)
+      (send-event *target* 'draw #f)
+      (send-event *camera* 'change-state cam-fixed 0)
+      (process-spawn ios-fishing-bobber :to self))
+  :exit
+    (behavior ()
+      (set! *ios-fishing-active* #f)
+      (set! *ios-fishing-phase* -1)
+      (ios-fisher-release-lure (if (= (-> self phase) IOS_FISHING_HOOKED) IOS_FISH_LURE_FLEE IOS_FISH_LURE_NONE))
+      (set! (-> *ios-fishing-rod* origin w) 0.0)
+      (when *target*
+        (send-event *target* 'draw #t)
+        (process-release? *target*))
+      (send-event *camera* 'change-state *camera-base-mode* 0))
+  :trans
+    (behavior ()
+      (cond
+        ((and (time-elapsed? (-> self start-time) (seconds 0.1)) (cpad-pressed? 0 circle))
+         (ios-fisher-leave))
+        ;; something else took Jak (death, a cutscene), or Fishing was turned off
+        ((or (not *target*)
+             (!= *ios-ocean-fish* #t)
+             (and (time-elapsed? (-> self start-time) (seconds 0.5))
+                  (!= (send-event *target* 'query 'mode) 'target-grab)))
+         (deactivate self))
+        (else
+         (ios-fisher-update-view)
+         (ios-fisher-update-camera)
+         (ios-fisher-controls)
+         (ios-fisher-update-rod)
+         (ios-fisher-update-bobber)
+         (set! *ios-fishing-bobber-hidden* (= (-> self phase) IOS_FISHING_REVEAL))
+         (if (!= (-> self phase) IOS_FISHING_REVEAL)
+           (ios-fishing-draw-line (-> self rod-tip)
+                                ;; to the top of the bobber (its origin is at the bottom of the orb model)
+                                (vector+*! (new 'stack-no-clear 'vector) *ios-fishing-bobber-pos* *up-vector* IOS_FISHING_BOBBER_TOP)
+                                (case (-> self phase)
+                                  ((IOS_FISHING_FLOATING)
+                                   (* 0.05 (vector-vector-distance (-> self rod-tip) *ios-fishing-bobber-pos*)))
+                                  ;; taut with a fish on it
+                                  ((IOS_FISHING_HOOKED)
+                                   (* 0.01 (vector-vector-distance (-> self rod-tip) *ios-fishing-bobber-pos*)))
+                                  (else 0.0))))
+         (ios-fishing-draw-message (-> self message) (-> self message-time))
+         (if (= (-> self phase) IOS_FISHING_REVEAL)
+           (ios-fishing-draw-reveal *ios-fishing-landed-species* (-> self phase-time)))
+         (ios-fishing-draw-hints (-> self start-time)))))
+  :code
+    (behavior ()
+      (loop
+        (suspend))))
