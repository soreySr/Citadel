index 000000000..2b0f70d70
--- /dev/null
+++ b/tools/ios/aot_relocation_manifest.py
@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+"""Create an offline relocation manifest for the iOS Jak 1 AOT packer.
+
+The manifest describes OpenGOAL v3 object segments and their unresolved links.
+It is generated on the build machine and must never be interpreted as an
+on-device linker instruction stream.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import struct
+import sys
+from collections import Counter
+from pathlib import Path
+
+from aot_object_audit import BASIC_OFFSET, HEADER_SIZE, LINK_NAMES, MAGIC, ObjectFormatError, u32
+
+
+SEGMENT_NAMES = ("main", "debug", "top_level")
+
+
+def string_at(data: bytes, offset: int) -> tuple[str, int]:
+    end = data.find(b"\0", offset)
+    if end < 0:
+        raise ObjectFormatError("unterminated relocation symbol")
+    return data[offset:end].decode("ascii"), end + 1
+
+
+def records_for_table(table: bytes, segment: int) -> list[dict[str, object]]:
+    records: list[dict[str, object]] = []
+    offset = 0
+    while True:
+        if offset >= len(table):
+            raise ObjectFormatError("link table has no terminator")
+        kind = table[offset]
+        offset += 1
+        name = LINK_NAMES.get(kind)
+        if name is None:
+            raise ObjectFormatError(f"unknown relocation kind {kind}")
+        if kind == 0:
+            if offset != len(table):
+                raise ObjectFormatError("bytes follow link-table terminator")
+            return records
+
+        record: dict[str, object] = {"segment": SEGMENT_NAMES[segment], "kind": name}
+        if kind in (1, 2, 6):
+            symbol, offset = string_at(table, offset)
+            record["symbol"] = symbol
+            if kind == 2:
+                record["method_count"] = table[offset]
+                offset += 1
+            count = u32(table, offset)
+            offset += 4
+            record["patch_offsets"] = list(struct.unpack_from(f"<{count}I", table, offset))
+            offset += count * 4
+        elif kind in (3, 4):
+            target = table[offset]
+            offset += 1
+            current_offset, target_offset, patch_offset = struct.unpack_from("<III", table, offset)
+            offset += 12
+            record.update({
+                "target_segment": SEGMENT_NAMES[target],
+                "current_offset": current_offset,
+                "target_offset": target_offset,
+                "patch_offset": patch_offset,
+            })
+        elif kind == 5:
+            source_offset, target_offset = struct.unpack_from("<II", table, offset)
+            offset += 8
+            record.update({"patch_offset": source_offset, "target_offset": target_offset})
+        elif kind == 7:
+            target = table[offset]
+            offset += 1
+            target_offset, patch_offset = struct.unpack_from("<II", table, offset)
+            offset += 8
+            record.update({
+                "target_segment": SEGMENT_NAMES[target],
+                "target_offset": target_offset,
+                "patch_offset": patch_offset,
+            })
+        if offset > len(table):
+            raise ObjectFormatError("truncated relocation record")
+        records.append(record)
+
+
+def read_object(path: Path) -> dict[str, object]:
+    data = path.read_bytes()
+    if len(data) < HEADER_SIZE or data[:4] != MAGIC:
+        raise ObjectFormatError("not a GOAL v3 object")
+    major, minor, version, segments = struct.unpack_from("<HHII", data, 4)
+    if version != 3 or segments != len(SEGMENT_NAMES):
+        raise ObjectFormatError(f"unsupported object version {version}, segments {segments}")
+    pairs = struct.unpack_from("<12I", data, 16)
+    links = list(zip(pairs[0:6:2], pairs[1:6:2]))
+    code = list(zip(pairs[6:12:2], pairs[7:12:2]))
+    link_block_length = u32(data, 64)
+    if link_block_length < HEADER_SIZE - BASIC_OFFSET or link_block_length > len(data):
+        raise ObjectFormatError("invalid link-block length")
+
+    all_records: list[dict[str, object]] = []
+    segment_layout: list[dict[str, int | str]] = []
+    for segment, ((link_offset, link_size), (code_offset, code_size)) in enumerate(zip(links, code)):
+        if link_offset < HEADER_SIZE - BASIC_OFFSET or link_offset + link_size > link_block_length:
+            raise ObjectFormatError("link table lies outside link block")
+        all_records.extend(records_for_table(data[BASIC_OFFSET + link_offset:BASIC_OFFSET + link_offset + link_size], segment))
+        segment_layout.append({
+            "name": SEGMENT_NAMES[segment],
+            "file_offset": link_block_length + code_offset,
+            "size": code_size,
+        })
+    if link_block_length + sum(size for _, size in code) != len(data):
+        raise ObjectFormatError("segment data does not fill object")
+    return {
+        "path": path.name,
+        "bytes": len(data),
+        "goal_version": f"{major}.{minor}",
+        "segments": segment_layout,
+        "relocations": all_records,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("object_directory", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    objects = [read_object(path) for path in sorted(args.object_directory.rglob("*.o"))]
+    if not objects:
+        parser.error("no .o files found")
+    counts = Counter(record["kind"] for obj in objects for record in obj["relocations"])
+    report = {
+        "format": "OpenGOAL v3 iOS AOT relocation manifest",
+        "object_count": len(objects),
+        "relocation_records": dict(sorted(counts.items())),
+        "objects": objects,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + "\n")
+    print(f"Wrote {args.output} ({len(objects)} objects, {sum(counts.values())} relocation records)")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
