+;; ---- engine/game/powerups.gc -----------------------------------------------------------------------------
+(defbehavior target-powerup-process target ()
+  ;; TFL note: added to reset color and max eco pill count
+  (vector-copy! (-> self draw color-emissive) (new 'static 'vector :x 0.0 :y 0.0 :z 0.0 :w 0.0))
+  (set! (-> self fact eco-pill-max) 50.0)
+  (water-control-method-10 (-> self water))
+  (when (not *weather-off*)
+    (case (-> self current-level name)
+      (('swamp) (update-rain self))
+      (('snow) (update-snow self))
