+      (set! (-> self propeller spin-rate) 0.0)
+      (logior! (-> self draw status) (draw-status hidden))
+      (clear-collide-with-as (-> self root-overlay)))
+  :trans
+    (behavior ()
+      (if (not (ios-free-boat)) (deactivate self)))
+  :code
+    (behavior ()
+      (loop
+        (suspend))))
+
