+;;
+;; logic-target and target2 are captured engine objects on iOS, so this file is linked as a startup object
+;; (aot_level_code_link.py --startup-object ios-blue-eco-swim). Its top-level runs once at boot: the defbehavior
+;; below replaces the captured build-conversions (called through its symbol), and target-swim-walk gets a new
+;; :code that plays the paddle animation faster.
+
+;; Swim/wade speed and paddle animation multiplier while charged with blue eco.
+(defconstant IOS_BLUE_ECO_SWIM_SCALE 1.5)
+
+(defbehavior ios-blue-eco-charged? target ()
+  (and (= (-> self fact eco-type) (pickup-type eco-blue)) (>= (-> self fact eco-level) 1.0)))
+
+;; Stock build-conversions (logic-target.gc) plus the swim boost.
+(defbehavior build-conversions target ((arg0 vector))
+  (surface-mult! (-> self control current-surface) (-> self control mod-surface) (-> self control surf))
+  (when (and (ios-blue-eco-charged?)
+             (or (= (-> self control mod-surface name) 'run) (= (-> self control mod-surface name) 'jump)))
+    (+! (-> self control current-surface target-speed) 20480.0)
+    (+! (-> self control current-surface transv-max) 20480.0))
+  ;; og:ios swimming (Jak's *swim-mods* and the flut's *flut-ios-swim-mods* are both named 'swim). Jak's swim
+  ;; target-speed follows his paddle animation, which target-swim-walk already plays faster, so only his speed
+  ;; cap is raised. The flut's target-speed is fixed (its paddle animation follows its speed instead).
+  (when (and (= (-> self control mod-surface name) 'swim) (ios-blue-eco-charged?))
+    (set! (-> self control current-surface transv-max) (* IOS_BLUE_ECO_SWIM_SCALE (-> self control current-surface transv-max)))
+    (if (logtest? (-> self control root-prim prim-core action) (collide-action flut))
+      (set! (-> self control current-surface target-speed)
+            (* IOS_BLUE_ECO_SWIM_SCALE (-> self control current-surface target-speed)))))
+  ;; og:ios wading (*wade-mods*): target-wade-walk times its animation from ctrl-xz-vel like running does, so
+  ;; raising the speed speeds up the wade animation too.
+  (when (and (= (-> self control mod-surface name) 'wade) (ios-blue-eco-charged?))
+    (set! (-> self control current-surface target-speed) (* IOS_BLUE_ECO_SWIM_SCALE (-> self control current-surface target-speed)))
+    (set! (-> self control current-surface transv-max) (* IOS_BLUE_ECO_SWIM_SCALE (-> self control current-surface transv-max))))
+  (let ((s5-0 (new-stack-vector0)))
+    (vector-z-quaternion! s5-0 (-> self control quat-for-control))
+    (when (logtest? (-> self control mod-surface flags) (surface-flags dive))
+      (vector-flatten! s5-0 s5-0 (-> self control dynam gravity-normal))
+      (vector-normalize! s5-0 1.0))
+    (forward-up-nopitch->inv-matrix (-> self control c-R-w) s5-0 (-> self control local-normal)))
+  (matrix-transpose! (-> self control w-R-c) (-> self control c-R-w))
+  (vector-matrix*! (-> self control transv-ctrl) arg0 (-> self control w-R-c))
+  (set! (-> self control last-gravity-normal quad) (-> self control gravity-normal quad))
+  (let ((v0-7 (-> self control gravity-normal))) (set! (-> v0-7 quad) (-> self control dynam gravity-normal quad)) v0-7))
+
+(defbehavior ios-swim-anim-rate target ()
+  (if (ios-blue-eco-charged?) IOS_BLUE_ECO_SWIM_SCALE 1.0))
+
+;; Stock target-swim-walk :code (target2.gc) with the paddle animation rate from ios-swim-anim-rate. The swim
+;; target-speed is the animation's alignment delta per frame, so the faster animation also moves Jak faster.
+(set! (-> target-swim-walk code)
+      (lambda :behavior target
+        ()
+        (let ((v1-2 (ja-group)))
+          (cond
+            ((or (= v1-2 eichar-swim-up-ja) (= v1-2 eichar-swim-down-to-up-ja) (= v1-2 eichar-swim-up-to-stance-ja))
+             (ja-channel-push! 1 (seconds 0.3)))
+            ((ja-group? eichar-swim-up-to-stance-ja)
+             (ja-channel-push! 1 (seconds 0.15))
+             (ja-no-eval :group! eichar-swim-walk-ja :num! (seek! max (ios-swim-anim-rate)) :frame-num (ja-aframe (the-as float 19.0) 0))
+             (until (ja-done? 0)
+               (compute-alignment! (-> self align))
+               (if (not (logtest? (-> self align flags) (align-flags disabled)))
+                 (set! (-> self control mod-surface target-speed)
+                       (* (-> self align delta trans z) (-> self control current-surface alignv) (-> *display* frames-per-second))))
+               (suspend)
+               (ja :num! (seek! max (ios-swim-anim-rate)))))
+            (else (ja-channel-push! 1 (seconds 0.15)))))
+        (loop
+          (ja-no-eval :group! eichar-swim-walk-ja :num! (seek! max (ios-swim-anim-rate)) :frame-num 0.0)
+          (until (ja-done? 0)
+            (compute-alignment! (-> self align))
+            (if (not (logtest? (-> self align flags) (align-flags disabled)))
+              (set! (-> self control mod-surface target-speed)
+                    (* (-> self align delta trans z) (-> self control current-surface alignv) (-> *display* frames-per-second))))
+            (suspend)
+            (ja :num! (seek! max (ios-swim-anim-rate)))))
+        (none)))
diff --git a/goal_src/jak1/pc/ios/ios-boat-park.gc b/goal_src/jak1/pc/ios/ios-boat-park.gc
new file mode 100644
index 000000000..c9e95a88f
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-boat-park.gc
@@ -0,0 +1,224 @@
+;;-*-Lisp-*-
+(in-package goal)
+(require "engine/target/logic-target.gc")
+(require "engine/target/target2.gc")
+
+;; og:ios Driveable Boat (experimental): the boat stays where Jak leaves it, anywhere.
+;;
+;; The boat is a village1 actor, so it only exists while village1 is in one of the two level slots. Its parked
+;; spot is kept in the boat entity's perm (user data), which lives in *game-info*'s perm-list and the save file:
+;; it survives deaths, level changes and save/load. Each frame, while Jak is near the parked spot outside
+;; Sandover, village1 is kept in the level slot Jak is not standing in ('special: only the boat spawns); farther
+;; away that slot goes back to what the stock load boundaries asked for.
+;;
+;; With the boat art resident (free-boat-plan.md phase 3: OpenGOALRuntimeHost.mm LoadResidentBoatArt links the boat code
+;; and art at boot, *ios-boat-art-resident*) none of the village1 juggling below is used: the per-frame update hands
+;; over to ios-free-boat-update (fishermans-boat.gc), which keeps a free boat (no level's actor) at the parked spot
+;; and the ocean manager running, whatever levels are loaded.
+;;
+;; Linked as a startup object (aot_level_code_link.py --startup-object ios-boat-park) so this runs even when
+;; village1 (fishermans-boat.o) was never loaded this session, e.g. a save loaded in Rock Village. The per-frame
+;; update is chained into *menu-hook*: the display loop runs it after the draw hook (render-boundaries) and
+;; before level-update, so a boundary's want-levels can be corrected before the level would be discarded.
+
+(define-extern *ios-driveable-boat* symbol)
+(define-extern *ios-boat-driving* symbol)
+(define-extern *ios-boat-boardable* symbol)
+(define-extern *ios-boat-art-resident* symbol)
+(define-extern ios-free-boat-update (function int))
+(define-extern ios-ocean-transition-fog (function int))
+
+;; fishermans-boat-2 (village1)
+(defconstant IOS_BOAT_PARK_AID 10419)
+;; user-int16 3 holds this while a parked spot is stored (0 in saves from before the option: Sandover's dock)
+(defconstant IOS_BOAT_PARK_MAGIC #x2b0a)
+;; position units in user-int16 0/1 (x, z): 0.25 m, +-8 km
+(defconstant IOS_BOAT_PARK_UNIT (meters 0.25))
+
+;; Jak near the parked spot (xz): keep village1 loaded so the boat exists; farther: give the slot back.
+(defconstant IOS_BOAT_PARK_SPAWN_DIST (meters 90))
+(defconstant IOS_BOAT_PARK_DESPAWN_DIST (meters 120))
+
+;; Rock Village spawn point (user, 2026-10-09): alongside the north dock where Jak stood (317.64, 3.7, -1580.82).
+;; The dock's north edge runs east-west at z -1579.5 (x 292.6..326.8) with posts/steps reaching z -1577.5, so the
+;; boat lies parallel to it, bow east, its 5.5 m half-width side ~1 m clear of the posts.
+(defconstant IOS_BOAT_PARK_VILLAGE2_X (meters 317.0))
+(defconstant IOS_BOAT_PARK_VILLAGE2_Z (meters -1571.0))
+(defconstant IOS_BOAT_PARK_VILLAGE2_YAW (degrees 90))
+
+;; The level slot village1 took over, restored once Jak walks away from the boat.
+(define *ios-boat-park-holding* #f)
+(define *ios-boat-park-displaced* (the-as symbol #f))
+(define *ios-boat-park-displaced-display* (the-as symbol #f))
+
+(defun ios-boat-park-perm ()
+  "The boat's perm: the live one while village1 is active, else the copy in game-info (#f if it has none)."
+  (let ((ent (entity-by-aid (the-as uint IOS_BOAT_PARK_AID))))
+    (if ent
+      (-> ent extra perm)
+      (lookup-entity-perm-by-aid *game-info* (the-as actor-id IOS_BOAT_PARK_AID)))))
+
+(defun ios-boat-park-perm-valid? ((perm entity-perm))
+  (and perm (= (-> perm user-int16 3) IOS_BOAT_PARK_MAGIC)))
+
+(defun ios-boat-park-perm-write ((perm entity-perm) (x float) (z float) (yaw float))
+  (when perm
+    (set! (-> perm user-int16 0) (the int (/ x IOS_BOAT_PARK_UNIT)))
+    (set! (-> perm user-int16 1) (the int (/ z IOS_BOAT_PARK_UNIT)))
+    ;; angle units, wraps to int16
+    (set! (-> perm user-int16 2) (the int yaw))
+    (set! (-> perm user-int16 3) IOS_BOAT_PARK_MAGIC)
+    ;; update-perm! (level login, death resets) zeroes the user data without this bit
+    (logior! (-> perm status) (entity-perm-status user-set-from-cstage)))
+  0)
+
+(defun ios-boat-park-store ((pos vector) (yaw float))
+  "Save the boat's spot in its live perm and in game-info's copy (the one the hook reads with village1 away)."
+  (let ((ent (entity-by-aid (the-as uint IOS_BOAT_PARK_AID))))
+    (if ent (ios-boat-park-perm-write (-> ent extra perm) (-> pos x) (-> pos z) yaw)))
+  (ios-boat-park-perm-write (lookup-entity-perm-by-aid *game-info* (the-as actor-id IOS_BOAT_PARK_AID))
+                            (-> pos x) (-> pos z) yaw)
+  0)
+
+(defun ios-boat-park-clear ()
+  "Back at a stock dock: no parked spot."
+  (let ((ent (entity-by-aid (the-as uint IOS_BOAT_PARK_AID))))
+    (if ent (set! (-> ent extra perm user-int16 3) 0)))
+  (let ((perm (lookup-entity-perm-by-aid *game-info* (the-as actor-id IOS_BOAT_PARK_AID))))
+    (if perm (set! (-> perm user-int16 3) 0)))
+  0)
+
+(defun ios-boat-park-get ((pos vector))
+  "Parked spot -> pos (y 0, w = yaw). #f if the boat has none (it docks at Sandover/Misty as in the stock game)."
+  (let ((perm (ios-boat-park-perm)))
+    (when (ios-boat-park-perm-valid? perm)
+      (set-vector! pos
+                   (* IOS_BOAT_PARK_UNIT (the float (-> perm user-int16 0)))
+                   0.0
+                   (* IOS_BOAT_PARK_UNIT (the float (-> perm user-int16 1)))
+                   (the float (-> perm user-int16 2)))
+      ;; first Rock Village spot (323.66, -1574.13, 42 deg) cut into the dock: saves still parked there move to
+      ;; the current one
+      (when (< (vector-vector-xz-distance pos (new 'static 'vector :x (meters 323.66) :z (meters -1574.13)))
+               (meters 2))
+        (set-vector! pos IOS_BOAT_PARK_VILLAGE2_X 0.0 IOS_BOAT_PARK_VILLAGE2_Z 1.0)
+        (ios-boat-park-store pos IOS_BOAT_PARK_VILLAGE2_YAW)
+        (set! (-> pos w) IOS_BOAT_PARK_VILLAGE2_YAW))
+      #t)))
+
+(defun ios-boat-park-want-slot ((name symbol))
+  (dotimes (i 2)
+    (if (= (-> *load-state* want i name) name) (return i)))
+  -1)
+
+(defun ios-boat-park-release ((restore symbol))
+  "Stop keeping village1 loaded. With restore, its slot gets back the level the stock logic wanted there."
+  (when *ios-boat-park-holding*
+    (set! *ios-boat-park-holding* #f)
+    (let ((slot (ios-boat-park-want-slot 'village1)))
+      (when (and restore (>= slot 0))
+        (format 0 "ios-boat-park: village1 slot back to ~A~%" *ios-boat-park-displaced*)
+        (set! (-> *load-state* want slot name) *ios-boat-park-displaced*)
+        (set! (-> *load-state* want slot display?) *ios-boat-park-displaced-display*)
+        (set! (-> *load-state* want slot force-vis?) #f)
+        (set! (-> *load-state* want slot force-inside?) #f))))
+  0)
+
+(defun ios-boat-park-hold ((inside symbol))
+  "Make sure village1 is wanted, taking the slot of the level Jak is not in. Re-taken whenever a load boundary
+   swaps it out again (the boundary's level is remembered instead)."
+  (when (< (ios-boat-park-want-slot 'village1) 0)
+    (let ((slot (if (= (-> *load-state* want 0 name) inside) 1 0)))
+      (format 0 "ios-boat-park: village1 replaces ~A for the parked boat~%" (-> *load-state* want slot name))
+      (set! *ios-boat-park-displaced* (-> *load-state* want slot name))
+      (set! *ios-boat-park-displaced-display* (-> *load-state* want slot display?))
+      (set! (-> *load-state* want slot name) 'village1)
+      ;; only bit-7 actors spawn (the boat; see ios-boat-park-ensure-spawn)
+      (set! (-> *load-state* want slot display?) 'special)
+      (set! (-> *load-state* want slot force-vis?) #f)
+      (set! (-> *load-state* want slot force-inside?) #f)
+      (set! *ios-boat-park-holding* #t)))
+  0)
+
+(defun ios-boat-park-ensure-spawn ()
+  "'special display only births bit-7 actors. The boat sets bit-7 on itself, but a save may not have it yet."
+  (let ((ent (entity-by-aid (the-as uint IOS_BOAT_PARK_AID))))
+    (if (and ent (not (logtest? (-> ent extra perm status) (entity-perm-status bit-7))))
+      (set-or-clear-status! (the-as entity-actor ent) (entity-perm-status bit-7) #t)))
+  0)
+
+(defun ios-boat-park-village2-spot ((inside symbol) (pos vector))
+  "New spawn point: a boat with no parked spot shows up at Rock Village's dock while Jak is there."
+  (when (and (= inside 'village2)
+             (not (ios-boat-park-get pos))
+             (task-complete? *game-info* (game-task jungle-fishgame)))
+    (format 0 "ios-boat-park: boat moved to the Rock Village dock~%")
+    (set-vector! pos IOS_BOAT_PARK_VILLAGE2_X 0.0 IOS_BOAT_PARK_VILLAGE2_Z 1.0)
+    (ios-boat-park-store pos IOS_BOAT_PARK_VILLAGE2_YAW))
+  0)
+
+(defun ios-boat-park-return-home ((pos vector))
+  "Jak died at sea with the boat adrift (fishermans-boat.gc ios-ocean-return-boat-on-death, user 2026-10-10): send
+   the boat to the nearer home spot from POS, Sandover's stock dock (no parked spot) or the Rock Village dock.
+   The free boat sees its parked spot change and respawns there (fishermans-boat-ios-record-park)."
+  (let ((rock (new 'stack-no-clear 'vector)))
+    (set-vector! rock IOS_BOAT_PARK_VILLAGE2_X 0.0 IOS_BOAT_PARK_VILLAGE2_Z 1.0)
+    (cond
+      ;; Sandover's dock is ~100 m from its centre (0, 40)
+      ((< (vector-vector-xz-distance pos rock)
+          (vector-vector-xz-distance pos (new 'static 'vector :x (meters 0.0) :z (meters 40.0))))
+       (format 0 "ios-boat-park: Jak died at sea, boat back to the Rock Village dock~%")
+       (ios-boat-park-store rock IOS_BOAT_PARK_VILLAGE2_YAW))
+      (else
+       (format 0 "ios-boat-park: Jak died at sea, boat back to Sandover's dock~%")
+       (ios-boat-park-clear))))
+  0)
+
+(defun ios-boat-park-update ()
+  (when (and *target*
+             (not (level-get *level* 'title))
+             (not (paused?))
+             (not (movie?))
+             ;; these wait for their own levels to load: target-continue for the continue point's, a warp gate
+             ;; (basebutton warp, Jak in target-warp-out) for its destination. Rock Village's gate is ~75 m
+             ;; from the boat's spot there.
+             (not (and (-> *target* next-state)
+                       (member (-> *target* next-state name) '(target-continue target-warp-out target-warp-in)))))
+    (let* ((inside-lev (level-get-target-inside *level*))
+           (inside (if inside-lev (-> inside-lev name) #f))
+           (pos (new 'stack-no-clear 'vector)))
+      (cond
+        ((!= *ios-driveable-boat* #t) (ios-boat-park-release #t))
+        ;; free boat: no level needs to be kept for the boat
+        ((= *ios-boat-art-resident* #t)
+         (ios-boat-park-release #t)
+         (ios-boat-park-village2-spot inside pos)
+         (ios-free-boat-update))
+        ;; Jak on the boat: its ocean manager picks the levels
+        ((or (= *ios-boat-driving* #t) (= *ios-boat-boardable* #t)) (ios-boat-park-release #f))
+        (else
+         (ios-boat-park-village2-spot inside pos)
+         (cond
+           ;; docked in Sandover/Misty, or Jak is in Sandover: the stock level logic keeps the boat
+           ((or (not (ios-boat-park-get pos)) (= inside 'village1)) (ios-boat-park-release #f))
+           (else
+            (let ((dist (vector-vector-xz-distance pos (target-pos 0))))
+              (cond
+                ((< dist IOS_BOAT_PARK_SPAWN_DIST)
+                 (ios-boat-park-hold inside)
+                 (if (and *ios-boat-park-holding* (zero? (logand (-> *display* base-frame-counter) 7)))
+                   (ios-boat-park-ensure-spawn)))
+                ((< IOS_BOAT_PARK_DESPAWN_DIST dist) (ios-boat-park-release #t))))))))))
+  0)
+
+;; Chain into *menu-hook* (retail: nothing). This file's top-level only runs once, at boot.
+(define *ios-boat-park-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-boat-park-menu-hook ()
+  (ios-boat-park-update)
+  ;; every frame, paused or not: after update-time-of-day, before the next update-camera (fishermans-boat.gc)
+  (if (= *ios-boat-art-resident* #t) (ios-ocean-transition-fog))
+  (*ios-boat-park-prev-menu-hook*)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-boat-park-menu-hook))
diff --git a/goal_src/jak1/pc/ios/ios-boat-summon.gc b/goal_src/jak1/pc/ios/ios-boat-summon.gc
new file mode 100644
index 000000000..533166e3c
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-boat-summon.gc
@@ -0,0 +1,345 @@
+;;-*-Lisp-*-
+(in-package goal)
+(require "engine/target/logic-target.gc")
+(require "engine/target/target2.gc")
+
+;; og:ios Driveable Boat: boat summon pads (user 2026-10-10).
+;;
+;; A sparkling spot on Sandover's dock and on Rock Village's dock. Standing on it shows "PRESS O TO SUMMON BOAT"
+;; (only when the boat isn't already moored at that dock); pressing O moves the boat's parked spot there, so the
+;; free boat (fishermans-boat.gc, *ios-boat-art-resident*) is removed wherever it was and appears at this dock. As it
+;; appears its model fades in from a cyan glow (*ios-boat-summon-fade*, mirrored by the host to the Merc renderer,
+;; Jak1RendererSetBoatFade) with a burst of sparkles, blue eco lightning and a splash.
+;;
+;; Linked as a startup object (aot_level_code_link.py --startup-object ios-boat-summon, after ios-ocean-fish).
+;; Uses only the always-linked startup objects ios-boat-park (parked spot) and ios-dynamic-save (free boat lookup).
+
+(define-extern *ios-driveable-boat* symbol)
+(define-extern *ios-boat-art-resident* symbol)
+(define-extern *ios-boat-driving* symbol)
+(define-extern ios-boat-park-store (function vector float int))
+(define-extern ios-boat-park-get (function vector symbol))
+(define-extern ios-dsp-free-boat (function process-drawable))
+
+;; read by the host every frame: x model alpha (0..1), y glow (0..1), w 1 while the fade runs
+(define-perm *ios-boat-summon-fade* vector (new 'global 'vector))
+
+;; ---- pads ----------------------------------------------------------------------------------------------------
+;; Pad = where Jak stands (xz; y found from the dock's collision), boat = where the summoned boat is moored.
+
+;; Sandover: the dock spot the ocean manager respawns Jak at; boat at the stock fishermans-boat-2 position.
+(defconstant IOS_SUMMON_VILLAGE1_PAD_X (meters -21.6))
+(defconstant IOS_SUMMON_VILLAGE1_PAD_Z (meters 104.0))
+(defconstant IOS_SUMMON_VILLAGE1_BOAT_X (meters -11.09))
+(defconstant IOS_SUMMON_VILLAGE1_BOAT_Z (meters 100.86))
+(defconstant IOS_SUMMON_VILLAGE1_BOAT_YAW (degrees 0))
+;; Rock Village: by the north dock edge; boat at ios-boat-park's Rock Village spot.
+(defconstant IOS_SUMMON_VILLAGE2_PAD_X (meters 317.64))
+(defconstant IOS_SUMMON_VILLAGE2_PAD_Z (meters -1580.82))
+(defconstant IOS_SUMMON_VILLAGE2_BOAT_X (meters 317.0))
+(defconstant IOS_SUMMON_VILLAGE2_BOAT_Z (meters -1571.0))
+(defconstant IOS_SUMMON_VILLAGE2_BOAT_YAW (degrees 90))
+
+(defconstant IOS_SUMMON_PAD_RADIUS (meters 1.5))   ;; stand within this (xz) for the prompt
+(defconstant IOS_SUMMON_SPARKLE_DIST (meters 60))  ;; pad sparkles while Jak is this close
+(defconstant IOS_SUMMON_MOORED_DIST (meters 15))   ;; boat this close to the dock's spot: already there
+(defconstant IOS_SUMMON_BOAT_AID 10419)            ;; fishermans-boat-2, the village1 actor
+
+;; ---- helpers -------------------------------------------------------------------------------------------------
+
+(defun ios-boat-summon-hint-line ((str string) (font font-context) (alpha int))
+  "Print one prompt line, fading the pad glyph colours with it (same as fishermans-boat-ios-hint-line)."
+  (dotimes (i 7)
+    (set-font-color-alpha (the-as font-color (-> (new 'static 'array uint8 7 1 22 23 24 25 26 27) i)) alpha))
+  (print-game-text str font #f alpha 22)
+  (dotimes (i 7)
+    (set-font-color-alpha (the-as font-color (-> (new 'static 'array uint8 7 1 22 23 24 25 26 27) i)) 128))
+  0)
+
+(defun ios-boat-summon-eat-circle ()
+  "Consume this O press entirely, history included, so Jak doesn't also attack (fishermans-boat-ios-eat-circle)."
+  (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons circle))
+  (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons circle))
+  (let ((history (-> *cpad-history-list* cpads 0)))
+    (dotimes (i 15)
+      (logclear! (-> history button0-rel i) (pad-buttons circle))))
+  0)
+
+(defun ios-boat-summon-boat ()
+  "The boat as it is now: the free boat, else the village1 actor if it is alive. #f if neither."
+  (let ((free (ios-dsp-free-boat)))
+    (if free
+      free
+      (let ((ent (entity-by-aid (the-as uint IOS_SUMMON_BOAT_AID))))
+        (the-as process-drawable (if ent (-> (the-as entity-actor ent) extra process)))))))
+
+(defun ios-boat-summon-moored? ((boat-spot vector))
+  "Is the boat already at (or about to appear at) this dock?"
+  (let ((boat (ios-boat-summon-boat))
+        (park (new 'stack-no-clear 'vector)))
+    (cond
+      (boat (< (vector-vector-xz-distance (-> boat root trans) boat-spot) IOS_SUMMON_MOORED_DIST))
+      ;; no boat process yet: it is about to spawn at its parked spot
+      ((ios-boat-park-get park) (< (vector-vector-xz-distance park boat-spot) IOS_SUMMON_MOORED_DIST))
+      (else #f))))
+
+(defun ios-boat-summon-jak-ready? ()
+  "Jak standing or walking on the ground, free to act."
+  (and *target*
+       (-> *target* next-state)
+       (member (-> *target* next-state name) '(target-stance target-walk target-turn-around target-stance-look-around))
+       (not (logtest? (-> *target* water flag) (water-flag touch-water)))))
+
+;; ---- the pad process -----------------------------------------------------------------------------------------
+
+(deftype ios-boat-summon (process-drawable)
+  ((pad        vector :inline)  ;; active pad (y from collision, w 1 once found)
+   (boat-spot  vector :inline)  ;; xz, w = yaw
+   (pad-level  symbol)
+   (old-boat   handle)          ;; the boat as it was when summoned (it must go away first)
+   (press-time time-frame)
+   (arrive-time time-frame)
+   (burst-time time-frame)
+   (bursts     int32))
+  (:states
+   ios-boat-summon-idle
+   ios-boat-summon-wait
+   ios-boat-summon-appear))
+
+(define *ios-boat-summon-ppointer* (the-as (pointer process) #f))
+(define *ios-boat-summon-pid* 0)
+
+(defun ios-boat-summon-get ()
+  (let ((pp *ios-boat-summon-ppointer*))
+    (the-as ios-boat-summon
+            (when pp
+              (let ((proc (-> pp 0)))
+                (if (and proc (= (-> proc pid) *ios-boat-summon-pid*)) proc))))))
+
+(defbehavior ios-boat-summon-pick-pad ios-boat-summon ()
+  "The pad of the dock level Jak is at (that level active, Jak within sparkle range), or #f."
+  (let ((jak (target-pos 0))
+        (found #f))
+    (dotimes (i 2)
+      (let ((lev (if (zero? i) 'village1 'village2))
+            (pad (new 'stack-no-clear 'vector)))
+        (if (zero? i)
+          (set-vector! pad IOS_SUMMON_VILLAGE1_PAD_X 0.0 IOS_SUMMON_VILLAGE1_PAD_Z 1.0)
+          (set-vector! pad IOS_SUMMON_VILLAGE2_PAD_X 0.0 IOS_SUMMON_VILLAGE2_PAD_Z 1.0))
+        (when (and (not found)
+                   (= (level-status *level* lev) 'active)
+                   (< (vector-vector-xz-distance pad jak) IOS_SUMMON_SPARKLE_DIST))
+          (set! found #t)
+          (when (!= (-> self pad-level) lev)
+            ;; new pad: find the dock's surface under it
+            (set! (-> self pad-level) lev)
+            (set! (-> self pad quad) (-> pad quad))
+            (set! (-> self pad w) 0.0)
+            (if (zero? i)
+              (set-vector! (-> self boat-spot)
+                           IOS_SUMMON_VILLAGE1_BOAT_X 0.0 IOS_SUMMON_VILLAGE1_BOAT_Z IOS_SUMMON_VILLAGE1_BOAT_YAW)
+              (set-vector! (-> self boat-spot)
+                           IOS_SUMMON_VILLAGE2_BOAT_X 0.0 IOS_SUMMON_VILLAGE2_BOAT_Z IOS_SUMMON_VILLAGE2_BOAT_YAW))))))
+    (if (not found) (set! (-> self pad-level) #f))
+    ;; the dock's height under the pad (collision only exists once the level is active)
+    (when (and found (< (-> self pad w) 0.5))
+      (let ((start (new 'stack-no-clear 'vector))
+            (probe (new 'stack-no-clear 'vector))
+            (result (new 'stack-no-clear 'collide-tri-result)))
+        (set-vector! start (-> self pad x) (meters 30) (-> self pad z) 1.0)
+        (set-vector! probe 0.0 (meters -40) 0.0 1.0)
+        (let ((u (fill-and-probe-using-line-sphere *collide-cache* start probe (meters 0.3)
+                                                   (collide-kind background) self result
+                                                   (new 'static 'pat-surface :noentity #x1))))
+          (when (>= u 0.0)
+            (set! (-> self pad y) (+ (- (meters 30) (* u (meters 40))) (meters 0.1)))
+            (set! (-> self pad w) 1.0)
+            (set! (-> self root trans quad) (-> self pad quad))
+            (set! (-> self root trans w) 1.0)))))
+    (and found (< 0.5 (-> self pad w)))))
+
+(defun ios-boat-summon-allowed? ()
+  "Driveable Boat on with the free boat (resident art), the fishing game done, normal gameplay."
+  (and (= *ios-driveable-boat* #t)
+       (= *ios-boat-art-resident* #t)
+       *target*
+       (task-complete? *game-info* (game-task jungle-fishgame))
+       (not (movie?))
+       (not (paused?))
+       (not (level-get *level* 'title))))
+
+(defbehavior ios-boat-summon-show-prompt ios-boat-summon ()
+  "The stock press-to-use layout (fishermans-boat-ios-board?), with our own text. #t if it is on screen."
+  (when (not (level-hint-displayed?))
+    (hide-hud)
+    (level-hint-surpress!)
+    (kill-current-level-hint '() '(sidekick voicebox) 'exit)
+    (when (and (hud-hidden?) (can-grab-display? self) (= *kernel-boot-message* 'play))
+      (let ((font (new 'stack 'font-context *font-default-matrix* 32 160 0.0 (font-color default) (font-flags shadow kerning))))
+        (set-width! font 440)
+        (set-height! font 80)
+        (set! (-> font flags) (font-flags shadow kerning large middle))
+        ;; <PAD_CIRCLE> in the game font (font_db_jak1.cpp), as in the boat's own hints
+        (ios-boat-summon-hint-line "PRESS ~Y~22L<~Z~Y~25L@~Z~Y~1L>~Z~Y~23L[~Z~+26H TO SUMMON BOAT" font 128))
+      #t)))
+
+(defbehavior ios-boat-summon-burst ios-boat-summon ((group-id int) (pos vector) (duration time-frame))
+  "One particle group at POS, run by its own part-tracker."
+  (let ((core (new 'stack-no-clear 'vector)))
+    (set! (-> core quad) (-> pos quad))
+    (set! (-> core w) (meters 4))
+    (process-spawn part-tracker
+                   :init part-tracker-init
+                   (-> *part-group-id-table* group-id)
+                   duration
+                   #f
+                   #f
+                   #f
+                   (the-as collide-prim-core core)
+                   :to *entity-pool*))
+  0)
+
+(defbehavior ios-boat-summon-pad-sparkle ios-boat-summon ()
+  ;; group-part-vent-blue-inactive (GAME.CGO): starflashes and blue motes rising off a 1.5 m square
+  (if (nonzero? (-> self part)) (spawn (-> self part) (-> self pad)))
+  0)
+
+(defbehavior ios-boat-summon-init-by-other ios-boat-summon ()
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! *ios-boat-summon-ppointer* (-> self ppointer))
+  (set! *ios-boat-summon-pid* (-> self pid))
+  (set! (-> self root) (new 'process 'trsqv))
+  (vector-reset! (-> self pad))
+  (set! (-> self pad-level) #f)
+  (set! (-> self old-boat) (the-as handle #f))
+  (set! (-> self part) (create-launch-control (-> *part-group-id-table* 45) self))
+  (set! (-> *ios-boat-summon-fade* w) 0.0)
+  (go ios-boat-summon-idle)
+  (none))
+
+(defmethod deactivate ((this ios-boat-summon))
+  ;; never leave the boat faded out
+  (set! (-> *ios-boat-summon-fade* w) 0.0)
+  ((method-of-type process-drawable deactivate) this)
+  (none))
+
+;; Sparkling pad; prompt + O press while Jak stands on it and the boat is elsewhere.
+(defstate ios-boat-summon-idle (ios-boat-summon)
+  :trans
+    (behavior ()
+      (when (and (ios-boat-summon-allowed?)
+                 (ios-boat-summon-pick-pad)
+                 (not (ios-boat-summon-moored? (-> self boat-spot))))
+        (ios-boat-summon-pad-sparkle)
+        (let ((jak (target-pos 0)))
+          (when (and (< (vector-vector-xz-distance jak (-> self pad)) IOS_SUMMON_PAD_RADIUS)
+                     (< (fabs (- (-> jak y) (-> self pad y))) (meters 2.5))
+                     (ios-boat-summon-jak-ready?)
+                     (ios-boat-summon-show-prompt)
+                     (cpad-pressed? 0 circle))
+            (ios-boat-summon-eat-circle)
+            (go ios-boat-summon-wait)))))
+  :code
+    (behavior ()
+      (loop
+        (suspend))))
+
+;; Pressed: move the parked spot here. The free boat wherever it was sees its spot change and goes; the free boat
+;; update (ios-boat-park.gc *menu-hook*) spawns the new one at this dock. Hidden (alpha 0) until it is here.
+(defstate ios-boat-summon-wait (ios-boat-summon)
+  :enter
+    (behavior ()
+      (set-time! (-> self press-time))
+      (let ((boat (ios-boat-summon-boat)))
+        (set! (-> self old-boat) (if boat (process->handle boat) (the-as handle #f))))
+      (sound-play "buzzer-pickup")
+      (ios-boat-summon-burst 63 (-> self pad) (seconds 1))
+      (set-vector! *ios-boat-summon-fade* 0.0 1.0 0.0 1.0)
+      (let ((spot (new 'stack-no-clear 'vector)))
+        (set-vector! spot (-> self boat-spot x) 0.0 (-> self boat-spot z) 1.0)
+        (ios-boat-park-store spot (-> self boat-spot w)))
+      (format 0 "ios-boat-summon: boat summoned to the ~A dock~%" (-> self pad-level)))
+  :trans
+    (behavior ()
+      (ios-boat-summon-pad-sparkle)
+      (let ((boat (ios-dsp-free-boat)))
+        (cond
+          ((and boat
+                (!= (process->handle boat) (-> self old-boat))
+                (< (vector-vector-xz-distance (-> boat root trans) (-> self boat-spot)) (meters 3)))
+           (go ios-boat-summon-appear))
+          ;; never stay invisible: give up after a while
+          ((time-elapsed? (-> self press-time) (seconds 5))
+           (format 0 "ios-boat-summon: no boat appeared~%")
+           (set! (-> *ios-boat-summon-fade* w) 0.0)
+           (go ios-boat-summon-idle)))))
+  :code
+    (behavior ()
+      (loop
+        (suspend))))
+
+;; The new boat is here: fade in from a glow over 2 s (glow gone after 3 s), with sparkles, lightning and a splash.
+(defstate ios-boat-summon-appear (ios-boat-summon)
+  :enter
+    (behavior ()
+      (set-time! (-> self arrive-time))
+      (set-time! (-> self burst-time))
+      (set! (-> self bursts) 0)
+      (let ((boat (ios-dsp-free-boat))
+            (pos (new 'stack-no-clear 'vector)))
+        (when boat
+          (set! (-> pos quad) (-> boat root trans quad))
+          (set! (-> pos y) (+ (ocean-get-height pos) (meters 0.3)))
+          (ios-boat-summon-burst 40 pos (seconds 3))   ;; group-part-water-splash
+          (ios-boat-summon-burst 44 pos (seconds 2.5)) ;; group-part-vent-blue-active: blue eco lightning
+          (+! (-> pos y) (meters 2.5))
+          (ios-boat-summon-burst 63 pos (seconds 1)))) ;; group-fuel-cell-starburst
+      (sound-play "y-eco-pickup"))
+  :trans
+    (behavior ()
+      (let* ((t (/ (the float (- (current-time) (-> self arrive-time))) (the float (seconds 2))))
+             (alpha (fmin 1.0 (fmax 0.0 t)))
+             (glow (fmax 0.0 (- 1.0 (* 0.6666667 t)))))
+        ;; ease in: slow start, quick finish
+        (set-vector! *ios-boat-summon-fade* (* alpha alpha (- 3.0 (* 2.0 alpha))) glow 0.0 1.0)
+        ;; sparkle bursts around the hull while it materializes
+        (let ((boat (ios-dsp-free-boat)))
+          (when (and boat (< (-> self bursts) 6) (time-elapsed? (-> self burst-time) (seconds 0.3)))
+            (set-time! (-> self burst-time))
+            (+! (-> self bursts) 1)
+            (let ((pos (new 'stack-no-clear 'vector)))
+              (set-vector! pos
+                           (+ (-> boat root trans x) (rand-vu-float-range (meters -5) (meters 5)))
+                           (+ (-> boat root trans y) (rand-vu-float-range (meters 1) (meters 4)))
+                           (+ (-> boat root trans z) (rand-vu-float-range (meters -5) (meters 5)))
+                           1.0)
+              (ios-boat-summon-burst 63 pos (seconds 1)))))
+        (when (or (< 1.5 t) (not (ios-dsp-free-boat)))
+          (set! (-> *ios-boat-summon-fade* w) 0.0)
+          (go ios-boat-summon-idle))))
+  :code
+    (behavior ()
+      (loop
+        (suspend))))
+
+;; ---- per frame -----------------------------------------------------------------------------------------------
+
+(defun ios-boat-summon-update ()
+  (cond
+    ((and (= *ios-driveable-boat* #t) (= *ios-boat-art-resident* #t) *target* (not (level-get *level* 'title)))
+     (if (not (ios-boat-summon-get)) (process-spawn ios-boat-summon :to *entity-pool*)))
+    (else
+     (let ((proc (ios-boat-summon-get)))
+       (if proc (deactivate proc)))
+     (set! (-> *ios-boat-summon-fade* w) 0.0)))
+  0)
+
+;; Chain into *menu-hook* (after ios-ocean-fish's). This file's top-level only runs once, at boot.
+(define *ios-boat-summon-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-boat-summon-menu-hook ()
+  (ios-boat-summon-update)
+  (*ios-boat-summon-prev-menu-hook*)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-boat-summon-menu-hook))
diff --git a/goal_src/jak1/pc/ios/ios-dynamic-save.gc b/goal_src/jak1/pc/ios/ios-dynamic-save.gc
new file mode 100644
index 000000000..327e36459
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-dynamic-save.gc
@@ -0,0 +1,453 @@
+;;-*-Lisp-*-
+(in-package goal)
+(require "engine/target/logic-target.gc")
+(require "engine/target/target2.gc")
+
+;; og:ios Dynamic Save Points (experimental): a save remembers exactly where Jak was, and loading it puts him back
+;; there instead of at the save's checkpoint (continue point). On the Driveable Boat he comes back on the boat.
+;;
+;; game-info / game-save are captured engine code on iOS, so this file is linked as a startup object
+;; (aot_level_code_link.py --startup-object ios-dynamic-save, after ios-boat-park). Its top-level runs once at boot:
+;; - every frame (chained into *menu-hook*) the last "safe" spot is kept in *ios-dsp-snapshot*: Jak standing,
+;;   walking, wading or swimming (never mid-air, in cutscenes, deaths, warps, on the zoomer or the flut flut), plus
+;;   the levels wanted at that moment. On the free boat the spot is relative to the boat.
+;; - save-game! (wrapped) copies the snapshot into four extra perms in *game-info*'s perm-list (aid
+;;   IOS_DSP_AID_BASE+0..3, no entity has those), so it goes into the save file with the rest of the perms. A
+;;   snapshot is only used while the checkpoint is still the one it was taken at.
+;; - load-game! (wrapped) reads those perms back. If they are valid, the checkpoint the save resumes at is
+;;   replaced by *ios-dsp-continue*: the save's checkpoint, moved to Jak's spot and with the levels he had. Once
+;;   target-continue is done with it, the stock checkpoint is put back (deaths respawn there as usual).
+;; Saves made with the option off (or from before it existed) have no valid record and load as in the stock game.
+
+;; set by the host every frame (OpenGOALRuntimeHost.mm SyncDynamicSavePointsOption)
+(define-perm *ios-dynamic-save-points* symbol #f)
+
+(define-extern *ios-driveable-boat* symbol)
+(define-extern *ios-boat-driving* symbol)
+(define-extern *ios-boat-art-resident* symbol)
+(define-extern *ios-free-boat-ppointer* (pointer process))
+(define-extern *ios-free-boat-pid* int)
+(define-extern *ios-free-boat-last-park* vector)
+(define-extern ios-boat-park-store (function vector float int))
+
+;; perm-list entries: +0 x y, +1 z yaw, +2 levels/flags/magic, +3 checkpoint name hash
+(defconstant IOS_DSP_AID_BASE #x7fd50000)
+(defconstant IOS_DSP_MAGIC #x5d5b)
+(defconstant IOS_DSP_NO_LEVEL 255)
+;; flags
+(defconstant IOS_DSP_FLAG_BOAT 1) ;; x y z yaw relative to the free boat (its spot is the save's parked spot)
+
+;; Above the deck / ground when placed, so Jak drops onto it instead of starting inside it.
+(defconstant IOS_DSP_LIFT (meters 0.3))
+;; After loading aboard: frames Jak is held on the free boat once it exists (it spawns after target-continue).
+(defconstant IOS_DSP_BOAT_HOLD_FRAMES 10)
+(defconstant IOS_DSP_BOAT_WAIT (seconds 3))
+;; Initial camera: behind and above Jak (cam-string takes over right away).
+(defconstant IOS_DSP_CAM_BACK (meters 7))
+(defconstant IOS_DSP_CAM_UP (meters 3))
+
+(deftype ios-dsp-record (structure)
+  ((valid     symbol)
+   (pos       vector :inline) ;; w = yaw (relative to the boat with IOS_DSP_FLAG_BOAT)
+   (flags     uint8)
+   (inside    uint8)
+   (lev0      uint8)
+   (lev1      uint8)
+   (vis       uint8)
+   (disp      uint8) ;; disp0 | disp1 << 4
+   (cont-hash uint32)))
+
+(define-perm *ios-dsp-snapshot* ios-dsp-record (new 'global 'ios-dsp-record))
+(set! (-> *ios-dsp-snapshot* valid) #f)
+(define-perm *ios-dsp-continue* continue-point (new 'global 'continue-point))
+;; the stock checkpoint *ios-dsp-continue* stands in for, and where that stand-in is in its use:
+;; 'armed (load-game! set it), 'running (target-continue started), 'boat (holding Jak on the boat), #f
+(define-perm *ios-dsp-stock-continue* continue-point #f)
+(define-perm *ios-dsp-phase* symbol #f)
+(define-perm *ios-dsp-boat-local* vector (new 'global 'vector))
+(define-perm *ios-dsp-boat-frames* int 0)
+(define-perm *ios-dsp-boat-start* time-frame 0)
+(define-perm *ios-dsp-continue-start* time-frame 0)
+;; target-continue never gives up waiting for vis: past this, a level still 'loading is let through
+(defconstant IOS_DSP_VIS_TIMEOUT (seconds 8))
+
+;; Helpers -----------------------------------------------------------------------------------------------------------
+
+(defun ios-dsp-string-hash ((str string))
+  (let ((hash (the-as uint 5381)))
+    (when str
+      (let ((i 0))
+        (while (nonzero? (-> str data i))
+          (set! hash (the-as uint (logand #xffffffff (+ (* hash 33) (-> str data i)))))
+          (+! i 1))))
+    hash))
+
+(defun ios-dsp-level-index ((name symbol))
+  (if (not name)
+    IOS_DSP_NO_LEVEL
+    (let ((info (lookup-level-info name)))
+      (if (or (= info default-level) (< (-> info index) 0) (>= (-> info index) IOS_DSP_NO_LEVEL))
+        IOS_DSP_NO_LEVEL
+        (-> info index)))))
+
+(defun ios-dsp-level-info ((index uint))
+  "level-load-info with this index, #f if none."
+  (when (!= index IOS_DSP_NO_LEVEL)
+    (let ((rest *level-load-list*))
+      (while (not (null? rest))
+        (let ((info (the-as level-load-info (-> (the-as symbol (car rest)) value))))
+          (if (= (-> info index) (the int index)) (return info)))
+        (set! rest (cdr rest)))))
+  (the-as level-load-info #f))
+
+(defun ios-dsp-level-name ((index uint))
+  (let ((info (ios-dsp-level-info index))) (if info (-> info name) #f)))
+
+(defun ios-dsp-disp-code ((disp symbol))
+  (cond
+    ((not disp) 0)
+    ((= disp 'special) 2)
+    ((= disp 'display-self) 3)
+    (else 1)))
+
+(defun ios-dsp-disp-symbol ((code uint))
+  (case code
+    ((0) #f)
+    ((2) 'special)
+    ((3) 'display-self)
+    (else 'display)))
+
+(defun ios-dsp-yaw ((quat quaternion))
+  (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) quat))) (atan (-> fwd x) (-> fwd z))))
+
+(defun ios-dsp-free-boat ()
+  "The Driveable Boat's free boat (fishermans-boat.gc ios-free-boat), or #f."
+  (the-as process-drawable
+          (when (and (= *ios-driveable-boat* #t) (= *ios-boat-art-resident* #t) *ios-free-boat-ppointer*)
+            (let ((proc (-> *ios-free-boat-ppointer* 0)))
+              (if (and proc (= (-> proc pid) *ios-free-boat-pid*)) proc)))))
+
+(defun ios-dsp-on-boat? ((boat process-drawable))
+  "Jak at the boat's wheel or standing on its deck (its only sticky rider slot)."
+  (and boat
+       (or (= *ios-boat-driving* #t)
+           (let ((riders (-> (the-as collide-shape (-> boat root)) riders)))
+             (and (nonzero? riders)
+                  (> (-> riders num-riders) 0)
+                  (= (handle->process (-> riders rider 0 rider-handle)) *target*))))))
+
+(defun ios-dsp-boat-to-local ((dst vector) (boat process-drawable) (pos vector) (yaw float))
+  "pos/yaw in the boat's frame (yaw only: the boat's parked spot keeps no pitch/roll)."
+  (let* ((boat-yaw (ios-dsp-yaw (-> boat root quat)))
+         (dx (- (-> pos x) (-> boat root trans x)))
+         (dz (- (-> pos z) (-> boat root trans z)))
+         (s (sin boat-yaw))
+         (c (cos boat-yaw)))
+    (set-vector! dst
+                 (- (* dx c) (* dz s))
+                 (- (-> pos y) (-> boat root trans y))
+                 (+ (* dx s) (* dz c))
+                 (- yaw boat-yaw)))
+  dst)
+
+(defun ios-dsp-local-to-world ((dst vector) (local vector) (x float) (y float) (z float) (boat-yaw float))
+  "Inverse of ios-dsp-boat-to-local for a boat at x y z facing boat-yaw (w = Jak's world yaw)."
+  (let ((s (sin boat-yaw))
+        (c (cos boat-yaw)))
+    (set-vector! dst
+                 (+ x (* (-> local x) c) (* (-> local z) s))
+                 (+ y (-> local y))
+                 (+ z (- (* (-> local z) c) (* (-> local x) s)))
+                 (+ (-> local w) boat-yaw)))
+  dst)
+
+;; Snapshot (every frame) --------------------------------------------------------------------------------------------
+
+(defun ios-dsp-safe-state? ()
+  "Jak standing, walking, wading or swimming on his own feet, or at the boat's wheel."
+  (let ((state (-> *target* next-state)))
+    (and state
+         (or (member (-> state name)
+                     '(target-stance target-walk target-turn-around target-stance-look-around target-stance-ambient
+                       target-duck-stance target-duck-walk target-wade-stance target-wade-walk target-swim-stance
+                       target-swim-walk))
+             (and (= *ios-boat-driving* #t) (member (-> state name) '(target-grab target-flut-grab)))))))
+
+(defun ios-dsp-update-snapshot ()
+  (let ((snap *ios-dsp-snapshot*))
+    (cond
+      ;; title screen: a new game or a load follows, the old game's spot must not leak into it
+      ((or (not *target*) (level-get *level* 'title) (!= *ios-dynamic-save-points* #t)) (set! (-> snap valid) #f))
+      ((and (not (paused?))
+            (not (movie?))
+            (not *ios-dsp-phase*)
+            (-> *game-info* current-continue)
+            (ios-dsp-safe-state?))
+       (let* ((inside-lev (level-get-target-inside *level*))
+              (lev0 (-> *load-state* want 0 name))
+              (lev1 (-> *load-state* want 1 name))
+              (inside (cond
+                        ((and inside-lev (or (= (-> inside-lev name) lev0) (= (-> inside-lev name) lev1)))
+                         (-> inside-lev name))
+                        (else lev0)))
+              (boat (ios-dsp-free-boat))
+              (pos (-> *target* control trans))
+              (yaw (ios-dsp-yaw (-> *target* control quat))))
+         (when (and inside (!= (ios-dsp-level-index lev0) IOS_DSP_NO_LEVEL))
+           (cond
+             ((ios-dsp-on-boat? boat)
+              (ios-dsp-boat-to-local (-> snap pos) boat pos yaw)
+              (set! (-> snap flags) IOS_DSP_FLAG_BOAT))
+             (else
+              (set! (-> snap pos quad) (-> pos quad))
+              (set! (-> snap pos w) yaw)
+              (set! (-> snap flags) 0)))
+           (set! (-> snap inside) (ios-dsp-level-index inside))
+           (set! (-> snap lev0) (ios-dsp-level-index lev0))
+           (set! (-> snap lev1) (ios-dsp-level-index lev1))
+           (set! (-> snap vis) (ios-dsp-level-index (-> *load-state* vis-nick)))
+           (set! (-> snap disp)
+                 (logior (ios-dsp-disp-code (-> *load-state* want 0 display?))
+                         (shl (ios-dsp-disp-code (-> *load-state* want 1 display?)) 4)))
+           (set! (-> snap cont-hash) (ios-dsp-string-hash (-> *game-info* current-continue name)))
+           (set! (-> snap valid) #t))))))
+  0)
+
+;; Save file perms ---------------------------------------------------------------------------------------------------
+
+(defun ios-dsp-perm ((this game-info) (index int) (create symbol))
+  "One of the four record perms in the perm-list (added at its end when create and there is room)."
+  (let ((perm (lookup-entity-perm-by-aid this (the-as actor-id (+ IOS_DSP_AID_BASE index)))))
+    (when (and (not perm) create)
+      (let ((perms (-> this perm-list)))
+        (when (< (-> perms length) (-> perms allocated-length))
+          (set! perm (-> perms data (-> perms length)))
+          (set! (-> perm quad) (the-as uint128 0))
+          (set! (-> perm aid) (the-as actor-id (+ IOS_DSP_AID_BASE index)))
+          (+! (-> perms length) 1))))
+    perm))
+
+(defun ios-dsp-clear-perms ((this game-info))
+  (let ((perm (ios-dsp-perm this 2 #f))) (if perm (set! (-> perm user-uint16 3) 0)))
+  0)
+
+(defun ios-dsp-write-perms ((this game-info))
+  "Before a save: the snapshot into the perms, or no record when there is nothing usable."
+  (let ((snap *ios-dsp-snapshot*))
+    (cond
+      ((and (= *ios-dynamic-save-points* #t)
+            (-> snap valid)
+            (-> this current-continue)
+            (= (-> snap cont-hash) (ios-dsp-string-hash (-> this current-continue name)))
+            ;; relative to a boat that is still there
+            (or (zero? (logand (-> snap flags) IOS_DSP_FLAG_BOAT)) (ios-dsp-free-boat)))
+       (when (nonzero? (logand (-> snap flags) IOS_DSP_FLAG_BOAT))
+         ;; the save's parked spot = where the boat is now (it only records it every 15 frames)
+         (let* ((boat (ios-dsp-free-boat))
+                (boat-yaw (ios-dsp-yaw (-> boat root quat))))
+           (ios-boat-park-store (-> boat root trans) boat-yaw)
+           ;; the boat checks its spot against this one and would otherwise remove itself (park-replaced?)
+           (when *ios-free-boat-last-park*
+             (set-vector! *ios-free-boat-last-park* (-> boat root trans x) 0.0 (-> boat root trans z) 1.0))))
+       (let ((p0 (ios-dsp-perm this 0 #t))
+             (p1 (ios-dsp-perm this 1 #t))
+             (p2 (ios-dsp-perm this 2 #t))
+             (p3 (ios-dsp-perm this 3 #t)))
+         (cond
+           ((and p0 p1 p2 p3)
+            (set! (-> p0 user-float 0) (-> snap pos x))
+            (set! (-> p0 user-float 1) (-> snap pos y))
+            (set! (-> p1 user-float 0) (-> snap pos z))
+            (set! (-> p1 user-float 1) (-> snap pos w))
+            (set! (-> p2 user-uint8 0) (-> snap inside))
+            (set! (-> p2 user-uint8 1) (-> snap lev0))
+            (set! (-> p2 user-uint8 2) (-> snap lev1))
+            (set! (-> p2 user-uint8 3) (-> snap vis))
+            (set! (-> p2 user-uint8 4) (-> snap disp))
+            (set! (-> p2 user-uint8 5) (-> snap flags))
+            (set! (-> p2 user-uint16 3) IOS_DSP_MAGIC)
+            (set! (-> p3 user-uint32 0) (-> snap cont-hash))
+            (set! (-> p3 user-uint32 1) 0)
+            (format 0 "ios-dynamic-save: saved Jak at ~M ~M ~M (flags ~D)~%"
+                    (-> snap pos x) (-> snap pos y) (-> snap pos z) (-> snap flags)))
+           (else (ios-dsp-clear-perms this)))))
+      (else (ios-dsp-clear-perms this))))
+  0)
+
+(defun ios-dsp-camera ((cont continue-point))
+  "A camera behind and above Jak's spot, looking at him."
+  (let ((fwd (new 'stack-no-clear 'vector))
+        (look (new 'stack-no-clear 'vector))
+        (mat (new 'stack-no-clear 'matrix)))
+    (set-vector! fwd (sin (-> cont trans w)) 0.0 (cos (-> cont trans w)) 1.0)
+    (vector+*! (-> cont camera-trans) (-> cont trans) fwd (- IOS_DSP_CAM_BACK))
+    (+! (-> cont camera-trans y) IOS_DSP_CAM_UP)
+    (set! (-> cont camera-trans w) 1.0)
+    (vector-! look (-> cont trans) (-> cont camera-trans))
+    (+! (-> look y) (meters 1))
+    (forward-down->inv-matrix mat look (new 'static 'vector :y -1.0))
+    (dotimes (row 3)
+      (set! (-> cont camera-rot (* row 3)) (-> mat vector row x))
+      (set! (-> cont camera-rot (+ (* row 3) 1)) (-> mat vector row y))
+      (set! (-> cont camera-rot (+ (* row 3) 2)) (-> mat vector row z))))
+  0)
+
+(defun ios-dsp-apply-perms ((this game-info))
+  "After a load: with a valid record for the save's checkpoint, resume at Jak's saved spot."
+  (let ((stock (-> this current-continue))
+        (p0 (ios-dsp-perm this 0 #f))
+        (p1 (ios-dsp-perm this 1 #f))
+        (p2 (ios-dsp-perm this 2 #f))
+        (p3 (ios-dsp-perm this 3 #f)))
+    (when (and (= *ios-dynamic-save-points* #t)
+               stock
+               (!= stock *ios-dsp-continue*)
+               p0 p1 p2 p3
+               (= (-> p2 user-uint16 3) IOS_DSP_MAGIC)
+               (= (-> p3 user-uint32 0) (ios-dsp-string-hash (-> stock name))))
+      (let ((inside (ios-dsp-level-name (-> p2 user-uint8 0)))
+            (lev0 (ios-dsp-level-name (-> p2 user-uint8 1)))
+            (lev1 (ios-dsp-level-name (-> p2 user-uint8 2)))
+            (local (new 'stack-no-clear 'vector))
+            (cont *ios-dsp-continue*))
+        (set-vector! local (-> p0 user-float 0) (-> p0 user-float 1) (-> p1 user-float 0) (-> p1 user-float 1))
+        (when (and lev0 inside (or (= inside lev0) (= inside lev1)))
+          (cond
+            ((nonzero? (logand (-> p2 user-uint8 5) IOS_DSP_FLAG_BOAT))
+             ;; the boat comes back anchored at the parked spot saved with it (water line y 0)
+             (let ((park (new 'stack-no-clear 'vector))
+                   (perm (lookup-entity-perm-by-aid this (the-as actor-id 10419))))
+               (cond
+                 ((and perm (= (-> perm user-int16 3) #x2b0a))
+                  (set-vector! park
+                               (* (meters 0.25) (the float (-> perm user-int16 0)))
+                               0.0
+                               (* (meters 0.25) (the float (-> perm user-int16 1)))
+                               (the float (-> perm user-int16 2)))
+                  (ios-dsp-local-to-world (-> cont trans) local (-> park x) 0.0 (-> park z) (-> park w))
+                  (set! (-> *ios-dsp-boat-local* quad) (-> local quad)))
+                 (else (return 0)))))
+            (else (set! (-> cont trans quad) (-> local quad))))
+          (+! (-> cont trans y) IOS_DSP_LIFT)
+          (quaternion-axis-angle! (-> cont quat) 0.0 1.0 0.0 (-> cont trans w))
+          (ios-dsp-camera cont)
+          (set! (-> cont trans w) 1.0)
+          (set! (-> cont name) (-> stock name))
+          (set! (-> cont level) inside)
+          (set! (-> cont flags) (continue-flags))
+          (set! (-> cont load-commands) (if (= inside (-> stock level)) (-> stock load-commands) '()))
+          ;; the vis of the level Jak is in, like every stock checkpoint: target-continue waits for that
+          ;; level's vis, which only loads for the vis-nick level (the recorded *load-state* vis-nick is often
+          ;; the neighbouring level's, which left the screen black forever)
+          (let ((vis (lookup-level-info inside)))
+            (set! (-> cont vis-nick) (if (!= vis default-level) (-> vis nickname) (-> stock vis-nick))))
+          (set! (-> cont lev0) lev0)
+          (set! (-> cont disp0) (ios-dsp-disp-symbol (logand (-> p2 user-uint8 4) 15)))
+          (set! (-> cont lev1) lev1)
+          (set! (-> cont disp1) (if lev1 (ios-dsp-disp-symbol (shr (-> p2 user-uint8 4) 4)) #f))
+          (set! *ios-dsp-stock-continue* stock)
+          (set! (-> this current-continue) cont)
+          (set! *ios-dsp-phase*
+                (if (nonzero? (logand (-> p2 user-uint8 5) IOS_DSP_FLAG_BOAT)) 'armed-boat 'armed))
+          (format 0 "ios-dynamic-save: resuming at ~M ~M ~M in ~A (~A ~A)~%"
+                  (-> cont trans x) (-> cont trans y) (-> cont trans z) inside lev0 lev1)))))
+  0)
+
+;; Stand-in checkpoint lifecycle (every frame, paused or not) ---------------------------------------------------------
+
+(defun ios-dsp-restore-stock-continue ()
+  (when (= (-> *game-info* current-continue) *ios-dsp-continue*)
+    ;; straight into the field: set-continue! would reset the checkpoint's death count and time
+    (set! (-> *game-info* current-continue) *ios-dsp-stock-continue*))
+  0)
+
+(defun ios-dsp-hold-on-boat ()
+  "After loading aboard: the free boat spawns once target-continue is done, so keep Jak on its deck for a few
+   frames after it appears (he would drop into the sea before it is there)."
+  (let ((boat (ios-dsp-free-boat)))
+    (cond
+      ((and boat *target*)
+       (let ((pos (new 'stack-no-clear 'vector)))
+         (ios-dsp-local-to-world pos *ios-dsp-boat-local*
+                                 (-> boat root trans x) (-> boat root trans y) (-> boat root trans z)
+                                 (ios-dsp-yaw (-> boat root quat)))
+         (+! (-> pos y) IOS_DSP_LIFT)
+         (set! (-> pos w) 1.0)
+         (move-to-point! (-> *target* control) pos)
+         (vector-reset! (-> *target* control transv)))
+       (+! *ios-dsp-boat-frames* 1)
+       (if (>= *ios-dsp-boat-frames* IOS_DSP_BOAT_HOLD_FRAMES) (set! *ios-dsp-phase* #f)))
+      ((time-elapsed? *ios-dsp-boat-start* IOS_DSP_BOAT_WAIT)
+       (format 0 "ios-dynamic-save: no free boat after loading aboard~%")
+       (set! *ios-dsp-phase* #f))))
+  0)
+
+(defun ios-dsp-update-phase ()
+  (let ((in-continue (and *target*
+                          (-> *target* next-state)
+                          (= (-> *target* next-state name) 'target-continue))))
+    (case *ios-dsp-phase*
+      (('armed 'armed-boat)
+       (cond
+         (in-continue
+          (set-time! *ios-dsp-continue-start*)
+          (set! *ios-dsp-phase* (if (= *ios-dsp-phase* 'armed-boat) 'running-boat 'running)))
+         ;; a new game or another load replaced it before it was used
+         ((!= (-> *game-info* current-continue) *ios-dsp-continue*) (set! *ios-dsp-phase* #f))))
+      (('running 'running-boat)
+       (when (and in-continue (time-elapsed? *ios-dsp-continue-start* IOS_DSP_VIS_TIMEOUT))
+         (dotimes (i (-> *level* length))
+           (let ((lev (-> *level* level i)))
+             (when (and (= (-> lev status) 'active) (= (-> lev all-visible?) 'loading))
+               (format 0 "ios-dynamic-save: no vis for ~A, continuing without it~%" (-> lev name))
+               (set! (-> lev all-visible?) #t))))
+         ;; same for the other level it waits on: don't wait for it to be displayed (Jak's own level still is)
+         (let ((cont *ios-dsp-continue*))
+           (when (and (-> cont lev1) (-> cont disp1) (!= (-> cont lev1) (-> cont level))
+                      (!= (level-status *level* (-> cont lev1)) 'active))
+             (format 0 "ios-dynamic-save: ~A not active, continuing without it~%" (-> cont lev1))
+             (set! (-> cont disp1) #f))
+           (when (and (-> cont lev0) (-> cont disp0) (!= (-> cont lev0) (-> cont level))
+                      (!= (level-status *level* (-> cont lev0)) 'active))
+             (format 0 "ios-dynamic-save: ~A not active, continuing without it~%" (-> cont lev0))
+             (set! (-> cont disp0) #f))))
+       (when (not in-continue)
+         (ios-dsp-restore-stock-continue)
+         (cond
+           ((= *ios-dsp-phase* 'running-boat)
+            (set! *ios-dsp-boat-frames* 0)
+            (set-time! *ios-dsp-boat-start*)
+            (set! *ios-dsp-phase* 'boat))
+           (else (set! *ios-dsp-phase* #f)))))
+      (('boat) (if (not (paused?)) (ios-dsp-hold-on-boat)))))
+  0)
+
+;; Engine hooks ------------------------------------------------------------------------------------------------------
+
+;; define-perm: the originals are taken once, so wrapping can never wrap itself
+(define-perm *ios-dsp-orig-save-game* function (method-of-type game-info save-game!))
+(define-perm *ios-dsp-orig-load-game* function (method-of-type game-info load-game!))
+
+(defmethod save-game! ((this game-info) (arg0 game-save) (arg1 string))
+  (ios-dsp-write-perms this)
+  ((the-as (function game-info game-save string none) *ios-dsp-orig-save-game*) this arg0 arg1)
+  (none))
+
+(defmethod load-game! ((this game-info) (save game-save))
+  ;; whatever happens below, the snapshot was of the game being left
+  (set! (-> *ios-dsp-snapshot* valid) #f)
+  (set! *ios-dsp-phase* #f)
+  ((the-as (function game-info game-save game-save) *ios-dsp-orig-load-game*) this save)
+  (if (zero? (-> save new-game)) (ios-dsp-apply-perms this))
+  save)
+
+;; Chain into *menu-hook* (after ios-boat-park's). This file's top-level only runs once, at boot.
+(define *ios-dsp-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-dsp-menu-hook ()
+  (ios-dsp-update-phase)
+  (ios-dsp-update-snapshot)
+  (*ios-dsp-prev-menu-hook*)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-dsp-menu-hook))
diff --git a/goal_src/jak1/pc/ios/ios-green-eco.gc b/goal_src/jak1/pc/ios/ios-green-eco.gc
new file mode 100644
index 000000000..ddb99ae53
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-green-eco.gc
@@ -0,0 +1,241 @@
+;;-*-Lisp-*-
+(in-package goal)
+(require "engine/game/game-info.gc")
+(require "engine/target/logic-target.gc")
+(require "engine/common-obs/collectables.gc")
+
+;; og:ios Expanded Green Eco (experimental, user 2026-10-12).
+;;
+;; - Green eco vents and big green eco clusters (the `health` collectable) charge Jak with green eco like the other
+;;   eco colours: a vent fills the meter, a cluster fills it partially (the stock eco timeouts). Stock only does this
+;;   for a green vent while racing on the zoomer; the glow, particles and loop sound are the stock
+;;   target-powerup-process ones for a green charge, so they now show on foot too. The stock health gain still
+;;   happens on pickup.
+;; - While charged: +1 health every IOS_GREEN_ECO_REGEN_TIME until full; at full health Jak takes no damage (the
+;;   stock but unused invuln-powerup state flag, honoured by target-attacked). The flag is dropped as soon as the
+;;   charge runs out (stock target-powerup-process also clears it then) or health is below full.
+;; - Extra green eco vents (user 2026-10-12), only while the option is on: see *ios-green-vent-spots* below.
+;;
+;; game-info and logic-target are captured engine objects on iOS, so this file is linked as a startup object
+;; (aot_level_code_link.py --startup-object ios-green-eco, after ios-boat-summon). Its top-level runs once at boot:
+;; it replaces fact-info-target's pickup-collectable! (wrapping the stock method) and chains the per-frame update
+;; into *menu-hook*.
+
+;; set by the host every frame (OpenGOALRuntimeHost.mm SyncExpandedGreenEcoOption)
+(define-perm *ios-expanded-green-eco* symbol #f)
+
+(defconstant IOS_GREEN_ECO_REGEN_TIME (seconds 5))
+
+;; the captured stock method (define-perm: never wrap the wrapper)
+(define-perm *ios-green-eco-stock-pickup* (function fact-info-target pickup-type float handle float)
+  (the-as (function fact-info-target pickup-type float handle float)
+          (method-of-type fact-info-target pickup-collectable!)))
+
+(defun ios-green-eco-source? ((source-handle handle))
+  "A green eco vent or a big green eco cluster."
+  (let ((proc (handle->process source-handle)))
+    (and proc (or (type-type? (-> proc type) vent) (type-type? (-> proc type) health)))))
+
+(defun ios-green-eco-charge! ((this fact-info-target) (amount float))
+  "Stock eco powerup path of pickup-collectable! (game-info.gc, label cfg-80) for green eco. The stock green
+   branch already ran and played the pickup sound, so the duplicate sound/vibration is skipped like it is on the
+   zoomer."
+  (when (!= (-> this eco-type) (pickup-type eco-green))
+    (set! (-> this eco-level) 0.0)
+    (set! (-> this eco-timeout) 0))
+  (set! (-> this eco-type) (pickup-type eco-green))
+  (let ((eco-lev (-> this eco-level)))
+    (set! (-> this eco-level) 1.0)
+    (when (= eco-lev 0.0)
+      (set! (-> this eco-pickup-time) (-> *display* game-frame-counter))
+      (send-event (-> this process) 'reset-collide))
+    (set! (-> this eco-timeout)
+          (the-as seconds
+                  (min (the-as int (+ (-> this eco-timeout) (* (the-as int (-> *FACT-bank* eco-single-timeout)) (the int amount))))
+                       (the-as int (+ (-> *FACT-bank* eco-full-timeout) (- (-> *display* game-frame-counter) (-> this eco-pickup-time)))))))
+    (if (>= (the-as int (- (-> this eco-timeout) (the-as uint (- (-> *display* game-frame-counter) (-> this eco-pickup-time)))))
+            (the-as int (-> *FACT-bank* eco-full-timeout)))
+      (set! (-> this eco-level) 2.0)))
+  (-> this eco-level))
+
+(defmethod pickup-collectable! ((this fact-info-target) (kind pickup-type) (amount float) (source-handle handle))
+  (let ((result (*ios-green-eco-stock-pickup* this kind amount source-handle)))
+    (if (and (= *ios-expanded-green-eco* #t)
+             (= kind (pickup-type eco-green))
+             (< 0.0 amount)
+             (ios-green-eco-source? source-handle)
+             ;; stock already charged it (green vent on the zoomer)
+             (not (and (logtest? (-> (the-as collide-shape (-> this process root)) root-prim prim-core action) (collide-action racer))
+                       (type-type? (-> (handle->process source-handle) type) vent))))
+      (ios-green-eco-charge! this amount)
+      result)))
+
+;; ---- per-frame: health regen + invulnerability while charged ----------------------------------------------------
+
+(define *ios-green-eco-regen-time* (the-as time-frame 0))
+(define *ios-green-eco-was-charged* #f)
+(define *ios-green-eco-invuln* #f) ;; we set invuln-powerup (only clear it if we did)
+
+(defun ios-green-eco-update ()
+  (let* ((tgt *target*)
+         (now (-> *display* game-frame-counter))
+         (charged (and (= *ios-expanded-green-eco* #t)
+                       tgt
+                       (= (-> tgt game mode) 'play)
+                       (not (logtest? (-> tgt state-flags) (state-flags dying)))
+                       (= (-> tgt fact eco-type) (pickup-type eco-green))
+                       (< 0.0 (-> tgt fact eco-level)))))
+    (cond
+      (charged
+       ;; the 5 s count starts when the charge does
+       (if (not *ios-green-eco-was-charged*) (set! *ios-green-eco-regen-time* now))
+       (cond
+         ((< (-> tgt fact health) (-> tgt fact health-max))
+          (when (>= (- now *ios-green-eco-regen-time*) IOS_GREEN_ECO_REGEN_TIME)
+            (set! *ios-green-eco-regen-time* now)
+            ;; stock big green eco pickup: health + 1, health HUD pops up
+            (pickup-collectable! (-> tgt fact) (pickup-type eco-green) (-> *FACT-bank* health-single-inc) (the-as handle #f))))
+         (else (set! *ios-green-eco-regen-time* now)))
+       (cond
+         ((>= (-> tgt fact health) (-> tgt fact health-max))
+          (logior! (-> tgt state-flags) (state-flags invuln-powerup))
+          (set! *ios-green-eco-invuln* #t))
+         (*ios-green-eco-invuln*
+          (logclear! (-> tgt state-flags) (state-flags invuln-powerup))
+          (set! *ios-green-eco-invuln* #f))))
+      (else
+       (when *ios-green-eco-invuln*
+         (if tgt (logclear! (-> tgt state-flags) (state-flags invuln-powerup)))
+         (set! *ios-green-eco-invuln* #f))))
+    (set! *ios-green-eco-was-charged* (if charged #t #f)))
+  0)
+
+;; ---- extra green eco vents ---------------------------------------------------------------------------------------
+;;
+;; Only while the option is on. Each is an ios-green-vent (a stock `vent`: eco stream particles, ambient sound,
+;; touch pickup, so pickup-collectable! above sees a vent source) spawned in *entity-pool* while its level is active
+;; and Jak is in range, re-ensured every frame (a death's reset-actors clears the pool). The vent has no model of
+;; its own: the stone ring is a background prop, so the renderer draws the citadel's vent ring (cit-ecovent.mb,
+;; Jak1Level-ios-vents.fr3z) at every vent listed in *ios-green-vent-props*.
+
+(defconstant IOS_GREEN_VENT_COUNT 1)
+(defconstant IOS_GREEN_VENT_RANGE (meters 120))
+
+;; Where each vent stands (on the ground, game units) and the level whose collision it stands on.
+;;  0: outside Gol and Maia's citadel, on the lava tube's bridge in front of the steps up to the door, 6 m south and
+;;     4 m east of the "citadel-entrance" continue point (Jak's spawn), 6 m from the bridge's east edge, nothing
+;;     taller within 9 m (bridge y -39.5 m, flat; spot picked from the lavatube collision mesh).
+(define *ios-green-vent-spots*
+  (new 'static 'inline-array vector IOS_GREEN_VENT_COUNT
+       (new 'static 'vector :x 11460362.0 :y -161792.0 :z -18448220.0 :w 1.0)))
+
+(defun ios-green-vent-level ((i int))
+  (case i
+    ((0) 'lavatube)
+    (else #f)))
+
+;; read by the host every frame (OpenGOALRuntimeHost.mm SyncExpandedGreenEcoOption): x y z w per vent, w = 1
+;; while its vent is up (the renderer draws the vent ring there); 8 slots (Jak1Background kMaxGreenVentProps)
+(define-perm *ios-green-vent-props* pointer
+  (let ((p (malloc 'global 128)))
+    (dotimes (i 32)
+      (set! (-> (the-as (pointer float) p) i) 0.0))
+    p))
+
+(defun ios-green-vent-prop ((i int))
+  (the-as vector (&+ *ios-green-vent-props* (* i 16))))
+
+(define-perm *ios-green-vent-entity* entity-actor #f)
+
+(defun ios-green-vent-entity ()
+  "The vents' entity: an empty res-lump (fact-info finds no eco-info, so the pickup is green eco), level-default,
+   process never set. Same as the ocean fish's. Made once."
+  (when (not *ios-green-vent-entity*)
+    (let ((ent (new 'global 'entity-actor 1 0))
+          (links (new 'global 'entity-links)))
+      (set! (-> links entity) ent)
+      (set! (-> links process) #f)
+      (set! (-> links level) (-> *level* level-default))
+      (set! (-> ent extra) links)
+      (set! (-> ent etype) vent)
+      (quaternion-identity! (-> ent quat))
+      (set! *ios-green-vent-entity* ent)))
+  *ios-green-vent-entity*)
+
+(deftype ios-green-vent (vent)
+  ((spot int32)))
+
+(define *ios-green-vent-ppointers* (new 'static 'array uint32 IOS_GREEN_VENT_COUNT))
+(define *ios-green-vent-pids* (new 'static 'array int32 IOS_GREEN_VENT_COUNT))
+
+(defun ios-green-vent-get ((i int))
+  (let ((pp (the-as (pointer process) (-> *ios-green-vent-ppointers* i))))
+    (the-as ios-green-vent
+            (when (nonzero? pp)
+              (let ((proc (-> pp 0)))
+                (if (and proc (= (-> proc pid) (-> *ios-green-vent-pids* i))) proc))))))
+
+(defbehavior ios-green-vent-init-by-other ios-green-vent ((i int))
+  "Stock vent initialize (collectables.gc) for green eco at spot I, without the entity's trans and blocker."
+  (set! (-> self entity) (ios-green-vent-entity))
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! (-> self spot) i)
+  (set! (-> *ios-green-vent-ppointers* i) (the-as uint (-> self ppointer)))
+  (set! (-> *ios-green-vent-pids* i) (-> self pid))
+  (let ((cshape (new 'process 'collide-shape self (collide-list-enum hit-by-player))))
+    (let ((sphere (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
+      (set! (-> sphere prim-core collide-as) (collide-kind powerup))
+      (set! (-> sphere collide-with) (collide-kind target))
+      (set-vector! (-> sphere local-sphere) 0.0 4915.2 0.0 6553.6)
+      (set-root-prim! cshape sphere))
+    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
+    (backup-collide-with-as cshape)
+    (set! (-> self root) cshape))
+  (set! (-> self root trans quad) (-> *ios-green-vent-spots* i quad))
+  (update-transforms! (-> self root))
+  (set! (-> self root pause-adjust-distance) 409600.0)
+  (set! (-> self fact) (new 'process 'fact-info self (pickup-type eco-green) (-> *FACT-bank* eco-full-inc)))
+  (set! (-> self block-func) (the-as (function vent symbol) true-func))
+  (set! (-> self part) (create-launch-control group-part-vent-green-active self))
+  (set! (-> self collect-effect) group-green-collect)
+  (set! (-> self collect-effect2) group-eco-green-collect)
+  (set! (-> self sound) (new 'process 'ambient-sound 'eco-bg-green (-> self root trans)))
+  (set! (-> self blocker) #f)
+  (set! (-> self pickup-handle) (the-as handle #f))
+  (set! (-> self show-particles) #t)
+  (format 0 "ios-green-vent: vent ~D up at ~m ~m ~m~%" i (-> self root trans x) (-> self root trans y) (-> self root trans z))
+  (go vent-wait-for-touch)
+  (none))
+
+(defun ios-green-vents-update ()
+  (dotimes (i IOS_GREEN_VENT_COUNT)
+    (let* ((spot (-> *ios-green-vent-spots* i))
+           (lev (level-get *level* (ios-green-vent-level i)))
+           (want (and (= *ios-expanded-green-eco* #t)
+                      *target*
+                      lev
+                      (= (-> lev status) 'active)
+                      (not (level-get *level* 'title))
+                      (< (vector-vector-distance (target-pos 0) spot) IOS_GREEN_VENT_RANGE)))
+           (proc (ios-green-vent-get i)))
+      (cond
+        ((and want (not proc)) (process-spawn ios-green-vent i :to *entity-pool*))
+        ((and (not want) proc) (deactivate proc)))
+      (let ((prop (ios-green-vent-prop i)))
+        (cond
+          ((ios-green-vent-get i)
+           (set! (-> prop quad) (-> spot quad))
+           (set! (-> prop w) 1.0))
+          (else (set! (-> prop w) 0.0))))))
+  0)
+
+;; Chain into *menu-hook* (after ios-boat-summon's). This file's top-level only runs once, at boot.
+(define *ios-green-eco-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-green-eco-menu-hook ()
+  (ios-green-eco-update)
+  (ios-green-vents-update)
+  (*ios-green-eco-prev-menu-hook*)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-green-eco-menu-hook))
diff --git a/goal_src/jak1/pc/ios/ios-ocean-fish.gc b/goal_src/jak1/pc/ios/ios-ocean-fish.gc
new file mode 100644
index 000000000..e6e821e4f
--- /dev/null
+++ b/goal_src/jak1/pc/ios/ios-ocean-fish.gc
@@ -0,0 +1,630 @@
+;;-*-Lisp-*-
+(in-package goal)
+(require "engine/target/logic-target.gc")
+(require "engine/target/target2.gc")
+
+;; og:ios Fish in Ocean (experimental, user 2026-10-10): ambient fish around Jak in the ocean.
+;;
+;; - Fish schools spawn in ocean water around Jak (any part of the ocean, docks and shores included) and despawn
+;;   once he is far from them. One fish is the most common, groups of up to 7 get rarer the bigger they are; a
+;;   group is always one kind, swims together, and stays close together at its own depth.
+;; - Models: catch-fisha / catch-fishb / junglefish (Forbidden Jungle; not catch-fishc, the fishing game's eel) and
+;;   the three sunkenfisha colours (Lost Precursor City). Each model is its own process type (ios-fish-*), all
+;;   sharing the ios-ocean-fish behaviour, so they can grow apart later.
+;; - The art is not tied to those levels: the host (OpenGOALRuntimeHost.mm LoadResidentFishArt) loads the four art
+;;   groups into the global heap as level-default art, and every fish has a stand-in entity whose level is
+;;   level-default, so initialize-skeleton takes those copies. The renderer draws the models from
+;;   Jak1Level-ios-fish.fr3z (built at import, jakIOS/Import/Jak1CustomLevelBuilder.cpp).
+;; - Fish never leave the water: every school probes the background collision under itself and ahead (sea floor,
+;;   shores, docks, rocks) and turns away from anything that is not deep enough water; each fish is kept between
+;;   the floor and the (wavy) ocean surface.
+;; - While Jak is in the ocean (in ocean water, or on the boat) *ios-clear-ocean* asks the renderer to draw the
+;;   near ocean at its clearest everywhere (Jak1Ocean SetOceanClearWater), so the fish show from a high camera too.
+;;
+;; Linked as a startup object (aot_level_code_link.py --startup-object ios-ocean-fish, after ios-dynamic-save): its
+;; top-level runs once at boot and chains the per-frame update into *menu-hook*.
+
+;; set by the host every frame (OpenGOALRuntimeHost.mm SyncOceanFishOption): option on and fish art resident
+(define-perm *ios-ocean-fish* symbol #f)
+;; read by the host every frame: draw the near ocean at its clearest
+(define-perm *ios-clear-ocean* symbol #f)
+
+;; ---- tuning --------------------------------------------------------------------------------------------------
+
+(defconstant IOS_FISH_MAX 28)              ;; fish alive at once (all schools)
+(defconstant IOS_FISH_MAX_SCHOOLS 12)
+(defconstant IOS_FISH_SPAWN_MIN (meters 14)) ;; new schools appear this far from Jak (xz) ...
+(defconstant IOS_FISH_SPAWN_MAX (meters 34)) ;; ... up to this far
+(defconstant IOS_FISH_HIDDEN_DIST (meters 24)) ;; closer than this, never spawn inside the camera's view
+(defconstant IOS_FISH_DESPAWN (meters 46))  ;; a school farther than this from Jak (xz) is removed
+(defconstant IOS_FISH_HOME_DIST (meters 32)) ;; beyond this, schools heading away turn back towards Jak
+(defconstant IOS_FISH_JAK_ABOVE_SEA (meters 15)) ;; Jak higher than this above the sea: no new fish
+;; water column
+(defconstant IOS_FISH_PROBE_ABOVE (meters 30)) ;; floor probe starts this far above the surface (finds land, docks)
+(defconstant IOS_FISH_MAX_DEPTH (meters 18)) ;; deepest a fish goes (open sea, or the floor is deeper)
+(defconstant IOS_FISH_MIN_COLUMN (meters 2.5)) ;; water shallower than this is "not water" for fish
+(defconstant IOS_FISH_SURFACE_GAP (meters 0.7)) ;; fish stay at least this far under the surface ...
+(defconstant IOS_FISH_FLOOR_GAP (meters 0.8))   ;; ... and above the floor
+(defconstant IOS_FISH_LOOK_AHEAD (meters 3))
+
+;; kinds (each its own process type)
+(defconstant IOS_FISH_KIND_CATCH_A 0)
+(defconstant IOS_FISH_KIND_CATCH_B 1)
+(defconstant IOS_FISH_KIND_JUNGLE 2)
+(defconstant IOS_FISH_KIND_SUNKEN_RED_YELLOW 3)
+(defconstant IOS_FISH_KIND_SUNKEN_YELLOW_BLUE 4)
+(defconstant IOS_FISH_KIND_SUNKEN_YELLOW_EYE 5)
+
+;; ---- art -----------------------------------------------------------------------------------------------------
+;; Same art groups as the stock skeleton groups (fisher.gc, junglefish.gc, sunken-fish.gc), defined here so they
+;; exist without the jungle/sunken code. Bounds are in world units, for the scaled ocean fish (about 1-1.5 m long).
+
+(defskelgroup *ios-fish-catch-a-sg*
+  catch-fisha
+  catch-fisha-lod0-jg
+  catch-fisha-idle-ja
+  ((catch-fisha-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 0.4 0 1.5))
+
+(defskelgroup *ios-fish-catch-b-sg*
+  catch-fishb
+  catch-fishb-lod0-jg
+  catch-fishb-idle-ja
+  ((catch-fishb-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 0.4 0 1.5))
+
+(defskelgroup *ios-fish-jungle-sg*
+  junglefish
+  junglefish-lod0-jg
+  junglefish-swim-ja
+  ((junglefish-lod0-mg (meters 20)) (junglefish-lod1-mg (meters 40)) (junglefish-lod2-mg (meters 999999)))
+  :bounds (static-spherem 0 0.4 0 1.5))
+
+(defskelgroup *ios-fish-sunken-red-yellow-sg*
+  sunkenfisha
+  sunkenfisha-red-yellow-lod0-jg
+  sunkenfisha-idle-ja
+  ((sunkenfisha-red-yellow-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 0.6 0 1.5))
+
+(defskelgroup *ios-fish-sunken-yellow-blue-sg*
+  sunkenfisha
+  sunkenfisha-yellow-blue-lod0-jg
+  sunkenfisha-idle-ja
+  ((sunkenfisha-yellow-blue-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 0.6 0 1.5))
+
+(defskelgroup *ios-fish-sunken-yellow-eye-sg*
+  sunkenfisha
+  sunkenfisha-yellow-eye-lod0-jg
+  sunkenfisha-idle-ja
+  ((sunkenfisha-yellow-eye-lod0-mg (meters 999999)))
+  :bounds (static-spherem 0 0.6 0 1.5))
+
+(defun ios-fish-skel ((kind int))
+  (case kind
+    ((IOS_FISH_KIND_CATCH_A) *ios-fish-catch-a-sg*)
+    ((IOS_FISH_KIND_CATCH_B) *ios-fish-catch-b-sg*)
+    ((IOS_FISH_KIND_JUNGLE) *ios-fish-jungle-sg*)
+    ((IOS_FISH_KIND_SUNKEN_RED_YELLOW) *ios-fish-sunken-red-yellow-sg*)
+    ((IOS_FISH_KIND_SUNKEN_YELLOW_BLUE) *ios-fish-sunken-yellow-blue-sg*)
+    (else *ios-fish-sunken-yellow-eye-sg*)))
+
+;; Swim animation: its index in the art group (engine/data/art-elts.gc).
+(defun ios-fish-anim-index ((kind int))
+  (case kind
+    ((IOS_FISH_KIND_CATCH_A IOS_FISH_KIND_CATCH_B) 2) ;; catch-fish?-idle-ja
+    ((IOS_FISH_KIND_JUNGLE) 4)                        ;; junglefish-swim-ja
+    (else 6)))                                        ;; sunkenfisha-idle-ja
+
+;; Model scale: the bind poses are ~3.6 m (catch), ~3 m (junglefish) and ~0.5 m (sunkenfisha) long.
+(defun ios-fish-scale ((kind int))
+  (case kind
+    ((IOS_FISH_KIND_CATCH_A) 0.3)
+    ((IOS_FISH_KIND_CATCH_B) 0.32)
+    ((IOS_FISH_KIND_JUNGLE) 0.45)
+    (else 2.4)))
+
+;; School cruising speed range.
+(defun ios-fish-speed-lo ((kind int))
+  (case kind
+    ((IOS_FISH_KIND_CATCH_A IOS_FISH_KIND_CATCH_B) (meters 1.0))
+    ((IOS_FISH_KIND_JUNGLE) (meters 1.4))
+    (else (meters 0.6))))
+
+(defun ios-fish-speed-hi ((kind int))
+  (case kind
+    ((IOS_FISH_KIND_CATCH_A IOS_FISH_KIND_CATCH_B) (meters 2.2))
+    ((IOS_FISH_KIND_JUNGLE) (meters 2.8))
+    (else (meters 1.6))))
+
+;; Spacing between fish of a school.
+(defun ios-fish-spread ((kind int))
+  (case kind
+    ((IOS_FISH_KIND_JUNGLE) (meters 1.6))
+    ((IOS_FISH_KIND_CATCH_A IOS_FISH_KIND_CATCH_B) (meters 1.4))
+    (else (meters 1.1))))
+
+(defun ios-fish-random-kind ()
+  "Catch fish 20% each, junglefish 15%, each sunken colour 15%."
+  (let ((r (rand-vu-int-count 100)))
+    (cond
+      ((< r 20) IOS_FISH_KIND_CATCH_A)
+      ((< r 40) IOS_FISH_KIND_CATCH_B)
+      ((< r 55) IOS_FISH_KIND_JUNGLE)
+      ((< r 70) IOS_FISH_KIND_SUNKEN_RED_YELLOW)
+      ((< r 85) IOS_FISH_KIND_SUNKEN_YELLOW_BLUE)
+      (else IOS_FISH_KIND_SUNKEN_YELLOW_EYE))))
+
+(defun ios-fish-random-count ()
+  "School size 1-7, rarer the bigger: 40/18/13/10/8/6/5 %."
+  (let ((r (rand-vu-int-count 100)))
+    (cond
+      ((< r 40) 1)
+      ((< r 58) 2)
+      ((< r 71) 3)
+      ((< r 81) 4)
+      ((< r 89) 5)
+      ((< r 95) 6)
+      (else 7))))
+
+;; ---- stand-in entity -----------------------------------------------------------------------------------------
+
+(define-perm *ios-fish-entity* entity-actor #f)
+
+(defun ios-fish-entity ()
+  "The fish's entity: an empty res-lump whose links point at level-default (so initialize-skeleton takes the
+   resident fish art) and whose process is never set. Same as the free boat's (fishermans-boat.gc). Made once."
+  (when (not *ios-fish-entity*)
+    (let ((ent (new 'global 'entity-actor 1 0))
+          (links (new 'global 'entity-links)))
+      (set! (-> links entity) ent)
+      (set! (-> links process) #f)
+      (set! (-> links level) (-> *level* level-default))
+      (set! (-> ent extra) links)
+      (set! (-> ent etype) process-drawable)
+      (quaternion-identity! (-> ent quat))
+      (set! *ios-fish-entity* ent)))
+  *ios-fish-entity*)
+
+;; ---- water ---------------------------------------------------------------------------------------------------
+
+(defun ios-fish-water-column ((pos vector) (proc process) (out vector))
+  "Is there ocean water at POS (xz) deep enough for fish? Probes the background straight down from well above the
+   surface, so land, docks and shallows above or near the surface all fail. OUT x = floor y (MAX_DEPTH under the
+   surface when the probe finds nothing, e.g. the open sea), y = surface y."
+  (let* ((surface (ocean-get-height pos))
+         (len (+ IOS_FISH_PROBE_ABOVE IOS_FISH_MAX_DEPTH))
+         (start (new 'stack-no-clear 'vector))
+         (probe (new 'stack-no-clear 'vector))
+         (result (new 'stack-no-clear 'collide-tri-result)))
+    (set-vector! start (-> pos x) (+ surface IOS_FISH_PROBE_ABOVE) (-> pos z) 1.0)
+    (set-vector! probe 0.0 (- len) 0.0 1.0)
+    (let* ((u (fill-and-probe-using-line-sphere *collide-cache*
+                                                start
+                                                probe
+                                                (meters 0.5)
+                                                (collide-kind background)
+                                                proc
+                                                result
+                                                (new 'static 'pat-surface :noentity #x1)))
+           (floor (if (>= u 0.0) (- (-> start y) (* u len)) (- surface IOS_FISH_MAX_DEPTH))))
+      (set! (-> out x) floor)
+      (set! (-> out y) surface)
+      (< (+ floor IOS_FISH_MIN_COLUMN) surface))))
+
+(define *ios-fish-at-sea* #f)
+
+(defun ios-fish-jak-at-sea? ((proc process))
+  "Jak in ocean water, or just above the sea with no ground under him (on the boat's deck)."
+  (when *target*
+    (let ((flags (-> *target* water flag)))
+      (or (and (logtest? flags (water-flag touch-water)) (logtest? flags (water-flag use-ocean)))
+          (let* ((pos (target-pos 0))
+                 (above (- (-> pos y) (ocean-get-height pos))))
+            (and (< (meters -0.5) above)
+                 (< above (meters 6))
+                 (let ((probe (new 'stack-no-clear 'vector))
+                       (result (new 'stack-no-clear 'collide-tri-result)))
+                   (set-vector! probe 0.0 (- (+ above (meters 2))) 0.0 1.0)
+                   ;; no background (dock, beach, rock) between his feet and 2 m under the surface
+                   (< (fill-and-probe-using-line-sphere *collide-cache*
+                                                        pos
+                                                        probe
+                                                        (meters 0.3)
+                                                        (collide-kind background)
+                                                        proc
+                                                        result
+                                                        (new 'static 'pat-surface :noentity #x1))
+                      0.0))))))))
+
+;; ---- types ---------------------------------------------------------------------------------------------------
+
+;; A school: the group's shared position, heading and depth. Its fish are its child processes.
+(deftype ios-fish-school (process)
+  ((kind         int32)
+   (count        int32)
+   (center       vector :inline)
+   (column       vector :inline) ;; x floor, y surface (latest probes)
+   (ahead        vector :inline)
+   (yaw          float)
+   (target-yaw   float)
+   (speed        float)
+   (target-speed float)
+   (target-y     float)
+   (radius       float)
+   (probe-ahead  symbol)         ;; alternate the two probes
+   (wander-time  time-frame)
+   (probe-time   time-frame))
+  (:states
+   ios-fish-school-swim))
+
+;; One fish. Each model is its own type (below) so they can be given their own behaviour later.
+(deftype ios-ocean-fish (process-drawable)
+  ((kind      int32)
+   (offset    vector :inline) ;; place in the school (school space: x right, y up, z ahead)
+   (vel       vector :inline)
+   (facing    vector :inline) ;; x pitch, y yaw
+   (phase     float)
+   (anim-rate float))
+  (:states
+   ios-ocean-fish-swim))
+
+(deftype ios-fish-catch-a (ios-ocean-fish) ())
+(deftype ios-fish-catch-b (ios-ocean-fish) ())
+(deftype ios-fish-jungle (ios-ocean-fish) ())
+(deftype ios-fish-sunken-red-yellow (ios-ocean-fish) ())
+(deftype ios-fish-sunken-yellow-blue (ios-ocean-fish) ())
+(deftype ios-fish-sunken-yellow-eye (ios-ocean-fish) ())
+
+;; Spawns schools around Jak, keeps the fish count capped. Its children are the schools.
+(deftype ios-fish-manager (process)
+  ((spawn-time   time-frame)
+   (sea-time     time-frame)
+   (fish-count   int32)  ;; ios-fish-manager-count
+   (school-count int32))
+  (:states
+   ios-fish-manager-run))
+
+(define *ios-fish-manager-ppointer* (the-as (pointer process) #f))
+(define *ios-fish-manager-pid* 0)
+
+(defun ios-fish-manager-get ()
+  (let ((pp *ios-fish-manager-ppointer*))
+    (the-as ios-fish-manager
+            (when pp
+              (let ((proc (-> pp 0)))
+                (if (and proc (= (-> proc pid) *ios-fish-manager-pid*)) proc))))))
+
+;; ---- fish ----------------------------------------------------------------------------------------------------
+
+(defun ios-fish-slot-world ((school ios-fish-school) (offset vector) (out vector))
+  "Where a fish with OFFSET wants to be: the school centre plus OFFSET turned to the school's heading."
+  (vector-rotate-around-y! out offset (-> school yaw))
+  (vector+! out out (-> school center)))
+
+(defbehavior ios-ocean-fish-init-by-other ios-ocean-fish ((kind int) (offset vector))
+  (let ((school (the-as ios-fish-school (ppointer->process (-> self parent)))))
+    (set! (-> self entity) (ios-fish-entity))
+    (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+    (set! (-> self kind) kind)
+    (set! (-> self offset quad) (-> offset quad))
+    (set! (-> self root) (new 'process 'trsqv))
+    (ios-fish-slot-world school offset (-> self root trans))
+    (initialize-skeleton self (ios-fish-skel kind) '())
+    ;; silent: no effect-control, so the swim animations' built-in sound effects (junglefish splashes etc.)
+    ;; never play (user 2026-10-10)
+    (set! (-> self skel effect) #f)
+    (let ((scale (* (ios-fish-scale kind) (rand-vu-float-range 0.85 1.15))))
+      (set-vector! (-> self root scale) scale scale scale 1.0))
+    (vector-reset! (-> self vel))
+    (set-vector! (-> self facing) 0.0 (-> school yaw) 0.0 1.0)
+    (quaternion-zxy! (-> self root quat) (-> self facing))
+    (set! (-> self phase) (rand-vu-float-range 0.0 65536.0))
+    (set! (-> self anim-rate) (rand-vu-float-range 0.8 1.2)))
+  (go ios-ocean-fish-swim)
+  (none))
+
+(defbehavior ios-ocean-fish-move ios-ocean-fish ()
+  (let ((school (the-as ios-fish-school (ppointer->process (-> self parent))))
+        (dt (seconds-per-frame)))
+    (when school
+      (let ((goal (new 'stack-no-clear 'vector))
+            (want (new 'stack-no-clear 'vector)))
+        (ios-fish-slot-world school (-> self offset) goal)
+        ;; a little personal wander so the school doesn't move like one rigid block
+        (+! (-> self phase) (* 16384.0 dt))
+        (+! (-> goal y) (* (meters 0.25) (sin (-> self phase))))
+        (+! (-> goal x) (* (meters 0.3) (cos (* 0.7 (-> self phase)))))
+        ;; spring towards the slot, never much faster than the school
+        (vector-! want goal (-> self root trans))
+        (vector-float*! want want 1.5)
+        (let ((len (vector-length want))
+              (max-speed (+ (-> school speed) (meters 1.5))))
+          (if (< max-speed len) (vector-float*! want want (/ max-speed len))))
+        (vector-lerp! (-> self vel) (-> self vel) want (fmin 1.0 (* 3.0 dt)))
+        (vector+*! (-> self root trans) (-> self root trans) (-> self vel) dt))
+      ;; stay in the water: under the (wavy) surface, above the school's floor
+      (let* ((pos (-> self root trans))
+             (top (- (ocean-get-height pos) IOS_FISH_SURFACE_GAP))
+             (bottom (+ (-> school column x) IOS_FISH_FLOOR_GAP)))
+        (if (< top (-> pos y)) (set! (-> pos y) top))
+        (if (< (-> pos y) bottom) (set! (-> pos y) (fmin bottom top))))
+      ;; face where it swims; level out when slow
+      (let ((flat (vector-xz-length (-> self vel))))
+        (when (< (meters 0.1) flat)
+          (set! (-> self facing y)
+                (deg-seek-smooth (-> self facing y) (vector-y-angle (-> self vel)) (* 32768.0 dt) 0.2)))
+        (set! (-> self facing x)
+              (deg-seek-smooth (-> self facing x)
+                               (fmax -3640.889 (fmin 3640.889 (- (atan (-> self vel y) (fmax (meters 0.2) flat)))))
+                               (* 16384.0 dt)
+                               0.2)))
+      (quaternion-zxy! (-> self root quat) (-> self facing))))
+  0
+  (none))
+
+(defstate ios-ocean-fish-swim (ios-ocean-fish)
+  :trans
+    (behavior ()
+      (if (ppointer->process (-> self parent)) (ios-ocean-fish-move) (deactivate self)))
+  :code
+    (behavior ()
+      (ja-channel-set! 1)
+      (let ((anim (the-as art-joint-anim (-> self draw art-group data (ios-fish-anim-index (-> self kind))))))
+        (loop
+          (ja-no-eval :group! anim :num! (seek! max (-> self anim-rate)) :frame-num 0.0)
+          (until (ja-done? 0)
+            (suspend)
+            (ja :num! (seek! max (-> self anim-rate)))))))
+  :post ja-post)
+
+(defun ios-fish-spawn-fish ((school ios-fish-school) (kind int) (offset vector))
+  "One fish of KIND in SCHOOL, as that model's own process type."
+  (case kind
+    ((IOS_FISH_KIND_CATCH_A)
+     (process-spawn ios-fish-catch-a :init ios-ocean-fish-init-by-other kind offset :to school))
+    ((IOS_FISH_KIND_CATCH_B)
+     (process-spawn ios-fish-catch-b :init ios-ocean-fish-init-by-other kind offset :to school))
+    ((IOS_FISH_KIND_JUNGLE)
+     (process-spawn ios-fish-jungle :init ios-ocean-fish-init-by-other kind offset :to school))
+    ((IOS_FISH_KIND_SUNKEN_RED_YELLOW)
+     (process-spawn ios-fish-sunken-red-yellow :init ios-ocean-fish-init-by-other kind offset :to school))
+    ((IOS_FISH_KIND_SUNKEN_YELLOW_BLUE)
+     (process-spawn ios-fish-sunken-yellow-blue :init ios-ocean-fish-init-by-other kind offset :to school))
+    (else
+     (process-spawn ios-fish-sunken-yellow-eye :init ios-ocean-fish-init-by-other kind offset :to school)))
+  0)
+
+;; ---- school --------------------------------------------------------------------------------------------------
+
+(defbehavior ios-fish-school-new-course ios-fish-school ()
+  "Every few seconds: a new heading (a gentle turn), speed and depth inside the water column."
+  (set! (-> self target-yaw) (+ (-> self yaw) (rand-vu-float-range -10922.667 10922.667)))
+  (set! (-> self target-speed) (rand-vu-float-range (ios-fish-speed-lo (-> self kind)) (ios-fish-speed-hi (-> self kind))))
+  (let ((top (- (-> self column y) IOS_FISH_SURFACE_GAP (* 0.5 (-> self radius))))
+        (bottom (+ (-> self column x) IOS_FISH_FLOOR_GAP (* 0.5 (-> self radius)))))
+    (set! (-> self target-y) (if (< bottom top) (rand-vu-float-range bottom top) (* 0.5 (+ top bottom)))))
+  (set! (-> self wander-time) (+ (current-time) (rand-vu-int-range (seconds 3) (seconds 8))))
+  0)
+
+(defbehavior ios-fish-school-turn-away ios-fish-school ()
+  "The water ahead ends (shore, rock, dock, shallows): turn to the first open direction, slowing down."
+  (let ((test (new 'stack-no-clear 'vector))
+        (col (new 'stack-no-clear 'vector))
+        (found #f))
+    ;; +-45, +-90, +-135, 180 degrees
+    (dotimes (k 7)
+      (when (not found)
+        (let ((yaw (+ (-> self yaw)
+                      (* 8192.0 (the float (* (+ 1 (/ k 2)) (if (zero? (logand k 1)) 1 -1)))))))
+          (set-vector! test (sin yaw) 0.0 (cos yaw) 1.0)
+          (vector+*! test (-> self center) test (+ IOS_FISH_LOOK_AHEAD (-> self radius)))
+          (when (ios-fish-water-column test self col)
+            (set! (-> self target-yaw) yaw)
+            (set! found #t)))))
+    (if (not found) (set! (-> self target-yaw) (+ (-> self yaw) 32768.0))))
+  (set! (-> self target-speed) (fmin (-> self target-speed) (meters 0.4)))
+  (set! (-> self wander-time) (+ (current-time) (seconds 2)))
+  0)
+
+(define-extern ios-fish-school-steer (function float vector int :behavior ios-fish-school))
+
+(defbehavior ios-fish-school-update ios-fish-school ()
+  (let ((dt (seconds-per-frame))
+        (jak (target-pos 0)))
+    ;; too far from Jak: gone (the manager spawns new schools nearer him)
+    (if (< IOS_FISH_DESPAWN (vector-vector-xz-distance (-> self center) jak))
+      (deactivate self)
+      (ios-fish-school-steer dt jak)))
+  0)
+
+(defbehavior ios-fish-school-steer ios-fish-school ((dt float) (jak vector))
+  (begin
+    ;; probes, alternating: the column under the school, and ahead of it
+    (when (time-elapsed? (-> self probe-time) (seconds 0.2))
+      (set-time! (-> self probe-time))
+      (let ((col (new 'stack-no-clear 'vector)))
+        (cond
+          ((-> self probe-ahead)
+           (set-vector! (-> self ahead) (sin (-> self yaw)) 0.0 (cos (-> self yaw)) 1.0)
+           (vector+*! (-> self ahead)
+                      (-> self center)
+                      (-> self ahead)
+                      (+ IOS_FISH_LOOK_AHEAD (-> self radius) (* 0.5 (-> self speed))))
+           (if (ios-fish-water-column (-> self ahead) self col)
+             ;; shallower ahead: keep the stricter floor so the fish rise before they get there
+             (set! (-> self column x) (fmax (-> self column x) (-> col x)))
+             (ios-fish-school-turn-away)))
+          (else
+           (if (ios-fish-water-column (-> self center) self col) (set! (-> self column quad) (-> col quad))))))
+      (set! (-> self probe-ahead) (not (-> self probe-ahead))))
+    (if (>= (current-time) (-> self wander-time)) (ios-fish-school-new-course))
+    ;; stay around Jak instead of swimming off: far out and heading away -> turn back towards him
+    (when (< IOS_FISH_HOME_DIST (vector-vector-xz-distance (-> self center) jak))
+      (let ((to-jak (vector-! (new 'stack-no-clear 'vector) jak (-> self center))))
+        (when (< (+ (* (sin (-> self yaw)) (-> to-jak x)) (* (cos (-> self yaw)) (-> to-jak z))) 0.0)
+          (set! (-> self target-yaw) (+ (vector-y-angle to-jak) (rand-vu-float-range -7281.778 7281.778)))
+          (set! (-> self wander-time) (+ (current-time) (seconds 4))))))
+    ;; steer, speed, depth
+    (set! (-> self yaw) (deg-seek (-> self yaw) (-> self target-yaw) (* 8192.0 dt)))
+    (set! (-> self speed) (seek (-> self speed) (-> self target-speed) (* (meters 1) dt)))
+    (+! (-> self center x) (* (sin (-> self yaw)) (-> self speed) dt))
+    (+! (-> self center z) (* (cos (-> self yaw)) (-> self speed) dt))
+    (let ((top (- (ocean-get-height (-> self center)) IOS_FISH_SURFACE_GAP (* 0.5 (-> self radius))))
+          (bottom (+ (-> self column x) IOS_FISH_FLOOR_GAP (* 0.5 (-> self radius)))))
+      (set! (-> self center y) (seek (-> self center y) (-> self target-y) (* (meters 0.6) dt)))
+      (if (< top (-> self center y)) (set! (-> self center y) top))
+      (if (< (-> self center y) bottom) (set! (-> self center y) (fmin bottom top)))))
+  0)
+
+(defbehavior ios-fish-school-init-by-other ios-fish-school ((kind int) (count int) (pos vector) (column vector))
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! (-> self kind) kind)
+  (set! (-> self count) count)
+  (set! (-> self center quad) (-> pos quad))
+  (set! (-> self column quad) (-> column quad))
+  (set! (-> self yaw) (rand-vu-float-range 0.0 65536.0))
+  (set! (-> self target-yaw) (-> self yaw))
+  (set! (-> self speed) (ios-fish-speed-lo kind))
+  (set! (-> self probe-ahead) #t)
+  (set-time! (-> self probe-time))
+  ;; places in the school: the first fish leads, the rest trail and flank it, a spread apart
+  (let ((spread (ios-fish-spread kind))
+        (offsets (new 'stack-no-clear 'inline-array 'vector 7)))
+    (set! (-> self radius) (meters 0.5))
+    (dotimes (i count)
+      (let ((offset (-> offsets i)))
+        (vector-reset! offset)
+        (when (> i 0)
+          (dotimes (try 8)
+            (set-vector! offset
+                         (rand-vu-float-range (* -1.2 spread) (* 1.2 spread))
+                         (rand-vu-float-range (* -0.5 spread) (* 0.5 spread))
+                         (rand-vu-float-range (* -1.8 spread) (* 0.4 spread))
+                         1.0)
+            (let ((clear #t))
+              (dotimes (j i)
+                (if (< (vector-vector-distance offset (-> offsets j)) (* 0.8 spread)) (set! clear #f)))
+              (if clear (set! try 8)))))
+        (set! (-> self radius) (fmax (-> self radius) (+ (vector-length offset) (meters 0.5))))))
+    (ios-fish-school-new-course)
+    (set! (-> self target-y) (-> pos y))
+    (dotimes (i count)
+      (ios-fish-spawn-fish self kind (-> offsets i))))
+  (go ios-fish-school-swim)
+  (none))
+
+(defstate ios-fish-school-swim (ios-fish-school)
+  :trans
+    (behavior ()
+      (ios-fish-school-update))
+  :code
+    (behavior ()
+      (loop
+        (suspend))))
+
+;; ---- manager -------------------------------------------------------------------------------------------------
+
+(defbehavior ios-fish-manager-count ios-fish-manager ()
+  "Count the fish alive in all schools, and the schools."
+  (set! (-> self fish-count) 0)
+  (set! (-> self school-count) 0)
+  (let ((child (-> self child)))
+    (while child
+      (let ((school (the-as ios-fish-school (-> child 0))))
+        (+! (-> self fish-count) (-> school count))
+        (+! (-> self school-count) 1)
+        (set! child (-> school brother)))))
+  0)
+
+(defbehavior ios-fish-manager-clear ios-fish-manager ()
+  "Remove every school (and so every fish)."
+  (let ((child (-> self child)))
+    (while child
+      (let ((next (-> child 0 brother)))
+        (deactivate (-> child 0))
+        (set! child next))))
+  0)
+
+(defbehavior ios-fish-manager-try-spawn ios-fish-manager ()
+  "Try one spot around Jak for a new school; most tries on land or in shallows just fail."
+  (ios-fish-manager-count)
+  (let ((fish (-> self fish-count)))
+    (when (and (< fish IOS_FISH_MAX) (< (-> self school-count) IOS_FISH_MAX_SCHOOLS))
+      (let* ((jak (target-pos 0))
+             (angle (rand-vu-float-range 0.0 65536.0))
+             (dist (rand-vu-float-range IOS_FISH_SPAWN_MIN IOS_FISH_SPAWN_MAX))
+             (pos (new 'stack-no-clear 'vector))
+             (col (new 'stack-no-clear 'vector)))
+        (set-vector! pos (+ (-> jak x) (* dist (sin angle))) 0.0 (+ (-> jak z) (* dist (cos angle))) 1.0)
+        (when (and
+                ;; close by, only where the camera isn't looking, so schools don't pop in right in front of it
+                (or (< IOS_FISH_HIDDEN_DIST dist)
+                    (let ((to (vector-! (new 'stack-no-clear 'vector) pos (-> *math-camera* trans)))
+                          (fwd (-> *math-camera* inv-camera-rot vector 2)))
+                      (set! (-> to y) 0.0)
+                      (vector-normalize! to 1.0)
+                      (< (+ (* (-> to x) (-> fwd x)) (* (-> to z) (-> fwd z))) 0.3)))
+                (ios-fish-water-column pos self col))
+          (let* ((count (min (ios-fish-random-count) (- IOS_FISH_MAX fish)))
+                 (top (- (-> col y) IOS_FISH_SURFACE_GAP (meters 1)))
+                 (bottom (+ (-> col x) IOS_FISH_FLOOR_GAP (meters 1))))
+            ;; any depth of the water column
+            (set! (-> pos y) (if (< bottom top) (rand-vu-float-range bottom top) (* 0.5 (+ top bottom))))
+            (process-spawn ios-fish-school (ios-fish-random-kind) count pos col :to self))))))
+  0)
+
+(defbehavior ios-fish-manager-init-by-other ios-fish-manager ()
+  (logclear! (-> self mask) (process-mask actor-pause enemy platform projectile death))
+  (set! *ios-fish-manager-ppointer* (-> self ppointer))
+  (set! *ios-fish-manager-pid* (-> self pid))
+  (set-time! (-> self spawn-time))
+  (set-time! (-> self sea-time))
+  (go ios-fish-manager-run)
+  (none))
+
+(defstate ios-fish-manager-run (ios-fish-manager)
+  :trans
+    (behavior ()
+      (cond
+        ((or (!= *ios-ocean-fish* #t)
+             (not *target*)
+             (not *ocean-map*)
+             (movie?)
+             (level-get *level* 'title)
+             ;; under Lost Precursor City's ocean, not the sea
+             (< (-> (target-pos 0) y) (meters -30)))
+         (set! *ios-fish-at-sea* #f)
+         (ios-fish-manager-clear))
+        (else
+         (when (time-elapsed? (-> self sea-time) (seconds 0.15))
+           (set-time! (-> self sea-time))
+           (set! *ios-fish-at-sea* (ios-fish-jak-at-sea? self)))
+         (when (and (time-elapsed? (-> self spawn-time) (seconds 0.3))
+                    (< (- (-> (target-pos 0) y) (ocean-get-height (target-pos 0))) IOS_FISH_JAK_ABOVE_SEA))
+           (set-time! (-> self spawn-time))
+           (ios-fish-manager-try-spawn)))))
+  :code
+    (behavior ()
+      (loop
+        (suspend))))
+
+;; ---- per frame -----------------------------------------------------------------------------------------------
+
+(defun ios-ocean-fish-update ()
+  (let ((on (and (= *ios-ocean-fish* #t) *target* (not (level-get *level* 'title)))))
+    (if (and on (not (ios-fish-manager-get))) (process-spawn ios-fish-manager :to *entity-pool*))
+    ;; no manager (just removed by a death's reset-actors, or off): normal water
+    (set! *ios-clear-ocean* (if (and on (ios-fish-manager-get) *ios-fish-at-sea*) #t #f)))
+  0)
+
+;; Chain into *menu-hook* (after ios-dynamic-save's). This file's top-level only runs once, at boot.
+(define *ios-fish-prev-menu-hook* (the-as (function none) *menu-hook*))
+
+(defun ios-fish-menu-hook ()
+  (ios-ocean-fish-update)
+  (*ios-fish-prev-menu-hook*)
+  (none))
+
+(set! *menu-hook* (the-as (function debug-menu-context) ios-fish-menu-hook))
