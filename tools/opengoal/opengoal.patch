+;; og:ios boat upgrades (boat-upgrades-plan.md): handling per *ios-boat-level* 1..6. Before upgrades the boat had
+;; cruise throttle 0.4351 (65% of the autopilot table's top, 0.6694), steering x0.5 and turn-in-place 0.22, between
+;; levels 2 and 3 here. Water drag is linear in velocity, so top speed scales with the cruise throttle.
+(define *fishermans-boat-ios-level-throttle* (new 'static 'array float 6 0.36 0.4 0.45 0.51 0.57 0.66))
+;; steering lock: the thrust is turned by atan(steering / 2), 0.5 = 14 deg
+(define *fishermans-boat-ios-level-steering* (new 'static 'array float 6 0.4 0.45 0.51 0.58 0.67 0.8))
+;; turn-in-place push at bow and stern, as a fraction of cruise thrust (which also grows with the level)
+(define *fishermans-boat-ios-level-turn* (new 'static 'array float 6 0.18 0.2 0.22 0.24 0.27 0.3))
+
+;; engine sound pitch offset (user 2026-10-23: lower at level 1, higher as it levels up), added to the stock
+;; spin-up sweep (-1 -> +1). :pitch units are 1524 = ~an octave (989snd: 128 per semitone), so 0.25 = ~3 semitones.
+(define *fishermans-boat-ios-level-pitch* (new 'static 'array float 6 -0.25 -0.15 -0.05 0.05 0.15 0.25))
+
+(defun fishermans-boat-ios-level-index ()
+  "0-based index of the boat level, clamped (the host writes *ios-boat-level*)."
+  (max 0 (min 5 (+ *ios-boat-level* -1))))
+
+(defun fishermans-boat-ios-max-throttle ()
+  "Cruise throttle for the boat's level."
+  (-> *fishermans-boat-ios-level-throttle* (fishermans-boat-ios-level-index)))
+
+(defbehavior fishermans-boat-ios-steady fishermans-boat ()
+  "og:ios driveable boat: damp pitch and roll, and at the wheel also unsteered yaw and sideways drift. Run every
+   physics step; without it the hull rocks a lot under thrust and waves (the stock ride was a canned animation), and
+   wave/drag forces on the six float points twist its heading and push it sideways, more the faster it goes.
+   - pitch/roll: 0.7 kept per step at rest -> 0.45 at cruise (user 2026-10-23: was 0.85 -> 0.72, still far too wobbly)
+   - yaw (at the wheel): 0.8 kept per step with the wheel centred, untouched at full lock, so turns stay as they were
+     but the heading no longer wanders on its own and a turn stops when the stick is let go
+   - sideways velocity (at the wheel): 0.9 kept per step, like a keel: the boat goes where it points"
+  (let* ((rb (-> self rbody))
+         (am (-> rb ang-momentum))
+         (yaw (vector-dot am *y-vector*))
+         (t (fmax 0.0 (fmin 1.0 (/ (-> self controller throttle) (fishermans-boat-ios-max-throttle)))))
+         (keep (lerp 0.7 0.45 t))
+         (yaw-keep 1.0))
+    (when *ios-boat-driving*
+      ;; 0 with the wheel centred .. 1 at this level's full lock
+      (let ((steer (fmin 1.0 (/ (fabs (-> self controller steering))
+                                (-> *fishermans-boat-ios-level-steering* (fishermans-boat-ios-level-index))))))
+        (set! yaw-keep (lerp 0.8 1.0 steer)))
+      (let* ((side (-> rb matrix vector 0))
+             (slip (vector-dot (-> rb lin-velocity) side))
+             (cut (* -0.1 slip)))
+        (vector+*! (-> rb lin-velocity) (-> rb lin-velocity) side cut)
+        (vector+*! (-> rb lin-momentum) (-> rb lin-momentum) side (* cut (-> rb mass)))))
+    (vector-float*! am am keep)
+    (vector+*! am am *y-vector* (* (- yaw-keep keep) yaw)))
+  0
+  (none))
+
+
+(defbehavior fishermans-boat-ios-turn-in-place fishermans-boat ()
+  "og:ios driveable boat: steering normally only bites through the engine's thrust, so a stopped boat could not
+   turn. At the wheel, add a slow yaw twist (equal and opposite side pushes at bow and stern, so it does not drift)
+   that fades out as the engine thrust builds."
+  (when (and *ios-boat-driving* (!= (-> self controller steering) 0.0))
+    (let* ((cruise (* 1228800.0 (fishermans-boat-ios-max-throttle)))
+           (fade (- 1.0 (fmax 0.0 (fmin 1.0 (/ (-> self engine-thrust) cruise)))))
+           ;; same turn direction as the thrust: the stern gets pushed toward -steering
+           (push (* (- (-> *fishermans-boat-ios-level-turn* (fishermans-boat-ios-level-index)))
+                    cruise fade (-> self controller steering)))
+           (mat (-> self rbody matrix))
+           (pos (new 'stack-no-clear 'vector))
+           (force (new 'stack-no-clear 'vector)))
+      (when (< 0.0 fade)
+        (set-vector! force push 0.0 0.0 1.0)
+        (vector-rotate*! force force mat)
+        (set-vector! pos 0.0 12288.0 -20480.0 1.0)
+        (vector-matrix*! pos pos mat)
+        (rigid-body-method-13 (-> self rbody) pos force)
+        (vector-float*! force force -1.0)
+        (set-vector! pos 0.0 12288.0 20480.0 1.0)
+        (vector-matrix*! pos pos mat)
+        (rigid-body-method-13 (-> self rbody) pos force))))
+  0
+  (none))
