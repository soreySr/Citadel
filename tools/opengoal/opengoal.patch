+;; Jak got away, or has just been eaten: swim forward while sinking out of sight.
+(defstate ios-ocean-shark-leave (ios-ocean-shark)
+  :code
+    (behavior ()
+      (set-time! (-> self state-time))
+      (until (time-elapsed? (-> self state-time) (seconds 2))
+        (vector+*! (-> self root trans) (-> self root trans) (-> self dir) (* (meters 9) (seconds-per-frame)))
+        (-! (-> self root trans y) (* (meters 6) (seconds-per-frame)))
+        (ja :num! (loop!))
+        (suspend))
+      (deactivate self))
+  :post
+    (behavior ()
+      (ios-ocean-shark-depth-tint)
+      (ja-post)))
