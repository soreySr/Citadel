+;; heap (OpenGOALRuntimeHost.mm LoadResidentBoatArt); without it the actor itself is driven as before.
+;; All define-perm: VI1 relinks (top-level re-run) whenever it loads, and the free boat outlives that.
+(define-perm *ios-boat-art-resident* symbol #f)
