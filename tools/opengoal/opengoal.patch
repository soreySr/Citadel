+(define *ios-fog-bank-carry* 0.0)
+(define *ios-fog-bank-close-carry* 0.0)
+(define *ios-glacier-fog-bank-carry* 0.0)
+(define *ios-glacier-fog-close-carry* 0.0)
+
+(defun ios-sea-fog-color ((out vector))
+  "The sea fog's colour now (ios-sea-fog-apply's): grey by day, dark blue-grey at night."
+  (let* ((time (-> *time-of-day-context* time))
+         (day (fmax 0.0 (fmin 1.0 (* 1.5 (sin (* 16384.0 (/ (- time 6.0) 6.0))))))))
+    (vector4-lerp! out *ios-sea-fog-night* *ios-sea-fog-day* day)))
+
+(defun ios-glacier-fog-color ((out vector))
+  "The Glacier fog ring's colour now: white by day, pale blue-grey at night."
+  (let* ((time (-> *time-of-day-context* time))
+         (day (fmax 0.0 (fmin 1.0 (* 1.5 (sin (* 16384.0 (/ (- time 6.0) 6.0))))))))
+    (vector4-lerp! out *ios-glacier-fog-night* *ios-glacier-fog-day* day)))
+
+(defun ios-glacier-fog-want ((d float))
+  "Strength (0..1) of the Glacier's fog ring at distance D from its centre."
+  (let ((off (- d IOS_GLACIER_FOG_RING)))
+    (fmax 0.0 (fmin 1.0 (if (< 0.0 off)
+                            (/ (- IOS_GLACIER_FOG_CLEAR_OUT off) (- IOS_GLACIER_FOG_CLEAR_OUT IOS_GLACIER_FOG_FULL_OUT))
+                            (/ (- IOS_GLACIER_FOG_CLEAR_IN (- off)) (- IOS_GLACIER_FOG_CLEAR_IN IOS_GLACIER_FOG_FULL_IN)))))))
+
+(defun ios-sea-fog-bank-launch ((pos vector) (sea float))
+  "Launch one fog bank cloud over POS's x / z: picks its kind and size and sets POS's height so that, fully grown,
+   none of it that shows reaches the waves."
+  (cond
+    ((< (rand-vu) IOS_FOG_BANK_FLAT_SHARE)
+     (let ((spec (-> *part-id-table* 2980 init-specs))
+           (sx (rand-vu-float-range (meters 50) (meters 80)))
+           (sy (rand-vu-float-range (meters 10) (meters 18)))
+           (up (rand-vu)))
+       (set! (-> spec 2 initial-valuef) sx)
+       (set! (-> spec 2 random-rangef) 0.0)
+       (set! (-> spec 4 initial-valuef) sy)
+       (set! (-> spec 4 random-rangef) 0.0)
+       ;; scale-y doesn't grow: the bottom of its ellipse stays where it starts
+       (set! (-> pos y) (+ sea IOS_FOG_BANK_CLEAR_WATER (* 0.5 sy) (* IOS_FOG_BANK_FLAT_RISE up up)))
+       (launch-particles (-> *part-id-table* 2980) pos)))
+    (else
+     (let ((spec (-> *part-id-table* 2977 init-specs))
+           (s (rand-vu-float-range (meters 40) (meters 70)))
+           (up (rand-vu)))
+       (set! (-> spec 2 initial-valuef) s)
+       (set! (-> spec 2 random-rangef) 0.0)
+       (set! (-> pos y) (+ sea IOS_FOG_BANK_CLEAR_WATER (* 0.5 (+ s IOS_FOG_BANK_GROWTH)) (* IOS_FOG_BANK_TALL_RISE up up)))
+       (launch-particles (-> *part-id-table* 2977) pos))))
+  0)
+
+(defun ios-glacier-fog-bank-update ((cam vector) (sea float))
+  "White clouds standing on the Glacier's fog ring (seen from afar like the Rock Village bank), thicker around Jak
+   while he is in it."
+  (let ((d-cam (ios-sea-distance cam IOS_SEA_GLACIER_X IOS_SEA_GLACIER_Z))
+        (pos (new 'stack-no-clear 'vector)))
+    (when (< (fabs (- d-cam IOS_GLACIER_FOG_RING)) IOS_FOG_BANK_SEE)
+      (let ((col (ios-glacier-fog-color (new 'stack-no-clear 'vector))))
+        (dotimes (i 2)
+          (let ((spec (-> *part-id-table* (if (zero? i) 2977 2980) init-specs)))
+            (set! (-> spec 5 initial-valuef) (-> col x))
+            (set! (-> spec 6 initial-valuef) (-> col y))
+            (set! (-> spec 7 initial-valuef) (-> col z)))))
+      ;; the whole ring (~4 km round) at the far bank's density per metre of arc
+      (+! *ios-glacier-fog-bank-carry* (* IOS_FOG_BANK_RATE 1.6 (seconds-per-frame)))
+      (let ((tries 0))
+        (while (and (<= 1.0 *ios-glacier-fog-bank-carry*) (< tries 40))
+          (+! tries 1)
+          (let* ((angle (rand-vu-float-range 0.0 (degrees 360)))
+                 (r (+ IOS_GLACIER_FOG_RING (rand-vu-float-range (- IOS_GLACIER_FOG_FULL_IN) IOS_GLACIER_FOG_FULL_OUT))))
+            (set-vector! pos (+ IOS_SEA_GLACIER_X (* r (sin angle))) sea (+ IOS_SEA_GLACIER_Z (* r (cos angle))) 1.0)
+            (let ((d (vector-vector-xz-distance pos cam)))
+              (when (and (< IOS_FOG_BANK_NEAR d) (< d IOS_FOG_BANK_SEE))
+                (+! *ios-glacier-fog-bank-carry* -1.0)
+                (ios-sea-fog-bank-launch pos sea))))))
+      (if (< 2.0 *ios-glacier-fog-bank-carry*) (set! *ios-glacier-fog-bank-carry* 0.0))
+      ;; close around the camera while in the ring
+      (+! *ios-glacier-fog-close-carry* (* (ios-glacier-fog-want d-cam) IOS_FOG_BANK_CLOSE_RATE (seconds-per-frame)))
+      (let ((tries 0))
+        (while (and (<= 1.0 *ios-glacier-fog-close-carry*) (< tries 40))
+          (+! tries 1)
+          (let* ((angle (rand-vu-float-range 0.0 (degrees 360)))
+                 (dist (lerp IOS_FOG_BANK_NEAR IOS_FOG_BANK_CLOSE (sqrtf (rand-vu)))))
+            (set-vector! pos (+ (-> cam x) (* dist (sin angle))) sea (+ (-> cam z) (* dist (cos angle))) 1.0)
+            (when (< 0.5 (ios-glacier-fog-want (ios-sea-distance pos IOS_SEA_GLACIER_X IOS_SEA_GLACIER_Z)))
+              (+! *ios-glacier-fog-close-carry* -1.0)
+              (ios-sea-fog-bank-launch pos sea)))))
+      (if (< 2.0 *ios-glacier-fog-close-carry*) (set! *ios-glacier-fog-close-carry* 0.0))))
+  0)
+
+(defun ios-sea-fog-bank-update ()
+  "Launch the far fog bank's clouds while Jak is at sea down the east coast and the bank is within sight."
+  (when (and *target*
+             (= *ios-driveable-boat* #t)
+             (not (paused?))
+             (not (level-get *level* 'title))
+             (not (level-get *level* 'firecanyon)))
+    (let* ((cam (math-camera-pos))
+           (d-village2 (ios-sea-distance cam IOS_SEA_VILLAGE2_X IOS_SEA_VILLAGE2_Z))
+           (d-jungle (ios-sea-distance cam IOS_SEA_JUNGLE_X IOS_SEA_JUNGLE_Z))
+           (d-other-north (fmin (fmin (ios-sea-distance cam IOS_SEA_VILLAGE_X IOS_SEA_VILLAGE_Z)
+                                      (ios-sea-distance cam IOS_SEA_BEACH_X IOS_SEA_BEACH_Z))
+                                (fmin (ios-sea-distance cam IOS_SEA_MISTY_X IOS_SEA_MISTY_Z)
+                                      (ios-sea-distance cam IOS_SEA_TRAINING_X IOS_SEA_TRAINING_Z)))))
+      (when (= *ios-glacier-warp* #t)
+        (ios-glacier-fog-bank-update cam (if *ocean-map* (-> *ocean-map* start-corner y) 0.0)))
+      (when (and (< d-jungle d-other-north) (< (fabs (- d-village2 IOS_SEA_FOG_CENTER)) IOS_FOG_BANK_SEE))
+        (let ((col (ios-sea-fog-color (new 'stack-no-clear 'vector))))
+          (dotimes (i 2)
+            (let ((spec (-> *part-id-table* (if (zero? i) 2977 2980) init-specs)))
+              (set! (-> spec 5 initial-valuef) (-> col x))
+              (set! (-> spec 6 initial-valuef) (-> col y))
+              (set! (-> spec 7 initial-valuef) (-> col z)))))
+        (+! *ios-fog-bank-carry* (* IOS_FOG_BANK_RATE (seconds-per-frame)))
+        (let ((pos (new 'stack-no-clear 'vector))
+              (sea (if *ocean-map* (-> *ocean-map* start-corner y) 0.0))
+              (tries 0))
+          (while (and (<= 1.0 *ios-fog-bank-carry*) (< tries 40))
+            (+! tries 1)
+            ;; a spot on the arc across the sea east of the coast (-5..55 degrees from north around Rock Village)
+            (let* ((angle (rand-vu-float-range (degrees -5) (degrees 55)))
+                   (r (+ IOS_SEA_FOG_CENTER (rand-vu-float-range (- IOS_SEA_FOG_FULL_IN) IOS_FOG_BANK_DEPTH))))
+              ;; height: ios-sea-fog-bank-launch
+              (set-vector! pos (+ IOS_SEA_VILLAGE2_X (* r (sin angle))) sea (+ IOS_SEA_VILLAGE2_Z (* r (cos angle))) 1.0)
+              (let ((d (vector-vector-xz-distance pos cam)))
+                (when (and (< IOS_FOG_BANK_NEAR d) (< d IOS_FOG_BANK_SEE)
+                           ;; not over the Glacier (inside its own white ring)
+                           (not (and (= *ios-glacier-warp* #t)
+                                     (< (ios-sea-distance pos IOS_SEA_GLACIER_X IOS_SEA_GLACIER_Z) IOS_GLACIER_FOG_RING))))
+                  (+! *ios-fog-bank-carry* -1.0)
+                  (ios-sea-fog-bank-launch pos sea)))))
+          ;; nothing in range this frame: don't bank up a burst
+          (if (< 2.0 *ios-fog-bank-carry*) (set! *ios-fog-bank-carry* 0.0))
+          ;; thicker around Jak while he is in it: the same clouds on the band, close to the camera
+          (+! *ios-fog-bank-close-carry* (* *ios-sea-fog* IOS_FOG_BANK_CLOSE_RATE (seconds-per-frame)))
+          (set! tries 0)
+          (while (and (<= 1.0 *ios-fog-bank-close-carry*) (< tries 40))
+            (+! tries 1)
+            (let* ((angle (rand-vu-float-range 0.0 (degrees 360)))
+                   (dist (lerp IOS_FOG_BANK_NEAR IOS_FOG_BANK_CLOSE (sqrtf (rand-vu)))))
+              (set-vector! pos (+ (-> cam x) (* dist (sin angle))) sea (+ (-> cam z) (* dist (cos angle))) 1.0)
+              ;; only on the band, so the bank keeps its edges
+              (let ((off (- (ios-sea-distance pos IOS_SEA_VILLAGE2_X IOS_SEA_VILLAGE2_Z) IOS_SEA_FOG_CENTER)))
+                (when (and (< (- IOS_SEA_FOG_FULL_IN) off) (< off IOS_FOG_BANK_DEPTH)
+                           (not (and (= *ios-glacier-warp* #t)
+                                     (< (ios-sea-distance pos IOS_SEA_GLACIER_X IOS_SEA_GLACIER_Z) IOS_GLACIER_FOG_RING))))
+                  (+! *ios-fog-bank-close-carry* -1.0)
+                  (ios-sea-fog-bank-launch pos sea)))))
+          (if (< 2.0 *ios-fog-bank-close-carry*) (set! *ios-fog-bank-close-carry* 0.0))))))
+  0)
+
+(defun ios-ocean-transition-fog ()
+  "Called every frame from pc/ios/ios-boat-park.gc's *menu-hook*: eases *ios-sea-fog* toward the fog bank's
+   strength at Jak's spot at sea and keeps ios-sea-fog-mood-func in the levels' mood functions, which apply it
+   inside update-time-of-day (distances and colours, so both the world and the sky go into the fog)."
+  (let ((want 0.0)
+        (white 0.0))
+    (when (and *target*
+               (= *ios-driveable-boat* #t)
+               (not (level-get *level* 'title))
+               ;; on land in Fire Canyon the same distances say "halfway": only over the water
+               (not (level-get *level* 'firecanyon))
+               (or (= *ios-boat-driving* #t)
+                   (ios-ocean-jak-aboard? (ios-free-boat))
+                   (logtest? (-> *target* water flag) (water-flag swimming under-water))))
+      (let* ((pos (-> *target* control trans))
+             (d-village2 (ios-sea-distance pos IOS_SEA_VILLAGE2_X IOS_SEA_VILLAGE2_Z))
+             (d-jungle (ios-sea-distance pos IOS_SEA_JUNGLE_X IOS_SEA_JUNGLE_Z))
+             (d-other-north (fmin (fmin (ios-sea-distance pos IOS_SEA_VILLAGE_X IOS_SEA_VILLAGE_Z)
+                                        (ios-sea-distance pos IOS_SEA_BEACH_X IOS_SEA_BEACH_Z))
+                                  (fmin (ios-sea-distance pos IOS_SEA_MISTY_X IOS_SEA_MISTY_Z)
+                                        (ios-sea-distance pos IOS_SEA_TRAINING_X IOS_SEA_TRAINING_Z))))
+             (off (- d-village2 IOS_SEA_FOG_CENTER)))
+        (if (< d-jungle d-other-north)
+            (set! want (fmax 0.0 (fmin 1.0 (if (< 0.0 off)
+                                                (/ (- IOS_SEA_FOG_CLEAR off) (- IOS_SEA_FOG_CLEAR IOS_SEA_FOG_FULL))
+                                                (/ (- IOS_SEA_FOG_CLEAR_IN (- off))
+                                                   (- IOS_SEA_FOG_CLEAR_IN IOS_SEA_FOG_FULL_IN)))))))
+        ;; held full right after a switch and until the arriving level is in
+        (if (< (current-time) *ios-sea-fog-hold-until*) (set! want 1.0))
+        ;; The Glacier's white fog ring. The Rock Village bank stays out of it (the glacier lies in that band), and
+        ;; the ring is held full while Jak is in or past it and the glacier is not in yet.
+        (when (= *ios-glacier-warp* #t)
+          (let* ((d-glacier (ios-sea-distance pos IOS_SEA_GLACIER_X IOS_SEA_GLACIER_Z))
+                 (g (if (and (< d-glacier (+ IOS_GLACIER_FOG_RING IOS_GLACIER_FOG_FULL_OUT))
+                             (not (= (level-status *level* 'glacier) 'active)))
+                        1.0
+                        (ios-glacier-fog-want d-glacier))))
+            (set! want (* want (fmax 0.0 (fmin 1.0 (/ (- d-glacier (- IOS_GLACIER_FOG_RING IOS_GLACIER_FOG_FULL_IN))
+                                                      IOS_GLACIER_FOG_CLEAR_OUT)))))
+            (when (< 0.0 g)
+              (set! white (if (< want g) 1.0 0.0))
+              (set! want (fmax want g)))))))
+    ;; about 1.5 s from clear to full
+    (set! *ios-sea-fog* (seek *ios-sea-fog* want (* 0.67 (seconds-per-frame))))
+    (set! *ios-sea-fog-white* (seek *ios-sea-fog-white* white (* 0.5 (seconds-per-frame))))
+    (ios-sea-fog-hook-moods)
+    (ios-sea-fog-bank-update))
+  0)
+
+;; Boat shark spacing (xz from the boat's centre; the hull is ~12-15 m long, the shark ~6 m).
+(defconstant IOS_SHARK_BOAT_CLEAR (meters 10)) ;; never closer: keeps it beside the hull, not under it
+(defconstant IOS_SHARK_ORBIT_R (meters 16))    ;; circling a stopped boat
+(defconstant IOS_SHARK_BREACH_R (meters 14))   ;; a chasing shark this close breaches
+
+(defbehavior ios-ocean-shark-keep-clear ios-ocean-shark ((boat fishermans-boat))
+  "Push the shark back out to the boat's clearance ring if it got inside."
+  (let ((off (vector-! (new 'stack-no-clear 'vector) (-> self root trans) (-> boat root-overlay trans))))
+    (set! (-> off y) 0.0)
+    (let ((len (vector-length off)))
+      (when (< len IOS_SHARK_BOAT_CLEAR)
+        (if (< len 1.0)
+          ;; dead centre: step out behind the boat
+          (begin
+            (vector-z-quaternion! off (-> boat root-overlay quat))
+            (set! (-> off y) 0.0)
+            (vector-normalize! off -1.0))
+          (vector-normalize! off 1.0))
+        (set! (-> self root trans x) (+ (-> boat root-overlay trans x) (* IOS_SHARK_BOAT_CLEAR (-> off x))))
+        (set! (-> self root trans z) (+ (-> boat root-overlay trans z) (* IOS_SHARK_BOAT_CLEAR (-> off z)))))))
+  0
+  (none))
+
+(defbehavior ios-ocean-shark-init-by-other ios-ocean-shark ((pos vector) (boat basic) (boat-mode symbol))
+  (set! (-> self root) (new 'process 'trsqv))
+  (set! (-> self root trans quad) (-> pos quad))
+  (initialize-skeleton self *sharkey-sg* '())
+  ;; Spawned under the boat (via the manager) we inherit its 'platform bit, and target-death stops every
+  ;; enemy/platform/projectile/death process from running: the shark froze mid-bite, never sent 'end-mode, and
+  ;; Jak never respawned. The stock sharkey clears 'enemy before its bite for the same reason.
+  (logclear! (-> self mask) (process-mask actor-pause platform enemy projectile death))
+  (set! (-> self boat-mode) boat-mode)
+  (set! (-> self boat) (if boat (process->handle (the-as fishermans-boat boat)) (the-as handle #f)))
+  (set! (-> self sound-id) (new-sound-id))
+  (set-time! (-> self chase-time))
+  (set-time! (-> self breach-time))
+  (go ios-ocean-shark-chase)
+  (none))
+
+;; Swim at Jak at the stock chase speed (12 m/s), rising from 12 m deep to just under the surface as it closes in.
+;; Boat mode (Jak aboard, driving or not) keeps up with the hull, stays shallow enough to see, and breaches nearby.
+(defstate ios-ocean-shark-chase (ios-ocean-shark)
+  :exit
+    (behavior ()
+      (sound-stop (-> self sound-id)))
+  :trans
+    (behavior ()
+      (let ((boat (the-as fishermans-boat (handle->process (-> self boat)))))
+        ;; follow Jak between the water and the boat: diving off makes him the prey again, climbing aboard
+        ;; turns the hunt into stalking the hull
+        (when (and boat *target*)
+          (cond
+            ((and (-> self boat-mode)
+                  (not (ios-ocean-jak-aboard? boat))
+                  (logtest? (-> *target* water flag) (water-flag touch-water)))
+             (set! (-> self boat-mode) #f))
+            ((and (not (-> self boat-mode)) (ios-ocean-jak-aboard? boat))
+             (set! (-> self boat-mode) #t)
+             (set-time! (-> self chase-time)))))
+        (if (cond
+              ((-> self boat-mode)
+               (or (not boat)
+                   (time-elapsed? (-> self chase-time) (seconds 25))
+                   (not (ios-ocean-open-sea? (-> boat root-overlay trans)))))
+              (else
+               (or (not *target*)
+                   (not (logtest? (-> *target* water flag) (water-flag touch-water)))
+                   (not (ios-ocean-open-sea? (-> *target* control trans))))))
+          (go ios-ocean-shark-leave))
+      (let* ((tpos (new 'stack-no-clear 'vector))
+             (surface (begin
+                        (set! (-> tpos quad)
+                              (if (-> self boat-mode) (-> boat root-overlay trans quad) (-> (target-pos 0) quad)))
+                        (ocean-get-height tpos)))
+             (dir (new 'stack-no-clear 'vector))
+             (dist (begin
+                     (vector-! dir tpos (-> self root trans))
+                     (set! (-> dir y) 0.0)
+                     (vector-length dir))))
+        (if (and (not (-> self boat-mode)) (< dist (meters 2))) (go ios-ocean-shark-bite))
+        (let ((circling (and (-> self boat-mode) (< (vector-xz-length (-> boat rbody lin-velocity)) (meters 0.75))))
+              (step (* (if (-> self boat-mode)
+                         ;; a hull under way would outrun the stock 12 m/s
+                         (fmax (meters 12) (+ (vector-xz-length (-> boat rbody lin-velocity)) (meters 3)))
+                         (meters 12))
+                       (seconds-per-frame))))
+          (vector-normalize! dir 1.0)
+          (cond
+            (circling
+             ;; A stopped boat gets a circling shark: swim along the tangent, steering in or out toward the orbit.
+             (let ((radial-x (-> dir x))
+                   (pull (fmax -1.0 (fmin 1.0 (/ (- dist IOS_SHARK_ORBIT_R) (meters 6))))))
+               (set! (-> dir x) (+ (- (-> dir z)) (* pull radial-x)))
+               (set! (-> dir z) (+ radial-x (* pull (-> dir z)))))
+             (vector-normalize! dir 1.0)
+             (vector+*! (-> self root trans) (-> self root trans) dir step))
+            ((-> self boat-mode)
+             ;; Chasing a moving boat: close in up to the hull's clearance ring, never through it.
+             (vector+*! (-> self root trans) (-> self root trans) dir (fmax 0.0 (fmin (- dist IOS_SHARK_BOAT_CLEAR) step))))
+            (else
+             (vector+*! (-> self root trans) (-> self root trans) dir (fmin dist step))))
+          (set! (-> self dir quad) (-> dir quad))
+          (if (-> self boat-mode) (ios-ocean-shark-keep-clear boat))
+          ;; breach only from a real chase, once close to the boat; a circling shark just circles
+          (if (and (-> self boat-mode)
+                   (not circling)
+                   (< dist IOS_SHARK_BREACH_R)
+                   (time-elapsed? (-> self breach-time) (seconds 4)))
+            (go ios-ocean-shark-breach)))
+        ;; the ocean surface hides anything a few metres down, so the boat shark rides just under it
+        (set! (-> self root trans y)
+              (if (-> self boat-mode)
+                (lerp (+ surface (meters -0.3)) (+ surface (meters -4)) (fmax 0.0 (fmin 1.0 (/ dist (meters 40)))))
+                (lerp (+ surface (meters -0.5)) (+ surface (meters -12.5)) (fmax 0.0 (fmin 1.0 (/ dist (meters 30)))))))
+        (forward-up->quaternion (-> self root quat) dir *up-vector*)
+        (sound-play "bigshark-alert"
+                    :id (-> self sound-id)
+                    :pitch (+ 0.5 (* 1.5 (fmax 0.0 (fmin 1.0 (- 1.0 (/ dist (meters 30)))))))
+                    :position (the-as symbol (-> self root trans))))))
+  :code
+    (behavior ()
+      (sound-play "bigshark-idle")
+      (loop
+        (ja-no-eval :group! sharkey-idle-ja :num! (seek!) :frame-num 0.0)
+        (until (ja-done? 0)
+          (suspend)
+          (ja :num! (seek!)))))
+  :post
+    (behavior ()
+      (ios-ocean-shark-depth-tint)
+      (ja-post)))
+
+;; Boat mode: leap out of the water beside the boat with the chomp animation (harmless), then dive back in.
+;; It keeps pace with the hull and stays outside its clearance ring the whole time.
+(defstate ios-ocean-shark-breach (ios-ocean-shark)
+  :trans
+    (behavior ()
+      (let ((boat (the-as fishermans-boat (handle->process (-> self boat)))))
+        (if boat (ios-ocean-shark-keep-clear boat))))
+  :code
+    (behavior ()
+      (sound-play "bigshark-bite" :position (the-as symbol (-> self root trans)))
+      (let ((boat (the-as fishermans-boat (handle->process (-> self boat)))))
+        (if boat
+          (vector+*! (-> self vel) (-> boat rbody lin-velocity) (-> self dir) (meters 4))
+          (vector-float*! (-> self vel) (-> self dir) (meters 10))))
+      (set! (-> self vel y) (meters 14))
+      (ja-channel-push! 1 (seconds 0.1))
+      (ja-no-eval :group! sharkey-chomp-ja :num! (seek!) :frame-num 0.0)
+      (set-time! (-> self state-time))
+      (until (or (time-elapsed? (-> self state-time) (seconds 2.5))
+                 (and (< (-> self vel y) 0.0)
+                      (< (-> self root trans y) (+ (ocean-get-height (-> self root trans)) (meters -2)))))
+        (+! (-> self vel y) (* (meters -40) (seconds-per-frame)))
+        (vector+*! (-> self root trans) (-> self root trans) (-> self vel) (seconds-per-frame))
+        (let ((fwd (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> self vel) 1.0)))
+          (forward-up->quaternion (-> self root quat) fwd *up-vector*))
+        (suspend)
+        (ja :num! (seek!)))
+      (set-time! (-> self breach-time))
+      (ja-channel-push! 1 (seconds 0.2))
+      (go ios-ocean-shark-chase))
+  :post
+    (behavior ()
+      (ios-ocean-shark-depth-tint)
+      (ja-post)))
+
+(defun ios-ocean-nearest-continue ((pos vector))
+  "The plain continue point (no warp / intro / cutscene flags) of the sea's islands closest to pos, or #f."
+  (let ((best (the-as continue-point #f))
+        (best-dist 0.0))
+    (dolist (lev-name '(village1 beach jungle misty training village2 swamp))
+      (let ((info (lookup-level-info (the-as symbol (car lev-name)))))
+        (when info
+          (dolist (c (-> info continues))
+            (let ((cp (the-as continue-point (car c))))
+              (when (zero? (-> cp flags))
+                (let ((d (vector-vector-xz-distance pos (-> cp trans))))
+                  (when (or (not best) (< d best-dist))
+                    (set! best cp)
+                    (set! best-dist d)))))))))
+    best))
+
+;; The stock sharkey bite: lunge up at Jak, eat him (target-death 'sharkey hides him while we exist), then fall back.
+(defstate ios-ocean-shark-bite (ios-ocean-shark)
+  :code
+    (behavior ()
+      (sound-play "bigshark-bite")
+      (set! (-> self start quad) (-> self root trans quad))
+      (ja-channel-push! 1 (seconds 0.1))
+      (ja-no-eval :group! sharkey-chomp-ja :num! (seek! (ja-aframe 3.0 0) 2.0) :frame-num 0.0)
+      (until (ja-done? 0)
+        (let ((tpos (target-pos 5)))
+          (vector-lerp! (-> self root trans)
+                        (-> self start)
+                        tpos
+                        (fmin 1.0 (/ (ja-aframe-num 0) 3.0))))
+        (suspend)
+        (ja :num! (seek! (ja-aframe 3.0 0) 2.0)))
+      (cond
+        ((send-event *target* 'attack-invinc #f (static-attack-info ((mode 'sharkey))))
+         ;; Respawn at the dock of the nearest island when it has one (Sandover, Misty), like the boat's other
+         ;; open-sea respawns; near an island without a dock, at the spawn closest to where Jak was eaten.
+         (let* ((pos (-> *target* control trans))
+                (d-village (ios-sea-distance pos IOS_SEA_VILLAGE_X IOS_SEA_VILLAGE_Z))
+                (d-misty (ios-sea-distance pos IOS_SEA_MISTY_X IOS_SEA_MISTY_Z))
+                (d-other (fmin (fmin (ios-sea-distance pos IOS_SEA_BEACH_X IOS_SEA_BEACH_Z)
+                                     (fmin (ios-sea-distance pos IOS_SEA_JUNGLE_X IOS_SEA_JUNGLE_Z)
+                                           (ios-sea-distance pos IOS_SEA_TRAINING_X IOS_SEA_TRAINING_Z)))
+                               (fmin (ios-sea-distance pos IOS_SEA_VILLAGE2_X IOS_SEA_VILLAGE2_Z)
+                                     (ios-sea-distance pos IOS_SEA_SWAMP_X IOS_SEA_SWAMP_Z)))))
+           (cond
+             ;; eaten off the Glacier: its own start (Misty's dock would load Sandover next to it)
+             ((and (= *ios-glacier-warp* #t)
+                   (< (- (ios-sea-distance pos IOS_SEA_GLACIER_X IOS_SEA_GLACIER_Z) IOS_SEA_GLACIER_SHORE)
+                      (fmin d-misty (fmin d-village d-other))))
+              (ios-ocean-set-respawn 'glacier))
+             ((and (<= d-village d-misty) (<= d-village d-other)) (ios-ocean-set-respawn 'village1))
+             ((<= d-misty d-other) (ios-ocean-set-respawn 'misty))
+             (else
+              (let ((cp (ios-ocean-nearest-continue pos)))
+                (if cp (set-continue! *game-info* (-> cp name)))))))
+         (vector-float*! (-> self vel) (-> self dir) (meters 8))
+         (set! (-> self vel y) (meters 20))
+         (set-time! (-> self state-time))
+         (until (time-elapsed? (-> self state-time) (seconds 3))
+           (ja-no-eval :group! sharkey-chomp-ja :num! (seek!) :frame-num (ja-aframe 3.0 0))
+           (until (ja-done? 0)
+             (+! (-> self vel y) (* (meters -100) (seconds-per-frame)))
+             (when (< (-> self root trans y) (ocean-get-height (-> self root trans)))
+               (vector-float*! (-> self vel) (-> self vel) 0.9))
+             (vector+*! (-> self root trans) (-> self root trans) (-> self vel) (seconds-per-frame))
+             (let ((fwd (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> self vel) 1.0)))
+               (forward-up->quaternion (-> self root quat) fwd *up-vector*))
+             (suspend)
+             (ja :num! (seek!))))
+         0)
+        (else (go ios-ocean-shark-leave)))
+      ;; Release Jak as soon as the complete stock bite/fall animation finishes, then remain alive long
+      ;; enough to visibly swim away. Deactivating here could strand target-death's sharkey mode in water.
+      (send-event *target* 'end-mode)
+      (go ios-ocean-shark-leave))
+  :post
+    (behavior ()
+      (ios-ocean-shark-depth-tint)
+      (ja-post)))
