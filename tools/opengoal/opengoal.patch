+(define-perm *ios-ocean-manager-ppointer* (pointer process) #f)
+(define-perm *ios-ocean-manager-pid* int 0)
+;; the parked spot the free boat last stored (w = 1 once set); a different spot in the perm means a save was loaded
+;; or a new game started (fishermans-boat-ios-record-park), so the free boat must make way
+(define-perm *ios-free-boat-last-park* vector #f)
+;; og:ios #t while the stand-in coastline (Jak1Level-ios-coast.fr3z, tools/coast/) should be drawn; read by the host.
+(define-perm *ios-coast-visible* symbol #f)
