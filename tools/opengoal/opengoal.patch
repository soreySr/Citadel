+(defbehavior fishermans-boat-ios-engine-off fishermans-boat ()
+  "Cut the engine: the propeller spins down and water drag brings the boat to a stop."
+  (set! (-> self ignition) #f)
+  (set! (-> self controller throttle) 0.0)
+  (set! (-> self controller steering) 0.0)
+  0
+  (none))
+
+
+(defbehavior fishermans-boat-ios-controls fishermans-boat ()
+  "Tap X to toggle the engine; while on, the throttle climbs to cruise by itself (and the thrust ramps exactly
+   like the autopilot ride). Stick / d-pad left-right steers, which only bites while the engine pushes
+   (steering turns the thrust)."
+  (when (cpad-pressed? 0 x)
+    (if (-> self ignition)
+      (fishermans-boat-ios-engine-off)
+      (begin
+        (set! (-> self ignition) #t)
+        (set! (-> self anchored) #f))))
+  (if (-> self ignition)
+    (seek! (-> self controller throttle) FISHERMANS_BOAT_IOS_MAX_THROTTLE (* 0.5 (seconds-per-frame))))
+  ;; same sign as the developers' player-control code (stick right = negative steering)
+  (let ((steer (analog-input (the-as int (-> *cpad-list* cpads 0 leftx)) 128.0 48.0 110.0 -1.0)))
+    (cond
+      ((cpad-hold? 0 right) (set! steer -1.0))
+      ((cpad-hold? 0 left) (set! steer 1.0)))
+    ;; half lock: slow, wide turns
+    (seek! (-> self controller steering) (* 0.5 (fmax -1.0 (fmin 1.0 steer))) (seconds-per-frame)))
+  0
+  (none))
+
+(defbehavior fishermans-boat-ios-hold-player fishermans-boat ()
+  "Pin Jak to his spot on the deck (old-target-pos trans holds it in boat space) facing the boat's heading,
+   so he turns with the boat."
+  (when *target*
+    (let ((tq (new 'stack-no-clear 'transformq)))
+      (vector-orient-by-quat! (-> tq trans) (-> self old-target-pos trans) (-> self root-overlay quat))
+      (vector+! (-> tq trans) (-> tq trans) (-> self root-overlay trans))
+      (set! (-> tq trans w) 1.0)
+      (forward-up-nopitch->quaternion (-> tq quat)
+                                      (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self root-overlay quat))
+                                      *up-vector*)
+      (send-event *target* 'trans 'restore tq)))
+  0
+  (none))
+
+;; cam-stick's height/distance follow view-off-param (0 = 2 m up / 5 m back, 1 = 15 m up / 30 m back, *CAM_STICK-bank*),
+;; which the right stick (vertical swipes) moves. Keep it at least this high so the camera never drops low and
+;; close to the boat: 0.55 = 9.15 m up, 18.75 m back.
+(defconstant FISHERMANS_BOAT_IOS_MIN_CAM_PARAM 0.55)
+
+(defbehavior fishermans-boat-ios-camera-follow fishermans-boat ()
+  "Keep cam-stick behind the boat. The right stick (touch swipes reach cam-stick as right stick) turns it
+   freely; 3 seconds after the last camera input it swings back behind the boat and follows it again.
+   controller sample-time (only used by the dev measurement mode) holds the last camera input time."
+  (let ((pad (-> *cpad-list* cpads 0)))
+    (if (or (< 24 (abs (+ -128 (the int (-> pad rightx))))) (< 24 (abs (+ -128 (the int (-> pad righty))))))
+      (set-time! (-> self controller sample-time))))
+  ;; stay high above the boat, however far the right stick pulls the camera in
+  (when (> (-> *camera* num-slaves) 0)
+    (let ((slave (the-as camera-slave (ppointer->process (-> *camera* slave (+ -1 (-> *camera* num-slaves)))))))
+      (if (and slave (= (-> slave state) cam-stick))
+        (set! (-> slave view-off-param) (fmax FISHERMANS_BOAT_IOS_MIN_CAM_PARAM (-> slave view-off-param))))))
+  (when (and (time-elapsed? (-> self controller sample-time) (seconds 3)) (> (-> *camera* num-slaves) 0))
+    ;; the newest slave is the one being blended to
+    (let ((slave (the-as camera-slave (ppointer->process (-> *camera* slave (+ -1 (-> *camera* num-slaves)))))))
+      (when (and slave (= (-> slave state) cam-stick))
+        (let ((cur (new 'stack-no-clear 'vector))
+              (want (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self root-overlay quat)))
+              (mat (new 'stack-no-clear 'matrix)))
+          ;; view-flat points from Jak to the camera: behind the boat is minus its heading
+          (set! (-> cur quad) (-> slave view-flat quad))
+          (set! (-> cur y) 0.0)
+          (set! (-> want y) 0.0)
+          (when (and (< 0.0 (vector-length cur)) (< 0.0 (vector-length want)))
+            (vector-normalize! cur 1.0)
+            (vector-normalize! want -1.0)
+            ;; ease in, at most 90 degrees a second
+            (matrix-from-two-vectors-max-angle-partial! mat cur want (* 16384.0 (seconds-per-frame)) 0.1)
+            (vector-matrix*! (-> slave view-flat) (-> slave view-flat) mat))))))
+  0
+  (none))
+
+(defun fishermans-boat-ios-eat-circle ()
+  "Consume this O press entirely. Jak's stance/walk states test recently-pressed?, which reads the
+   high-fps *cpad-history-list* rather than *cpad-list*, so clear it there too or he attacks once released."
+  (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons circle))
+  (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons circle))
+  (let ((history (-> *cpad-history-list* cpads 0)))
+    (dotimes (i 15)
+      (logclear! (-> history button0-rel i) (pad-buttons circle))))
+  0)
+
+(defbehavior fishermans-boat-ios-borders-off fishermans-boat ((want-off object))
+  "Turn the stock load boundaries off (border-mode #f) while Jak is aboard. Several of them lie out in the water,
+   e.g. Rock Village's (load village2 sunken) by the Lost Precursor City entrance: crossing one swaps village1 out,
+   which kills the boat (a village1 actor) under Jak. The ocean manager picks the levels at sea instead."
+  (let ((off (if want-off #t #f)))
+    (when (!= off *ios-boat-borders-off*)
+      (set! *ios-boat-borders-off* off)
+      (if off (set-setting! 'border-mode #f 0.0 0) (remove-setting! 'border-mode))))
+  0
+  (none))
+
+(defun ios-free-boat-last-park ()
+  "*ios-free-boat-last-park*, made once in the global heap."
+  (when (not *ios-free-boat-last-park*)
+    (set! *ios-free-boat-last-park* (new 'global 'vector))
+    (set! (-> *ios-free-boat-last-park* w) 0.0))
+  *ios-free-boat-last-park*)
+
+(defun ios-free-boat-park-replaced? ()
+  "Has the parked spot changed under the free boat since it last stored it (a save loaded, a new game: the
+   perm holds a different spot or none)?"
+  (let ((last (ios-free-boat-last-park))
+        (cur (new 'stack-no-clear 'vector)))
+    (and (= (-> last w) 1.0)
+         (or (not (ios-boat-park-get cur))
+             (< (meters 1) (vector-vector-xz-distance cur last))))))
+
+(defbehavior fishermans-boat-ios-record-park fishermans-boat ()
+  "Remember where the boat is, every 15 frames (ios-boat-park.gc keeps it in the boat's perm: through deaths,
+   level changes and saves). The free boat first checks the perm still holds its own spot: if not, the game
+   state it belonged to is gone and it makes way (ios-free-boat-update spawns it again at the new spot)."
+  (when (zero? (logand (-> *display* base-frame-counter) 15))
+    (when (and (fishermans-boat-ios-free? self) (ios-free-boat-park-replaced?))
+      (format 0 "ios-free-boat: parked spot changed (save loaded / new game), removing the boat~%")
+      (deactivate self))
+    (let ((pos (-> self root-overlay trans))
+          (yaw 0.0))
+      (if (and (-> self anchored) (= (-> self dock-point-index) -1))
+        (begin
+          (set! pos (-> self dock-point))
+          (set! yaw (atan (-> self dest-dir x) (-> self dest-dir z))))
+        (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self root-overlay quat))))
+          (set! yaw (atan (-> fwd x) (-> fwd z)))))
+      (ios-boat-park-store pos yaw)
+      (when (fishermans-boat-ios-free? self)
+        (let ((last (ios-free-boat-last-park)))
+          (set-vector! last (-> pos x) 0.0 (-> pos z) 1.0)))))
+  0
+  (none))
+
+(defbehavior fishermans-boat-ios-anchor-when-stopped fishermans-boat ()
+  "Nobody aboard and (nearly) stopped: anchor on the spot, so the boat holds its parked position and heading."
+  (when (and (not (-> self anchored))
+             (not (fishermans-boat-ios-player-aboard?))
+             (< (vector-length (-> self rbody lin-velocity)) (meters 0.5)))
+    (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self root-overlay quat))))
+      (set! (-> fwd y) 0.0)
+      (vector-normalize! fwd 1.0)
+      (set! (-> fwd w) 1.0)
+      (set! (-> self dest-dir quad) (-> fwd quad)))
+    (set-vector! (-> self dock-point) (-> self root-overlay trans x) 0.0 (-> self root-overlay trans z) 1.0)
+    (set! (-> self dock-point-index) -1)
+    (set! (-> self anchored) #t))
+  0
+  (none))
+
+(defbehavior fishermans-boat-ios-leave-wheel fishermans-boat ()
+  "Engine off, then back to the dock state while still anchored there, else float freely."
+  (fishermans-boat-ios-engine-off)
+  (cond
+    ;; -1: anchored at a parked spot, not a stock dock
+    ((or (not (-> self anchored)) (= (-> self dock-point-index) -1)) (go fishermans-boat-ios-idle))
+    ((= (-> self dock-point-index) 4) (go fishermans-boat-docked-misty))
+    (else (go fishermans-boat-docked-village)))
+  0
+  (none))
+
+(defbehavior fishermans-boat-ios-free-check fishermans-boat ()
+  "The free boat removes itself when the option is turned off or the title screen loads; the village1 actor,
+   hidden while it exists, is then born again at the parked spot (fishermans-boat-ios-hidden). The actor hides
+   as soon as a free boat exists (e.g. ios-free-boat-update spawned one at the parked spot)."
+  (cond
+    ((fishermans-boat-ios-free? self)
+     (if (or (not *ios-driveable-boat*) (level-get *level* 'title)) (deactivate self)))
+    ((ios-free-boat) (go fishermans-boat-ios-hidden)))
+  0
+  (none))
+
+;; Jak holds the wheel: he is grabbed (locked in place on the deck) and the camera follows from behind
+;; (cam-stick, the developers' third-person boat camera; the right stick still turns and zooms it).
+(defstate fishermans-boat-ios-drive (fishermans-boat)
+  :event rigid-body-platform-event-handler
+  :enter
+    (behavior ()
+      (set-time! (-> self state-time))
+      (set! *ios-boat-driving* #t)
+      (fishermans-boat-ios-borders-off #t)
+      ;; camera follows the boat right away (no camera input yet)
+      (set! (-> self controller sample-time) (- (current-time) (seconds 3)))
+      (set! (-> self auto-pilot) #f)
+      (set! (-> self waiting-for-player) #f)
+      ;; remember where Jak stands in boat space (old-target-pos is only used by the ride cutscenes),
+      ;; then face him along the boat so the camera starts behind both
+      (when *target*
+        (let ((inv (quaternion-conjugate! (new 'stack-no-clear 'quaternion) (-> self root-overlay quat))))
+          (vector-! (-> self old-target-pos trans) (-> *target* control trans) (-> self root-overlay trans))
+          (vector-orient-by-quat! (-> self old-target-pos trans) (-> self old-target-pos trans) inv))
+        (fishermans-boat-ios-hold-player)))
+  :exit
+    (behavior ()
+      (set! *ios-boat-driving* #f)
+      ;; fishermans-boat-ios-idle keeps them off while Jak still stands on the deck
+      (fishermans-boat-ios-borders-off #f)
+      (send-event *camera* 'change-state *camera-base-mode* 0)
+      (process-release? *target*))
+  :trans
+    (behavior ()
+      (rider-trans)
+      (cond
+        ((and (time-elapsed? (-> self state-time) (seconds 0.1)) (cpad-pressed? 0 circle))
+         (fishermans-boat-ios-eat-circle)
+         (fishermans-boat-ios-leave-wheel))
+        ;; something else took Jak out of the grab (death, a cutscene...). On the flut flut (Expanded Flut Flut)
+        ;; the grab keeps him on it: target-flut-grab.
+        ((and (time-elapsed? (-> self state-time) (seconds 0.5))
+              (or (not *target*)
+                  (let ((mode (send-event *target* 'query 'mode)))
+                    (not (or (= mode 'target-grab) (= mode 'target-flut-grab))))))
+         (fishermans-boat-ios-leave-wheel)))
+      (fishermans-boat-ios-free-check)
+      (fishermans-boat-ios-controls)
+      (fishermans-boat-ios-record-park)
+      (fishermans-boat-ios-hold-player)
+      (fishermans-boat-ios-camera-follow)
+      (fishermans-boat-ios-draw-hints))
+  :code
+    (behavior ()
+      ;; one frame for the 'trans restore to land, so the camera's tracking frame is behind Jak
+      (suspend)
+      (send-event *camera* 'change-state cam-stick 0)
+      (anim-loop))
+  :post fishermans-boat-post)
+
+;; Afloat away from the docks with nobody at the wheel.
+(defstate fishermans-boat-ios-idle (fishermans-boat)
+  :event rigid-body-platform-event-handler
+  :enter
+    (behavior ()
+      (set-time! (-> self state-time))
+      (fishermans-boat-ios-borders-off (fishermans-boat-ios-player-aboard?)))
+  :exit
+    (behavior ()
+      (fishermans-boat-ios-borders-off #f))
+  :trans
+    (behavior ()
+      ;; drifting with Jak on deck: the boat must not be unloaded under him either
+      (fishermans-boat-ios-borders-off (fishermans-boat-ios-player-aboard?))
+      (when *ios-driveable-boat*
+        (fishermans-boat-ios-anchor-when-stopped)
+        (fishermans-boat-ios-record-park))
+      (if (and *ios-driveable-boat* (fishermans-boat-ios-board?)) (fishermans-boat-ios-take-wheel))
+      (fishermans-boat-ios-free-check)
+      (rider-trans))
+  :code anim-loop
+  :post fishermans-boat-post)
+
+;; og:ios free boat (free-boat-plan.md phase 2) ----------------------------------------------------------------
+;; Taking the wheel of the village1 actor spawns the free boat in its place (same type, same states) and hides the
+;; actor. The free boat belongs to no level: it is in *entity-pool*, not linked to any level's entities, and its
+;; stand-in entity points at level-default, so initialize-skeleton takes the resident art (the actor uses
+;; village1's own copy) and level unloads never kill it.
+
+(defun ios-free-boat-entity ()
+  "The free boat's entity: an empty res-lump (every res lookup gets its default; nav-mesh-connect falls back to
+   *default-nav-mesh*) with links whose level is level-default and whose process is never set, so
+   process-entity-status! and entity-deactivate-handler leave it alone. Made once in the global heap."
+  (when (not *ios-free-boat-entity*)
+    (let ((ent (new 'global 'entity-actor 1 0))
+          (links (new 'global 'entity-links)))
+      (set! (-> links entity) ent)
+      (set! (-> links process) #f)
+      (set! (-> links level) (-> *level* level-default))
+      (set! (-> ent extra) links)
+      (set! (-> ent etype) fishermans-boat)
+      (quaternion-identity! (-> ent quat))
+      (set! *ios-free-boat-entity* ent)))
+  *ios-free-boat-entity*)
+
+(defbehavior fishermans-boat-ios-free-init-by-other fishermans-boat ((src fishermans-boat) (park vector))
+  "Init the free boat. With SRC (the village1 actor, Jak just took its wheel and is grabbed) it takes over SRC's
+   position and motion and drives; otherwise it lies anchored at PARK (xz, w = yaw: the parked spot)."
+  (set! (-> self entity) (ios-free-boat-entity))
+  (stack-size-set! (-> self main-thread) 512)
+  (logior! (-> self mask) (process-mask platform))
+  (rigid-body-platform-method-30 self)
+  (cond
+    (src
+     (set! (-> self root-overlay trans quad) (-> src root-overlay trans quad))
+     (quaternion-copy! (-> self root-overlay quat) (-> src root-overlay quat)))
+    (else
+     (set-vector! (-> self root-overlay trans) (-> park x) 0.0 (-> park z) 1.0)
+     (quaternion-axis-angle! (-> self root-overlay quat) 0.0 1.0 0.0 (-> park w))))
+  (vector-identity! (-> self root-overlay scale))
+  ;; method-31 puts it at a stock dock or the parked spot and resets the physics there
+  (rigid-body-platform-method-31 self)
+  (set! (-> self dock-point-index) -1)
+  (cond
+    (src
+     ;; back to the actor's spot, with its momentum
+     (set! (-> self root-overlay trans quad) (-> src root-overlay trans quad))
+     (quaternion-copy! (-> self root-overlay quat) (-> src root-overlay quat))
+     (mem-copy! (the-as pointer (-> self rbody)) (the-as pointer (-> src rbody)) (size-of rigid-body))
+     (set! (-> self dock-point quad) (-> src root-overlay trans quad))
+     (set! (-> self dest-dir quad) (-> src dest-dir quad))
+     (set! (-> self anchored) #f)
+     (set! (-> self propeller spin-rate) (-> src propeller spin-rate)))
+    (else
+     ;; held at the spot, like method-31 does for the actor
+     (set-vector! (-> self dock-point) (-> park x) 0.0 (-> park z) 1.0)
+     (set-vector! (-> self dest-dir) (sin (-> park w)) 0.0 (cos (-> park w)) 1.0)
+     (set! (-> self anchored) #t)))
+  ;; nothing stored by this boat yet; spawned at the parked spot, that spot is its own
+  (let ((last (ios-free-boat-last-park)))
+    (if src
+      (set! (-> last w) 0.0)
+      (set-vector! last (-> park x) 0.0 (-> park z) 1.0)))
+  (set! *ios-free-boat-ppointer* (-> self ppointer))
+  (set! *ios-free-boat-pid* (-> self pid))
+  (format 0 "ios-free-boat: spawned at ~M ~M~%" (-> self root-overlay trans x) (-> self root-overlay trans z))
+  (if src (go fishermans-boat-ios-drive) (go fishermans-boat-ios-idle))
+  (none))
+
+(defbehavior fishermans-boat-ios-take-wheel fishermans-boat ()
+  "Jak took the wheel (fishermans-boat-ios-board? grabbed him). The village1 actor hands over to a new free boat
+   when the resident art is there; the free boat (or the actor without resident art) drives itself."
+  (cond
+    ((and (not (fishermans-boat-ios-free? self)) *ios-boat-art-resident* (not (ios-free-boat)))
+     (if (process-spawn fishermans-boat :init fishermans-boat-ios-free-init-by-other self (the-as vector #f) :to *entity-pool*)
+       (go fishermans-boat-ios-hidden)
+       (go fishermans-boat-ios-drive)))
+    (else (go fishermans-boat-ios-drive)))
+  0
+  (none))
+
+(defun ios-free-boat-update ()
+  "Per frame from pc/ios/ios-boat-park.gc (its *menu-hook*, which skips the title, pauses, movies, continues and
+   warps) while the option is on and the boat art is resident: keeps the standalone ocean manager running and the
+   free boat at its parked spot, whatever levels are loaded. With no parked spot the boat is at a stock dock as a
+   village1 actor until Jak takes its wheel."
+  (ios-ocean-manager-ensure)
+  (when (and (not (ios-free-boat))
+             (!= *ios-boat-driving* #t)
+             ;; Jak on the actor's deck: he takes its wheel (handoff) instead
+             (!= *ios-boat-boardable* #t))
+    (let ((park (new 'stack-no-clear 'vector)))
+      (when (ios-boat-park-get park)
+        (process-spawn fishermans-boat
+                       :init fishermans-boat-ios-free-init-by-other
+                       (the-as fishermans-boat #f)
+                       park
+                       :to *entity-pool*))))
+  0)
+
+;; The village1 actor while the free boat exists: not drawn, no collision, no physics. Once the free boat is gone
+;; it deactivates, and the entity is born again (actors-update) at the parked spot the free boat kept recording.
