+(defbehavior tfl-yellow-shot-init-by-other tfl-yellow-shot ((e entity-actor) (pos vector) (vel vector) (charged-time time-frame))
+  (stack-size-set! (-> self main-thread) 512)
+  (set! (-> self entity) e)
+  (set! (-> self attack-mode) #f)
+  (set! (-> self update-velocity) projectile-update-velocity-space-wars)
+  (set! (-> self max-speed) (vector-length vel))
+  (set! (-> self max-turn) 0.0)
+  (set! (-> self tween) 1.0)
+  (set! (-> self last-target) (the handle #f))
+  (set! (-> self options) (the uint 25))
+  (set! (-> self notify-handle) (the handle #f))
+  (set! (-> self fully-charged?) (>= charged-time SUPER_YELLOW_MAX_CHARGE_TIME))
+  (set! (-> self charged-time) charged-time)
+  ; (format 0
+  ;         "charge time ~D ratio ~f result ~f~%"
+  ;         charged-time
+  ;         (/ (the float charged-time) SUPER_YELLOW_MAX_CHARGE_TIME)
+  ;         (* (the float (seconds 2)) (/ (the float charged-time) SUPER_YELLOW_MAX_CHARGE_TIME)))
+  (set! (-> self timeout)
+        (the time-frame
+             (- (* (the float (seconds 1)) (/ (the float charged-time) SUPER_YELLOW_MAX_CHARGE_TIME)) (seconds 0.25))))
+  (countdown (i 16)
+    (set! (-> self old-dist i) 4095996000.0))
+  (projectile-method-26 self)
+  (set! (-> self root dynam gravity y) (meters 300))
+  (set! (-> self root dynam gravity-length) (meters 300))
+  (set! (-> self root dynam gravity-max) (meters 300))
+  (vector-copy! (-> self root trans) pos)
+  (vector-copy! (-> self base-trans) pos)
+  (vector-copy! (-> self parent-base) pos)
+  (quaternion-copy! (-> self root quat) (-> self parent 0 root quat))
+  (quaternion-copy! (the quaternion (-> self parent-quat)) (-> self parent 0 root quat))
+  (vector-identity! (-> self root scale))
+  (vector-copy! (-> self root transv) vel)
+  (vector-normalize-copy! (-> self base-vector) vel 1.0)
+  (vector+float*! (-> self target) (-> self root trans) (-> self root transv) 2.0)
+  (vector-copy! (-> self target-base) (-> self target))
+  (projectile-method-27 self)
+  (projectile-method-24 self)
+  (when (not (type-type? (-> self type) projectile-blue))
+    (let ((oo (new 'stack-no-clear 'overlaps-others-params)))
+      (set! (-> oo options) (the uint 1))
+      (set! (-> oo tlist) *touching-list*)
+      (find-overlapping-shapes (-> self root) oo)))
+  (set! (-> self event-hook) (-> (method-of-object self projectile-moving) event))
+  (projectile-method-25 self))
+
