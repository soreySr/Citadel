+;; og:ios collision of the east coastline (coastline-plan.md phase 3). The rock is drawn natively and has no
+;; background collision, so the boat and Jak test a height grid of it, built at import together with the model
+;; (Jak1CustomLevelBuilder.cpp WriteCoastHeights -> Jak1Level-ios-coast.heights) and loaded by the host into the
+;; global heap: float x0, z0, cell (game units), int32 nx, nz, padding to 32 bytes, then nx * nz int8 heights
+;; (m, -128 = no rock), row by row from z0. #f until the host has set it: no coast collision.
+(define-perm *ios-coast-grid* pointer #f)
+
+(defun ios-coast-height ((x float) (z float))
+  "Height of the east coastline's rock at x z (game units), or -1e9 where it has none."
+  (let ((grid *ios-coast-grid*))
+    (if (or (not grid) (zero? grid))
+      -1000000000.0
+      (let* ((cell (-> (the-as (pointer float) grid) 2))
+             (nx (-> (the-as (pointer int32) grid) 3))
+             (nz (-> (the-as (pointer int32) grid) 4))
+             (fx (/ (- x (-> (the-as (pointer float) grid) 0)) cell))
+             (fz (/ (- z (-> (the-as (pointer float) grid) 1)) cell)))
+        (if (and (>= fx 0.0) (>= fz 0.0) (< fx (the float nx)) (< fz (the float nz)))
+          (let ((h (-> (the-as (pointer int8) (&+ grid 32)) (+ (the int fx) (* (the int fz) nx)))))
+            (if (= h -128) -1000000000.0 (* 4096.0 (the float h))))
+          -1000000000.0)))))
