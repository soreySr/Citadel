+(defun path-distance-up-to-cvert ((this path-control) (up-to int))
+  (let ((dist 0.0))
+    (dotimes (i (min up-to (1- (-> this curve num-cverts))))
+      (+! dist (vector-vector-distance (-> this cverts i) (-> this cverts (1+ i)))))
+    dist))
