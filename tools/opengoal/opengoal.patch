@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""Pack executable Jak 1 AOT ranges for the signed iOS code view.
+
+Only v3 object `main` and `top_level` segments are callable GOAL code. Debug
+segments are deliberately excluded so a future native call site can reject an
+arbitrary GOAL offset before converting it to a signed Mach-O address.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import struct
+from pathlib import Path
+
+
+MAGIC = b"JAK1COD\0"
+HEADER = struct.Struct("<8sIII")
+ENTRY = struct.Struct("<II")
+EXECUTABLE_SEGMENTS = {"main", "top_level"}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("layout", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+
+    layout = json.loads(args.layout.read_text())
+    base = layout["goal_base_offset"]
+    image_size = layout["image_size"]
+    ranges = []
+    for segment in layout["segments"]:
+        if segment["segment"] not in EXECUTABLE_SEGMENTS or segment["size"] == 0:
+            continue
+        start = segment["goal_offset"]
+        size = segment["size"]
+        if start < base or start + size > base + image_size:
+            raise RuntimeError(f"executable segment lies outside image: {segment}")
+        ranges.append((start, size))
+    ranges.sort()
+    if not ranges:
+        raise RuntimeError("layout contains no executable segments")
+    for (start, size), (next_start, _) in zip(ranges, ranges[1:]):
+        if start + size > next_start:
+            raise RuntimeError("executable segments overlap")
+
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open("wb") as file:
+        file.write(HEADER.pack(MAGIC, 1, base, len(ranges)))
+        for start, size in ranges:
+            file.write(ENTRY.pack(start, size))
+    print(f"Wrote {args.output} ({len(ranges)} executable ranges)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
