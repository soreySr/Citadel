@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Pack planned Jak 1 Type record headers for the iOS GOAL type arena."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import struct
+from pathlib import Path
+
+
+HEADER = struct.Struct("<8sII")
+ENTRY = struct.Struct("<IIHH")
+MAGIC = b"JAK1TYP\0"
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("type_image", type=Path)
+    parser.add_argument("symbol_slots", type=Path)
+    parser.add_argument("s7_goal_offset", type=lambda value: int(value, 0))
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+
+    types = json.loads(args.type_image.read_text())["types"]
+    slots = json.loads(args.symbol_slots.read_text())["assignments"]
+    slot_by_name = {entry["name"]: entry["s7_relative_offset"] for entry in slots}
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open("wb") as file:
+        file.write(HEADER.pack(MAGIC, 1, len(types)))
+        for type_info in types:
+            slot = slot_by_name.get(type_info["name"])
+            if slot is None:
+                raise RuntimeError(f"type is missing a symbol slot: {type_info['name']}")
+            file.write(ENTRY.pack(
+                type_info["goal_offset"],
+                args.s7_goal_offset + slot,
+                type_info["method_count"],
+                type_info.get("allocation_size", 0),
+            ))
+    print(f"Wrote {args.output} ({len(types)} type records)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
