+        (when (and (not jumping?) (not (-> *ios-tfl-super* super-yellow-charge-loop)) (< (ja-aframe-num 0) running-start-loop-frame))
+          (ja :num! (seek! running-start-loop-frame 0.5)))
+        ;; then loop between frame 8 and 10
+        (when (and (not jumping?) (>= (ja-aframe-num 0) running-start-loop-frame))
+          (if (and (-> *ios-tfl-super* super-yellow-charge-loop) (<= (ja-aframe-num 0) 10.0))
