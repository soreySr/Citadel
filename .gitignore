# ---- Never publish: the disc, and anything built from it ------------------------------------------
# Desktop build inputs made from the disc (see LocalGameData/README.md) and old app files.
LocalGameData/
# Eroded Coast, removed from the app (ripped meshes, game textures, assembled DGO).
Parked/
# Old level-code/runtime snapshots (contain disc data).
AOTBackup-*/
# OpenGOAL is not stored here: tools/opengoal/opengoal.sh checks out upstream OpenGOAL (which includes its
# decompilation of the game) and applies tools/opengoal/opengoal.patch. Its disc data and build outputs stay local too.
/OpenGOAL/

# ---- Build products -------------------------------------------------------------------------------
# AOT-compiled GOAL code, link tables, runtime-state patch and extractor config: built, never committed
# (jakIOS/Runtime/Jak1GeneratedFilesCheck.c lists what the target needs).
jakIOS/Generated/
# OpenGOAL level-extractor libraries (sh tools/ios_extractor/build.sh).
build-ios-extractor/
# Release build scratch folder (tools/release/build.sh): capture, compiled objects, DerivedData, Citadel.ipa.
build-release/
tools/runtime_state_patch/xd3_tool
__pycache__/

# ---- Xcode / macOS --------------------------------------------------------------------------------
xcuserdata/
*.xcuserstate
DerivedData/
.DS_Store

# Local restore points (contain the level-code blob and full source snapshots)
Checkpoints/

# Personal to-do list
/plans
